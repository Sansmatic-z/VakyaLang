स्थिर CODEX_PAGE_NAME = "english_vak_native"
स्थिर CODEX_PAGE_DESCRIPTION = "Vak-native English bridge page"
स्थिर CODEX_PAGE_PRIORITY = 48
स्थिर CODEX_PAGE_KIND = "vak_module"
स्थिर CODEX_PAGE_CHAPTER = "vak_native"
स्थिर CODEX_PAGE_CHAPTER_TITLE = "Vak Native Pages"
स्थिर CODEX_PAGE_CHAPTER_ORDER = 50
स्थिर CODEX_PAGE_CAPABILITIES = ["bridge", "translate", "normalize"]
स्थिर CODEX_PAGE_EMITS_VAK = सत्य
स्थिर CODEX_PAGE_EXTENSIONS = ["py"]
स्थिर CODEX_PAGE_HINTS = ["def ", "class ", "while ", "for ", "return ", "import "]
स्थिर CODEX_PAGE_MAX_FIXPOINT_PASSES = 2

कर्म codex_probe(source, filename = शून्य):
    यदि filename != शून्य और ".py" अन्तर्गत filename:
        प्रत्यागच्छ {"score": 45, "reason": "Python-like path matched by Vak page"}
    यदि "def " अन्तर्गत source अथवा "class " अन्तर्गत source अथवा "return " अन्तर्गत source:
        प्रत्यागच्छ {"score": 43, "reason": "English/Python-like constructs detected by Vak page"}
    यदि "while " अन्तर्गत source अथवा "for " अन्तर्गत source अथवा "import " अन्तर्गत source:
        प्रत्यागच्छ {"score": 40, "reason": "ASCII bridge syntax detected by Vak page"}
    प्रत्यागच्छ {"score": 0, "reason": "not an English Vak-native candidate"}

कर्म codex_transform(source, filename = शून्य):
    प्रत्यागच्छ कोडेक्स_विवरण(source, "english_vak", filename)
