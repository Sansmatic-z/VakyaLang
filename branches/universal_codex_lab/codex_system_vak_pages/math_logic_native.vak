स्थिर CODEX_PAGE_NAME = "math_logic_native"
स्थिर CODEX_PAGE_DESCRIPTION = "Vak-native math and logic notation page"
स्थिर CODEX_PAGE_PRIORITY = 46
स्थिर CODEX_PAGE_KIND = "vak_module"
स्थिर CODEX_PAGE_CHAPTER = "vak_native"
स्थिर CODEX_PAGE_CHAPTER_TITLE = "Vak Native Pages"
स्थिर CODEX_PAGE_CHAPTER_ORDER = 50
स्थिर CODEX_PAGE_CAPABILITIES = ["math_logic", "symbolic_notation", "normalize"]
स्थिर CODEX_PAGE_EMITS_VAK = सत्य
स्थिर CODEX_PAGE_EXTENSIONS = ["logic", "math", "bool", "proof"]
स्थिर CODEX_PAGE_HINTS = ["¬", "∧", "∨", "⇒", "⇔", "∈", "⊤", "⊥"]
स्थिर CODEX_PAGE_MAX_FIXPOINT_PASSES = 2

कर्म codex_probe(source, filename = शून्य):
    यदि "¬" अन्तर्गत source अथवा "∧" अन्तर्गत source अथवा "∨" अन्तर्गत source:
        प्रत्यागच्छ {"score": 58, "reason": "symbolic logic operators detected by Vak page"}
    यदि "⇒" अन्तर्गत source अथवा "⇔" अन्तर्गत source अथवा "∈" अन्तर्गत source:
        प्रत्यागच्छ {"score": 56, "reason": "symbolic implication/equivalence detected by Vak page"}
    यदि filename != शून्य और (".logic" अन्तर्गत filename अथवा ".math" अन्तर्गत filename अथवा ".proof" अन्तर्गत filename):
        प्रत्यागच्छ {"score": 40, "reason": "symbolic notation path matched by Vak page"}
    प्रत्यागच्छ {"score": 0, "reason": "not a symbolic Vak-native candidate"}

कर्म codex_transform(source, filename = शून्य):
    प्रत्यागच्छ कोडेक्स_विवरण(source, "math_logic", filename)
