# वाक् तनाव-परीक्षण — मुख्य भाषा एवं रनटाइम

सूत्र दोहरा(x): अनुवाद -> x * २

पारिणाम सरल:
    जोड़(क, ०) -> क
    जोड़(०, क) -> क
    गुण(क, १) -> क

डेटा विकल्प[T]:
    कुछ(T)
    रिक्त

कर्म संचायक_निर्माता(आधार: संख्या):
    कर्म भीतर(मान: संख्या = १) → संख्या:
        वापस आधार + मान
    वापस भीतर

कर्म भाग(क: संख्या, ख: संख्या):
    यदि ख == ०:
        वापस असिद्ध("शून्य")
    वापस सिद्ध(क // ख)

वर्ग गणक:
    कर्म __init__(स्वयं, नाम: तार, प्रारम्भ: संख्या = ०):
        स्वयं.नाम = नाम
        स्वयं.मान = प्रारम्भ

    कर्म जोड़ो(स्वयं, मात्रा: संख्या = १) → संख्या:
        स्वयं.मान = स्वयं.मान + मात्रा
        वापस स्वयं.मान

    कर्म __str__(स्वयं):
        वापस स्वयं.नाम + ":" + पाठ_कर(स्वयं.मान)


मान बढ़ाओ = संचायक_निर्माता(१०)
मान सम = [क प्रति क में परास(८) यदि क % २ == ०]
मान वर्ग = {पाठ_कर(क): क * क प्रति क में परास(५) यदि क > १}
मान पंक्ति = "  vak core  "
    |> छाँटो
    |> उच्च
मान ग = गणक("गण", प्रारम्भ=५)
ग.जोड़ो(३)
मान मान: विकल्प[संख्या] = कुछ(९)

मुद्रय "सूत्र:", सरल(जोड़(दोहरा(३), ०))
मुद्रय "closure:", बढ़ाओ(५)
मुद्रय "list:", सम
मुद्रय "dict:", वर्ग
मुद्रय "pipeline:", पंक्ति
मुद्रय "map:", map(lambda x: x + १, [१, २, ३])
मुद्रय "class:", पाठ_कर(ग)

प्रत्यभिज्ञा भाग(२०, ५):
    सिद्ध(उत्तर):
        मुद्रय "result:", उत्तर
    असिद्ध(त्रुटि):
        मुद्रय "result-error:", त्रुटि
    _:
        मुद्रय "result: अज्ञात"

प्रत्यभिज्ञा मान:
    कुछ(x):
        मुद्रय "data:", x + १
    रिक्त():
        मुद्रय "data:", ०

मुद्रय "STRESS CORE OK"
