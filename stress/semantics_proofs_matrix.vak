# वाक् तनाव-परीक्षण — Sansmatic, refinement, गूढार्थ

आयात gudhartha

कर्म सुरक्षित_भाग(क: संख्या, ख: संख्या) → फल[संख्या, तार]:
    यदि ख == ०:
        वापस असिद्ध("शून्य")
    वापस सिद्ध(क // ख)

कर्म अगला_अभाज्य(x: परिशुद्ध[संख्या, अभाज्य_है]) → संख्या:
    वापस x + २

मान अभाज्य: परिशुद्ध[संख्या, अभाज्य_है] = १७
मुद्रय "refinement:", अगला_अभाज्य(अभाज्य)

परिभाषय("१७", ["अभाज्य", "विषम"])
नियम("*", "HAS", "अभाज्य", "*", "IS", "विशिष्ट")
नियम("*", "HAS", "विषम", "*", "IS", "सम_नहीं")

मुद्रय "proof:", सिद्ध_है("१७", "IS", "विशिष्ट")
मुद्रय "proof-odd:", सिद्ध_है("१७", "IS", "सम_नहीं")

चर धर्म = gudhartha.धर्म_बनाओ("धनात्मक_विषम", "संख्या", ["धनात्मक", "विषम"])
मुद्रय "dharma:", gudhartha.धर्म_मान्य(धर्म, २१)

चर हस्ताक्षर = gudhartha.कारक_बनाओ("प्रेषण", [
    {"नाम": "कर्ता", "भूमिका": "कर्ता", "आवश्यक": सत्य},
    {"नाम": "कर्म", "भूमिका": "कर्म", "आवश्यक": सत्य},
    {"नाम": "गन्तव्य", "भूमिका": "अधिकरण", "आवश्यक": असत्य},
])
चर कारक_रिपोर्ट = gudhartha.कारक_रिपोर्ट(हस्ताक्षर, {
    "कर्ता": "राम",
    "कर्म": "पत्र"
})
मुद्रय "karaka:", कारक_रिपोर्ट["मान्य"]

मुद्रय "nyaya:", gudhartha.न्याय_मान्य(
    "पर्वत अग्निमान् है",
    "क्योंकि धूमवान् है",
    "यथा रसोई",
    "पर्वत धूमवान् है",
    "पर्वत अग्निमान् है"
)

प्रत्यभिज्ञा सुरक्षित_भाग(८१, ९):
    सिद्ध(उत्तर):
        मुद्रय "result:", उत्तर
    असिद्ध(त्रुटि):
        मुद्रय "result-error:", त्रुटि
    _:
        मुद्रय "result: अज्ञात"

मुद्रय "padartha:", gudhartha.पदार्थ(धर्म)
मुद्रय "STRESS SEMANTICS OK"
