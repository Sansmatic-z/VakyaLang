# VakyaLang Full Comprehensive Test Suite

मुद्रय "========================================="
मुद्रय "  VakyaLang Full System Test"
मुद्रय "========================================="
मुद्रय ""

चर पास = 0
चर विफल = 0

कर्म टेस्ट(नाम, actual, expected):
    चर global पास
    चर global विफल
    यदि actual == expected:
        मुद्रय "PASS:", नाम
        पास = पास + 1
    अन्यथा:
        मुद्रय "FAIL:", नाम
        मुद्रय "  Expected:", expected
        मुद्रय "  Got:", actual
        विफल = विफल + 1

मुद्रय ""
मुद्रय "=== BASIC ARITHMETIC ==="

टेस्ट("addition", 5 + 3, 8)
टेस्ट("subtraction", 10 - 4, 6)
टेस्ट("multiplication", 6 * 7, 42)
टेस्ट("division", 20 / 4, 5)
टेस्ट("modulo", 17 % 5, 2)
टेस्ट("power", 2 ** 10, 1024)

मुद्रय ""
मुद्रय "=== STRING OPERATIONS ==="

चर text = "नमस्ते"
टेस्ट("string length", दीर्घता(text), 6)
टेस्ट("string concat", "Hello" + " " + "World", "Hello World")

मुद्रय ""
मुद्रय "=== LIST OPERATIONS ==="

चर lst = [1, 2, 3, 4, 5]
टेस्ट("list length", दीर्घता(lst), 5)
टेस्ट("list access", lst[2], 3)

