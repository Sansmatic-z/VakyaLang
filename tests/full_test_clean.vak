मुद्रय "=== MATH FUNCTIONS ==="

आयात ganit_vistarit

चर pi_val = 3.14159265358979

टेस्ट("sin(0)", गोल(साइन(0), 6), 0.0)
टेस्ट("cos(0)", गोल(कोसाइन(0), 6), 1.0)
टेस्ट("sqrt(144)", गोल(वर्गमूल(144), 6), 12.0)
टेस्ट("5!", क्रमगुणित(5), 120)
टेस्ट("GCD(48,18)", महत्तम_समापवर्तक(48, 18), 6)
टेस्ट("Fib(10)", फिबोनचि(10), 55)
टेस्ट("prime(2)", अभाज्य_है(2), सत्य)
टेस्ट("prime(4)", अभाज्य_है(4), असत्य)

मुद्रय ""
मुद्रय "=== DATA STRUCTURES ==="

आयात data_sangrah

चर stack = नव स्टैक()
stack.धक्का(10)
stack.धक्का(20)
stack.धक्का(30)
टेस्ट("stack pop", stack.पॉप(), 30)
टेस्ट("stack size", stack.आकार(), 2)

चर queue = नव कतार()
queue.प्रवेश(1)
queue.प्रवेश(2)
queue.प्रवेश(3)
टेस्ट("queue dequeue", queue.निर्गम(), 1)
टेस्ट("queue size", queue.आकार(), 2)

चर bst = नव बाइनरी_सर्च_ट्री()
bst.जोड़ो(50)
bst.जोड़ो(30)
bst.जोड़ो(70)
टेस्ट("BST search 30", bst.खोजो(30), सत्य)
टेस्ट("BST search 20", bst.खोजो(20), असत्य)

