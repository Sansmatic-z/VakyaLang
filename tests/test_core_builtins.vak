# वाक् भाषा — कोर बिल्टिन्स परीक्षण (Core Builtins Test Suite)
# Comprehensive Test Suite for Core Builtins Library

मुद्रय "═══════════════════════════════════════════════════════════"
मुद्रय "  कोर बिल्टिन्स — विस्तृत परीक्षण"
मुद्रय "  Core Builtins — Comprehensive Tests"
मुद्रय "═══════════════════════════════════════════════════════════"

चर पास = 0
चर विफल = 0
चर कुल = 0

# ── परीक्षण सहायक (Test Helper) ────────────────────────────────────────────

कर्म परीक्षण_करें(नाम, actual, expected):
    चर global पास
    चर global विफल
    चर global कुल
    कुल = कुल + 1
    
    # Simple comparison
    चर match = actual == expected
    
    यदि match:
        मुद्रय "✓ पास:", नाम
        पास = पास + 1
    अन्यथा:
        मुद्रय "✗ विफल:", नाम
        मुद्रय "  अपेक्षित:", expected
        मुद्रय "  प्राप्त:", actual
        विफल = विफल + 1

# ── 1. Type Conversion Tests ─────────────────────────────────────────────

मुद्रय "\n───────────────────────────────────────────────────────────"
मुद्रय "  1. प्रकार रूपांतरण परीक्षण (Type Conversion Tests)"
मुद्रय "───────────────────────────────────────────────────────────"

आयात core_builtins

# पूर्णांक_कर tests
परीक्षण_करें("पूर्णांक_कर(3.7)", पूर्णांक_कर(3.7), 3)
परीक्षण_करें("पूर्णांक_कर(3.2)", पूर्णांक_कर(3.2), 3)
परीक्षण_करें("पूर्णांक_कर(-3.7)", पूर्णांक_कर(-3.7), -3)
परीक्षण_करें("पूर्णांक_कर(42)", पूर्णांक_कर(42), 42)
परीक्षण_करें("पूर्णांक_कर('42')", पूर्णांक_कर("42"), 42)
परीक्षण_करें("पूर्णांक_कर('-15')", पूर्णांक_कर("-15"), -15)
परीक्षण_करें("पूर्णांक_कर(सत्य)", पूर्णांक_कर(सत्य), 1)
परीक्षण_करें("पूर्णांक_कर(असत्य)", पूर्णांक_कर(असत्य), 0)
परीक्षण_करें("पूर्णांक_कर(शून्य)", पूर्णांक_कर(शून्य), 0)

# पाठ_कर tests
परीक्षण_करें("पाठ_कर(42)", पाठ_कर(42), "42")
परीक्षण_करें("पाठ_कर(-15)", पाठ_कर(-15), "-15")
परीक्षण_करें("पाठ_कर(3.14)", पाठ_कर(3.14), "3.14")
परीक्षण_करें("पाठ_कर(सत्य)", पाठ_कर(सत्य), "सत्य")
परीक्षण_करें("पाठ_कर(असत्य)", पाठ_कर(असत्य), "असत्य")
परीक्षण_करें("पाठ_कर(शून्य)", पाठ_कर(शून्य), "शून्य")
परीक्षण_करें("पाठ_कर([1,2,3])", पाठ_कर([1,2,3]), "[1, 2, 3]")

# ── 2. Collection Operations Tests ───────────────────────────────────────

मुद्रय "\n───────────────────────────────────────────────────────────"
मुद्रय "  2. संग्रह संचालन परीक्षण (Collection Operations Tests)"
मुद्रय "───────────────────────────────────────────────────────────"

# दीर्घता tests
परीक्षण_करें("दीर्घता('hello')", दीर्घता("hello"), 5)
परीक्षण_करें("दीर्घता('')", दीर्घता(""), 0)
परीक्षण_करें("दीर्घता([1,2,3,4])", दीर्घता([1,2,3,4]), 4)
परीक्षण_करें("दीर्घता([])", दीर्घता([]), 0)

# प्रकार tests
परीक्षण_करें("प्रकार(42)", प्रकार(42), "पूर्णांक")
परीक्षण_करें("प्रकार(3.14)", प्रकार(3.14), "दशमलव")
परीक्षण_करें("प्रकार('hello')", प्रकार("hello"), "तार")
परीक्षण_करें("प्रकार([1,2,3])", प्रकार([1,2,3]), "सूची")
परीक्षण_करें("प्रकार(सत्य)", प्रकार(सत्य), "बूलियन")

# ── 3. Arithmetic Operator Tests ─────────────────────────────────────────

मुद्रय "\n───────────────────────────────────────────────────────────"
मुद्रय "  3. अंकगणित संचालक परीक्षण (Arithmetic Operator Tests)"
मुद्रय "───────────────────────────────────────────────────────────"

परीक्षण_करें("योग(5, 3)", योग(5, 3), 8)
परीक्षण_करें("व्यवकलन(10, 4)", व्यवकलन(10, 4), 6)
परीक्षण_करें("गुणन(6, 7)", गुणन(6, 7), 42)
परीक्षण_करें("भाग(20, 4)", भाग(20, 4), 5)
परीक्षण_करें("पूर्णांक_भाग(17, 5)", पूर्णांक_भाग(17, 5), 3)
परीक्षण_करें("मापांक(17, 5)", मापांक(17, 5), 2)
परीक्षण_करें("घात(2, 10)", घात(2, 10), 1024)
परीक्षण_करें("वर्गमूल(144)", वर्गमूल(144), 12)
परीक्षण_करें("निरपेक्ष(-15)", निरपेक्ष(-15), 15)
परीक्षण_करें("निरपेक्ष(15)", निरपेक्ष(15), 15)

# ── 4. Comparison Operator Tests ─────────────────────────────────────────

मुद्रय "\n───────────────────────────────────────────────────────────"
मुद्रय "  4. तुलना संचालक परीक्षण (Comparison Operator Tests)"
मुद्रय "───────────────────────────────────────────────────────────"

परीक्षण_करें("समान_है(5, 5)", समान_है(5, 5), सत्य)
परीक्षण_करें("समान_है(5, 6)", समान_है(5, 6), असत्य)
परीक्षण_करें("असमान_है(5, 6)", असमान_है(5, 6), सत्य)
परीक्षण_करें("लघु_है(3, 5)", लघु_है(3, 5), सत्य)
परीक्षण_करें("महत्_है(10, 5)", महत्_है(10, 5), सत्य)
परीक्षण_करें("लघु_समान_है(5, 5)", लघु_समान_है(5, 5), सत्य)
परीक्षण_करें("महत्_समान_है(6, 5)", महत्_समान_है(6, 5), सत्य)

# ── 5. Logical Operator Tests ────────────────────────────────────────────

मुद्रय "\n───────────────────────────────────────────────────────────"
मुद्रय "  5. तार्किक संचालक परीक्षण (Logical Operator Tests)"
मुद्रय "───────────────────────────────────────────────────────────"

परीक्षण_करें("तर्क_न(सत्य)", तर्क_न(सत्य), असत्य)
परीक्षण_करें("तर्क_न(असत्य)", तर्क_न(असत्य), सत्य)
परीक्षण_करें("तर्क_और(सत्य, सत्य)", तर्क_और(सत्य, सत्य), सत्य)
परीक्षण_करें("तर्क_और(सत्य, असत्य)", तर्क_और(सत्य, असत्य), असत्य)
परीक्षण_करें("तर्क_अथवा(सत्य, असत्य)", तर्क_अथवा(सत्य, असत्य), सत्य)
परीक्षण_करें("तर्क_अथवा(असत्य, असत्य)", तर्क_अथवा(असत्य, असत्य), असत्य)

# ── 6. Bitwise Operator Tests ────────────────────────────────────────────

मुद्रय "\n───────────────────────────────────────────────────────────"
मुद्रय "  6. बिटवाइज संचालक परीक्षण (Bitwise Operator Tests)"
मुद्रय "───────────────────────────────────────────────────────────"

परीक्षण_करें("बिटवाइज_और(12, 10)", बिटवाइज_और(12, 10), 8)  # 1100 & 1010 = 1000
परीक्षण_करें("बिटवाइज_अथवा(12, 10)", बिटवाइज_अथवा(12, 10), 14)  # 1100 | 1010 = 1110
परीक्षण_करें("बिटवाइज_xor(12, 10)", बिटवाइज_xor(12, 10), 6)  # 1100 ^ 1010 = 0110
परीक्षण_करें("बिटवाइज_न(5)", बिटवाइज_न(5), -6)  # ~(5) = -6
परीक्षण_करें("बिटवाइज_बायाँ_शिफ्ट(4, 2)", बिटवाइज_बायाँ_शिफ्ट(4, 2), 16)  # 4 << 2 = 16
परीक्षण_करें("बिटवाइज_दायाँ_शिफ्ट(16, 2)", बिटवाइज_दायाँ_शिफ्ट(16, 2), 4)  # 16 >> 2 = 4

# ── 7. Membership Operator Tests ─────────────────────────────────────────

मुद्रय "\n───────────────────────────────────────────────────────────"
मुद्रय "  7. सदस्यता संचालक परीक्षण (Membership Operator Tests)"
मुद्रय "───────────────────────────────────────────────────────────"

परीक्षण_करें("सदस्य_है(2, [1,2,3])", सदस्य_है(2, [1,2,3]), सत्य)
परीक्षण_करें("सदस्य_है(5, [1,2,3])", सदस्य_है(5, [1,2,3]), असत्य)
परीक्षण_करें("सदस्य_है('ell', 'hello')", सदस्य_है("ell", "hello"), सत्य)
परीक्षण_करें("सदस्य_नहीं_है(5, [1,2,3])", सदस्य_नहीं_है(5, [1,2,3]), सत्य)

# ── 8. List Operations Tests ─────────────────────────────────────────────

मुद्रय "\n───────────────────────────────────────────────────────────"
मुद्रय "  8. सूची संचालन परीक्षण (List Operations Tests)"
मुद्रय "───────────────────────────────────────────────────────────"

चर test_list = [1, 2, 3, 4, 5]
परीक्षण_करें("सूची_उपतार([1,2,3,4,5], 1, 4)", सूची_उपतार(test_list, 1, 4), [2, 3, 4])
परीक्षण_करें("सूची_उपतार([1,2,3,4,5], 0, 2)", सूची_उपतार(test_list, 0, 2), [1, 2])

# ── 9. String Operations Tests ───────────────────────────────────────────

मुद्रय "\n───────────────────────────────────────────────────────────"
मुद्रय "  9. तार संचालन परीक्षण (String Operations Tests)"
मुद्रय "───────────────────────────────────────────────────────────"

परीक्षण_करें("तार_लंबाई('hello')", तार_लंबाई("hello"), 5)
परीक्षण_करें("तार_उपतार('hello', 1, 4)", तार_उपतार("hello", 1, 4), "ell")
परीक्षण_करें("तार_खोजो('hello', 'ell')", तार_खोजो("hello", "ell"), 1)
परीक्षण_करें("तार_खोजो('hello', 'x')", तार_खोजो("hello", "x"), -1)

# ── Results ──────────────────────────────────────────────────────────────

मुद्रय "\n═══════════════════════════════════════════════════════════"
मुद्रय "  कोर बिल्टिन्स — परीक्षण परिणाम"
मुद्रय "═══════════════════════════════════════════════════════════"
मुद्रय "✓ पास:", पास
मुद्रय "✗ विफल:", विफल
मुद्रय "कुल परीक्षण:", कुल

चर success_rate = (पास / कुल) * 100
मुद्रय "सफलता दर:", success_rate, "%"

यदि विफल == 0:
    मुद्रय "\n🎉 सभी परीक्षण उत्तीर्ण! (All tests passed!)"
अन्यथा:
    मुद्रय "\n⚠️  कुछ परीक्षण विफल हुए (Some tests failed)"

मुद्रय "═══════════════════════════════════════════════════════════"
