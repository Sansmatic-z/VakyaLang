# वाक् भाषा — पात्र संग्रह परीक्षण (Container Data Structures Test Suite)

मुद्रय "═══════════════════════════════════════════════════════════"
मुद्रय "  पात्र संग्रह — विस्तृत परीक्षण"
मुद्रय "  Container Data Structures — Comprehensive Tests"
मुद्रय "═══════════════════════════════════════════════════════════"

चर पास = 0
चर विफल = 0
चर कुल = 0

कर्म परीक्षण_करें(नाम, actual, expected, tolerance=0.0001):
    चर global पास, विफल, कुल
    कुल = कुल + 1
    
    चर match = असत्य
    यदि प्रकार(actual) == "दशमलव" और प्रकार(expected) == "दशमलव":
        यदि निरपेक्ष(actual - expected) < tolerance:
            match = सत्य
    अन्यथा:
        यदि actual == expected:
            match = सत्य
    
    यदि match:
        मुद्रय "✓ पास:", नाम
        पास = पास + 1
    अन्यथा:
        मुद्रय "✗ विफल:", नाम
        मुद्रय "  अपेक्षित:", expected
        मुद्रय "  प्राप्त:", actual
        विफल = विफल + 1

मुद्रय "\n───────────────────────────────────────────────────────────"
मुद्रय "  1. शब्दकोश परीक्षण (Dictionary Tests)"
मुद्रय "───────────────────────────────────────────────────────────"

आयात container_sangrah

चर dict = नव शब्दकोश()

# Insert
dict.डालो("name", "राज")
dict.डालो("age", 30)
dict.डालो("city", "मुंबई")

परीक्षण_करें("Dict get name", dict.प्राप्त_करो("name"), "राज")
परीक्षण_करें("Dict get age", dict.प्राप्त_करो("age"), 30)
परीक्षण_करें("Dict get city", dict.प्राप्त_करो("city"), "मुंबई")
परीक्षण_करें("Dict size", dict.आकार(), 3)

# Key exists
परीक्षण_करें("Dict key exists", dict.कुंजी_है("name"), सत्य)
परीक्षण_करें("Dict key not exists", dict.कुंजी_है("country"), असत्य)

# Get keys
चर keys = dict.कुंजियाँ()
परीक्षण_करें("Dict keys count", दीर्घता(keys), 3)

# Update value
dict.डालो("age", 31)
परीक्षण_करें("Dict updated age", dict.प्राप्त_करो("age"), 31)

# Remove
dict.हटाओ("city")
परीक्षण_करें("Dict after remove size", dict.आकार(), 2)
परीक्षण_करें("Dict removed key", dict.कुंजी_है("city"), असत्य)

मुद्रय "\n───────────────────────────────────────────────────────────"
मुद्रय "  2. समुच्चय परीक्षण (Set Tests)"
मुद्रय "───────────────────────────────────────────────────────────"

चर set = नव समुच्चय()

# Add
set.जोड़ो(1)
set.जोड़ो(2)
set.जोड़ो(3)
set.जोड़ो(2)  # Duplicate

परीक्षण_करें("Set size (no dups)", set.आकार(), 3)
परीक्षण_करें("Set member exists", set.सदस्य_है(2), सत्य)
परीक्षण_करें("Set member not exists", set.सदस्य_है(5), असत्य)

# Remove
set.हटाओ(2)
परीक्षण_करें("Set after remove size", set.आकार(), 2)
परीक्षण_करें("Set after remove member", set.सदस्य_है(2), असत्य)

# Union
चर set1 = नव समुच्चय()
set1.जोड़ो(1)
set1.जोड़ो(2)

चर set2 = नव समुच्चय()
set2.जोड़ो(2)
set2.जोड़ो(3)

चर union_result = set1.संघ(set2)
परीक्षण_करें("Set union size", union_result.आकार(), 3)
परीक्षण_करें("Set union has 1", union_result.सदस्य_है(1), सत्य)
परीक्षण_करें("Set union has 3", union_result.सदस्य_है(3), सत्य)

# Intersection
चर inter_result = set1.प्रतिच्छेदन(set2)
परीक्षण_करें("Set intersection size", inter_result.आकार(), 1)
परीक्षण_करें("Set intersection has 2", inter_result.सदस्य_है(2), सत्य)

# Difference
चर diff_result = set1.अंतर(set2)
परीक्षण_करें("Set difference size", diff_result.आकार(), 1)
परीक्षण_करें("Set difference has 1", diff_result.सदस्य_है(1), सत्य)

# Subset
चर sub1 = नव समुच्चय()
sub1.जोड़ो(1)
sub1.जोड़ो(2)

चर sub2 = नव समुच्चय()
sub2.जोड़ो(1)
sub2.जोड़ो(2)
sub2.जोड़ो(3)

परीक्षण_करें("Set is subset", sub1.उपसमुच्चय_है(sub2), सत्य)

मुद्रय "\n───────────────────────────────────────────────────────────"
मुद्रय "  3. कतार परीक्षण (Queue Tests)"
मुद्रय "───────────────────────────────────────────────────────────"

चर queue = नव कतार()

# Enqueue
queue.जोड़ो(10)
queue.जोड़ो(20)
queue.जोड़ो(30)

परीक्षण_करें("Queue size", queue.आकार(), 3)
परीक्षण_करें("Queue front", queue.अग्र_तत्व(), 10)
परीक्षण_करें("Queue rear", queue.पृष्ठ_तत्व(), 30)

# Dequeue (FIFO)
परीक्षण_करें("Queue dequeue 1", queue.निकालो(), 10)
परीक्षण_करें("Queue dequeue 2", queue.निकालो(), 20)
परीक्षण_करें("Queue size after dequeue", queue.आकार(), 1)

# Empty check
परीक्षण_करें("Queue not empty", queue.रिक्त_है(), असत्य)
queue.निकालो()
परीक्षण_करें("Queue empty", queue.रिक्त_है(), सत्य)

मुद्रय "\n───────────────────────────────────────────────────────────"
मुद्रय "  4. द्वि-कतार परीक्षण (Deque Tests)"
मुद्रय "───────────────────────────────────────────────────────────"

चर deque = नव द्वि_कतार()

# Add to both ends
deque.पृष्ठ_जोड़ो(1)
deque.पृष्ठ_जोड़ो(2)
deque.अग्र_जोड़ो(0)

परीक्षण_करें("Deque front", deque.अग्र_तत्व(), 0)
परीक्षण_करें("Deque rear", deque.पृष्ठ_तत्व(), 2)
परीक्षण_करें("Deque size", deque.आकार(), 3)

# Remove from both ends
परीक्षण_करें("Deque remove front", deque.अग्र_निकालो(), 0)
परीक्षण_करें("Deque remove rear", deque.पृष्ठ_निकालो(), 2)
परीक्षण_करें("Deque size after", deque.आकार(), 1)

मुद्रय "\n───────────────────────────────────────────────────────────"
मुद्रय "  5. ढेर परीक्षण (Stack Tests)"
मुद्रय "───────────────────────────────────────────────────────────"

चर stack = नव ढेर()

# Push
stack.धकेलो(100)
stack.धकेलो(200)
stack.धकेलो(300)

परीक्षण_करें("Stack size", stack.आकार(), 3)
परीक्षण_करें("Stack top", stack.शीर्ष(), 300)

# Pop (LIFO)
परीक्षण_करें("Stack pop 1", stack.निकालो(), 300)
परीक्षण_करें("Stack pop 2", stack.निकालो(), 200)
परीक्षण_करें("Stack pop 3", stack.निकालो(), 100)
परीक्षण_करें("Stack empty after pops", stack.रिक्त_है(), सत्य)

# Find min/max
चर stack2 = नव ढेर()
stack2.धकेलो(5)
stack2.धकेलो(2)
stack2.धकेलो(8)
stack2.धकेलो(1)

परीक्षण_करें("Stack min", stack2.न्यूनतम_खोजो(), 1)
परीक्षण_करें("Stack max", stack2.अधिकतम_खोजो(), 8)

मुद्रय "\n───────────────────────────────────────────────────────────"
मुद्रय "  6. क्रमबद्ध सूची परीक्षण (Sorted List Tests)"
मुद्रय "───────────────────────────────────────────────────────────"

चर sorted_list = नव क्रमबद्ध_सूची()

# Add (automatically sorted)
sorted_list.जोड़ो(5)
sorted_list.जोड़ो(2)
sorted_list.जोड़ो(8)
sorted_list.जोड़ो(1)
sorted_list.जोड़ो(9)

# Should be [1, 2, 5, 8, 9]
परीक्षण_करें("Sorted list min", sorted_list.न्यूनतम(), 1)
परीक्षण_करें("Sorted list max", sorted_list.अधिकतम(), 9)
परीक्षण_करें("Sorted list size", sorted_list.आकार(), 5)

# Binary search
परीक्षण_करें("Sorted list search 5", sorted_list.खोजो(5), 2)
परीक्षण_करें("Sorted list search 1", sorted_list.खोजो(1), 0)
परीक्षण_करें("Sorted list search 9", sorted_list.खोजो(9), 4)
परीक्षण_करें("Sorted list search 3", sorted_list.खोजो(3), -1)

# Remove
sorted_list.हटाओ(5)
परीक्षण_करें("Sorted list after remove size", sorted_list.आकार(), 4)
परीक्षण_करें("Sorted list search after remove", sorted_list.खोजो(5), -1)

मुद्रय "\n───────────────────────────────────────────────────────────"
मुद्रय "  7. टुपल परीक्षण (Tuple Tests)"
मुद्रय "───────────────────────────────────────────────────────────"

चर tuple_data = [1, 2, 3, 4, 5]
चर tup = नव टुपल(tuple_data)

परीक्षण_करें("Tuple get(0)", tup.प्राप्त_करो(0), 1)
परीक्षण_करें("Tuple get(2)", tup.प्राप्त_करो(2), 3)
परीक्षण_करें("Tuple size", tup.आकार(), 5)
परीक्षण_करें("Tuple length", tup.दीर्घता(), 5)

मुद्रय "\n───────────────────────────────────────────────────────────"
मुद्रय "  8. नामित टुपल परीक्षण (Named Tuple Tests)"
मुद्रय "───────────────────────────────────────────────────────────"

चर Point = नव नामित_टुपल(["x", "y", "z"])
चर p = Point.बनाओ([10, 20, 30])

परीक्षण_करें("Named tuple x", Point.क्षेत्र(p, "x"), 10)
परीक्षण_करें("Named tuple y", Point.क्षेत्र(p, "y"), 20)
परीक्षण_करें("Named tuple z", Point.क्षेत्र(p, "z"), 30)

मुद्रय "\n═══════════════════════════════════════════════════════════"
मुद्रय "  पात्र संग्रह — परीक्षण परिणाम"
मुद्रय "═══════════════════════════════════════════════════════════"
मुद्रय "✓ पास:", पास
मुद्रय "✗ विफल:", विफल
मुद्रय "कुल परीक्षण:", कुल

चर success_rate = (पास / कुल) * 100
मुद्रय "सफलता दर:", success_rate, "%"

यदि विफल == 0:
    मुद्रय "\n🎉 सभी परीक्षण उत्तीर्ण! (All tests passed!)"
अन्यथा:
    मुद्रय "\n⚠️  कुछ परीक्षण विफल हुए (Some tests failed)"

मुद्रय "═══════════════════════════════════════════════════════════"
