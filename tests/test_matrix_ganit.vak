# वाक् भाषा — मैट्रिक्स गणित परीक्षण (Matrix Mathematics Test Suite)
# Comprehensive Test Suite for Matrix Library

मुद्रय "═══════════════════════════════════════════════════════════"
मुद्रय "  मैट्रिक्स गणित — विस्तृत परीक्षण"
मुद्रय "  Matrix Mathematics — Comprehensive Tests"
मुद्रय "═══════════════════════════════════════════════════════════"

चर पास = 0
चर विफल = 0
चर कुल = 0

कर्म परीक्षण_करें(नाम, actual, expected, tolerance=0.0001):
    चर global पास, विफल, कुल
    कुल = कुल + 1
    
    चर match = असत्य
    यदि प्रकार(actual) == "दशमलव" और प्रकार(expected) == "दशमलव":
        यदि निरपेक्ष(actual - expected) < tolerance:
            match = सत्य
    अन्यथा:
        यदि actual == expected:
            match = सत्य
    
    यदि match:
        मुद्रय "✓ पास:", नाम
        पास = पास + 1
    अन्यथा:
        मुद्रय "✗ विफल:", नाम
        मुद्रय "  अपेक्षित:", expected
        मुद्रय "  प्राप्त:", actual
        विफल = विफल + 1

मुद्रय "\n───────────────────────────────────────────────────────────"
मुद्रय "  1. मैट्रिक्स संरचना परीक्षण (Matrix Structure Tests)"
मुद्रय "───────────────────────────────────────────────────────────"

आयात matrix_ganit

# Create matrix
चर A = नव मैट्रिक्स(2, 2)
A.सेट(0, 0, 5)
A.सेट(0, 1, 3)
A.सेट(1, 0, 2)
A.सेट(1, 1, 7)

परीक्षण_करें("Matrix get(0,0)", A.प्राप्त_करो(0, 0), 5)
परीक्षण_करें("Matrix get(0,1)", A.प्राप्त_करो(0, 1), 3)
परीक्षण_करें("Matrix get(1,0)", A.प्राप्त_करो(1, 0), 2)
परीक्षण_करें("Matrix get(1,1)", A.प्राप्त_करो(1, 1), 7)
परीक्षण_करें("Matrix size", A.आकार(), [2, 2])

मुद्रय "\n───────────────────────────────────────────────────────────"
मुद्रय "  2. मैट्रिक्स संचालन परीक्षण (Matrix Operations Tests)"
मुद्रय "───────────────────────────────────────────────────────────"

# Matrix from 2D list
चर M1 = मैट्रिक्स_बनाओ([[1, 2], [3, 4]])
चर M2 = मैट्रिक्स_बनाओ([[5, 6], [7, 8]])

# Matrix addition
चर sum_result = मैट्रिक्स_योग(M1, M2)
परीक्षण_करें("Matrix add[0,0]", sum_result.प्राप्त_करो(0, 0), 6)
परीक्षण_करें("Matrix add[1,1]", sum_result.प्राप्त_करो(1, 1), 12)

# Matrix subtraction
चर diff_result = मैट्रिक्स_व्यवकलन(M2, M1)
परीक्षण_करें("Matrix sub[0,0]", diff_result.प्राप्त_करो(0, 0), 4)
परीक्षण_करें("Matrix sub[1,1]", diff_result.प्राप्त_करो(1, 1), 4)

# Scalar multiplication
चर scalar_result = मैट्रिक्स_अदिश_गुणन(M1, 3)
परीक्षण_करें("Matrix scalar[0,0]", scalar_result.प्राप्त_करो(0, 0), 3)
परीक्षण_करें("Matrix scalar[1,1]", scalar_result.प्राप्त_करो(1, 1), 12)

मुद्रय "\n───────────────────────────────────────────────────────────"
मुद्रय "  3. मैट्रिक्स गुणन परीक्षण (Matrix Multiplication Tests)"
मुद्रय "───────────────────────────────────────────────────────────"

# Matrix multiplication
चर prod_result = मैट्रिक्स_गुणन(M1, M2)
# [1,2] × [5,6] = [1*5+2*7, 1*6+2*8] = [19, 22]
# [3,4]   [7,8]   [3*5+4*7, 3*6+4*8]   [43, 50]
परीक्षण_करें("Matrix mul[0,0]", prod_result.प्राप्त_करो(0, 0), 19)
परीक्षण_करें("Matrix mul[0,1]", prod_result.प्राप्त_करो(0, 1), 22)
परीक्षण_करें("Matrix mul[1,0]", prod_result.प्राप्त_करो(1, 0), 43)
परीक्षण_करें("Matrix mul[1,1]", prod_result.प्राप्त_करो(1, 1), 50)

मुद्रय "\n───────────────────────────────────────────────────────────"
मुद्रय "  4. मैट्रिक्स स्थानांतरण परीक्षण (Matrix Transpose Tests)"
मुद्रय "───────────────────────────────────────────────────────────"

चर transposed = मैट्रिक्स_स्थानांतरण(M1)
परीक्षण_करें("Transpose[0,0]", transposed.प्राप्त_करो(0, 0), 1)
परीक्षण_करें("Transpose[0,1]", transposed.प्राप्त_करो(0, 1), 3)
परीक्षण_करें("Transpose[1,0]", transposed.प्राप्त_करो(1, 0), 2)
परीक्षण_करें("Transpose[1,1]", transposed.प्राप्त_करो(1, 1), 4)

मुद्रय "\n───────────────────────────────────────────────────────────"
मुद्रय "  5. मैट्रिक्स निर्धारक परीक्षण (Matrix Determinant Tests)"
मुद्रय "───────────────────────────────────────────────────────────"

# 2x2 determinant: ad - bc
चर det_2x2 = मैट्रिक्स_निर्धारक(M1)
# det([[1,2],[3,4]]) = 1*4 - 2*3 = 4 - 6 = -2
परीक्षण_करें("Determinant 2x2", det_2x2, -2)

# 3x3 determinant
चर M3 = मैट्रिक्स_बनाओ([[1, 2, 3], [4, 5, 6], [7, 8, 10]])
चर det_3x3 = मैट्रिक्स_निर्धारक(M3)
# det = 1*(5*10-6*8) - 2*(4*10-6*7) + 3*(4*8-5*7)
#     = 1*(50-48) - 2*(40-42) + 3*(32-35)
#     = 1*2 - 2*(-2) + 3*(-3)
#     = 2 + 4 - 9 = -3
परीक्षण_करें("Determinant 3x3", det_3x3, -3)

मुद्रय "\n───────────────────────────────────────────────────────────"
मुद्रय "  6. मैट्रिक्स व्युत्क्रम परीक्षण (Matrix Inverse Tests)"
मुद्रय "───────────────────────────────────────────────────────────"

# 2x2 inverse
चर M_inv = मैट्रिक्स_व्युत्क्रम(M1)
# M1 = [[1,2],[3,4]], det = -2
# inv = 1/det * [[4,-2],[-3,1]] = [[-2,1],[1.5,-0.5]]
परीक्षण_करें("Inverse[0,0]", M_inv.प्राप्त_करो(0, 0), -2, 0.01)
परीक्षण_करें("Inverse[0,1]", M_inv.प्राप्त_करो(0, 1), 1, 0.01)
परीक्षण_करें("Inverse[1,0]", M_inv.प्राप्त_करो(1, 0), 1.5, 0.01)
परीक्षण_करें("Inverse[1,1]", M_inv.प्राप्त_करो(1, 1), -0.5, 0.01)

# Verify: M * M_inv = I
चर identity_check = मैट्रिक्स_गुणन(M1, M_inv)
परीक्षण_करें("M * M_inv[0,0]", identity_check.प्राप्त_करो(0, 0), 1, 0.01)
परीक्षण_करें("M * M_inv[1,1]", identity_check.प्राप्त_करो(1, 1), 1, 0.01)

मुद्रय "\n───────────────────────────────────────────────────────────"
मुद्रय "  7. विशेष मैट्रिक्स परीक्षण (Special Matrix Tests)"
मुद्रय "───────────────────────────────────────────────────────────"

# Identity matrix
चर I = तत्समक_मैट्रिक्स(3)
परीक्षण_करें("Identity[0,0]", I.प्राप्त_करो(0, 0), 1)
परीक्षण_करें("Identity[1,1]", I.प्राप्त_करो(1, 1), 1)
परीक्षण_करें("Identity[0,1]", I.प्राप्त_करो(0, 1), 0)

# Zero matrix
चर Z = शून्य_मैट्रिक्स(2, 3)
परीक्षण_करें("Zero matrix size", Z.आकार(), [2, 3])
परीक्षण_करें("Zero matrix[0,0]", Z.प्राप्त_करो(0, 0), 0)

# Diagonal matrix
चर D = विकर्ण_मैट्रिक्स([2, 5, 3])
परीक्षण_करें("Diagonal[0,0]", D.प्राप्त_करो(0, 0), 2)
परीक्षण_करें("Diagonal[1,1]", D.प्राप्त_करो(1, 1), 5)
परीक्षण_करें("Diagonal[2,2]", D.प्राप्त_करो(2, 2), 3)
परीक्षण_करें("Diagonal[0,1]", D.प्राप्त_करो(0, 1), 0)

मुद्रय "\n───────────────────────────────────────────────────────────"
मुद्रय "  8. रैखिक समीकरण परीक्षण (Linear Equation Tests)"
मुद्रय "───────────────────────────────────────────────────────────"

# Solve: 2x + y = 5, x - y = 1
# Solution: x = 2, y = 1
चर A_lin = मैट्रिक्स_बनाओ([[2, 1], [1, -1]])
चर b_lin = [5, 1]
चर x_lin = रैखिक_समीकरण_हल(A_lin, b_lin)

परीक्षण_करें("Linear eq x[0]", x_lin[0], 2, 0.01)
परीक्षण_करें("Linear eq x[1]", x_lin[1], 1, 0.01)

मुद्रय "\n───────────────────────────────────────────────────────────"
मुद्रय "  9. सदिश संचालन परीक्षण (Vector Operations Tests)"
मुद्रय "───────────────────────────────────────────────────────────"

चर v1 = [1, 2, 3]
चर v2 = [4, 5, 6]

परीक्षण_करें("Vector dot", सदिश_डॉट(v1, v2), 32)  # 1*4 + 2*5 + 3*6 = 32

चर cross = सदिश_क्रॉस(v1, v2)
परीक्षण_करें("Vector cross[0]", cross[0], -3)  # (2*6 - 3*5) = -3
परीक्षण_करें("Vector cross[1]", cross[1], 6)   # (3*4 - 1*6) = 6
परीक्षण_करें("Vector cross[2]", cross[2], -3)  # (1*5 - 2*4) = -3

परीक्षण_करें("Vector length", सदिश_लंबाई([3, 4]), 5)

मुद्रय "\n═══════════════════════════════════════════════════════════"
मुद्रय "  मैट्रिक्स गणित — परीक्षण परिणाम"
मुद्रय "═══════════════════════════════════════════════════════════"
मुद्रय "✓ पास:", पास
मुद्रय "✗ विफल:", विफल
मुद्रय "कुल परीक्षण:", कुल

चर success_rate = (पास / कुल) * 100
मुद्रय "सफलता दर:", success_rate, "%"

यदि विफल == 0:
    मुद्रय "\n🎉 सभी परीक्षण उत्तीर्ण! (All tests passed!)"
अन्यथा:
    मुद्रय "\n⚠️  कुछ परीक्षण विफल हुए (Some tests failed)"

मुद्रय "═══════════════════════════════════════════════════════════"
