# वाक् भाषा — मास्टर परीक्षण (Master Test Suite)
# Comprehensive Test Suite for All Standard Libraries
# लेखक: Visionary RM (Raj Mitra)

मुद्रय "═══════════════════════════════════════════════════════════"
मुद्रय "  वाक् मानक पुस्तकालय — मास्टर परीक्षण"
मुद्रय "  VakyaLang Standard Library — Master Test Suite"
मुद्रय "═══════════════════════════════════════════════════════════"

चर पास = ०
चर विफल = ०

# ── परीक्षण सहायक (Test Helpers) ────────────────────────────────────────────

कर्म परीक्षण(नाम, परिणाम, अपेक्षित):
    चर global पास
    चर global विफल
    
    यदि परिणाम == अपेक्षित:
        मुद्रय "✓ पास:", नाम
        पास = पास + १
    अन्यथा:
        मुद्रय "✗ विफल:", नाम
        मुद्रय "  अपेक्षित:", अपेक्षित
        मुद्रय "  प्राप्त:", परिणाम
        विफल = विफल + १

# ── 1. गणित विस्तारित परीक्षण (Mathematics Tests) ─────────────────────────

मुद्रय "\n───────────────────────────────────────────────────────────"
मुद्रय "  1. गणित विस्तारित परीक्षण (Mathematics Tests)"
मुद्रय "───────────────────────────────────────────────────────────"

आयात ganit_vistarit

# मूल संचालन
परीक्षण("निरपेक्ष(-5)", निरपेक्ष(-५), ५)
परीक्षण("फर्श(3.7)", फर्श(३.७), ३)
परीक्षण("छत(3.2)", छत(३.२), ४)

# घात और मूल
परीक्षण("वर्ग(5)", वर्ग(५), २५)
परीक्षण("घन(3)", घन(३), २७)
परीक्षण("वर्गमूल(144)", वर्गमूल(१४४), १२)
परीक्षण("घनमूल(27)", घनमूल(२७), ३)

# त्रिकोणमिति
परीक्षण("sin(0)", साइन(०), ०)
परीक्षण("cos(0)", कोसाइन(०), १)
# Note: sin(π/2) should be ~1.0

# लघुगणक
चर ln_e = प्राकृतिक_लघुगणक(ई)
परीक्षण("ln(e) approx 1", गोल(ln_e, ४), १.०)

# क्रमगुणित
परीक्षण("5!", क्रमगुणित(५), १२०)
परीक्षण("0!", क्रमगुणित(०), १)

# अभाज्य
परीक्षण("2 is prime", अभाज्य_है(२), सत्य)
परीक्षण("4 is not prime", अभाज्य_है(४), असत्य)
परीक्षण("97 is prime", अभाज्य_है(९७), सत्य)

# GCD/LCM
परीक्षण("GCD(48,18)", महत्तम_समापवर्तक(४८, १८), ६)
परीक्षण("LCM(4,6)", लघुत्तम_समापवर्त्य(४, ६), १२)

# Fibonacci
परीक्षण("Fib(0)", फिबोनचि(०), ०)
परीक्षण("Fib(1)", फिबोनचि(१), १)
परीक्षण("Fib(10)", फिबोनचि(१०), ५५)

# ── 2. भाषा प्रसंस्करण परीक्षण (Language Processing Tests) ─────────────────

मुद्रय "\n───────────────────────────────────────────────────────────"
मुद्रय "  2. भाषा प्रसंस्करण परीक्षण (Language Processing Tests)"
मुद्रय "───────────────────────────────────────────────────────────"

आयात bhasha_prasadan

चर test_str = "नमस्ते जगत्"

परीक्षण("तार_लंबाई", तार_लंबाई(test_str), ११)
परीक्षण("तार_उल्टा", तार_उल्टा("abc"), "cba")
परीक्षण("तार_खोजो", तार_खोजो(test_str, "जगत्"), ७)
परीक्षण("निम्न", निम्न("HELLO"), "hello")
परीक्षण("उच्च", उच्च("hello"), "HELLO")
परीक्षण("ट्रिम", ट्रिम("  hello  "), "hello")
परीक्षण("विभाजित", विभाजित("a,b,c", ","), ["a", "b", "c"])
परीक्षण("पेलिंड्रोम", पेलिंड्रोम_है("aba"), सत्य)
परीक्षण("अनग्राम", अनग्राम_है("listen", "silent"), सत्य)

# ── 3. तर्क शास्त्र परीक्षण (Logic Tests) ──────────────────────────────────

मुद्रय "\n───────────────────────────────────────────────────────────"
मुद्रय "  3. तर्क शास्त्र परीक्षण (Logic Tests)"
मुद्रय "───────────────────────────────────────────────────────────"

आयात tarka_shastra

परीक्षण("AND(T,T)", न्याय_और(सत्य, सत्य), सत्य)
परीक्षण("AND(T,F)", न्याय_और(सत्य, असत्य), असत्य)
परीक्षण("OR(T,F)", न्याय_अथवा(सत्य, असत्य), सत्य)
परीक्षण("OR(F,F)", न्याय_अथवा(असत्य, असत्य), असत्य)
परीक्षण("NOT(T)", न्याय_न(सत्य), असत्य)
परीक्षण("NOT(F)", न्याय_न(असत्य), सत्य)

# Modus Ponens
परीक्षण("Modus Ponens", मोडस_पोनेंस(सत्य, सत्य), सत्य)

# ── 4. संग्रह विस्तारित परीक्षण (Data Structures Tests) ───────────────────

मुद्रय "\n───────────────────────────────────────────────────────────"
मुद्रय "  4. संग्रह विस्तारित परीक्षण (Data Structures Tests)"
मुद्रय "───────────────────────────────────────────────────────────"

आयात sangrah_vistarit

# Sorting
चर unsorted = [६४, ३४, २५, १२, २२, ११, ९०]
चर sorted_expected = [११, १२, २२, २५, ३४, ६४, ९०]
परीक्षण("Bubble Sort", बुलबुला_क्रमबद्ध(unsorted), sorted_expected)
परीक्षण("Quick Sort", द्रुत_क्रमबद्ध(unsorted), sorted_expected)

# Search
परीक्षण("Linear Search", रैखिक_खोज(unsorted, २५), २)
परीक्षण("Binary Search", द्विआधारी_खोज(sorted_expected, २५), ३)

# Statistics
चर data = [१, २, ३, ४, ५]
परीक्षण("Sum", योग(data), १५)
परीक्षण("Mean", माध्य(data), ३)
परीक्षण("Min", न्यूनतम(data), १)
परीक्षण("Max", अधिकतम(data), ५)

# Stack
चर stack = नव स्टैक()
stack.धक्का(१०)
stack.धक्का(२०)
परीक्षण("Stack Pop", stack.पॉप(), २०)
परीक्षण("Stack Size", stack.आकार(), १)

# Queue
चर queue = नव कतार()
queue.प्रवेश(१)
queue.प्रवेश(२)
परीक्षण("Queue Dequeue", queue.निर्गम(), १)

# BST
चर bst = नव बाइनरी_सर्च_ट्री()
bst.जोड़ो(५०)
bst.जोड़ो(३०)
bst.जोड़ो(७०)
परीक्षण("BST Search 30", bst.खोजो(३०), सत्य)
परीक्षण("BST Search 20", bst.खोजो(२०), असत्य)

# ── 5. संभावना परीक्षण (Statistics & Probability Tests) ───────────────────

मुद्रय "\n───────────────────────────────────────────────────────────"
मुद्रय "  5. संभावना परीक्षण (Statistics & Probability Tests)"
मुद्रय "───────────────────────────────────────────────────────────"

आयात sambhavana

चर test_data = [२, ४, ४, ४, ५, ५, ७, ९]

परीक्षण("Mean", माध्य(test_data), ५)
परीक्षण("Median", माध्यिका(test_data), ४.५)
परीक्षण("Mode", बहुलक(test_data), [४])
परीक्षण("Range", परास(test_data), ७)

# Permutations & Combinations
परीक्षण("P(5,3)", क्रमचय(५, ३), ६०)
परीक्षण("C(5,3)", संचय(५, ३), १०)

# Probability
परीक्षण("P(event)", प्रायिकता(५, ५२), ५/५२)

# ── 6. उपयोजिता परीक्षण (Utilities Tests) ─────────────────────────────────

मुद्रय "\n───────────────────────────────────────────────────────────"
मुद्रय "  6. उपयोजिता परीक्षण (Utilities Tests)"
मुद्रय "───────────────────────────────────────────────────────────"

आयात upayogita

# Number conversions
परीक्षण("Dec to Binary", दशमलव_से_द्विआधारी(१०), "1010")
परीक्षण("Binary to Dec", द्विआधारी_से_दशमलव("1010"), १०)
परीक्षण("Dec to Octal", दशमलव_से_अष्टभुज(८), "10")
परीक्षण("Dec to Hex", दशमलव_से_षोडशभुज(१६), "10")

# Roman numerals
परीक्षण("Dec to Roman", दशमलव_से_रोमन(२०२४), "MMXXIV")
परीक्षण("Roman to Dec", रोमन_से_दशमलव("MMXXIV"), २०२४)

# Leap year
परीक्षण("Leap 2000", लीप_वर्ष_जाँच(२०००), सत्य)
परीक्षण("Not Leap 1900", लीप_वर्ष_जाँच(१९००), असत्य)
परीक्षण("Leap 2024", लीप_वर्ष_जाँच(२०२४), सत्य)

# Unit conversions
परीक्षण("C to F", गोल(सेल्सियस_से_फ़ारेनहाइट(०), ४), ३२.०)
परीक्षण("Km to Miles", गोल(किलोमीटर_से_मील(१), ४), ०.६२१४)

# Random number generator
चर rng = नव यादृच्छा_जनरेटर(४२)
चर rand1 = rng.अगला()
चर rng2 = नव यादृच्छा_जनरेटर(४२)
चर rand2 = rng2.अगला()
परीक्षण("Deterministic RNG", rand1, rand2)

# RLE Compression
चर compressed = RLE_एन्कोड("AAABBBCCCC")
परीक्षण("RLE Encode", compressed, "3A3B4C")
परीक्षण("RLE Decode", RLE_डिकोड(compressed), "AAABBBCCCC")

# ── परिणाम (Results) ─────────────────────────────────────────────────────

मुद्रय "\n═══════════════════════════════════════════════════════════"
मुद्रय "  परीक्षण परिणाम (Test Results)"
मुद्रय "═══════════════════════════════════════════════════════════"
मुद्रय "✓ पास:", पास
मुद्रय "✗ विफल:", विफल
मुद्रय "कुल:", पास + विफल

चर success_rate = (पास / (पास + विफल)) * १००
मुद्रय "सफलता दर:", success_rate, "%"

यदि विफल == ०:
    मुद्रय "\n🎉 सभी परीक्षण उत्तीर्ण! (All tests passed!)"
अन्यथा:
    मुद्रय "\n⚠️  कुछ परीक्षण विफल हुए (Some tests failed)"

मुद्रय "═══════════════════════════════════════════════════════════"
