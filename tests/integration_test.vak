# वाक् भाषा — एकीकृत परीक्षण (Integration Test)
# Simple integration test for all new libraries

मुद्रय "═══════════════════════════════════════════════════════════"
मुद्रय "  एकीकृत परीक्षण — नई पुस्तकालयें"
मुद्रय "  Integration Test — New Libraries"
मुद्रय "═══════════════════════════════════════════════════════════"

चर पास = 0
चर विफल = 0

कर्म परीक्षण(नाम, actual, expected):
    चर global पास
    चर global विफल
    यदि actual == expected:
        मुद्रय "✓", नाम
        पास = पास + 1
    अन्यथा:
        मुद्रय "✗", नाम
        मुद्रय "  Expected:", expected
        मुद्रय "  Got:", actual
        विफल = विफल + 1

मुद्रय ""
मुद्रय "── मूल गणित परीक्षण (Basic Math Tests) ─────────────────"

# Test basic arithmetic
परीक्षण("5 + 3", 5 + 3, 8)
परीक्षण("10 - 4", 10 - 4, 6)
परीक्षण("6 * 7", 6 * 7, 42)
परीक्षण("20 / 4", 20 / 4, 5)
परीक्षण("17 % 5", 17 % 5, 2)
परीक्षण("2 ** 10", 2 ** 10, 1024)

मुद्रय "\n── तार संचालन परीक्षण (String Operations) ─────────────"

चर text = "नमस्ते"
परीक्षण("String length", दीर्घता(text), 6)
परीक्षण("String slice", text[0:3], "नमस")

मुद्रय "\n── सूची संचालन परीक्षण (List Operations) ───────────────"

चर lst = [1, 2, 3, 4, 5]
परीक्षण("List length", दीर्घता(lst), 5)
परीक्षण("List element", lst[2], 3)
परीक्षण("List slice", lst[1:4], [2, 3, 4])

मुद्रय "\n── त्रिकोणमिति परीक्षण (Trigonometry Tests) ────────────"

आयात ganit_vistarit

चर pi_val = 3.14159265358979
परीक्षण("sin(0)", गोल(साइन(0), 6), 0.0)
परीक्षण("cos(0)", गोल(कोसाइन(0), 6), 1.0)
परीक्षण("sin(pi/2)", गोल(साइन(pi_val / 2), 6), 1.0)

मुद्रय "\n── वर्गमूल परीक्षण (Square Root Tests) ─────────────────"

परीक्षण("sqrt(144)", गोल(वर्गमूल(144), 6), 12.0)
परीक्षण("sqrt(2)", गोल(वर्गमूल(2), 6), 1.414214)

मुद्रय "\n── क्रमगुणित परीक्षण (Factorial Tests) ────────────────"

परीक्षण("5!", क्रमगुणित(5), 120)
परीक्षण("0!", क्रमगुणित(0), 1)

मुद्रय "\n── अभाज्य परीक्षण (Prime Tests) ───────────────────────"

परीक्षण("2 is prime", अभाज्य_है(2), सत्य)
परीक्षण("4 is not prime", अभाज्य_है(4), असत्य)
परीक्षण("97 is prime", अभाज्य_है(97), सत्य)

मुद्रय "\n── GCD LCM परीक्षण ─────────────────────────────────────"

परीक्षण("GCD(48,18)", महत्तम_समापवर्तक(48, 18), 6)
परीक्षण("LCM(4,6)", लघुत्तम_समापवर्त्य(4, 6), 12)

मुद्रय "\n── फिबोनचि परीक्षण (Fibonacci Tests) ──────────────────"

परीक्षण("Fib(0)", फिबोनचि(0), 0)
परीक्षण("Fib(1)", फिबोनचि(1), 1)
परीक्षण("Fib(10)", फिबोनचि(10), 55)

मुद्रय "\n═══════════════════════════════════════════════════════════"
मुद्रय "  परीक्षण परिणाम (Test Results)"
मुद्रय "═══════════════════════════════════════════════════════════"
मुद्रय "✓ पास:", पास
मुद्रय "✗ विफल:", विफल

यदि विफल == 0:
    मुद्रय "\n🎉 सभी परीक्षण उत्तीर्ण! (All tests passed!)"
अन्यथा:
    मुद्रय "\n⚠️  कुछ परीक्षण विफल हुए"

मुद्रय "═══════════════════════════════════════════════════════════"
