# Default Arguments Torture Test
कर्म गणा(क, ख="नमस्ते", ग=५):
    मुद्रय "क: ", क
    मुद्रय "ख: ", ख
    मुद्रय "ग: ", ग
    प्रत्यागच्छ क + ग

मुद्रय "--- Test 1 (All args) ---"
मुद्रय गणा(१०, "स्वागतम्", २०)

मुद्रय "--- Test 2 (Partial defaults) ---"
मुद्रय गणा(५, "हरिः")

मुद्रय "--- Test 3 (Full defaults) ---"
मुद्रय गणा(१)
