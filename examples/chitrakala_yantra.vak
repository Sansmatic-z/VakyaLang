# चित्रकला — श्री यन्त्र (Sri Yantra Pattern)
# Sacred geometry inspired by Sri Yantra - interlocking triangles
# © 2026 Raj Mitra (Visionary RM)
#
# Signature: Visionary RM (Raj Mitra) ⚡
# "Ancient Wisdom, Modern Code" 🔥

# Create canvas (900x900, deep blue background)
कैनवास = _chitra_canvas(900, 900, "nila")

# Sri Yantra parameters
केंद्र_x = 450
केंद्र_y = 450
आधार_त्रिज्या = 350

# Gold color for sacred lines
स्वर्ण = "pita"

# Draw concentric circles representing layers of consciousness
चर वृत्त_संख्या = 9
चर i = 0
यावत् i < वृत्त_संख्या:
    चर वर्तमान_त्रिज्या = (i + 1) * (आधार_त्रिज्या / वृत्त_संख्या)
    _chitra_circle(कैनवास, केंद्र_x, केंद्र_y, पूर्णांक_कर(वर्तमान_त्रिज्या), स्वर्ण, असत्य)
    चर i = i + 1

# Draw central downward triangle (शक्ति - feminine)
चर त्रिकोण_बिन्दु_अधः = [
    [केंद्र_x, केंद्र_y + आधार_त्रिज्या * 0.6],
    [केंद्र_x - आधार_त्रिज्या * 0.52, केंद्र_y - आधार_त्रिज्या * 0.3],
    [केंद्र_x + आधार_त्रिज्या * 0.52, केंद्र_y - आधार_त्रिज्या * 0.3]
]
_chitra_polygon(कैनवास, त्रिकोण_बिन्दु_अधः, "rakta", असत्य)

# Draw central upward triangle (शिव - masculine)
चर त्रिकोण_बिन्दु_ऊर्ध्व = [
    [केंद्र_x, केंद्र_y - आधार_त्रिज्या * 0.55],
    [केंद्र_x - आधार_त्रिज्या * 0.48, केंद्र_y + आधार_त्रिज्या * 0.28],
    [केंद्र_x + आधार_त्रिज्या * 0.48, केंद्र_y + आधार_त्रिज्या * 0.28]
]
_chitra_polygon(कैनवास, त्रिकोण_बिन्दु_ऊर्ध्व, "nila", असत्य)

# Draw interlocking smaller triangles
चर छोटा_त्रिज्या = आधार_त्रिज्या * 0.35
चर छोटा_त्रिकोण_अधः = [
    [केंद्र_x, केंद्र_y + छोटा_त्रिज्या],
    [केंद्र_x - छोटा_त्रिज्या * 0.87, केंद्र_y - छोटा_त्रिज्या * 0.5],
    [केंद्र_x + छोटा_त्रिज्या * 0.87, केंद्र_y - छोटा_त्रिज्या * 0.5]
]
_chitra_polygon(कैनवास, छोटा_त्रिकोण_अधः, "pita", असत्य)

चर छोटा_त्रिकोण_ऊर्ध्व = [
    [केंद्र_x, केंद्र_y - छोटा_त्रिज्या],
    [केंद्र_x - छोटा_त्रिज्या * 0.87, केंद्र_y + छोटा_त्रिज्या * 0.5],
    [केंद्र_x + छोटा_त्रिज्या * 0.87, केंद्र_y + छोटा_त्रिज्या * 0.5]
]
_chitra_polygon(कैनवास, छोटा_त्रिकोण_ऊर्ध्व, "hari", असत्य)

# Draw 8 petals around center (अष्टदल पद्म)
चर पंखुड़ी_त्रिज्या = आधार_त्रिज्या * 0.15
चर पंखुड़ी_दूरी = आधार_त्रिज्या * 0.25
चर पंखुड़ियाँ = 8
चर कोण_वृद्धि = 6.28318 / पंखुड़ियाँ

चर p = 0
यावत् p < पंखुड़ियाँ:
    चर कोण = p * कोण_वृद्धि
    चर px = केंद्र_x + _math_cos(कोण) * पंखुड़ी_दूरी
    चर py = केंद्र_y + _math_sin(कोण) * पंखुड़ी_दूरी
    _chitra_circle(कैनवास, पूर्णांक_कर(px), पूर्णांक_कर(py), पूर्णांक_कर(पंखुड़ी_त्रिज्या), "padma", सत्य)
    चर p = p + 1

# Draw outer square (भूपुर - protective boundary)
चर वर्ग_आकार = आधार_त्रिज्या * 1.5
चर वर्ग_बिन्दु = [
    [केंद्र_x - वर्ग_आकार, केंद्र_y - वर्ग_आकार],
    [केंद्र_x + वर्ग_आकार, केंद्र_y - वर्ग_आकार],
    [केंद्र_x + वर्ग_आकार, केंद्र_y + वर्ग_आकार],
    [केंद्र_x - वर्ग_आकार, केंद्र_y + वर्ग_आकार]
]
_chitra_polygon(कैनवास, वर्ग_बिन्दु, "rajata", असत्य)

# Add larger outer square
चर बाहरी_वर्ग_आकार = आधार_त्रिज्या * 1.7
चर बाहरी_वर्ग_बिन्दु = [
    [केंद्र_x - बाहरी_वर्ग_आकार, केंद्र_y - बाहरी_वर्ग_आकार],
    [केंद्र_x + बाहरी_वर्ग_आकार, केंद्र_y - बाहरी_वर्ग_आकार],
    [केंद्र_x + बाहरी_वर्ग_आकार, केंद्र_y + बाहरी_वर्ग_आकार],
    [केंद्र_x - बाहरी_वर्ग_आकार, केंद्र_y + बाहरी_वर्ग_आकार]
]
_chitra_polygon(कैनवास, बाहरी_वर्ग_बिन्दु, "rajata", असत्य)

# Save the Yantra
_chitra_save(कैनवास, "श्री_यन्त्र.png")

मुद्रय "═══════════════════════════════════════"
मुद्रय "🕉️  श्री यन्त्र चित्रकला सफल!"
मुद्रय "═══════════════════════════════════════"
मुद्रय "केंद्र बिन्दु: (", केंद्र_x, ",", केंद्र_y, ")"
मुद्रय "त्रिकोण: ४ (२ शिव-शक्ति + २ छोटे)"
मुद्रय "पंखुड़ियाँ: ", पंखुड़ियाँ
मुद्रय "वृत्त: ", वृत्त_संख्या
मुद्रय "═══════════════════════════════════════"
मुद्रय "📁 सहेजी गई: श्री_यन्त्र.png"
