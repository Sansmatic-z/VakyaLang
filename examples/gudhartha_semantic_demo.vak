आयात gudhartha

चर धनात्मक_संख्या = gudhartha.धर्म_बनाओ("धनात्मक_संख्या", "संख्या", ["धनात्मक", "सम"])
मुद्रय gudhartha.धर्म_मान्य(धनात्मक_संख्या, ४२)
मुद्रय gudhartha.धर्म_रिपोर्ट(धनात्मक_संख्या, -३)

चर गमन = gudhartha.कारक_बनाओ("गमन", [
    {"नाम": "कर्ता", "भूमिका": "कर्ता", "आवश्यक": सत्य},
    {"नाम": "गन्तव्य", "भूमिका": "अधिकरण", "आवश्यक": सत्य},
    {"नाम": "मार्ग", "भूमिका": "करण", "आवश्यक": असत्य},
])

मुद्रय gudhartha.कारक_रिपोर्ट(गमन, {"कर्ता": "राम", "गन्तव्य": "ग्राम"})

चर न्याय_रिपोर्ट = gudhartha.न्याय_रिपोर्ट(
    "पर्वत अग्निमान् है",
    "क्योंकि धूमवान् है",
    "यथा रसोई",
    "पर्वत धूमवान् है",
    "पर्वत अग्निमान् है"
)

मुद्रय न्याय_रिपोर्ट
मुद्रय gudhartha.पदार्थ(धनात्मक_संख्या)
