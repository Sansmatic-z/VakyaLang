# वाक् कार्य-सूची प्रबंधक — फ़ाइल I/O + सूची + लूप + कर्म
# Deterministic todo manager demo for end-to-end testing

स्थिर डेटा_पथ = "vak_todo_demo.txt"

कर्म कार्य_लोड():
    यदि अस्तित्व(डेटा_पथ) == असत्य:
        प्रत्यागच्छ []

    चर सामग्री = छाँटो(पठन(डेटा_पथ))
    यदि दीर्घता(सामग्री) == ०:
        प्रत्यागच्छ []

    चर पंक्तियाँ = विभाजन(सामग्री, "\n")
    चर कार्यसूची = []

    प्रत्येक चर पंक्ति अन्तर्गत पंक्तियाँ:
        यदि दीर्घता(छाँटो(पंक्ति)) == ०:
            जारी
        चर भाग = विभाजन(पंक्ति, "|")
        यदि दीर्घता(भाग) == ३:
            कार्यसूची.जोड़ो({
                "क्रमांक": भाग[०],
                "शीर्षक": भाग[१],
                "स्थिति": भाग[२]
            })

    प्रत्यागच्छ कार्यसूची

कर्म कार्य_सहेजो(कार्यसूची):
    चर पंक्तियाँ = []
    प्रत्येक चर कार्य अन्तर्गत कार्यसूची:
        पंक्तियाँ.जोड़ो(कार्य["क्रमांक"] + "|" + कार्य["शीर्षक"] + "|" + कार्य["स्थिति"])
    लेखन(डेटा_पथ, संयोग(पंक्तियाँ, "\n"))

कर्म अगला_क्रमांक(कार्यसूची):
    यदि दीर्घता(कार्यसूची) == ०:
        प्रत्यागच्छ "1"

    चर अधिकतम = ०
    प्रत्येक चर कार्य अन्तर्गत कार्यसूची:
        चर वर्तमान = पूर्णांक_कर(कार्य["क्रमांक"])
        यदि वर्तमान > अधिकतम:
            अधिकतम = वर्तमान
    प्रत्यागच्छ पाठ_कर(अधिकतम + १)

कर्म कार्य_जोड़ो(कार्यसूची, शीर्षक):
    चर नया = {
        "क्रमांक": अगला_क्रमांक(कार्यसूची),
        "शीर्षक": शीर्षक,
        "स्थिति": "अपूर्ण"
    }
    कार्यसूची.जोड़ो(नया)
    प्रत्यागच्छ नया

कर्म कार्य_पूर्ण(कार्यसूची, क्रमांक):
    प्रत्येक चर कार्य अन्तर्गत कार्यसूची:
        यदि कार्य["क्रमांक"] == क्रमांक:
            कार्य["स्थिति"] = "पूर्ण"
            प्रत्यागच्छ सत्य
    प्रत्यागच्छ असत्य

कर्म कार्य_दिखाओ(कार्यसूची):
    प्रत्येक चर कार्य अन्तर्गत कार्यसूची:
        मुद्रय "[" + कार्य["क्रमांक"] + "] " + कार्य["शीर्षक"] + " -> " + कार्य["स्थिति"]

यदि अस्तित्व(डेटा_पथ):
    मिटाओ(डेटा_पथ)

चर कार्यसूची = []
कार्य_जोड़ो(कार्यसूची, "वाक् प्रकार-परीक्षा चलाओ")
कार्य_जोड़ो(कार्यसूची, "सान्समैटिक निष्कर्ष जाँचो")
कार्य_जोड़ो(कार्यसूची, "चित्रकला आउटपुट बनाओ")
कार्य_पूर्ण(कार्यसूची, "2")
कार्य_सहेजो(कार्यसूची)

मुद्रय "━━ Todo सूची (memory) ━━"
कार्य_दिखाओ(कार्यसूची)

मुद्रय "━━ Todo सूची (disk reload) ━━"
चर पुनः_लोड = कार्य_लोड()
कार्य_दिखाओ(पुनः_लोड)
मुद्रय "सहेजी गई फ़ाइल:", डेटा_पथ
