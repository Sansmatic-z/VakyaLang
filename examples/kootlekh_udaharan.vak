# वाक् भाषा — कूटलेखन उदाहरण (Cryptography Example)
# Demonstrates: Hash functions, HMAC, Password hashing, Base64

आयात kootlekh

मुद्रय "═══════════════════════════════════════════════════════════"
मुद्रय "  कूटलेखन पुस्तकालय प्रदर्शन (Cryptography Demo)"
मुद्रय "═══════════════════════════════════════════════════════════"

# ── हैश फंक्शन (Hash Functions) ──────────────────────────────────
मुद्रय "\n🔐 हैश फंक्शन (Hash Functions):"
मुद्रय "──────────────────────────────────"

चर संदेश = "नमस्ते संस्कृत!"

मुद्रय "मूल संदेश:", संदेश

चर sha256 = kootlekh.SHA256(संदेश)
मुद्रय "SHA-256:", sha256

चर sha512 = kootlekh.SHA512(संदेश)
मुद्रय "SHA-512:", sha512

चर md5 = kootlekh.MD5(संदेश)
मुद्रय "MD5:", md5

# ── HMAC (Message Authentication) ────────────────────────────────
मुद्रय "\n🔑 HMAC (Message Authentication Code):"
मुद्रय "──────────────────────────────────────"

चर कुंजी = "गुप्त_कुंजी_१२३"
चर डेटा = "महत्वपूर्ण संदेश"

चर हस्ताक्षर = kootlekh.HMAC_निरूपण(डेटा, कुंजी)
मुद्रय "HMAC हस्ताक्षर:", हस्ताक्षर

चर परिणाम१ = kootlekh.HMAC_सत्यापन(डेटा, कुंजी, हस्ताक्षर)
मुद्रय "सत्यापन परिणाम:", परिणाम१

चर गलत_हस्ताक्षर = "गलत_हस्ताक्षर"
चर परिणाम२ = kootlekh.HMAC_सत्यापन(डेटा, कुंजी, गलत_हस्ताक्षर)
मुद्रय "गलत हस्ताक्षर सत्यापन:", परिणाम२

# ── पासवर्ड हैशिंग (Password Hashing) ────────────────────────────
मुद्रय "\n🔒 पासवर्ड हैशिंग (Password Hashing):"
मुद्रय "────────────────────────────────────"

चर पासवर्ड = "मेरा_गुप्त_पासवर्ड"

मुद्रय "मूल पासवर्ड:", पासवर्ड

चर हैश_नमक = kootlekh.पासवर्ड_हैश(पासवर्ड)
चर हैश_मान = हैश_नमक[०]
चर नमक = हैश_नमक[१]

मुद्रय "हैश:", हैश_मान
मुद्रय "नमक:", नमक

# सही पासवर्ड जाँच
चर सही_जाँच = kootlekh.पासवर्ड_जाँच(पासवर्ड, नमक, हैश_मान)
मुद्रय "सही पासवर्ड जाँच:", सही_जाँच

# गलत पासवर्ड जाँच
चर गलत_पासवर्ड = "गलत_पासवर्ड"
चर गलत_जाँच = kootlekh.पासवर्ड_जाँच(गलत_पासवर्ड, नमक, हैश_मान)
मुद्रय "गलत पासवर्ड जाँच:", गलत_जाँच

# ── बेस64 एन्कोडिंग (Base64 Encoding) ────────────────────────────
मुद्रय "\n📦 Base64 Encoding:"
मुद्रय "────────────────────────"

चर मूल_तार = "वाक् भाषा - संस्कृत प्रोग्रामिंग!"
मुद्रय "मूल:", मूल_तार

चर एन्कोडेड = kootlekh.बेस64_एन्कोड(मूल_तार)
मुद्रय "एन्कोडेड:", एन्कोडेड

चर डिकोडेड = kootlekh.बेस64_डिकोड(एन्कोडेड)
मुद्रय "डिकोडेड:", डिकोडेड

# ── सुरक्षित टोकन (Secure Tokens) ───────────────────────────────
मुद्रय "\n🎲 सुरक्षित टोकन जनरेटर (Secure Token Generator):"
मुद्रय "────────────────────────────────────────────"

चर टोकन = kootlekh.सुरक्षित_टोकन_बनाओ(१६)
मुद्रय "१६-बाइट टोकन:", टोकन

चर पासवर्ड_जनरेट = kootlekh.सुरक्षित_पासवर्ड_बनाओ(१२)
मुद्रय "१२-अक्षर पासवर्ड:", पासवर्ड_जनरेट

मुद्रय "\n═══════════════════════════════════════════════════════════"
मुद्रय "  प्रदर्शन सम्पूर्ण (Demo Complete)"
मुद्रय "═══════════════════════════════════════════════════════════"
