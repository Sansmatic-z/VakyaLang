# ─────────────────────────────────────────────────────────────────────────────
# वाक् भाषा - Tier 2 उदाहरण
# Pattern matching (प्रत्यभिज्ञा), Result values (फल), and Vibhakti checks
# ─────────────────────────────────────────────────────────────────────────────

कर्म भाग(क, ख):
    यदि ख == ०:
        वापस असिद्ध("शून्य")
    वापस सिद्ध(क // ख)

कर्म दिखाओ_परिणाम(कर्ता शीर्षक: तार, कर्म मान):
    प्रत्यभिज्ञा मान:
        सिद्ध(उत्तर):
            मुद्रय शीर्षक + ":"
            मुद्रय उत्तर
        असिद्ध(त्रुटि):
            मुद्रय शीर्षक + ":"
            मुद्रय त्रुटि
        [पहला, ...]:
            मुद्रय "सूची"
            मुद्रय पहला
        _:
            मुद्रय "अज्ञात"

दिखाओ_परिणाम("सफल", भाग(१०, २))
दिखाओ_परिणाम("विफल", भाग(१०, ०))

प्रत्यभिज्ञा [१, २, ३]:
    []:
        मुद्रय "खाली"
    [पहला, ...]:
        मुद्रय "प्रथम"
        मुद्रय पहला
    _:
        मुद्रय "कोई मेल नहीं"
