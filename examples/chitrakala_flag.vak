# चित्रकला — भारतीय ध्वज (Indian Flag / Tiranga)
# Tricolor with Ashoka Chakra - accurate proportions
# © 2026 Raj Mitra (Visionary RM)
#
# Signature: Visionary RM (Raj Mitra) ⚡
# "Pride Through Code" 🔥

# Flag parameters (3:2 aspect ratio as per official specifications)
ध्वज_विस्तार = 900   # Width
ध्वज_ऊंचाई = 600    # Height (2/3 of width)

# Create canvas
कैनवास = _chitra_canvas(ध्वज_विस्तार, ध्वज_ऊंचाई)

# Fill background with white (will be overwritten by saffron stripe)
_chitra_clear(कैनवास, "श्वेत")

# Calculate stripe heights (equal thirds)
पट्टी_ऊंचाई = ध्वज_ऊंचाई / 3

# ──────────────────────────────────────────────────────────────
# TOP STRIPE: Saffron (भगवा/केसरिया) - Courage & Sacrifice
# ──────────────────────────────────────────────────────────────
_chitra_rect(कैनवास, 0, 0, ध्वज_विस्तार, पूर्णांक_कर(पट्टी_ऊंचाई), "aruna", सत्य)

# ──────────────────────────────────────────────────────────────
# MIDDLE STRIPE: White (श्वेत) - Truth & Purity
# ──────────────────────────────────────────────────────────────
# Already white from background

# ──────────────────────────────────────────────────────────────
# BOTTOM STRIPE: Green (हरा) - Prosperity & Growth
# ──────────────────────────────────────────────────────────────
चर हरा_य = पट्टी_ऊंचाई * 2
_chitra_rect(कैनवास, 0, पूर्णांक_कर(हरा_य), ध्वज_विस्तार, पूर्णांक_कर(पट्टी_ऊंचाई), "harita", सत्य)

# ──────────────────────────────────────────────────────────────
# ASHOKA CHAKRA (24-spoke wheel) at center
# ──────────────────────────────────────────────────────────────
चर केंद्र_x = ध्वज_विस्तार / 2
चर केंद्र_y = ध्वज_ऊंचाई / 2
चर चक्र_त्रिज्या = पट्टी_ऊंचाई * 0.35  # Chakra radius

# Draw outer circle of Chakra (navy blue)
_chitra_circle(कैनवास, पूर्णांक_कर(केंद्र_x), पूर्णांक_कर(केंद्र_y), पूर्णांक_कर(चक्र_त्रिज्या), "neela", असत्य)

# Draw inner circle (filled)
_chitra_circle(कैनवास, पूर्णांक_कर(केंद्र_x), पूर्णांक_कर(केंद्र_y), 15, "neela", सत्य)

# Draw 24 spokes (अर)
चर spokes = 24
चर कोण_वृद्धि = 6.28318 / spokes

चर s = 0
यावत् s < spokes:
    चर कोण = s * कोण_वृद्धि
    चर spoke_x = केंद्र_x + _math_cos(कोण) * चक्र_त्रिज्या
    चर spoke_y = केंद्र_y + _math_sin(कोण) * चक्र_त्रिज्या
    _chitra_line(कैनवास, पूर्णांक_कर(केंद्र_x), पूर्णांक_कर(केंद्र_y), पूर्णांक_कर(spoke_x), पूर्णांक_कर(spoke_y), "neela")
    चर s = s + 1

# Add small decorative circles around the chakra
चर छोटे_वृत्त = 24
चर छोटा_त्रिज्या = चक्र_त्रिज्या * 0.1
चर वृत्त_दूरी = चक्र_त्रिज्या * 0.85

चर c = 0
यावत् c < छोटे_वृत्त:
    चर कोण = c * कोण_वृद्धि
    चर cx = केंद्र_x + _math_cos(कोण) * वृत्त_दूरी
    चर cy = केंद्र_y + _math_sin(कोण) * वृत्त_दूरी
    _chitra_circle(कैनवास, पूर्णांक_कर(cx), पूर्णांक_कर(cy), पूर्णांक_कर(छोटा_त्रिज्या), "neela", सत्य)
    चर c = c + 1

# Save the flag
_chitra_save(कैनवास, "तिरंगा.png")

मुद्रय "═══════════════════════════════════════"
मुद्रय "🇮🇳  तिरंगा चित्रकला सफल!"
मुद्रय "═══════════════════════════════════════"
मुद्रय "ध्वज विस्तार:", ध्वज_विस्तार
मुद्रय "ध्वज ऊंचाई:", ध्वज_ऊंचाई
मुद्रय "अनुपात: ३:२ (आधिकारिक)"
मुद्रय "अशोक चक्र: ", spokes, " अर"
मुद्रय "═══════════════════════════════════════"
मुद्रय "📁 सहेजी गई: तिरंगा.png"
मुद्रय ""
मुद्रय "🕉️ वन्दे मातरम् 🕉️"
