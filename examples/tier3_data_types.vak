# ─────────────────────────────────────────────────────────────────────────────
# वाक् भाषा - Tier 3 डेटा प्रकार उदाहरण
# Tagged unions (डेटा) + typed constructors + exhaustive pattern matching
# ─────────────────────────────────────────────────────────────────────────────

डेटा विकल्प[T]:
    कुछ(T)
    रिक्त

कर्म शीर्ष_मान(मान: विकल्प[संख्या]) → संख्या:
    प्रत्यभिज्ञा मान:
        कुछ(x):
            वापस x
        रिक्त():
            वापस ०

मान पहला: विकल्प[संख्या] = कुछ(५)
मान दूसरा: विकल्प[संख्या] = रिक्त()

मुद्रय शीर्ष_मान(पहला)
मुद्रय शीर्ष_मान(दूसरा)
