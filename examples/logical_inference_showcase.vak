# सान्समैटिक तर्क-प्रदर्शन — नियम, निष्कर्ष, मूल्यांकन
# A Vak-native logical inference showcase

मुद्रय "━━ Vak Logical Inference Showcase ━━"

परिभाषय("2", ["अभाज्य", "सम"])
परिभाषय("17", ["अभाज्य"])
परिभाषय("19", ["अभाज्य"])

नियम("*", "HAS", "अभाज्य", "*", "IS", "विभाजक_केवल_१_और_स्वयं")
नियम("*", "IS", "विभाजक_केवल_१_और_स्वयं", "*", "IS", "संख्या_तत्त्व_रूपेण_विशेष")
नियम("*", "HAS", "सम", "*", "IS", "2_से_विभाज्य")

मुद्रय मूल्यांकन("2", "IS", "विभाजक_केवल_१_और_स्वयं")
मुद्रय मूल्यांकन("2", "IS", "संख्या_तत्त्व_रूपेण_विशेष")
मुद्रय मूल्यांकन("2", "IS", "2_से_विभाज्य")
मुद्रय मूल्यांकन("17", "IS", "संख्या_तत्त्व_रूपेण_विशेष")
मुद्रय मूल्यांकन("19", "IS", "संख्या_तत्त्व_रूपेण_विशेष")

यदि सिद्ध_है("17", "IS", "संख्या_तत्त्व_रूपेण_विशेष"):
    मुद्रय "निष्कर्ष: 17 नियमों से सिद्ध हुआ"
अन्यथा:
    मुद्रय "निष्कर्ष: 17 सिद्ध नहीं हुआ"

यदि सिद्ध_है("2", "IS", "2_से_विभाज्य"):
    मुद्रय "निष्कर्ष: 2 सम होने से 2_से_विभाज्य सिद्ध हुआ"
अन्यथा:
    मुद्रय "निष्कर्ष: 2_से_विभाज्य सिद्ध नहीं हुआ"
