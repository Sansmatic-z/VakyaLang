# वाक् आत्म-परीक्षा — Vak-native self-check

मुद्रय "━━ Vak आत्म-परीक्षा ━━"

कर्म परीक्षण(नाम, शर्त, विवरण = ""):
    यदि शर्त:
        मुद्रय "✓", नाम
        प्रत्यागच्छ 0
    यदि विवरण == "":
        मुद्रय "✗", नाम
    अन्यथा:
        मुद्रय "✗", नाम, "-", विवरण
    प्रत्यागच्छ 1

चर विफल = 0
चर कोडेक्स_कोश = "stress/codex_corpus"
यदि अस्तित्व("../stress/codex_corpus"):
    कोडेक्स_कोश = "../stress/codex_corpus"

# ── Codex surface ────────────────────────────────────────────────────────────
चर पृष्ठ = कोडेक्स_पृष्ठ()
चर अध्याय = कोडेक्स_अध्याय()
चर उन्नयन = कोडेक्स_उन्नयन("vak_legacy", कोडेक्स_कोश)

विफल += परीक्षण("कोडेक्स पृष्ठ उपलब्ध", दीर्घता(पृष्ठ) >= 5, पाठ_कर(दीर्घता(पृष्ठ)))
विफल += परीक्षण("कोडेक्स अध्याय उपलब्ध", दीर्घता(अध्याय) >= 4, पाठ_कर(दीर्घता(अध्याय)))
विफल += परीक्षण("कोडेक्स उन्नयन रिपोर्ट", उन्नयन["total_cases"] >= 1, पाठ_कर(उन्नयन))

चर legacy_payload = कोडेक्स_विवरण(
    "चर x = 0\nजबतक x < 1:\n    x = x + 1\n",
    "vak_legacy",
    "legacy.vak"
)
विफल += परीक्षण("कोडेक्स legacy पृष्ठ चयन", legacy_payload["page"] == "vak_legacy", legacy_payload["page"])
विफल += परीक्षण("कोडेक्स legacy संकलित", legacy_payload["validation"]["compiled"], legacy_payload["source"])
विफल += परीक्षण("कोडेक्स legacy सुधार", "यावत् x < 1:" अन्तर्गत legacy_payload["source"], legacy_payload["source"])

चर english_payload = कोडेक्स_विवरण(
    "def add(a, b):\n    return a + b\n",
    "english_vak",
    "sample.py"
)
विफल += परीक्षण("कोडेक्स English bridge संकलित", english_payload["validation"]["compiled"], english_payload["source"])
विफल += परीक्षण("कोडेक्स English bridge कर्म", "कर्म add(a, b):" अन्तर्गत english_payload["source"], english_payload["source"])

# ── रूपान्तर surface ────────────────────────────────────────────────────────
चर टूट_स्रोत = "चर सूची = []\nसूची.apend(१)\n"
चर रूप_स्रोत = रूपान्तर(टूट_स्रोत)
चर रूप_विवरण = रूपान्तर_विवरण(टूट_स्रोत)

विफल += परीक्षण("रूपान्तर संकलित", रूप_विवरण["compiled"], रूप_स्रोत)
विफल += परीक्षण("रूपान्तर सदस्य-सुधार", "सूची.जोड़ो(१)" अन्तर्गत रूप_स्रोत, रूप_स्रोत)

# ── Sansmatic surface ───────────────────────────────────────────────────────
प्रमाण_रीसेट()
परिभाषय("अग्नि", ["ताप"])
दावा("अग्नि", "HAS", "ताप")
नियम("*", "HAS", "ताप", "*", "IS", "तेज")

चर प्रमाण_सार = प्रमाण_सारांश()
विफल += परीक्षण("सान्समैटिक तथ्य दर्ज", प्रमाण_सार["facts"] >= 1, पाठ_कर(प्रमाण_सार))
विफल += परीक्षण("सान्समैटिक पश्च सिद्धि", पश्च_सिद्ध_है("अग्नि", "IS", "तेज"), पाठ_कर(प्रमाण_सार))
चर अनुक्रम_पाठ = प्रमाण_अनुक्रम_पाठ()
चर वृक्ष_पाठ = प्रमाण_वृक्ष_पाठ("अग्नि", "IS", "तेज")
चर व्याख्या_पाठ = प्रमाण_व्याख्या_पाठ("अग्नि", "IS", "तेज")
विफल += परीक्षण("सान्समैटिक अनुक्रम पाठ", "प्रमाण अनुक्रम" अन्तर्गत अनुक्रम_पाठ, अनुक्रम_पाठ)
विफल += परीक्षण("सान्समैटिक वृक्ष पाठ", "प्रमाण वृक्ष" अन्तर्गत वृक्ष_पाठ, वृक्ष_पाठ)
विफल += परीक्षण("सान्समैटिक व्याख्या पाठ", "प्रमाण व्याख्या" अन्तर्गत व्याख्या_पाठ, व्याख्या_पाठ)

# ── Stdlib surface ──────────────────────────────────────────────────────────
आयात रंग_पुस्तकालय
आयात colour_lib
चर नील = रंग_पुस्तकालय.प्राप्त("Blue")
विफल += परीक्षण("रंग_पुस्तकालय lookup", नील == "#0000FF", नील)
चर compat_नील = colour_lib.प्राप्त("Blue")
विफल += परीक्षण("colour_lib compatibility lookup", compat_नील == नील, compat_नील)

# ── Graphics + profiling surface ────────────────────────────────────────────
चर पट = _chitra_canvas(8, 8, "white")
_chitra_line(पट, 0, 0, 7, 7, "black")
विफल += परीक्षण("चित्रकला कैनवास चौड़ाई", _chitra_width(पट) == 8, पाठ_कर(_chitra_width(पट)))
विफल += परीक्षण("चित्रकला रंग सूची", दीर्घता(_chitra_colors()) > 0, पाठ_कर(दीर्घता(_chitra_colors())))

चर प्रोफ़ाइल = प्रदर्शन_विवरण("मुद्रय १\n", "inline_profile.vak", 1, असत्य)
विफल += परीक्षण("प्रदर्शन चरण उपलब्ध", दीर्घता(प्रोफ़ाइल["stages"]) >= 4, पाठ_कर(प्रोफ़ाइल))
विफल += परीक्षण("प्रदर्शन कुल समय", प्रोफ़ाइल["total_ms"] >= 0, पाठ_कर(प्रोफ़ाइल["total_ms"]))

मुद्रय "कुल विफलताएँ:", विफल

यदि विफल == 0:
    मुद्रय "✓ Vak आत्म-परीक्षा पूर्ण"
अन्यथा:
    उत्क्षिप "Vak आत्म-परीक्षा विफल"
