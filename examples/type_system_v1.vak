# ─────────────────────────────────────────────────────────────────────────────
# वाक् भाषा - Type System v1 उदाहरण
# Compile-time typing + परिणाम handling + pattern narrowing
# ─────────────────────────────────────────────────────────────────────────────

कर्म जोड़(x: संख्या, y: संख्या) → संख्या:
    वापस x + y

कर्म भाग(क: संख्या, ख: संख्या):
    यदि ख == ०:
        वापस असिद्ध("शून्य")
    वापस सिद्ध(क // ख)

मान सूची: सूची[संख्या] = [१, २, ३]
मान शायद: संख्या | शून्य = शून्य
शायद = ७

मान योग: संख्या = जोड़(४, ५)
मुद्रय योग
मुद्रय सूची[१]
मुद्रय शायद

मान परिणाम: फल[संख्या, तार] = भाग(१०, २)

प्रत्यभिज्ञा परिणाम:
    सिद्ध(उत्तर):
        मुद्रय उत्तर
    असिद्ध(त्रुटि):
        मुद्रय त्रुटि
    _:
        मुद्रय "अज्ञात"
