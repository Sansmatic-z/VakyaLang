आयात event_loop
आयात promise
आयात task_group

चर लूप = नव event_loop.घटना_लूप()
चर योग = ०

कर्म सूक्ष्म():
    मुद्रय "microtask"

कर्म पहला():
    प्रत्यागच्छ "कर्म-१"

कर्म दूसरा():
    प्रत्यागच्छ "कर्म-२"

कर्म विलम्बित():
    मुद्रय "delayed"

कर्म परिणाम_दिखाओ(सूची):
    मुद्रय "group-size: " + पाठ_कर(दीर्घता(सूची))
    मुद्रय सूची[०]
    मुद्रय सूची[१]

कर्म दौड़_जीती(मान):
    मुद्रय "race: " + मान

लूप.सूक्ष्म_कार्य_जोड़ो(सूक्ष्म)
लूप.विलम्ब_जोड़ो(विलम्बित, २)

चर समूह = नव task_group.कार्य_समूह(लूप)
समूह.जोड़ो(पहला)
समूह.जोड़ो(दूसरा)
समूह.प्रतीक्षा_करो().तब(परिणाम_दिखाओ, शून्य)

चर यंत्र = नव promise.वादा_यंत्र()
चर वादा१ = नव promise.वादा()
चर वादा२ = नव promise.वादा()
यंत्र.कोई_भी([वादा१, वादा२]).तब(दौड़_जीती, शून्य)
वादा२.पूर्ण_करो("जीत")

लूप.चलाओ()
