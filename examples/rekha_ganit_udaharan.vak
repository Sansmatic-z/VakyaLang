# वाक् भाषा — रेखा गणित उदाहरण (Linear Algebra Example)
# Demonstrates: Vector operations, Matrix operations, Linear algebra

आयात rekha_ganit

मुद्रय "═══════════════════════════════════════════════════════════"
मुद्रय "  रेखा गणित पुस्तकालय प्रदर्शन (Linear Algebra Demo)"
मुद्रय "═══════════════════════════════════════════════════════════"

# ── सदिश संचालन (Vector Operations) ──────────────────────────────
मुद्रय "\n📐 सदिश संचालन (Vector Operations):"
मुद्रय "─────────────────────────────────────"

चर व१ = [३, ४, ०]
चर व२ = [१, २, ०]

मुद्रय "सदिश १:", व१
मुद्रय "सदिश २:", व२

चर योग = rekha_ganit.सदिश_योग(व१, व२)
मुद्रय "योग (v1 + v2):", योग

चर व्यवकलन = rekha_ganit.सदिश_व्यवकलन(व१, व२)
मुद्रय "व्यवकलन (v1 - v2):", व्यवकलन

चर अदिश = २
चर गुणन = rekha_ganit.सदिश_अदिश_गुणन(व१, अदिश)
मुद्रय "अदिश गुणन (v1 * 2):", गुणन

चर डॉट = rekha_ganit.सदिश_गुणनफल(व१, व२)
मुद्रय "डॉट गुणनफल (v1 · v2):", डॉट

चर लंबाई = rekha_ganit.सदिश_लंबाई(व१)
मुद्रय "सदिश १ लंबाई:", लंबाई

चर सामान्य = rekha_ganit.सदिश_सामान्यीकरण(व१)
मुद्रय "सामान्यीकृत सदिश:", सामान्य

# ── मैट्रिक्स संचालन (Matrix Operations) ─────────────────────────
मुद्रय "\n🔲 मैट्रिक्स संचालन (Matrix Operations):"
मुद्रय "────────────────────────────────────────"

चर म१ = [
    [१, २],
    [३, ४]
]

चर म२ = [
    [५, ६],
    [७, ८]
]

मुद्रय "मैट्रिक्स A:", म१
मुद्रय "मैट्रिक्स B:", म२

चर म_योग = rekha_ganit.मैट्रिक्स_योग(म१, म२)
मुद्रय "A + B:", म_योग

चर म_गुणन = rekha_ganit.मैट्रिक्स_गुणन(म१, म२)
मुद्रय "A × B:", म_गुणन

चर म_स्थानांतरण = rekha_ganit.मैट्रिक्स_स्थानांतरण(म१)
मुद्रय "A^T (transpose):", म_स्थानांतरण

चर निर्धारक = rekha_ganit.मैट्रिक्स_निर्धारक(म१)
मुद्रय "det(A):", निर्धारक

# ── ३डी सदिश (3D Vectors) ────────────────────────────────────────
मुद्रय "\n🎯 ३डी सदिश (3D Vectors):"
मुद्रय "────────────────────────"

चर त्रि१ = [१, २, ३]
चर त्रि२ = [४, ५, ६]

मुद्रय "सदिश ३डी-१:", त्रि१
मुद्रय "सदिश ३डी-२:", त्रि२

चर पार = rekha_ganit.सदिश_पार_गुणनफल(त्रि१, त्रि२)
मुद्रय "पार गुणनफल (cross product):", पार

मुद्रय "\n═══════════════════════════════════════════════════════════"
मुद्रय "  प्रदर्शन सम्पूर्ण (Demo Complete)"
मुद्रय "═══════════════════════════════════════════════════════════"
