# चित्रकला — Star Weave Showcase
# Generates a layered geometric weave using circles, lines, polygons, and text.

चर विस्तार = 1000
चर ऊंचाई = 1000
चर केंद्र_x = 500
चर केंद्र_y = 500
चर कैनवास = _chitra_canvas(विस्तार, ऊंचाई, "shyama")

चर रंग_चक्र = ["tapta", "padma", "harita", "rajata", "nila", "pita"]
चर बाहरी_त्रिज्या = 380
चर आंतरिक_त्रिज्या = 210
चर बिंदु_संख्या = 18
चर कोण_वृद्धि = 6.28318 / बिंदु_संख्या

चर बाहरी_बिंदु = []
चर आंतरिक_बिंदु = []

चर i = 0
यावत् i < बिंदु_संख्या:
    चर कोण = i * कोण_वृद्धि
    चर बाहरी_x = पूर्णांक_कर(केंद्र_x + _math_cos(कोण) * बाहरी_त्रिज्या)
    चर बाहरी_y = पूर्णांक_कर(केंद्र_y + _math_sin(कोण) * बाहरी_त्रिज्या)
    चर आंतरिक_x = पूर्णांक_कर(केंद्र_x + _math_cos(कोण + (कोण_वृद्धि / 2)) * आंतरिक_त्रिज्या)
    चर आंतरिक_y = पूर्णांक_कर(केंद्र_y + _math_sin(कोण + (कोण_वृद्धि / 2)) * आंतरिक_त्रिज्या)

    बाहरी_बिंदु.जोड़ो([बाहरी_x, बाहरी_y])
    आंतरिक_बिंदु.जोड़ो([आंतरिक_x, आंतरिक_y])

    _chitra_circle(कैनवास, बाहरी_x, बाहरी_y, 10, रंग_चक्र[i % दीर्घता(रंग_चक्र)], सत्य)
    _chitra_circle(कैनवास, आंतरिक_x, आंतरिक_y, 7, "rajata", सत्य)
    चर i = i + 1

चर j = 0
यावत् j < बिंदु_संख्या:
    चर अगला = (j + 7) % बिंदु_संख्या
    चर आगे = (j + 1) % बिंदु_संख्या
    चर रंग = रंग_चक्र[j % दीर्घता(रंग_चक्र)]

    _chitra_line(
        कैनवास,
        बाहरी_बिंदु[j][0], बाहरी_बिंदु[j][1],
        बाहरी_बिंदु[अगला][0], बाहरी_बिंदु[अगला][1],
        रंग
    )
    _chitra_line(
        कैनवास,
        बाहरी_बिंदु[j][0], बाहरी_बिंदु[j][1],
        आंतरिक_बिंदु[j][0], आंतरिक_बिंदु[j][1],
        "rajata"
    )
    _chitra_line(
        कैनवास,
        आंतरिक_बिंदु[j][0], आंतरिक_बिंदु[j][1],
        आंतरिक_बिंदु[आगे][0], आंतरिक_बिंदु[आगे][1],
        "padma"
    )
    चर j = j + 1

_chitra_polygon(कैनवास, बाहरी_बिंदु, "tapta", असत्य)
_chitra_polygon(कैनवास, आंतरिक_बिंदु, "harita", असत्य)

चर वृत्त_त्रिज्या = 90
यावत् वृत्त_त्रिज्या <= 360:
    चर रंग = रंग_चक्र[(वृत्त_त्रिज्या // 45) % दीर्घता(रंग_चक्र)]
    _chitra_circle(कैनवास, केंद्र_x, केंद्र_y, वृत्त_त्रिज्या, रंग, असत्य)
    चर वृत्त_त्रिज्या = वृत्त_त्रिज्या + 45

चर कमल_बिंदु = []
चर p = 0
यावत् p < 8:
    चर कोण = p * (6.28318 / 8)
    कमल_बिंदु.जोड़ो([
        पूर्णांक_कर(केंद्र_x + _math_cos(कोण) * 110),
        पूर्णांक_कर(केंद्र_y + _math_sin(कोण) * 110)
    ])
    _chitra_circle(
        कैनवास,
        पूर्णांक_कर(केंद्र_x + _math_cos(कोण) * 140),
        पूर्णांक_कर(केंद्र_y + _math_sin(कोण) * 140),
        28,
        "padma",
        असत्य
    )
    चर p = p + 1

_chitra_polygon(कैनवास, कमल_बिंदु, "pita", असत्य)
_chitra_circle(कैनवास, केंद्र_x, केंद्र_y, 32, "श्वेत", सत्य)
_chitra_circle(कैनवास, केंद्र_x, केंद्र_y, 18, "tapta", सत्य)

_chitra_text_centered(कैनवास, 72, "Vak Star Weave", "श्वेत", 2)
_chitra_text_centered(कैनवास, 905, "Geometry through Vak", "rajata", 1)

_chitra_save(कैनवास, "vak_star_weave.png")

मुद्रय "Star weave complete"
मुद्रय "Saved: vak_star_weave.png"
मुद्रय "Center:", केंद्र_x, केंद्र_y
