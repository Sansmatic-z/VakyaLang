# चित्रकला ज्यामितिक-प्रदर्शन — वाक् + चित्रकला end-to-end

चर विस्तार = 900
चर ऊंचाई = 900
चर केंद्र_x = 450
चर केंद्र_y = 450
चर कैनवास = _chitra_canvas(विस्तार, ऊंचाई, "krishna")

चर रंग_चक्र = ["rakta", "pita", "harita", "nila", "padma", "rajata"]
चर बाहरी_त्रिज्या = 360
चर रेखाएँ = 18
चर कोण_वृद्धि = 6.28318 / रेखाएँ

चर i = 0
यावत् i < रेखाएँ:
    चर कोण = i * कोण_वृद्धि
    चर cos_val = _math_cos(कोण)
    चर sin_val = _math_sin(कोण)
    चर x = केंद्र_x + cos_val * बाहरी_त्रिज्या
    चर y = केंद्र_y + sin_val * बाहरी_त्रिज्या
    चर रंग = रंग_चक्र[i % दीर्घता(रंग_चक्र)]
    _chitra_line(कैनवास, केंद्र_x, केंद्र_y, पूर्णांक_कर(x), पूर्णांक_कर(y), रंग)
    _chitra_circle(कैनवास, पूर्णांक_कर(x), पूर्णांक_कर(y), 14, रंग, सत्य)
    चर i = i + 1

चर त्रिज्या = 60
यावत् त्रिज्या <= 360:
    चर रंग = रंग_चक्र[(त्रिज्या // 60) % दीर्घता(रंग_चक्र)]
    _chitra_circle(कैनवास, केंद्र_x, केंद्र_y, त्रिज्या, रंग, असत्य)
    चर त्रिज्या = त्रिज्या + 60

चर षट्कोण = []
चर j = 0
यावत् j < 6:
    चर कोण = j * (6.28318 / 6)
    षट्कोण.जोड़ो([
        पूर्णांक_कर(केंद्र_x + _math_cos(कोण) * 180),
        पूर्णांक_कर(केंद्र_y + _math_sin(कोण) * 180)
    ])
    चर j = j + 1

_chitra_polygon(कैनवास, षट्कोण, "pita", असत्य)
_chitra_text_centered(कैनवास, 80, "Vak Chitra Geometry", "श्वेत", 2)
_chitra_text_centered(कैनवास, 820, "वाक् चित्रकला प्रदर्शन", "padma", 2)
_chitra_save(कैनवास, "vak_geometric_showcase.png")

मुद्रय "चित्रकला प्रदर्शन पूर्ण"
मुद्रय "चित्र सहेजा गया: vak_geometric_showcase.png"
मुद्रय "केंद्र:", केंद्र_x, केंद्र_y
