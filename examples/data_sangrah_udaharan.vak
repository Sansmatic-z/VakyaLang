# वाक् भाषा — डाटा संग्रह उदाहरण (Data Structures Example)
# Demonstrates: Stack, Queue, Linked List, Binary Search Tree, Hash Table

आयात data_sangrah

चर स्टैक = data_sangrah.स्टैक
चर कतार = data_sangrah.कतार
चर लिंक्ड_लिस्ट = data_sangrah.लिंक्ड_लिस्ट
चर बाइनरी_सर्च_ट्री = data_sangrah.बाइनरी_सर्च_ट्री
चर हैश_टेबल = data_sangrah.हैश_टेबल
चर लिंक_नोड = data_sangrah.लिंक_नोड
चर ट्री_नोड = data_sangrah.ट्री_नोड

मुद्रय "═══════════════════════════════════════════════════════════"
मुद्रय "  डाटा संग्रह पुस्तकालय प्रदर्शन (Data Structures Demo)"
मुद्रय "═══════════════════════════════════════════════════════════"

# ── स्टैक (Stack - LIFO) ─────────────────────────────────────────
मुद्रय "\n📚 स्टैक (Stack - Last In First Out):"
मुद्रय "────────────────────────────────────────"

चर स्टैक = नव स्टैक()

स्टैक.धक्का(१०)
स्टैक.धक्का(२०)
स्टैक.धक्का(३०)
स्टैक.धक्का(४०)

मुद्रय "स्टैक आकार:", स्टैक.आकार()
मुद्रय "शीर्ष तत्व:", स्टैक.शीर्ष_तत्व()

मुद्रय "पॉप:", स्टैक.पॉप()
मुद्रय "पॉप:", स्टैक.पॉप()
मुद्रय "अब आकार:", स्टैक.आकार()

# ── कतार (Queue - FIFO) ──────────────────────────────────────────
मुद्रय "\n🔄 कतार (Queue - First In First Out):"
मुद्रय "──────────────────────────────────────"

चर कतार = नव कतार()

कतार.प्रवेश(१)
कतार.प्रवेश(२)
कतार.प्रवेश(३)
कतार.प्रवेश(४)

मुद्रय "कतार आकार:", कतार.आकार()
मुद्रय "अग्र तत्व:", कतार.अग्र()

मुद्रय "निर्गम:", कतार.निर्गम()
मुद्रय "निर्गम:", कतार.निर्गम()
मुद्रय "अब आकार:", कतार.आकार()

# ── लिंक्ड लिस्ट (Linked List) ───────────────────────────────────
मुद्रय "\n🔗 लिंक्ड लिस्ट (Linked List):"
मुद्रय "────────────────────────────────"

चर लिस्ट = नव लिंक्ड_लिस्ट()

लिस्ट.जोड़ो(१००)
लिस्ट.जोड़ो(२००)
लिस्ट.जोड़ो(३००)
लिस्ट.जोड़ो(४००)

मुद्रय "लिंक्ड लिस्ट:", लिस्ट.सूची_में()
मुद्रय "आकार:", लिस्ट.आकार()

मुद्रय "२०० खोजो:", लिस्ट.खोजो(२००)
मुद्रय "९९९ खोजो:", लिस्ट.खोजो(९९९)

लिस्ट.हटाओ(२००)
मुद्रय "२०० हटाने के बाद:", लिस्ट.सूची_में()

# ── बाइनरी सर्च ट्री (Binary Search Tree) ────────────────────────
मुद्रय "\n🌳 बाइनरी सर्च ट्री (BST):"
मुद्रय "────────────────────────────"

चर ट्री = नव बाइनरी_सर्च_ट्री()

ट्री.जोड़ो(५०)
ट्री.जोड़ो(३०)
ट्री.जोड़ो(७०)
ट्री.जोड़ो(२०)
ट्री.जोड़ो(४०)
ट्री.जोड़ो(६०)
ट्री.जोड़ो(८०)

मुद्रय "इनऑर्डर (क्रमबद्ध):", ट्री.इनऑर्डर()
मुद्रय "प्रीऑर्डर:", ट्री.प्रीऑर्डर()
मुद्रय "पोस्टऑर्डर:", ट्री.पोस्टऑर्डर()

मुद्रय "४० खोजो:", ट्री.खोजो(४०)
मुद्रय "२५ खोजो:", ट्री.खोजो(२५)

मुद्रय "ट्री ऊँचाई:", ट्री.ऊँचाई()
मुद्रय "ट्री आकार:", ट्री.आकार()

# ── हैश टेबल (Hash Table) ────────────────────────────────────────
मुद्रय "\n🗂️ हैश टेबल (Hash Table / Dictionary):"
मुद्रय "────────────────────────────────────────"

चर हैश = नव हैश_टेबल(१०)  # 10 buckets

हैश.डालो("नाम", "राज")
हैश.डालो("आयु", ३०)
हैश.डालो("शहर", "मुंबई")
हैश.डालो("भाषा", "संस्कृत")

मुद्रय "नाम:", हैश.प्राप्त_करो("नाम")
मुद्रय "आयु:", हैश.प्राप्त_करो("आयु")
मुद्रय "शहर:", हैश.प्राप्त_करो("शहर")

मुद्रय "कुंजियाँ:", हैश.कुंजियाँ()
मुद्रय "मान:", हैश.मान()

मुद्रय "आकार:", हैश.आकार()
मुद्रय "तार:", हैश.तार_कर()

मुद्रय "\n═══════════════════════════════════════════════════════════"
मुद्रय "  प्रदर्शन सम्पूर्ण (Demo Complete)"
मुद्रय "═══════════════════════════════════════════════════════════"
