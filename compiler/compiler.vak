# ── Python bridge handles for staged bootstrap ─────────────────────────────

चर _पायथन_ओएस = पायथन_आयात("os")
चर _पायथन_पथलिब = पायथन_आयात("pathlib")
चर _पायथन_पुरातन_पृष्ठ = पायथन_आयात("compiler.legacy_backend")


# ── Lexical Analysis ──────────────────────────────────────────────────────

वर्ग टोकन:
    कर्म प्रारम्भ(स्वयं, प्रकार, मान, पंक्ति):
        स्वयं.प्रकार = प्रकार
        स्वयं.मान = मान
        स्वयं.पंक्ति = पंक्ति

    कर्म विवरण(स्वयं):
        प्रत्यागच्छ "<टोकन:" + स्वयं.प्रकार + "," + पाठ_कर(स्वयं.मान) + ">"


वर्ग लेक्सर:
    कर्म प्रारम्भ(स्वयं, स्रोत):
        स्वयं.स्रोत = स्रोत
        स्वयं.स्थिति = ०
        स्वयं.पंक्ति = १
        स्वयं.पंक्ति_आरम्भ = सत्य
        स्वयं.लंबित_टोकन = []
        स्वयं.इंडेंट_स्तर = [०]
        स्वयं.ईओएफ_दिया = असत्य

    कर्म अगला_टोकन(स्वयं):
        यदि दीर्घता(स्वयं.लंबित_टोकन) > ०:
            चर लंबित = स्वयं.लंबित_टोकन[०]
            स्वयं.लंबित_टोकन.हटाओ(०)
            प्रत्यागच्छ लंबित

        चर _लूप१ = ०
        यावत् स्वयं.स्थिति < दीर्घता(स्वयं.स्रोत) और _लूप१ < १००००:
            _लूप१ = _लूप१ + १

            यदि स्वयं.पंक्ति_आरम्भ:
                चर इंडेंट = ०
                चर _इंडेंट_लूप = ०
                यावत् स्वयं.स्थिति < दीर्घता(स्वयं.स्रोत) और _इंडेंट_लूप < १००००:
                    _इंडेंट_लूप = _इंडेंट_लूप + १
                    चर अग्रवर्ण = स्वयं.स्रोत[स्वयं.स्थिति]
                    यदि अग्रवर्ण == " ":
                        इंडेंट = इंडेंट + १
                        स्वयं.स्थिति = स्वयं.स्थिति + १
                        अग्रे
                    यदि अग्रवर्ण == "\t":
                        इंडेंट = इंडेंट + ४
                        स्वयं.स्थिति = स्वयं.स्थिति + १
                        अग्रे
                    विराम

                यदि स्वयं.स्थिति < दीर्घता(स्वयं.स्रोत) और स्वयं.स्रोत[स्वयं.स्थिति] == "#":
                    चर _टिप्पणी_लूप = ०
                    यावत् स्वयं.स्थिति < दीर्घता(स्वयं.स्रोत) और स्वयं.स्रोत[स्वयं.स्थिति] != "\n" और _टिप्पणी_लूप < १००००:
                        _टिप्पणी_लूप = _टिप्पणी_लूप + १
                        स्वयं.स्थिति = स्वयं.स्थिति + १

                यदि स्वयं.स्थिति < दीर्घता(स्वयं.स्रोत) और स्वयं.स्रोत[स्वयं.स्थिति] == "\n":
                    स्वयं.स्थिति = स्वयं.स्थिति + १
                    स्वयं.पंक्ति = स्वयं.पंक्ति + १
                    स्वयं.पंक्ति_आरम्भ = सत्य
                    प्रत्यागच्छ नव टोकन("NEWLINE", "", स्वयं.पंक्ति - १)

                यदि स्वयं.स्थिति >= दीर्घता(स्वयं.स्रोत):
                    विराम

                चर वर्तमान_इंडेंट = स्वयं.इंडेंट_स्तर[दीर्घता(स्वयं.इंडेंट_स्तर) - १]
                यदि इंडेंट > वर्तमान_इंडेंट:
                    स्वयं.इंडेंट_स्तर.जोड़ो(इंडेंट)
                    स्वयं.पंक्ति_आरम्भ = असत्य
                    प्रत्यागच्छ नव टोकन("INDENT", "", स्वयं.पंक्ति)

                यदि इंडेंट < वर्तमान_इंडेंट:
                    चर _dedent_लूप = ०
                    यावत् दीर्घता(स्वयं.इंडेंट_स्तर) > १ और इंडेंट < स्वयं.इंडेंट_स्तर[दीर्घता(स्वयं.इंडेंट_स्तर) - १] और _dedent_लूप < १००००:
                        _dedent_लूप = _dedent_लूप + १
                        स्वयं.इंडेंट_स्तर.हटाओ(दीर्घता(स्वयं.इंडेंट_स्तर) - १)
                        स्वयं.लंबित_टोकन.जोड़ो(नव टोकन("DEDENT", "", स्वयं.पंक्ति))
                    यदि इंडेंट != स्वयं.इंडेंट_स्तर[दीर्घता(स्वयं.इंडेंट_स्तर) - १]:
                        उत्क्षिप "अमान्य इंडेंट स्तर [पंक्ति " + पाठ_कर(स्वयं.पंक्ति) + "]"
                    स्वयं.पंक्ति_आरम्भ = असत्य
                    यदि दीर्घता(स्वयं.लंबित_टोकन) > ०:
                        चर लंबित_टोकन = स्वयं.लंबित_टोकन[०]
                        स्वयं.लंबित_टोकन.हटाओ(०)
                        प्रत्यागच्छ लंबित_टोकन

                स्वयं.पंक्ति_आरम्भ = असत्य

            यदि स्वयं.स्थिति >= दीर्घता(स्वयं.स्रोत):
                विराम

            चर वर्ण = स्वयं.स्रोत[स्वयं.स्थिति]

            यदि वर्ण == " " अथवा वर्ण == "\t" अथवा वर्ण == "\r":
                स्वयं.स्थिति = स्वयं.स्थिति + १
                अग्रे

            यदि वर्ण == "\n":
                स्वयं.पंक्ति = स्वयं.पंक्ति + १
                स्वयं.स्थिति = स्वयं.स्थिति + १
                स्वयं.पंक्ति_आरम्भ = सत्य
                प्रत्यागच्छ नव टोकन("NEWLINE", "", स्वयं.पंक्ति - १)
                अग्रे

            यदि वर्ण == "#":
                चर _लूप२ = ०
                यावत् स्वयं.स्थिति < दीर्घता(स्वयं.स्रोत) और स्वयं.स्रोत[स्वयं.स्थिति] != "\n" और _लूप२ < १००००:
                    _लूप२ = _लूप२ + १
                    स्वयं.स्थिति = स्वयं.स्थिति + १
                अग्रे

            यदि वर्ण >= "०" और वर्ण <= "९":
                चर संख्या = ""
                चर _लूप३ = ०
                यावत् स्वयं.स्थिति < दीर्घता(स्वयं.स्रोत) और स्वयं.स्रोत[स्वयं.स्थिति] >= "०" और स्वयं.स्रोत[स्वयं.स्थिति] <= "९" और _लूप३ < १०००:
                    _लूप३ = _लूप३ + १
                    संख्या = संख्या + स्वयं.स्रोत[स्वयं.स्थिति]
                    स्वयं.स्थिति = स्वयं.स्थिति + १
                प्रत्यागच्छ नव टोकन("संख्या", पूर्णांक_कर(संख्या), स्वयं.पंक्ति)

            यदि वर्ण == '"':
                स्वयं.स्थिति = स्वयं.स्थिति + १
                चर तार = ""
                चर _लूप४ = ०
                यावत् स्वयं.स्थिति < दीर्घता(स्वयं.स्रोत) और स्वयं.स्रोत[स्वयं.स्थिति] != '"' और _लूप४ < १००००:
                    _लूप४ = _लूप४ + १
                    तार = तार + स्वयं.स्रोत[स्वयं.स्थिति]
                    स्वयं.स्थिति = स्वयं.स्थिति + १
                स्वयं.स्थिति = स्वयं.स्थिति + १
                प्रत्यागच्छ नव टोकन("तार", तार, स्वयं.पंक्ति)

            यदि (वर्ण >= "a" और वर्ण <= "z") अथवा (वर्ण >= "A" और वर्ण <= "Z") अथवा अक्षर_मान(वर्ण) > १२७ अथवा वर्ण == "_":
                चर शब्द = ""
                चर _लूप५ = ०
                यावत् स्वयं.स्थिति < दीर्घता(स्वयं.स्रोत) और _लूप५ < १००००:
                    _लूप५ = _लूप५ + १
                    चर वर्तमान_वर्ण = स्वयं.स्रोत[स्वयं.स्थिति]
                    चर मान्य = असत्य
                    यदि (वर्तमान_वर्ण >= "a" और वर्तमान_वर्ण <= "z"): मान्य = सत्य
                    यदि (वर्तमान_वर्ण >= "A" और वर्तमान_वर्ण <= "Z"): मान्य = सत्य
                    यदि अक्षर_मान(वर्तमान_वर्ण) > १२७: मान्य = सत्य
                    यदि (वर्तमान_वर्ण >= "०" और वर्तमान_वर्ण <= "९"): मान्य = सत्य
                    यदि वर्तमान_वर्ण == "_": मान्य = सत्य

                    यदि मान्य:
                        शब्द = शब्द + वर्तमान_वर्ण
                        स्वयं.स्थिति = स्वयं.स्थिति + १
                    अन्यथा:
                        विराम

                चर कीवर्ड्स = ["वर्ग", "कर्म", "चर", "यदि", "अन्यथा", "यावत्", "प्रत्येक", "अन्तर्गत", "प्रत्यागच्छ", "आयात", "से", "मुद्रय", "नव", "वैश्विक", "अस्थानिक"]
                यदि शब्द अन्तर्गत कीवर्ड्स:
                    प्रत्यागच्छ नव टोकन(शब्द, शब्द, स्वयं.पंक्ति)
                अन्यथा:
                    प्रत्यागच्छ नव टोकन("पहचान", शब्द, स्वयं.पंक्ति)

            यदि वर्ण == "(":
                स्वयं.स्थिति = स्वयं.स्थिति + १
                प्रत्यागच्छ नव टोकन("(", "(", स्वयं.पंक्ति)
            यदि वर्ण == ")":
                स्वयं.स्थिति = स्वयं.स्थिति + १
                प्रत्यागच्छ नव टोकन(")", ")", स्वयं.पंक्ति)
            यदि वर्ण == "[":
                स्वयं.स्थिति = स्वयं.स्थिति + १
                प्रत्यागच्छ नव टोकन("[", "[", स्वयं.पंक्ति)
            यदि वर्ण == "]":
                स्वयं.स्थिति = स्वयं.स्थिति + १
                प्रत्यागच्छ नव टोकन("]", "]", स्वयं.पंक्ति)
            यदि वर्ण == "{":
                स्वयं.स्थिति = स्वयं.स्थिति + १
                प्रत्यागच्छ नव टोकन("{", "{", स्वयं.पंक्ति)
            यदि वर्ण == "}":
                स्वयं.स्थिति = स्वयं.स्थिति + १
                प्रत्यागच्छ नव टोकन("}", "}", स्वयं.पंक्ति)
            यदि वर्ण == ":":
                स्वयं.स्थिति = स्वयं.स्थिति + १
                प्रत्यागच्छ नव टोकन(":", ":", स्वयं.पंक्ति)
            यदि वर्ण == ",":
                स्वयं.स्थिति = स्वयं.स्थिति + १
                प्रत्यागच्छ नव टोकन(",", ",", स्वयं.पंक्ति)
            यदि वर्ण == ".":
                स्वयं.स्थिति = स्वयं.स्थिति + १
                प्रत्यागच्छ नव टोकन(".", ".", स्वयं.पंक्ति)

            यदि वर्ण == "+":
                स्वयं.स्थिति = स्वयं.स्थिति + १
                प्रत्यागच्छ नव टोकन("+", "+", स्वयं.पंक्ति)
            यदि वर्ण == "-":
                स्वयं.स्थिति = स्वयं.स्थिति + १
                प्रत्यागच्छ नव टोकन("-", "-", स्वयं.पंक्ति)
            यदि वर्ण == "*":
                यदि स्वयं.स्थिति + १ < दीर्घता(स्वयं.स्रोत) और स्वयं.स्रोत[स्वयं.स्थिति + १] == "*":
                    स्वयं.स्थिति = स्वयं.स्थिति + २
                    प्रत्यागच्छ नव टोकन("**", "**", स्वयं.पंक्ति)
                स्वयं.स्थिति = स्वयं.स्थिति + १
                प्रत्यागच्छ नव टोकन("*", "*", स्वयं.पंक्ति)
            यदि वर्ण == "/":
                स्वयं.स्थिति = स्वयं.स्थिति + १
                प्रत्यागच्छ नव टोकन("/", "/", स्वयं.पंक्ति)
            यदि वर्ण == "!":
                यदि स्वयं.स्थिति + १ < दीर्घता(स्वयं.स्रोत) और स्वयं.स्रोत[स्वयं.स्थिति + १] == "=":
                    स्वयं.स्थिति = स्वयं.स्थिति + २
                    प्रत्यागच्छ नव टोकन("!=", "!=", स्वयं.पंक्ति)
                उत्क्षिप "अज्ञात वर्ण: " + वर्ण
            यदि वर्ण == "<":
                यदि स्वयं.स्थिति + १ < दीर्घता(स्वयं.स्रोत) और स्वयं.स्रोत[स्वयं.स्थिति + १] == "=":
                    स्वयं.स्थिति = स्वयं.स्थिति + २
                    प्रत्यागच्छ नव टोकन("<=", "<=", स्वयं.पंक्ति)
                स्वयं.स्थिति = स्वयं.स्थिति + १
                प्रत्यागच्छ नव टोकन("<", "<", स्वयं.पंक्ति)
            यदि वर्ण == ">":
                यदि स्वयं.स्थिति + १ < दीर्घता(स्वयं.स्रोत) और स्वयं.स्रोत[स्वयं.स्थिति + १] == "=":
                    स्वयं.स्थिति = स्वयं.स्थिति + २
                    प्रत्यागच्छ नव टोकन(">=", ">=", स्वयं.पंक्ति)
                स्वयं.स्थिति = स्वयं.स्थिति + १
                प्रत्यागच्छ नव टोकन(">", ">", स्वयं.पंक्ति)
            यदि वर्ण == "=":
                यदि स्वयं.स्थिति + १ < दीर्घता(स्वयं.स्रोत) और स्वयं.स्रोत[स्वयं.स्थिति + १] == "=":
                    स्वयं.स्थिति = स्वयं.स्थिति + २
                    प्रत्यागच्छ नव टोकन("==", "==", स्वयं.पंक्ति)
                स्वयं.स्थिति = स्वयं.स्थिति + १
                प्रत्यागच्छ नव टोकन("=", "=", स्वयं.पंक्ति)

            उत्क्षिप "अज्ञात वर्ण: " + वर्ण

        यदि दीर्घता(स्वयं.लंबित_टोकन) > ०:
            चर लंबित_ईओएफ = स्वयं.लंबित_टोकन[०]
            स्वयं.लंबित_टोकन.हटाओ(०)
            प्रत्यागच्छ लंबित_ईओएफ

        यदि दीर्घता(स्वयं.इंडेंट_स्तर) > १:
            स्वयं.इंडेंट_स्तर.हटाओ(दीर्घता(स्वयं.इंडेंट_स्तर) - १)
            प्रत्यागच्छ नव टोकन("DEDENT", "", स्वयं.पंक्ति)

        यदि न स्वयं.ईओएफ_दिया:
            स्वयं.ईओएफ_दिया = सत्य
            प्रत्यागच्छ नव टोकन("EOF", "", स्वयं.पंक्ति)

        प्रत्यागच्छ नव टोकन("EOF", "", स्वयं.पंक्ति)

    कर्म सभी_टोकन(स्वयं):
        चर टोकन_सूची = []
        चर _सुरक्षा = ०
        चर लूप_चल_रहा_है = सत्य
        यावत् लूप_चल_रहा_है:
            _सुरक्षा = _सुरक्षा + १
            यदि _सुरक्षा > १०००:
                लूप_चल_रहा_है = असत्य
            अन्यथा:
                चर टोकन = स्वयं.अगला_टोकन()
                टोकन_सूची.जोड़ो(टोकन)
                यदि टोकन.प्रकार == "EOF":
                    लूप_चल_रहा_है = असत्य
        प्रत्यागच्छ टोकन_सूची


# ── Bootstrap summaries and staged compilation driver ─────────────────────

वर्ग पार्सर:
    कर्म प्रारम्भ(स्वयं, टोकन_सूची):
        स्वयं.टोकन_सूची = टोकन_सूची
        स्वयं.स्थिति = ०

    कर्म कार्यक्रम_सार(स्वयं):
        चर सार = {"कुल": दीर्घता(स्वयं.टोकन_सूची), "पहचान": ०, "संख्या": ०, "तार": ०, "कीवर्ड": ०}
        चर कीवर्ड्स = ["वर्ग", "कर्म", "चर", "यदि", "अन्यथा", "यावत्", "प्रत्यागच्छ", "आयात", "से", "मुद्रय", "नव"]
        प्रत्येक चर टोकन अन्तर्गत स्वयं.टोकन_सूची:
            यदि टोकन.प्रकार == "पहचान":
                सार["पहचान"] = सार["पहचान"] + १
            यदि टोकन.प्रकार == "संख्या":
                सार["संख्या"] = सार["संख्या"] + १
            यदि टोकन.प्रकार == "तार":
                सार["तार"] = सार["तार"] + १
            यदि टोकन.प्रकार अन्तर्गत कीवर्ड्स:
                सार["कीवर्ड"] = सार["कीवर्ड"] + १
        प्रत्यागच्छ सार

    कर्म _वर्तमान(स्वयं):
        यदि स्वयं.स्थिति >= दीर्घता(स्वयं.टोकन_सूची):
            प्रत्यागच्छ स्वयं.टोकन_सूची[दीर्घता(स्वयं.टोकन_सूची) - १]
        प्रत्यागच्छ स्वयं.टोकन_सूची[स्वयं.स्थिति]

    कर्म _झांको(स्वयं, दूर=१):
        चर स्थान = स्वयं.स्थिति + दूर
        यदि स्थान >= दीर्घता(स्वयं.टोकन_सूची):
            प्रत्यागच्छ स्वयं.टोकन_सूची[दीर्घता(स्वयं.टोकन_सूची) - १]
        प्रत्यागच्छ स्वयं.टोकन_सूची[स्थान]

    कर्म _स्वीकारो(स्वयं, प्रकार):
        यदि स्वयं._वर्तमान().प्रकार == प्रकार:
            चर टोकन = स्वयं._वर्तमान()
            यदि टोकन.प्रकार != "EOF":
                स्वयं.स्थिति = स्वयं.स्थिति + १
            प्रत्यागच्छ टोकन
        प्रत्यागच्छ शून्य

    कर्म _अपेक्षा(स्वयं, प्रकार, सन्देश):
        चर टोकन = स्वयं._स्वीकारो(प्रकार)
        यदि टोकन == शून्य:
            उत्क्षिप सन्देश + " [पंक्ति " + पाठ_कर(स्वयं._वर्तमान().पंक्ति) + "]"
        प्रत्यागच्छ टोकन

    कर्म मूल_विश्लेषण(स्वयं):
        स्वयं.स्थिति = ०
        चर वाक्य = []
        चर _सुरक्षा = ०
        यावत् स्वयं._वर्तमान().प्रकार != "EOF" और _सुरक्षा < १०००:
            _सुरक्षा = _सुरक्षा + १
            यावत् स्वयं._वर्तमान().प्रकार == "NEWLINE":
                स्वयं.स्थिति = स्वयं.स्थिति + १
            यदि स्वयं._वर्तमान().प्रकार == "EOF":
                विराम
            वाक्य.जोड़ो(स्वयं._वाक्य())
            यावत् स्वयं._वर्तमान().प्रकार == "NEWLINE":
                स्वयं.स्थिति = स्वयं.स्थिति + १
        प्रत्यागच्छ {"kind": "program", "statements": वाक्य}

    कर्म _वाक्य(स्वयं):
        यदि स्वयं._वर्तमान().प्रकार == "कर्म":
            प्रत्यागच्छ स्वयं._कर्म_वाक्य()
        यदि स्वयं._वर्तमान().प्रकार == "वर्ग":
            प्रत्यागच्छ स्वयं._वर्ग_वाक्य()
        यदि स्वयं._वर्तमान().प्रकार == "चर":
            प्रत्यागच्छ स्वयं._चर_वाक्य()
        यदि स्वयं._वर्तमान().प्रकार == "वैश्विक":
            प्रत्यागच्छ स्वयं._वैश्विक_वाक्य()
        यदि स्वयं._वर्तमान().प्रकार == "अस्थानिक":
            प्रत्यागच्छ स्वयं._अस्थानिक_वाक्य()
        यदि स्वयं._वर्तमान().प्रकार == "यदि":
            प्रत्यागच्छ स्वयं._यदि_वाक्य()
        यदि स्वयं._वर्तमान().प्रकार == "यावत्":
            प्रत्यागच्छ स्वयं._यावत्_वाक्य()
        यदि स्वयं._वर्तमान().प्रकार == "प्रत्येक":
            प्रत्यागच्छ स्वयं._प्रत्येक_वाक्य()
        यदि स्वयं._वर्तमान().प्रकार == "प्रत्यागच्छ":
            प्रत्यागच्छ स्वयं._प्रत्यागच्छ_वाक्य()
        यदि स्वयं._वर्तमान().प्रकार == "मुद्रय":
            प्रत्यागच्छ स्वयं._मुद्रय_वाक्य()
        यदि स्वयं._वर्तमान().प्रकार == "आयात":
            प्रत्यागच्छ स्वयं._आयात_वाक्य()
        यदि (
            स्वयं._वर्तमान().प्रकार == "पहचान"
            अथवा स्वयं._वर्तमान().प्रकार == "("
            अथवा स्वयं._वर्तमान().प्रकार == "["
            अथवा स्वयं._वर्तमान().प्रकार == "{"
            अथवा स्वयं._वर्तमान().प्रकार == "संख्या"
            अथवा स्वयं._वर्तमान().प्रकार == "तार"
        ):
            चर अभिव्यक्ति = स्वयं._अभिव्यक्ति()
            प्रत्यागच्छ {"kind": "expr", "expr": अभिव्यक्ति}
        उत्क्षिप "असमर्थित native वाक्य: " + स्वयं._वर्तमान().प्रकार + " [पंक्ति " + पाठ_कर(स्वयं._वर्तमान().पंक्ति) + "]"

    कर्म _कर्म_वाक्य(स्वयं):
        स्वयं._अपेक्षा("कर्म", "कर्म अपेक्षित")
        चर नाम = स्वयं._अपेक्षा("पहचान", "कार्य नाम अपेक्षित")
        स्वयं._अपेक्षा("(", "( अपेक्षित")

        चर पैरामीटर = []
        चर डिफ़ॉल्ट_आरम्भ = असत्य
        चर varargs_name = शून्य
        चर kwargs_name = शून्य
        यदि स्वयं._वर्तमान().प्रकार != ")":
            चर पैरामीटर_जारी = सत्य
            यावत् पैरामीटर_जारी:
                यदि स्वयं._वर्तमान().प्रकार == "*":
                    स्वयं.स्थिति = स्वयं.स्थिति + १
                    varargs_name = स्वयं._अपेक्षा("पहचान", "अनियत तर्क नाम अपेक्षित").मान
                    यदि स्वयं._वर्तमान().प्रकार == ",":
                        स्वयं.स्थिति = स्वयं.स्थिति + १
                        यदि स्वयं._वर्तमान().प्रकार == "**":
                            स्वयं.स्थिति = स्वयं.स्थिति + १
                            kwargs_name = स्वयं._अपेक्षा("पहचान", "नामित-संग्रह नाम अपेक्षित").मान
                    पैरामीटर_जारी = असत्य
                    अग्रे
                यदि स्वयं._वर्तमान().प्रकार == "**":
                    स्वयं.स्थिति = स्वयं.स्थिति + १
                    kwargs_name = स्वयं._अपेक्षा("पहचान", "नामित-संग्रह नाम अपेक्षित").मान
                    पैरामीटर_जारी = असत्य
                    अग्रे
                चर पैरामीटर_नाम = स्वयं._अपेक्षा("पहचान", "पैरामीटर नाम अपेक्षित")
                चर डिफ़ॉल्ट = शून्य
                यदि स्वयं._वर्तमान().प्रकार == "=":
                    स्वयं.स्थिति = स्वयं.स्थिति + १
                    डिफ़ॉल्ट = स्वयं._अभिव्यक्ति()
                    डिफ़ॉल्ट_आरम्भ = सत्य
                अन्यथा:
                    यदि डिफ़ॉल्ट_आरम्भ:
                        उत्क्षिप "native subset में default के बाद non-default पैरामीटर समर्थित नहीं हैं [पंक्ति " + पाठ_कर(स्वयं._वर्तमान().पंक्ति) + "]"
                पैरामीटर.जोड़ो({"name": पैरामीटर_नाम.मान, "default": डिफ़ॉल्ट})
                यदि स्वयं._वर्तमान().प्रकार == ",":
                    स्वयं.स्थिति = स्वयं.स्थिति + १
                अन्यथा:
                    पैरामीटर_जारी = असत्य

        स्वयं._अपेक्षा(")", ") अपेक्षित")
        स्वयं._अपेक्षा(":", ": अपेक्षित")
        स्वयं._अपेक्षा("NEWLINE", "कार्य शरीर के पहले NEWLINE अपेक्षित")
        स्वयं._अपेक्षा("INDENT", "कार्य शरीर के लिए INDENT अपेक्षित")

        चर शरीर = []
        चर _शरीर_सुरक्षा = ०
        यावत् स्वयं._वर्तमान().प्रकार != "DEDENT" और स्वयं._वर्तमान().प्रकार != "EOF" और _शरीर_सुरक्षा < १०००:
            _शरीर_सुरक्षा = _शरीर_सुरक्षा + १
            यावत् स्वयं._वर्तमान().प्रकार == "NEWLINE":
                स्वयं.स्थिति = स्वयं.स्थिति + १
            यदि स्वयं._वर्तमान().प्रकार == "DEDENT" अथवा स्वयं._वर्तमान().प्रकार == "EOF":
                विराम
            शरीर.जोड़ो(स्वयं._वाक्य())
            यावत् स्वयं._वर्तमान().प्रकार == "NEWLINE":
                स्वयं.स्थिति = स्वयं.स्थिति + १

        स्वयं._अपेक्षा("DEDENT", "कार्य शरीर के बाद DEDENT अपेक्षित")
        प्रत्यागच्छ {
            "kind": "function",
            "name": नाम.मान,
            "params": पैरामीटर,
            "varargs": varargs_name,
            "kwargs_name": kwargs_name,
            "body": शरीर
        }

    कर्म _वर्ग_वाक्य(स्वयं):
        स्वयं._अपेक्षा("वर्ग", "वर्ग अपेक्षित")
        चर नाम = स्वयं._अपेक्षा("पहचान", "वर्ग नाम अपेक्षित")
        चर superclass = शून्य
        यदि स्वयं._वर्तमान().प्रकार == "(":
            स्वयं.स्थिति = स्वयं.स्थिति + १
            यदि स्वयं._वर्तमान().प्रकार != ")":
                superclass = स्वयं._अभिव्यक्ति()
            स्वयं._अपेक्षा(")", ") अपेक्षित")
        चर शरीर = स्वयं._ब्लॉक()
        प्रत्यागच्छ {"kind": "class", "name": नाम.मान, "superclass": superclass, "body": शरीर}

    कर्म _चर_वाक्य(स्वयं):
        स्वयं._अपेक्षा("चर", "चर अपेक्षित")
        चर names = [स्वयं._अपेक्षा("पहचान", "चर नाम अपेक्षित").मान]
        यावत् स्वयं._वर्तमान().प्रकार == ",":
            स्वयं.स्थिति = स्वयं.स्थिति + १
            names.जोड़ो(स्वयं._अपेक्षा("पहचान", "चर नाम अपेक्षित").मान)
        स्वयं._अपेक्षा("=", "= अपेक्षित")
        चर अभिव्यक्ति = स्वयं._अभिव्यक्ति()
        प्रत्यागच्छ {"kind": "var", "names": names, "expr": अभिव्यक्ति}

    कर्म _वैश्विक_वाक्य(स्वयं):
        स्वयं._अपेक्षा("वैश्विक", "वैश्विक अपेक्षित")
        चर names = [स्वयं._अपेक्षा("पहचान", "वैश्विक नाम अपेक्षित").मान]
        यावत् स्वयं._वर्तमान().प्रकार == ",":
            स्वयं.स्थिति = स्वयं.स्थिति + १
            names.जोड़ो(स्वयं._अपेक्षा("पहचान", "वैश्विक नाम अपेक्षित").मान)
        प्रत्यागच्छ {"kind": "global", "names": names}

    कर्म _अस्थानिक_वाक्य(स्वयं):
        स्वयं._अपेक्षा("अस्थानिक", "अस्थानिक अपेक्षित")
        चर names = [स्वयं._अपेक्षा("पहचान", "अस्थानिक नाम अपेक्षित").मान]
        यावत् स्वयं._वर्तमान().प्रकार == ",":
            स्वयं.स्थिति = स्वयं.स्थिति + १
            names.जोड़ो(स्वयं._अपेक्षा("पहचान", "अस्थानिक नाम अपेक्षित").मान)
        प्रत्यागच्छ {"kind": "nonlocal", "names": names}

    कर्म _ब्लॉक(स्वयं):
        स्वयं._अपेक्षा(":", ": अपेक्षित")
        स्वयं._अपेक्षा("NEWLINE", "ब्लॉक के पहले NEWLINE अपेक्षित")
        स्वयं._अपेक्षा("INDENT", "ब्लॉक के लिए INDENT अपेक्षित")

        चर शरीर = []
        चर _शरीर_सुरक्षा = ०
        यावत् स्वयं._वर्तमान().प्रकार != "DEDENT" और स्वयं._वर्तमान().प्रकार != "EOF" और _शरीर_सुरक्षा < १०००:
            _शरीर_सुरक्षा = _शरीर_सुरक्षा + १
            यावत् स्वयं._वर्तमान().प्रकार == "NEWLINE":
                स्वयं.स्थिति = स्वयं.स्थिति + १
            यदि स्वयं._वर्तमान().प्रकार == "DEDENT" अथवा स्वयं._वर्तमान().प्रकार == "EOF":
                विराम
            शरीर.जोड़ो(स्वयं._वाक्य())
            यावत् स्वयं._वर्तमान().प्रकार == "NEWLINE":
                स्वयं.स्थिति = स्वयं.स्थिति + १

        स्वयं._अपेक्षा("DEDENT", "ब्लॉक के बाद DEDENT अपेक्षित")
        प्रत्यागच्छ शरीर

    कर्म _यदि_वाक्य(स्वयं):
        स्वयं._अपेक्षा("यदि", "यदि अपेक्षित")
        चर शर्त = स्वयं._अभिव्यक्ति()
        चर तब_शरीर = स्वयं._ब्लॉक()
        चर अन्यथा_शरीर = शून्य

        यावत् स्वयं._वर्तमान().प्रकार == "NEWLINE":
            स्वयं.स्थिति = स्वयं.स्थिति + १

        यदि स्वयं._वर्तमान().प्रकार == "अन्यथा":
            स्वयं._अपेक्षा("अन्यथा", "अन्यथा अपेक्षित")
            अन्यथा_शरीर = स्वयं._ब्लॉक()

        प्रत्यागच्छ {
            "kind": "if",
            "condition": शर्त,
            "then_body": तब_शरीर,
            "else_body": अन्यथा_शरीर
        }

    कर्म _यावत्_वाक्य(स्वयं):
        स्वयं._अपेक्षा("यावत्", "यावत् अपेक्षित")
        चर शर्त = स्वयं._अभिव्यक्ति()
        चर शरीर = स्वयं._ब्लॉक()
        प्रत्यागच्छ {"kind": "while", "condition": शर्त, "body": शरीर}

    कर्म _प्रत्येक_वाक्य(स्वयं):
        स्वयं._अपेक्षा("प्रत्येक", "प्रत्येक अपेक्षित")
        यदि स्वयं._वर्तमान().प्रकार == "चर":
            स्वयं.स्थिति = स्वयं.स्थिति + १
        चर var_names = [स्वयं._अपेक्षा("पहचान", "प्रत्येक चर नाम अपेक्षित").मान]
        यावत् स्वयं._वर्तमान().प्रकार == ",":
            स्वयं.स्थिति = स्वयं.स्थिति + १
            var_names.जोड़ो(स्वयं._अपेक्षा("पहचान", "प्रत्येक चर नाम अपेक्षित").मान)
        स्वयं._अपेक्षा("अन्तर्गत", "अन्तर्गत अपेक्षित")
        चर iterable = स्वयं._अभिव्यक्ति()
        चर शरीर = स्वयं._ब्लॉक()
        प्रत्यागच्छ {"kind": "for", "var_names": var_names, "iterable": iterable, "body": शरीर}

    कर्म _आयात_वाक्य(स्वयं):
        स्वयं._अपेक्षा("आयात", "आयात अपेक्षित")
        चर पहला = स्वयं._अपेक्षा("पहचान", "आयात नाम अपेक्षित")
        चर names = [पहला.मान]
        यावत् स्वयं._वर्तमान().प्रकार == ",":
            स्वयं.स्थिति = स्वयं.स्थिति + १
            names.जोड़ो(स्वयं._अपेक्षा("पहचान", "आयात नाम अपेक्षित").मान)

        यदि स्वयं._वर्तमान().प्रकार == "से":
            स्वयं.स्थिति = स्वयं.स्थिति + १
            चर module_parts = [स्वयं._अपेक्षा("पहचान", "मॉड्यूल नाम अपेक्षित").मान]
            यावत् स्वयं._वर्तमान().प्रकार == ".":
                स्वयं.स्थिति = स्वयं.स्थिति + १
                module_parts.जोड़ो(स्वयं._अपेक्षा("पहचान", "मॉड्यूल नाम अपेक्षित").मान)
            प्रत्यागच्छ {"kind": "import", "module": _डॉट_जोड़ो(module_parts), "names": names}

        यदि दीर्घता(names) > १:
            उत्क्षिप "native subset में अनेक नामों का आयात केवल 'से' रूप में समर्थित है [पंक्ति " + पाठ_कर(स्वयं._वर्तमान().पंक्ति) + "]"

        चर module_parts = [पहला.मान]
        यावत् स्वयं._वर्तमान().प्रकार == ".":
            स्वयं.स्थिति = स्वयं.स्थिति + १
            module_parts.जोड़ो(स्वयं._अपेक्षा("पहचान", "मॉड्यूल नाम अपेक्षित").मान)
        प्रत्यागच्छ {"kind": "import", "module": _डॉट_जोड़ो(module_parts), "names": शून्य}

    कर्म _मुद्रय_वाक्य(स्वयं):
        स्वयं._अपेक्षा("मुद्रय", "मुद्रय अपेक्षित")
        चर अभिव्यक्ति = स्वयं._अभिव्यक्ति()
        प्रत्यागच्छ {"kind": "print", "expr": अभिव्यक्ति}

    कर्म _प्रत्यागच्छ_वाक्य(स्वयं):
        स्वयं._अपेक्षा("प्रत्यागच्छ", "प्रत्यागच्छ अपेक्षित")
        चर अभिव्यक्ति = स्वयं._अभिव्यक्ति()
        प्रत्यागच्छ {"kind": "return", "expr": अभिव्यक्ति}

    कर्म _अभिव्यक्ति(स्वयं):
        प्रत्यागच्छ स्वयं._नियोजन()

    कर्म _नियोजन(स्वयं):
        चर बायाँ = स्वयं._तुलना()
        यदि स्वयं._वर्तमान().प्रकार == "=":
            स्वयं.स्थिति = स्वयं.स्थिति + १
            चर मान = स्वयं._नियोजन()
            प्रत्यागच्छ {"kind": "assign_expr", "target": बायाँ, "expr": मान}
        प्रत्यागच्छ बायाँ

    कर्म _तुलना(स्वयं):
        चर बायाँ = स्वयं._योग()
        चर चक्र_जारी = सत्य
        यावत् चक्र_जारी:
            यदि (
                स्वयं._वर्तमान().प्रकार == "=="
                अथवा स्वयं._वर्तमान().प्रकार == "!="
                अथवा स्वयं._वर्तमान().प्रकार == "<"
                अथवा स्वयं._वर्तमान().प्रकार == ">"
                अथवा स्वयं._वर्तमान().प्रकार == "<="
                अथवा स्वयं._वर्तमान().प्रकार == ">="
            ):
                चर संचालन = स्वयं._वर्तमान().प्रकार
                स्वयं.स्थिति = स्वयं.स्थिति + १
                चर दायाँ = स्वयं._योग()
                बायाँ = {"kind": "binary", "op": संचालन, "left": बायाँ, "right": दायाँ}
            अन्यथा:
                चक्र_जारी = असत्य
        प्रत्यागच्छ बायाँ

    कर्म _योग(स्वयं):
        चर बायाँ = स्वयं._गुणन()
        चर चक्र_जारी = सत्य
        यावत् चक्र_जारी:
            यदि स्वयं._वर्तमान().प्रकार == "+" अथवा स्वयं._वर्तमान().प्रकार == "-":
                चर संचालन = स्वयं._वर्तमान().प्रकार
                स्वयं.स्थिति = स्वयं.स्थिति + १
                चर दायाँ = स्वयं._गुणन()
                बायाँ = {"kind": "binary", "op": संचालन, "left": बायाँ, "right": दायाँ}
            अन्यथा:
                चक्र_जारी = असत्य
        प्रत्यागच्छ बायाँ

    कर्म _गुणन(स्वयं):
        चर बायाँ = स्वयं._आह्वान()
        चर चक्र_जारी = सत्य
        यावत् चक्र_जारी:
            यदि स्वयं._वर्तमान().प्रकार == "*" अथवा स्वयं._वर्तमान().प्रकार == "/":
                चर संचालन = स्वयं._वर्तमान().प्रकार
                स्वयं.स्थिति = स्वयं.स्थिति + १
                चर दायाँ = स्वयं._आह्वान()
                बायाँ = {"kind": "binary", "op": संचालन, "left": बायाँ, "right": दायाँ}
            अन्यथा:
                चक्र_जारी = असत्य
        प्रत्यागच्छ बायाँ

    कर्म _आह्वान(स्वयं):
        चर अभिव्यक्ति = स्वयं._प्राथमिक()
        चर चक्र_जारी = सत्य
        यावत् चक्र_जारी:
            यदि स्वयं._वर्तमान().प्रकार == "(":
                स्वयं.स्थिति = स्वयं.स्थिति + १
                चर तर्क = []
                चर kwargs = {}
                यदि स्वयं._वर्तमान().प्रकार != ")":
                    चर तर्क_जारी = सत्य
                    यावत् तर्क_जारी:
                        यदि स्वयं._वर्तमान().प्रकार == "पहचान" और स्वयं._झांको(१).प्रकार == "=":
                            चर kw_name = स्वयं._अपेक्षा("पहचान", "नामित तर्क नाम अपेक्षित").मान
                            स्वयं._अपेक्षा("=", "= अपेक्षित")
                            kwargs[kw_name] = स्वयं._अभिव्यक्ति()
                        अन्यथा:
                            तर्क.जोड़ो(स्वयं._अभिव्यक्ति())
                        यदि स्वयं._वर्तमान().प्रकार == ",":
                            स्वयं.स्थिति = स्वयं.स्थिति + १
                        अन्यथा:
                            तर्क_जारी = असत्य
                स्वयं._अपेक्षा(")", ") अपेक्षित")
                अभिव्यक्ति = {"kind": "call", "callee": अभिव्यक्ति, "args": तर्क, "kwargs": kwargs}
            अन्यथा यदि स्वयं._वर्तमान().प्रकार == ".":
                स्वयं.स्थिति = स्वयं.स्थिति + १
                चर attr = स्वयं._अपेक्षा("पहचान", "सदस्य नाम अपेक्षित")
                अभिव्यक्ति = {"kind": "member", "obj": अभिव्यक्ति, "attr": attr.मान}
            अन्यथा यदि स्वयं._वर्तमान().प्रकार == "[":
                स्वयं.स्थिति = स्वयं.स्थिति + 1
                चर index = स्वयं._अभिव्यक्ति()
                स्वयं._अपेक्षा("]", "] अपेक्षित")
                अभिव्यक्ति = {"kind": "index", "obj": अभिव्यक्ति, "index": index}
            अन्यथा:
                चक्र_जारी = असत्य
        प्रत्यागच्छ अभिव्यक्ति

    कर्म _प्राथमिक(स्वयं):
        यदि स्वयं._वर्तमान().प्रकार == "संख्या":
            चर टोकन = स्वयं._वर्तमान()
            स्वयं.स्थिति = स्वयं.स्थिति + १
            प्रत्यागच्छ {"kind": "number", "value": टोकन.मान}
        यदि स्वयं._वर्तमान().प्रकार == "तार":
            चर टोकन = स्वयं._वर्तमान()
            स्वयं.स्थिति = स्वयं.स्थिति + १
            प्रत्यागच्छ {"kind": "string", "value": टोकन.मान}
        यदि स्वयं._वर्तमान().प्रकार == "पहचान":
            चर टोकन = स्वयं._वर्तमान()
            स्वयं.स्थिति = स्वयं.स्थिति + १
            यदि टोकन.मान == "सत्य":
                प्रत्यागच्छ {"kind": "bool", "value": सत्य}
            यदि टोकन.मान == "असत्य":
                प्रत्यागच्छ {"kind": "bool", "value": असत्य}
            यदि टोकन.मान == "शून्य":
                प्रत्यागच्छ {"kind": "null", "value": शून्य}
            प्रत्यागच्छ {"kind": "identifier", "name": टोकन.मान}
        यदि स्वयं._वर्तमान().प्रकार == "(":
            स्वयं.स्थिति = स्वयं.स्थिति + १
            यदि स्वयं._वर्तमान().प्रकार == ")":
                स्वयं.स्थिति = स्वयं.स्थिति + १
                प्रत्यागच्छ {"kind": "tuple", "elements": []}
            चर अभिव्यक्ति = स्वयं._अभिव्यक्ति()
            यदि स्वयं._वर्तमान().प्रकार == ",":
                चर elements = [अभिव्यक्ति]
                यावत् स्वयं._वर्तमान().प्रकार == ",":
                    स्वयं.स्थिति = स्वयं.स्थिति + १
                    यदि स्वयं._वर्तमान().प्रकार == ")":
                        विराम
                    elements.जोड़ो(स्वयं._अभिव्यक्ति())
                स्वयं._अपेक्षा(")", ") अपेक्षित")
                प्रत्यागच्छ {"kind": "tuple", "elements": elements}
            स्वयं._अपेक्षा(")", ") अपेक्षित")
            प्रत्यागच्छ अभिव्यक्ति
        यदि स्वयं._वर्तमान().प्रकार == "[":
            स्वयं.स्थिति = स्वयं.स्थिति + १
            चर elements = []
            यदि स्वयं._वर्तमान().प्रकार != "]":
                चर सूची_चलू = सत्य
                यावत् सूची_चलू:
                    elements.जोड़ो(स्वयं._अभिव्यक्ति())
                    यदि स्वयं._वर्तमान().प्रकार == ",":
                        स्वयं.स्थिति = स्वयं.स्थिति + १
                    अन्यथा:
                        सूची_चलू = असत्य
            स्वयं._अपेक्षा("]", "] अपेक्षित")
            प्रत्यागच्छ {"kind": "list", "elements": elements}
        यदि स्वयं._वर्तमान().प्रकार == "{":
            स्वयं.स्थिति = स्वयं.स्थिति + १
            यदि स्वयं._वर्तमान().प्रकार == "}":
                स्वयं.स्थिति = स्वयं.स्थिति + १
                प्रत्यागच्छ {"kind": "dict", "pairs": []}
            चर पहला = स्वयं._अभिव्यक्ति()
            यदि स्वयं._वर्तमान().प्रकार == ":":
                चर pairs = []
                चर युग्म_चलू = सत्य
                यावत् युग्म_चलू:
                    स्वयं._अपेक्षा(":", ": अपेक्षित")
                    चर value = स्वयं._अभिव्यक्ति()
                    pairs.जोड़ो({"key": पहला, "value": value})
                    यदि स्वयं._वर्तमान().प्रकार == ",":
                        स्वयं.स्थिति = स्वयं.स्थिति + १
                        यदि स्वयं._वर्तमान().प्रकार == "}":
                            युग्म_चलू = असत्य
                        अन्यथा:
                            पहला = स्वयं._अभिव्यक्ति()
                    अन्यथा:
                        युग्म_चलू = असत्य
                स्वयं._अपेक्षा("}", "} अपेक्षित")
                प्रत्यागच्छ {"kind": "dict", "pairs": pairs}
            चर elements = [पहला]
            चर सेट_चलू = सत्य
            यावत् सेट_चलू:
                यदि स्वयं._वर्तमान().प्रकार == ",":
                    स्वयं.स्थिति = स्वयं.स्थिति + १
                    यदि स्वयं._वर्तमान().प्रकार == "}":
                        सेट_चलू = असत्य
                    अन्यथा:
                        elements.जोड़ो(स्वयं._अभिव्यक्ति())
                अन्यथा:
                    सेट_चलू = असत्य
            स्वयं._अपेक्षा("}", "} अपेक्षित")
            प्रत्यागच्छ {"kind": "set", "elements": elements}
        उत्क्षिप "असमर्थित native अभिव्यक्ति: " + स्वयं._वर्तमान().प्रकार + " [पंक्ति " + पाठ_कर(स्वयं._वर्तमान().पंक्ति) + "]"


कर्म _पर्यावरण_मान(नाम, डिफ़ॉल्ट=""):
    चर मान = _पायथन_ओएस.getenv(नाम, डिफ़ॉल्ट)
    यदि मान == शून्य:
        प्रत्यागच्छ डिफ़ॉल्ट
    प्रत्यागच्छ मान


कर्म _डॉट_जोड़ो(भाग):
    यदि दीर्घता(भाग) == ०:
        प्रत्यागच्छ ""
    चर result = भाग[०]
    चर i = १
    यावत् i < दीर्घता(भाग):
        result = result + "." + भाग[i]
        i = i + १
    प्रत्यागच्छ result


कर्म _सूची_अन्तर्गत(सूची, मान):
    चर i = ०
    यावत् i < दीर्घता(सूची):
        यदि सूची[i] == मान:
            प्रत्यागच्छ सत्य
        i = i + १
    प्रत्यागच्छ असत्य


कर्म _सूची_जोड़ो_यदि_न(सूची, मान):
    यदि न _सूची_अन्तर्गत(सूची, मान):
        सूची.जोड़ो(मान)


कर्म _किसी_क्षेत्र_में(क्षेत्र_श्रृंखला, नाम):
    चर i = दीर्घता(क्षेत्र_श्रृंखला) - १
    यावत् i >= ०:
        यदि _सूची_अन्तर्गत(क्षेत्र_श्रृंखला[i], नाम):
            प्रत्यागच्छ सत्य
        i = i - १
    प्रत्यागच्छ असत्य


कर्म _लक्ष्य_से_नाम_जोड़ो(लक्ष्य, बन्धन, global_list, nonlocal_list):
    यदि लक्ष्य["kind"] == "identifier":
        यदि न _सूची_अन्तर्गत(global_list, लक्ष्य["name"]) और न _सूची_अन्तर्गत(nonlocal_list, लक्ष्य["name"]):
            _सूची_जोड़ो_यदि_न(बन्धन, लक्ष्य["name"])


कर्म _स्वदेशी_क्षेत्र_निर्देश_संग्रह(वाक्य_सूची, global_list, nonlocal_list):
    प्रत्येक चर वाक्य अन्तर्गत वाक्य_सूची:
        यदि वाक्य["kind"] == "global":
            प्रत्येक चर नाम अन्तर्गत वाक्य["names"]:
                _सूची_जोड़ो_यदि_न(global_list, नाम)
            अग्रे
        यदि वाक्य["kind"] == "nonlocal":
            प्रत्येक चर नाम अन्तर्गत वाक्य["names"]:
                _सूची_जोड़ो_यदि_न(nonlocal_list, नाम)
            अग्रे
        यदि (
            वाक्य["kind"] == "function"
            अथवा वाक्य["kind"] == "class"
        ):
            अग्रे
        यदि वाक्य["kind"] == "if":
            _स्वदेशी_क्षेत्र_निर्देश_संग्रह(वाक्य["then_body"], global_list, nonlocal_list)
            यदि वाक्य["else_body"] != शून्य:
                _स्वदेशी_क्षेत्र_निर्देश_संग्रह(वाक्य["else_body"], global_list, nonlocal_list)
            अग्रे
        यदि वाक्य["kind"] == "while" अथवा वाक्य["kind"] == "for":
            _स्वदेशी_क्षेत्र_निर्देश_संग्रह(वाक्य["body"], global_list, nonlocal_list)


कर्म _स्वदेशी_बन्धन_संग्रह(वाक्य_सूची, बन्धन, global_list, nonlocal_list):
    प्रत्येक चर वाक्य अन्तर्गत वाक्य_सूची:
        यदि वाक्य["kind"] == "function" अथवा वाक्य["kind"] == "class":
            यदि न _सूची_अन्तर्गत(global_list, वाक्य["name"]) और न _सूची_अन्तर्गत(nonlocal_list, वाक्य["name"]):
                _सूची_जोड़ो_यदि_न(बन्धन, वाक्य["name"])
            अग्रे
        यदि वाक्य["kind"] == "var":
            प्रत्येक चर नाम अन्तर्गत वाक्य["names"]:
                यदि न _सूची_अन्तर्गत(global_list, नाम) और न _सूची_अन्तर्गत(nonlocal_list, नाम):
                    _सूची_जोड़ो_यदि_न(बन्धन, नाम)
            अग्रे
        यदि वाक्य["kind"] == "assign":
            यदि न _सूची_अन्तर्गत(global_list, वाक्य["name"]) और न _सूची_अन्तर्गत(nonlocal_list, वाक्य["name"]):
                _सूची_जोड़ो_यदि_न(बन्धन, वाक्य["name"])
            अग्रे
        यदि वाक्य["kind"] == "expr":
            यदि वाक्य["expr"]["kind"] == "assign_expr":
                _लक्ष्य_से_नाम_जोड़ो(वाक्य["expr"]["target"], बन्धन, global_list, nonlocal_list)
            अग्रे
        यदि वाक्य["kind"] == "for":
            प्रत्येक चर नाम अन्तर्गत वाक्य["var_names"]:
                यदि न _सूची_अन्तर्गत(global_list, नाम) और न _सूची_अन्तर्गत(nonlocal_list, नाम):
                    _सूची_जोड़ो_यदि_न(बन्धन, नाम)
            _स्वदेशी_बन्धन_संग्रह(वाक्य["body"], बन्धन, global_list, nonlocal_list)
            अग्रे
        यदि वाक्य["kind"] == "import":
            यदि वाक्य["names"] != शून्य:
                प्रत्येक चर नाम अन्तर्गत वाक्य["names"]:
                    यदि न _सूची_अन्तर्गत(global_list, नाम) और न _सूची_अन्तर्गत(nonlocal_list, नाम):
                        _सूची_जोड़ो_यदि_न(बन्धन, नाम)
            अन्यथा:
                यदि न _सूची_अन्तर्गत(global_list, वाक्य["module"]) और न _सूची_अन्तर्गत(nonlocal_list, वाक्य["module"]):
                    _सूची_जोड़ो_यदि_न(बन्धन, वाक्य["module"])
            अग्रे
        यदि वाक्य["kind"] == "if":
            _स्वदेशी_बन्धन_संग्रह(वाक्य["then_body"], बन्धन, global_list, nonlocal_list)
            यदि वाक्य["else_body"] != शून्य:
                _स्वदेशी_बन्धन_संग्रह(वाक्य["else_body"], बन्धन, global_list, nonlocal_list)
            अग्रे
        यदि वाक्य["kind"] == "while":
            _स्वदेशी_बन्धन_संग्रह(वाक्य["body"], बन्धन, global_list, nonlocal_list)


कर्म _स्वदेशी_प्रयुक्त_नाम_संग्रह_अभिव्यक्ति(अभिव्यक्ति, प्रयुक्त):
    यदि अभिव्यक्ति == शून्य:
        प्रत्यागच्छ
    यदि अभिव्यक्ति["kind"] == "identifier":
        _सूची_जोड़ो_यदि_न(प्रयुक्त, अभिव्यक्ति["name"])
        प्रत्यागच्छ
    यदि अभिव्यक्ति["kind"] == "call":
        _स्वदेशी_प्रयुक्त_नाम_संग्रह_अभिव्यक्ति(अभिव्यक्ति["callee"], प्रयुक्त)
        प्रत्येक चर तर्क अन्तर्गत अभिव्यक्ति["args"]:
            _स्वदेशी_प्रयुक्त_नाम_संग्रह_अभिव्यक्ति(तर्क, प्रयुक्त)
        प्रत्येक चर kw_name अन्तर्गत अभिव्यक्ति["kwargs"]:
            _स्वदेशी_प्रयुक्त_नाम_संग्रह_अभिव्यक्ति(अभिव्यक्ति["kwargs"][kw_name], प्रयुक्त)
        प्रत्यागच्छ
    यदि अभिव्यक्ति["kind"] == "member":
        _स्वदेशी_प्रयुक्त_नाम_संग्रह_अभिव्यक्ति(अभिव्यक्ति["obj"], प्रयुक्त)
        प्रत्यागच्छ
    यदि अभिव्यक्ति["kind"] == "index":
        _स्वदेशी_प्रयुक्त_नाम_संग्रह_अभिव्यक्ति(अभिव्यक्ति["obj"], प्रयुक्त)
        _स्वदेशी_प्रयुक्त_नाम_संग्रह_अभिव्यक्ति(अभिव्यक्ति["index"], प्रयुक्त)
        प्रत्यागच्छ
    यदि अभिव्यक्ति["kind"] == "assign_expr":
        _स्वदेशी_प्रयुक्त_नाम_संग्रह_अभिव्यक्ति(अभिव्यक्ति["target"], प्रयुक्त)
        _स्वदेशी_प्रयुक्त_नाम_संग्रह_अभिव्यक्ति(अभिव्यक्ति["expr"], प्रयुक्त)
        प्रत्यागच्छ
    यदि अभिव्यक्ति["kind"] == "binary":
        _स्वदेशी_प्रयुक्त_नाम_संग्रह_अभिव्यक्ति(अभिव्यक्ति["left"], प्रयुक्त)
        _स्वदेशी_प्रयुक्त_नाम_संग्रह_अभिव्यक्ति(अभिव्यक्ति["right"], प्रयुक्त)
        प्रत्यागच्छ
    यदि अभिव्यक्ति["kind"] == "list" अथवा अभिव्यक्ति["kind"] == "tuple" अथवा अभिव्यक्ति["kind"] == "set":
        प्रत्येक चर तत्व अन्तर्गत अभिव्यक्ति["elements"]:
            _स्वदेशी_प्रयुक्त_नाम_संग्रह_अभिव्यक्ति(तत्व, प्रयुक्त)
        प्रत्यागच्छ
    यदि अभिव्यक्ति["kind"] == "dict":
        प्रत्येक चर युग्म अन्तर्गत अभिव्यक्ति["pairs"]:
            _स्वदेशी_प्रयुक्त_नाम_संग्रह_अभिव्यक्ति(युग्म["key"], प्रयुक्त)
            _स्वदेशी_प्रयुक्त_नाम_संग्रह_अभिव्यक्ति(युग्म["value"], प्रयुक्त)


कर्म _स्वदेशी_प्रयुक्त_नाम_संग्रह(वाक्य_सूची, प्रयुक्त):
    प्रत्येक चर वाक्य अन्तर्गत वाक्य_सूची:
        यदि वाक्य["kind"] == "function" अथवा वाक्य["kind"] == "class":
            अग्रे
        यदि वाक्य["kind"] == "var":
            _स्वदेशी_प्रयुक्त_नाम_संग्रह_अभिव्यक्ति(वाक्य["expr"], प्रयुक्त)
            अग्रे
        यदि वाक्य["kind"] == "assign":
            _सूची_जोड़ो_यदि_न(प्रयुक्त, वाक्य["name"])
            _स्वदेशी_प्रयुक्त_नाम_संग्रह_अभिव्यक्ति(वाक्य["expr"], प्रयुक्त)
            अग्रे
        यदि वाक्य["kind"] == "expr":
            _स्वदेशी_प्रयुक्त_नाम_संग्रह_अभिव्यक्ति(वाक्य["expr"], प्रयुक्त)
            अग्रे
        यदि वाक्य["kind"] == "print" अथवा वाक्य["kind"] == "return":
            _स्वदेशी_प्रयुक्त_नाम_संग्रह_अभिव्यक्ति(वाक्य["expr"], प्रयुक्त)
            अग्रे
        यदि वाक्य["kind"] == "if":
            _स्वदेशी_प्रयुक्त_नाम_संग्रह_अभिव्यक्ति(वाक्य["condition"], प्रयुक्त)
            _स्वदेशी_प्रयुक्त_नाम_संग्रह(वाक्य["then_body"], प्रयुक्त)
            यदि वाक्य["else_body"] != शून्य:
                _स्वदेशी_प्रयुक्त_नाम_संग्रह(वाक्य["else_body"], प्रयुक्त)
            अग्रे
        यदि वाक्य["kind"] == "while":
            _स्वदेशी_प्रयुक्त_नाम_संग्रह_अभिव्यक्ति(वाक्य["condition"], प्रयुक्त)
            _स्वदेशी_प्रयुक्त_नाम_संग्रह(वाक्य["body"], प्रयुक्त)
            अग्रे
        यदि वाक्य["kind"] == "for":
            _स्वदेशी_प्रयुक्त_नाम_संग्रह_अभिव्यक्ति(वाक्य["iterable"], प्रयुक्त)
            _स्वदेशी_प्रयुक्त_नाम_संग्रह(वाक्य["body"], प्रयुक्त)
            अग्रे
        यदि वाक्य["kind"] == "import":
            अग्रे


कर्म _स्वदेशी_कार्य_क्षेत्र_विश्लेषण(पैरामीटर, varargs_name, kwargs_name, शरीर, enclosing_scopes):
    चर global_list = []
    चर nonlocal_list = []
    _स्वदेशी_क्षेत्र_निर्देश_संग्रह(शरीर, global_list, nonlocal_list)

    चर local_names = []
    प्रत्येक चर पैरामीटर_विवरण अन्तर्गत पैरामीटर:
        _सूची_जोड़ो_यदि_न(local_names, पैरामीटर_विवरण["name"])
    यदि varargs_name != शून्य:
        _सूची_जोड़ो_यदि_न(local_names, varargs_name)
    यदि kwargs_name != शून्य:
        _सूची_जोड़ो_यदि_न(local_names, kwargs_name)

    _स्वदेशी_बन्धन_संग्रह(शरीर, local_names, global_list, nonlocal_list)

    चर प्रयुक्त = []
    _स्वदेशी_प्रयुक्त_नाम_संग्रह(शरीर, प्रयुक्त)

    चर closure_names = []
    प्रत्येक चर नाम अन्तर्गत प्रयुक्त:
        यदि (
            न _सूची_अन्तर्गत(local_names, नाम)
            और न _सूची_अन्तर्गत(global_list, नाम)
            और _किसी_क्षेत्र_में(enclosing_scopes, नाम)
        ):
            _सूची_जोड़ो_यदि_न(closure_names, नाम)
    प्रत्येक चर नाम अन्तर्गत nonlocal_list:
        _सूची_जोड़ो_यदि_न(closure_names, नाम)

    प्रत्यागच्छ {
        "global_names": global_list,
        "nonlocal_names": nonlocal_list,
        "local_names": local_names,
        "closure_names": closure_names
    }


कर्म _स्रोत_पथ(पथ):
    प्रत्यागच्छ _पायथन_पथलिब.Path(पथ).resolve()


कर्म _हैश_करो(पथ_वस्तु):
    प्रत्यागच्छ _पायथन_पुरातन_पृष्ठ._sha256(पाठ_कर(पथ_वस्तु))


कर्म _बूटस्ट्रैप_रिपोर्ट(स्रोत_वस्तु, निर्गत_वस्तु, साथी_वस्तु, बाइटकोड):
    प्रत्यागच्छ {
        "source_path": पाठ_कर(स्रोत_वस्तु),
        "compiled_path": पाठ_कर(निर्गत_वस्तु),
        "meta_path": पाठ_कर(साथी_वस्तु),
        "byte_hash": _हैश_करो(निर्गत_वस्तु),
        "meta_hash": _हैश_करो(साथी_वस्तु),
        "code_bytes": दीर्घता(बाइटकोड.code),
        "constants": दीर्घता(बाइटकोड.constants)
    }


कर्म बूटस्ट्रैप_संकलन(स्रोत_पथ, निर्गत_पथ):
    चर स्रोत_वस्तु = _स्रोत_पथ(स्रोत_पथ)
    चर निर्गत_वस्तु = _स्रोत_पथ(निर्गत_पथ)
    यदि न स्रोत_वस्तु.exists():
        उत्क्षिप "स्रोत फ़ाइल नहीं मिली: " + पाठ_कर(स्रोत_वस्तु)

    प्रत्यागच्छ _पायथन_पुरातन_पृष्ठ.compile_file_to_artifact(
        पाठ_कर(स्रोत_वस्तु),
        पाठ_कर(निर्गत_वस्तु)
    )


कर्म बूटस्ट्रैप_पुनरुत्पादन(स्रोत_पथ, निर्गत_पहला, निर्गत_दूसरा):
    प्रत्यागच्छ _पायथन_पुरातन_पृष्ठ.reproduce_file_to_artifacts(
        पाठ_कर(_स्रोत_पथ(स्रोत_पथ)),
        पाठ_कर(_स्रोत_पथ(निर्गत_पहला)),
        पाठ_कर(_स्रोत_पथ(निर्गत_दूसरा))
    )


कर्म असेंबली_विशेष_पढ़ो(विशेष_पथ):
    चर विशेष_वस्तु = _स्रोत_पथ(विशेष_पथ)
    यदि न विशेष_वस्तु.exists():
        उत्क्षिप "असेंबली विशेष फ़ाइल नहीं मिली: " + पाठ_कर(विशेष_वस्तु)
    चर सामग्री = विशेष_वस्तु.read_text(encoding="utf-8")
    चर विशेष = जेसन_पढ़ो(सामग्री)
    यदि न ("instructions" अन्तर्गत विशेष):
        उत्क्षिप "असेंबली विशेष में instructions अपेक्षित हैं"
    प्रत्यागच्छ विशेष


कर्म असेंबली_संकलन(विशेष_पथ, निर्गत_पथ):
    चर विशेष = असेंबली_विशेष_पढ़ो(विशेष_पथ)
    चर निर्गत_वस्तु = _स्रोत_पथ(निर्गत_पथ)
    प्रत्यागच्छ _पायथन_पुरातन_पृष्ठ.assemble_spec_to_artifact(
        विशेष,
        पाठ_कर(निर्गत_वस्तु)
    )


कर्म _रिक्त_विशेष(स्रोत_पथ):
    प्रत्यागच्छ {
        "name": "<module>",
        "source_path": स्रोत_पथ,
        "constants": [],
        "var_names": [],
        "param_names": [],
        "defaults": [],
        "varargs_name": शून्य,
        "num_params": ०,
        "global_names": [],
        "nonlocal_names": [],
        "local_names": [],
        "closure_names": [],
        "type_hints": {},
        "is_async": असत्य,
        "functions": {},
        "instructions": []
    }


कर्म _स्थिर_जोड़ो(विशेष, मान):
    चर सूची = विशेष["constants"]
    चर i = ०
    यावत् i < दीर्घता(सूची):
        यदि सूची[i] == मान:
            प्रत्यागच्छ i
        i = i + १
    सूची.जोड़ो(मान)
    प्रत्यागच्छ दीर्घता(सूची) - १


कर्म _चर_स्थान(विशेष, नाम):
    चर सूची = विशेष["var_names"]
    चर i = ०
    यावत् i < दीर्घता(सूची):
        यदि सूची[i] == नाम:
            प्रत्यागच्छ i
        i = i + १
    सूची.जोड़ो(नाम)
    प्रत्यागच्छ दीर्घता(सूची) - १


कर्म _emit०(विशेष, op):
    विशेष["instructions"].जोड़ो({"op": op})


कर्म _emit१(विशेष, op, operand):
    विशेष["instructions"].जोड़ो({"op": op, "operand": operand})


कर्म _emit१६(विशेष, op, operand):
    विशेष["instructions"].जोड़ो({"op": op, "operand": operand, "width": 16})


कर्म _निर्देश_आकार(निर्देश):
    यदि "label" अन्तर्गत निर्देश:
        प्रत्यागच्छ ०
    यदि "width" अन्तर्गत निर्देश:
        यदि निर्देश["width"] == 16:
            प्रत्यागच्छ ३
    यदि निर्देश["op"] == "LOAD_CONST" अथवा निर्देश["op"] == "JUMP" अथवा निर्देश["op"] == "JUMP_IF_FALSE":
        प्रत्यागच्छ ३
    यदि "operand" अन्तर्गत निर्देश:
        प्रत्यागच्छ २
    प्रत्यागच्छ १


कर्म _नया_लेबल(विशेष):
    यदि न ("label_counter" अन्तर्गत विशेष):
        विशेष["label_counter"] = ०
    चर label = "__L" + पाठ_कर(विशेष["label_counter"])
    विशेष["label_counter"] = विशेष["label_counter"] + १
    प्रत्यागच्छ label


कर्म _emit_लेबल(विशेष, label):
    विशेष["instructions"].जोड़ो({"label": label})


कर्म _emit_कूद(विशेष, op, label):
    विशेष["instructions"].जोड़ो({"op": op, "target_label": label, "width": 16})


कर्म _अंतिम_ऑप(निर्देश_सूची):
    चर i = दीर्घता(निर्देश_सूची) - १
    यावत् i >= ०:
        यदि "op" अन्तर्गत निर्देश_सूची[i]:
            प्रत्यागच्छ निर्देश_सूची[i]["op"]
        i = i - १
    प्रत्यागच्छ ""


कर्म _अन्तिम_निर्देश(विशेष):
    प्रत्येक चर कार्य_नाम अन्तर्गत विशेष["functions"]:
        _अन्तिम_निर्देश(विशेष["functions"][कार्य_नाम])

    चर labels = {}
    चर offset = ०
    प्रत्येक चर निर्देश अन्तर्गत विशेष["instructions"]:
        यदि "label" अन्तर्गत निर्देश:
            labels[निर्देश["label"]] = offset
        अन्यथा:
            offset = offset + _निर्देश_आकार(निर्देश)

    चर अंतिम = []
    offset = ०
    प्रत्येक चर निर्देश अन्तर्गत विशेष["instructions"]:
        यदि "label" अन्तर्गत निर्देश:
            अग्रे
        यदि "target_label" अन्तर्गत निर्देश:
            चर target = labels[निर्देश["target_label"]]
            चर patched = {"op": निर्देश["op"], "operand": target - (offset + ३), "width": 16}
            अंतिम.जोड़ो(patched)
            offset = offset + _निर्देश_आकार(patched)
        अन्यथा:
            अंतिम.जोड़ो(निर्देश)
            offset = offset + _निर्देश_आकार(निर्देश)
    विशेष["instructions"] = अंतिम


कर्म _स्वदेशी_अभिव्यक्ति_संकलन(विशेष, अभिव्यक्ति):
    यदि अभिव्यक्ति["kind"] == "number":
        चर idx = _स्थिर_जोड़ो(विशेष, अभिव्यक्ति["value"])
        _emit१६(विशेष, "LOAD_CONST", idx)
        प्रत्यागच्छ
    यदि अभिव्यक्ति["kind"] == "string":
        चर idx = _स्थिर_जोड़ो(विशेष, अभिव्यक्ति["value"])
        _emit१६(विशेष, "LOAD_CONST", idx)
        प्रत्यागच्छ
    यदि अभिव्यक्ति["kind"] == "bool":
        चर idx = _स्थिर_जोड़ो(विशेष, अभिव्यक्ति["value"])
        _emit१६(विशेष, "LOAD_CONST", idx)
        प्रत्यागच्छ
    यदि अभिव्यक्ति["kind"] == "null":
        चर idx = _स्थिर_जोड़ो(विशेष, शून्य)
        _emit१६(विशेष, "LOAD_CONST", idx)
        प्रत्यागच्छ
    यदि अभिव्यक्ति["kind"] == "identifier":
        चर slot = _चर_स्थान(विशेष, अभिव्यक्ति["name"])
        _emit१(विशेष, "LOAD_VAR", slot)
        प्रत्यागच्छ
    यदि अभिव्यक्ति["kind"] == "call":
        चर method_call = अभिव्यक्ति["callee"]["kind"] == "member"
        यदि method_call:
            _स्वदेशी_अभिव्यक्ति_संकलन(विशेष, अभिव्यक्ति["callee"]["obj"])
            चर method_idx = _स्थिर_जोड़ो(विशेष, अभिव्यक्ति["callee"]["attr"])
            _emit१६(विशेष, "LOAD_CONST", method_idx)
        अन्यथा:
            _स्वदेशी_अभिव्यक्ति_संकलन(विशेष, अभिव्यक्ति["callee"])
        प्रत्येक चर तर्क अन्तर्गत अभिव्यक्ति["args"]:
            _स्वदेशी_अभिव्यक्ति_संकलन(विशेष, तर्क)
        यदि दीर्घता(अभिव्यक्ति["kwargs"]) > ०:
            प्रत्येक चर kw_name अन्तर्गत अभिव्यक्ति["kwargs"]:
                _स्वदेशी_अभिव्यक्ति_संकलन(विशेष, अभिव्यक्ति["kwargs"][kw_name])
                चर kw_idx = _स्थिर_जोड़ो(विशेष, kw_name)
                _emit१६(विशेष, "LOAD_CONST", kw_idx)
            _emit१(विशेष, "BUILD_DICT", दीर्घता(अभिव्यक्ति["kwargs"]))
            यदि method_call:
                _emit१(विशेष, "CALL_METHOD_KW", दीर्घता(अभिव्यक्ति["args"]))
            अन्यथा:
                _emit१(विशेष, "CALL_KW", दीर्घता(अभिव्यक्ति["args"]))
        अन्यथा:
            यदि method_call:
                _emit१(विशेष, "CALL_METHOD", दीर्घता(अभिव्यक्ति["args"]))
            अन्यथा:
                _emit१(विशेष, "CALL", दीर्घता(अभिव्यक्ति["args"]))
        प्रत्यागच्छ
    यदि अभिव्यक्ति["kind"] == "list":
        प्रत्येक चर तत्व अन्तर्गत अभिव्यक्ति["elements"]:
            _स्वदेशी_अभिव्यक्ति_संकलन(विशेष, तत्व)
        _emit१(विशेष, "BUILD_LIST", दीर्घता(अभिव्यक्ति["elements"]))
        प्रत्यागच्छ
    यदि अभिव्यक्ति["kind"] == "dict":
        प्रत्येक चर युग्म अन्तर्गत अभिव्यक्ति["pairs"]:
            _स्वदेशी_अभिव्यक्ति_संकलन(विशेष, युग्म["value"])
            _स्वदेशी_अभिव्यक्ति_संकलन(विशेष, युग्म["key"])
        _emit१(विशेष, "BUILD_DICT", दीर्घता(अभिव्यक्ति["pairs"]))
        प्रत्यागच्छ
    यदि अभिव्यक्ति["kind"] == "set":
        प्रत्येक चर तत्व अन्तर्गत अभिव्यक्ति["elements"]:
            _स्वदेशी_अभिव्यक्ति_संकलन(विशेष, तत्व)
        _emit१(विशेष, "BUILD_SET", दीर्घता(अभिव्यक्ति["elements"]))
        प्रत्यागच्छ
    यदि अभिव्यक्ति["kind"] == "tuple":
        प्रत्येक चर तत्व अन्तर्गत अभिव्यक्ति["elements"]:
            _स्वदेशी_अभिव्यक्ति_संकलन(विशेष, तत्व)
        _emit१(विशेष, "BUILD_TUPLE", दीर्घता(अभिव्यक्ति["elements"]))
        प्रत्यागच्छ
    यदि अभिव्यक्ति["kind"] == "index":
        _स्वदेशी_अभिव्यक्ति_संकलन(विशेष, अभिव्यक्ति["obj"])
        _स्वदेशी_अभिव्यक्ति_संकलन(विशेष, अभिव्यक्ति["index"])
        _emit०(विशेष, "INDEX_GET")
        प्रत्यागच्छ
    यदि अभिव्यक्ति["kind"] == "member":
        _स्वदेशी_अभिव्यक्ति_संकलन(विशेष, अभिव्यक्ति["obj"])
        चर attr_idx = _स्थिर_जोड़ो(विशेष, अभिव्यक्ति["attr"])
        _emit१६(विशेष, "ATTR_GET", attr_idx)
        प्रत्यागच्छ
    यदि अभिव्यक्ति["kind"] == "assign_expr":
        _स्वदेशी_अभिव्यक्ति_संकलन(विशेष, अभिव्यक्ति["expr"])
        यदि अभिव्यक्ति["target"]["kind"] == "identifier":
            चर slot = _चर_स्थान(विशेष, अभिव्यक्ति["target"]["name"])
            _emit१(विशेष, "STORE_VAR", slot)
            _emit१(विशेष, "LOAD_VAR", slot)
            प्रत्यागच्छ
        चर temp_slot = _चर_स्थान(विशेष, "__temp_assign_val")
        यदि विशेष["name"] != "<module>":
            _सूची_जोड़ो_यदि_न(विशेष["local_names"], "__temp_assign_val")
        _emit१(विशेष, "STORE_VAR", temp_slot)
        यदि अभिव्यक्ति["target"]["kind"] == "member":
            _स्वदेशी_अभिव्यक्ति_संकलन(विशेष, अभिव्यक्ति["target"]["obj"])
            _emit१(विशेष, "LOAD_VAR", temp_slot)
            चर attr_idx = _स्थिर_जोड़ो(विशेष, अभिव्यक्ति["target"]["attr"])
            _emit१६(विशेष, "ATTR_SET", attr_idx)
            _emit१(विशेष, "LOAD_VAR", temp_slot)
            प्रत्यागच्छ
        यदि अभिव्यक्ति["target"]["kind"] == "index":
            _स्वदेशी_अभिव्यक्ति_संकलन(विशेष, अभिव्यक्ति["target"]["obj"])
            _स्वदेशी_अभिव्यक्ति_संकलन(विशेष, अभिव्यक्ति["target"]["index"])
            _emit१(विशेष, "LOAD_VAR", temp_slot)
            _emit०(विशेष, "INDEX_SET")
            _emit१(विशेष, "LOAD_VAR", temp_slot)
            प्रत्यागच्छ
        उत्क्षिप "असमर्थित native assignment target: " + अभिव्यक्ति["target"]["kind"]
    यदि अभिव्यक्ति["kind"] == "binary":
        _स्वदेशी_अभिव्यक्ति_संकलन(विशेष, अभिव्यक्ति["left"])
        _स्वदेशी_अभिव्यक्ति_संकलन(विशेष, अभिव्यक्ति["right"])
        यदि अभिव्यक्ति["op"] == "+":
            _emit०(विशेष, "ADD")
            प्रत्यागच्छ
        यदि अभिव्यक्ति["op"] == "-":
            _emit०(विशेष, "SUB")
            प्रत्यागच्छ
        यदि अभिव्यक्ति["op"] == "*":
            _emit०(विशेष, "MUL")
            प्रत्यागच्छ
        यदि अभिव्यक्ति["op"] == "/":
            _emit०(विशेष, "DIV")
            प्रत्यागच्छ
        यदि अभिव्यक्ति["op"] == "==":
            _emit०(विशेष, "EQ")
            प्रत्यागच्छ
        यदि अभिव्यक्ति["op"] == "!=":
            _emit०(विशेष, "NEQ")
            प्रत्यागच्छ
        यदि अभिव्यक्ति["op"] == "<":
            _emit०(विशेष, "LT")
            प्रत्यागच्छ
        यदि अभिव्यक्ति["op"] == ">":
            _emit०(विशेष, "GT")
            प्रत्यागच्छ
        यदि अभिव्यक्ति["op"] == "<=":
            _emit०(विशेष, "LTE")
            प्रत्यागच्छ
        यदि अभिव्यक्ति["op"] == ">=":
            _emit०(विशेष, "GTE")
            प्रत्यागच्छ
        उत्क्षिप "असमर्थित native binary op: " + अभिव्यक्ति["op"]
    उत्क्षिप "असमर्थित native expr kind: " + अभिव्यक्ति["kind"]


कर्म _स्वदेशी_स्थिर_डिफ़ॉल्ट(अभिव्यक्ति):
    यदि अभिव्यक्ति == शून्य:
        प्रत्यागच्छ शून्य
    यदि अभिव्यक्ति["kind"] == "number":
        प्रत्यागच्छ अभिव्यक्ति["value"]
    यदि अभिव्यक्ति["kind"] == "string":
        प्रत्यागच्छ अभिव्यक्ति["value"]
    यदि अभिव्यक्ति["kind"] == "bool":
        प्रत्यागच्छ अभिव्यक्ति["value"]
    यदि अभिव्यक्ति["kind"] == "null":
        प्रत्यागच्छ शून्य
    यदि अभिव्यक्ति["kind"] == "list":
        चर परिणाम = []
        प्रत्येक चर तत्व अन्तर्गत अभिव्यक्ति["elements"]:
            परिणाम.जोड़ो(_स्वदेशी_स्थिर_डिफ़ॉल्ट(तत्व))
        प्रत्यागच्छ परिणाम
    यदि अभिव्यक्ति["kind"] == "tuple":
        चर परिणाम = []
        प्रत्येक चर तत्व अन्तर्गत अभिव्यक्ति["elements"]:
            परिणाम.जोड़ो(_स्वदेशी_स्थिर_डिफ़ॉल्ट(तत्व))
        प्रत्यागच्छ tuple(परिणाम)
    यदि अभिव्यक्ति["kind"] == "set":
        चर परिणाम = set()
        प्रत्येक चर तत्व अन्तर्गत अभिव्यक्ति["elements"]:
            परिणाम.add(_स्वदेशी_स्थिर_डिफ़ॉल्ट(तत्व))
        प्रत्यागच्छ परिणाम
    यदि अभिव्यक्ति["kind"] == "dict":
        चर परिणाम = {}
        प्रत्येक चर युग्म अन्तर्गत अभिव्यक्ति["pairs"]:
            परिणाम[_स्वदेशी_स्थिर_डिफ़ॉल्ट(युग्म["key"])] = _स्वदेशी_स्थिर_डिफ़ॉल्ट(युग्म["value"])
        प्रत्यागच्छ परिणाम
    उत्क्षिप "native subset default अभिव्यक्ति समर्थित नहीं: " + अभिव्यक्ति["kind"]


कर्म _स्वदेशी_नो_डिफ़ॉल्ट():
    प्रत्यागच्छ {"__vak_default__": "no_default"}


कर्म _स्वदेशी_कार्य_विशेष(नाम, पैरामीटर, varargs_name, kwargs_name, शरीर, स्रोत_पथ, enclosing_scopes=[]):
    चर विशेष = _रिक्त_विशेष(स्रोत_पथ)
    विशेष["name"] = नाम
    विशेष["source_path"] = शून्य
    विशेष["scope_chain"] = enclosing_scopes
    चर scope_info = _स्वदेशी_कार्य_क्षेत्र_विश्लेषण(पैरामीटर, varargs_name, kwargs_name, शरीर, enclosing_scopes)
    विशेष["global_names"] = scope_info["global_names"]
    विशेष["nonlocal_names"] = scope_info["nonlocal_names"]
    विशेष["local_names"] = scope_info["local_names"]
    विशेष["closure_names"] = scope_info["closure_names"]

    चर default_देखा = असत्य
    प्रत्येक चर पैरामीटर_विवरण अन्तर्गत पैरामीटर:
        चर पैरामीटर_नाम = पैरामीटर_विवरण["name"]
        विशेष["param_names"].जोड़ो(पैरामीटर_नाम)
        विशेष["num_params"] = विशेष["num_params"] + १
        _चर_स्थान(विशेष, पैरामीटर_नाम)
        यदि पैरामीटर_विवरण["default"] != शून्य:
            default_देखा = सत्य
            विशेष["defaults"].जोड़ो(_स्वदेशी_स्थिर_डिफ़ॉल्ट(पैरामीटर_विवरण["default"]))
        अन्यथा:
            यदि default_देखा:
                उत्क्षिप "native subset में default के बाद non-default पैरामीटर समर्थित नहीं हैं"
            विशेष["defaults"].जोड़ो(_स्वदेशी_नो_डिफ़ॉल्ट())
    यदि varargs_name != शून्य:
        विशेष["varargs_name"] = varargs_name
        _चर_स्थान(विशेष, varargs_name)
    यदि kwargs_name != शून्य:
        विशेष["type_hints"]["__vak_kwargs_capture__"] = kwargs_name
        _चर_स्थान(विशेष, kwargs_name)

    प्रत्येक चर शरीर_वाक्य अन्तर्गत शरीर:
        _स्वदेशी_वाक्य_संकलन(विशेष, शरीर_वाक्य)

    यदि दीर्घता(विशेष["instructions"]) == ० अथवा _अंतिम_ऑप(विशेष["instructions"]) != "RETURN":
        चर none_idx = _स्थिर_जोड़ो(विशेष, शून्य)
        _emit१६(विशेष, "LOAD_CONST", none_idx)
        _emit०(विशेष, "RETURN")

    प्रत्यागच्छ विशेष


कर्म _स्वदेशी_वाक्य_संकलन(विशेष, वाक्य):
    यदि वाक्य["kind"] == "function":
        चर enclosing_scopes = []
        यदि "scope_chain" अन्तर्गत विशेष:
            प्रत्येक चर scope अन्तर्गत विशेष["scope_chain"]:
                enclosing_scopes.जोड़ो(scope)
        यदि विशेष["name"] != "<module>" और न ("<class " अन्तर्गत विशेष["name"]):
            enclosing_scopes.जोड़ो(विशेष["local_names"])
        चर कार्य_विशेष = _स्वदेशी_कार्य_विशेष(
            वाक्य["name"],
            वाक्य["params"],
            वाक्य["varargs"],
            वाक्य["kwargs_name"],
            वाक्य["body"],
            विशेष["source_path"],
            enclosing_scopes
        )
        विशेष["functions"][वाक्य["name"]] = कार्य_विशेष
        प्रत्येक चर अंतः_कार्य_नाम अन्तर्गत कार्य_विशेष["functions"]:
            विशेष["functions"][अंतः_कार्य_नाम] = कार्य_विशेष["functions"][अंतः_कार्य_नाम]
        चर env = {}
        प्रत्येक चर closure_name अन्तर्गत कार्य_विशेष["closure_names"]:
            env[closure_name] = शून्य
        चर callable_idx = _स्थिर_जोड़ो(विशेष, ("function", वाक्य["name"], env))
        _emit१६(विशेष, "LOAD_CONST", callable_idx)
        चर कार्य_slot = _चर_स्थान(विशेष, वाक्य["name"])
        _emit१(विशेष, "STORE_VAR", कार्य_slot)
        यदि विशेष["name"] != "<module>" और न _सूची_अन्तर्गत(विशेष["global_names"], वाक्य["name"]) और न _सूची_अन्तर्गत(विशेष["nonlocal_names"], वाक्य["name"]):
            _सूची_जोड़ो_यदि_न(विशेष["local_names"], वाक्य["name"])
        प्रत्यागच्छ
    यदि वाक्य["kind"] == "class":
        चर class_spec = _रिक्त_विशेष(विशेष["source_path"])
        class_spec["name"] = "<class " + वाक्य["name"] + ">"
        class_spec["scope_chain"] = []
        यदि "scope_chain" अन्तर्गत विशेष:
            प्रत्येक चर scope अन्तर्गत विशेष["scope_chain"]:
                class_spec["scope_chain"].जोड़ो(scope)
        प्रत्येक चर class_stmt अन्तर्गत वाक्य["body"]:
            _स्वदेशी_वाक्य_संकलन(class_spec, class_stmt)
        यदि दीर्घता(class_spec["instructions"]) == ० अथवा _अंतिम_ऑप(class_spec["instructions"]) != "RETURN_VOID":
            _emit०(class_spec, "RETURN_VOID")
        विशेष["functions"][वाक्य["name"]] = class_spec
        यदि वाक्य["superclass"] != शून्य:
            _स्वदेशी_अभिव्यक्ति_संकलन(विशेष, वाक्य["superclass"])
        अन्यथा:
            चर none_idx = _स्थिर_जोड़ो(विशेष, शून्य)
            _emit१६(विशेष, "LOAD_CONST", none_idx)
        चर class_name_idx = _स्थिर_जोड़ो(विशेष, वाक्य["name"])
        _emit१६(विशेष, "LOAD_CONST", class_name_idx)
        _emit०(विशेष, "BUILD_CLASS")
        चर class_slot = _चर_स्थान(विशेष, वाक्य["name"])
        _emit१(विशेष, "STORE_VAR", class_slot)
        यदि विशेष["name"] != "<module>" और न _सूची_अन्तर्गत(विशेष["global_names"], वाक्य["name"]) और न _सूची_अन्तर्गत(विशेष["nonlocal_names"], वाक्य["name"]):
            _सूची_जोड़ो_यदि_न(विशेष["local_names"], वाक्य["name"])
        प्रत्यागच्छ
    यदि वाक्य["kind"] == "global":
        प्रत्येक चर नाम अन्तर्गत वाक्य["names"]:
            _सूची_जोड़ो_यदि_न(विशेष["global_names"], नाम)
            _चर_स्थान(विशेष, नाम)
        प्रत्यागच्छ
    यदि वाक्य["kind"] == "nonlocal":
        प्रत्येक चर नाम अन्तर्गत वाक्य["names"]:
            _सूची_जोड़ो_यदि_न(विशेष["nonlocal_names"], नाम)
            _चर_स्थान(विशेष, नाम)
        प्रत्यागच्छ
    यदि वाक्य["kind"] == "if":
        चर अन्यथा_लेबल = _नया_लेबल(विशेष)
        चर अंत_लेबल = _नया_लेबल(विशेष)
        _स्वदेशी_अभिव्यक्ति_संकलन(विशेष, वाक्य["condition"])
        _emit_कूद(विशेष, "JUMP_IF_FALSE", अन्यथा_लेबल)
        प्रत्येक चर तब_वाक्य अन्तर्गत वाक्य["then_body"]:
            _स्वदेशी_वाक्य_संकलन(विशेष, तब_वाक्य)
        _emit_कूद(विशेष, "JUMP", अंत_लेबल)
        _emit_लेबल(विशेष, अन्यथा_लेबल)
        यदि वाक्य["else_body"] != शून्य:
            प्रत्येक चर अन्य_वाक्य अन्तर्गत वाक्य["else_body"]:
                _स्वदेशी_वाक्य_संकलन(विशेष, अन्य_वाक्य)
        _emit_लेबल(विशेष, अंत_लेबल)
        प्रत्यागच्छ
    यदि वाक्य["kind"] == "while":
        चर आरम्भ_लेबल = _नया_लेबल(विशेष)
        चर अंत_लेबल = _नया_लेबल(विशेष)
        _emit_लेबल(विशेष, आरम्भ_लेबल)
        _स्वदेशी_अभिव्यक्ति_संकलन(विशेष, वाक्य["condition"])
        _emit_कूद(विशेष, "JUMP_IF_FALSE", अंत_लेबल)
        प्रत्येक चर शरीर_वाक्य अन्तर्गत वाक्य["body"]:
            _स्वदेशी_वाक्य_संकलन(विशेष, शरीर_वाक्य)
        _emit_कूद(विशेष, "JUMP", आरम्भ_लेबल)
        _emit_लेबल(विशेष, अंत_लेबल)
        प्रत्यागच्छ
    यदि वाक्य["kind"] == "for":
        चर आरम्भ_लेबल = _नया_लेबल(विशेष)
        चर अंत_लेबल = _नया_लेबल(विशेष)
        _स्वदेशी_अभिव्यक्ति_संकलन(विशेष, वाक्य["iterable"])
        _emit०(विशेष, "GET_ITER")
        _emit_लेबल(विशेष, आरम्भ_लेबल)
        _emit_कूद(विशेष, "FOR_ITER", अंत_लेबल)
        यदि दीर्घता(वाक्य["var_names"]) == १:
            चर var_slot = _चर_स्थान(विशेष, वाक्य["var_names"][०])
            _emit१(विशेष, "STORE_VAR", var_slot)
        अन्यथा:
            _emit१(विशेष, "UNPACK_SEQUENCE", दीर्घता(वाक्य["var_names"]))
            प्रत्येक चर var_name अन्तर्गत वाक्य["var_names"]:
                चर var_slot = _चर_स्थान(विशेष, var_name)
                _emit१(विशेष, "STORE_VAR", var_slot)
        यदि विशेष["name"] != "<module>":
            प्रत्येक चर var_name अन्तर्गत वाक्य["var_names"]:
                यदि न _सूची_अन्तर्गत(विशेष["global_names"], var_name) और न _सूची_अन्तर्गत(विशेष["nonlocal_names"], var_name):
                    _सूची_जोड़ो_यदि_न(विशेष["local_names"], var_name)
        प्रत्येक चर शरीर_वाक्य अन्तर्गत वाक्य["body"]:
            _स्वदेशी_वाक्य_संकलन(विशेष, शरीर_वाक्य)
        _emit_कूद(विशेष, "JUMP", आरम्भ_लेबल)
        _emit_लेबल(विशेष, अंत_लेबल)
        प्रत्यागच्छ
    यदि वाक्य["kind"] == "import":
        चर module_idx = _स्थिर_जोड़ो(विशेष, वाक्य["module"])
        _emit१६(विशेष, "IMPORT_NAME", module_idx)
        यदि वाक्य["names"] != शून्य:
            चर temp_name = "__imported_module_" + पाठ_कर(दीर्घता(विशेष["var_names"]))
            चर temp_slot = _चर_स्थान(विशेष, temp_name)
            _emit१(विशेष, "STORE_VAR", temp_slot)
            _सूची_जोड़ो_यदि_न(विशेष["local_names"], temp_name)
            प्रत्येक चर नाम अन्तर्गत वाक्य["names"]:
                _emit१(विशेष, "LOAD_VAR", temp_slot)
                चर attr_idx = _स्थिर_जोड़ो(विशेष, नाम)
                _emit१६(विशेष, "ATTR_GET", attr_idx)
                चर slot = _चर_स्थान(विशेष, नाम)
                _emit१(विशेष, "STORE_VAR", slot)
        अन्यथा:
            चर slot = _चर_स्थान(विशेष, वाक्य["module"])
            _emit१(विशेष, "STORE_VAR", slot)
        प्रत्यागच्छ
    यदि वाक्य["kind"] == "var":
        _स्वदेशी_अभिव्यक्ति_संकलन(विशेष, वाक्य["expr"])
        यदि दीर्घता(वाक्य["names"]) == १:
            चर slot = _चर_स्थान(विशेष, वाक्य["names"][०])
            _emit१(विशेष, "STORE_VAR", slot)
        अन्यथा:
            _emit१(विशेष, "UNPACK_SEQUENCE", दीर्घता(वाक्य["names"]))
            प्रत्येक चर नाम अन्तर्गत वाक्य["names"]:
                चर slot = _चर_स्थान(विशेष, नाम)
                _emit१(विशेष, "STORE_VAR", slot)
        यदि विशेष["name"] != "<module>":
            प्रत्येक चर नाम अन्तर्गत वाक्य["names"]:
                यदि न _सूची_अन्तर्गत(विशेष["global_names"], नाम) और न _सूची_अन्तर्गत(विशेष["nonlocal_names"], नाम):
                    _सूची_जोड़ो_यदि_न(विशेष["local_names"], नाम)
        प्रत्यागच्छ
    यदि वाक्य["kind"] == "assign":
        _स्वदेशी_अभिव्यक्ति_संकलन(विशेष, वाक्य["expr"])
        चर slot = _चर_स्थान(विशेष, वाक्य["name"])
        _emit१(विशेष, "STORE_VAR", slot)
        _emit१(विशेष, "LOAD_VAR", slot)
        _emit०(विशेष, "POP")
        यदि विशेष["name"] != "<module>" और न _सूची_अन्तर्गत(विशेष["global_names"], वाक्य["name"]) और न _सूची_अन्तर्गत(विशेष["nonlocal_names"], वाक्य["name"]):
            _सूची_जोड़ो_यदि_न(विशेष["local_names"], वाक्य["name"])
        प्रत्यागच्छ
    यदि वाक्य["kind"] == "print":
        _स्वदेशी_अभिव्यक्ति_संकलन(विशेष, वाक्य["expr"])
        _emit०(विशेष, "PRINT")
        चर newline_idx = _स्थिर_जोड़ो(विशेष, "\n")
        _emit१६(विशेष, "LOAD_CONST", newline_idx)
        _emit०(विशेष, "PRINT")
        प्रत्यागच्छ
    यदि वाक्य["kind"] == "return":
        _स्वदेशी_अभिव्यक्ति_संकलन(विशेष, वाक्य["expr"])
        _emit०(विशेष, "RETURN")
        प्रत्यागच्छ
    यदि वाक्य["kind"] == "expr":
        _स्वदेशी_अभिव्यक्ति_संकलन(विशेष, वाक्य["expr"])
        _emit०(विशेष, "POP")
        प्रत्यागच्छ
    उत्क्षिप "असमर्थित native statement kind: " + वाक्य["kind"]


कर्म _स्वदेशी_विशेष_बनाओ(स्रोत, स्रोत_पथ):
    चर लेक्सर_यंत्र = नव लेक्सर(स्रोत)
    चर टोकन_सूची = लेक्सर_यंत्र.सभी_टोकन()
    चर पार्सर_यंत्र = नव पार्सर(टोकन_सूची)
    चर कार्यक्रम = पार्सर_यंत्र.मूल_विश्लेषण()
    चर विशेष = _रिक्त_विशेष(स्रोत_पथ)

    चर पाई_idx = _स्थिर_जोड़ो(विशेष, 3.141592653589793)
    _emit१६(विशेष, "LOAD_CONST", पाई_idx)
    चर पाई_slot = _चर_स्थान(विशेष, "पाई")
    _emit१(विशेष, "STORE_VAR", पाई_slot)

    प्रत्येक चर वाक्य अन्तर्गत कार्यक्रम["statements"]:
        _स्वदेशी_वाक्य_संकलन(विशेष, वाक्य)

    _emit०(विशेष, "HALT")
    _अन्तिम_निर्देश(विशेष)
    प्रत्यागच्छ विशेष


कर्म स्वदेशी_संकलन_चलाओ(स्रोत_पथ, निर्गत_पथ):
    चर स्रोत_वस्तु = _स्रोत_पथ(स्रोत_पथ)
    यदि न स्रोत_वस्तु.exists():
        उत्क्षिप "native स्रोत फ़ाइल नहीं मिली: " + पाठ_कर(स्रोत_वस्तु)
    चर स्रोत = स्रोत_वस्तु.read_text(encoding="utf-8")
    चर विशेष = _स्वदेशी_विशेष_बनाओ(स्रोत, पाठ_कर(स्रोत_वस्तु))
    प्रत्यागच्छ _पायथन_पुरातन_पृष्ठ.assemble_spec_to_artifact(
        विशेष,
        पाठ_कर(_स्रोत_पथ(निर्गत_पथ))
    )


कर्म स्वदेशी_पुनरुत्पादन_चलाओ(स्रोत_पथ, निर्गत_पहला, निर्गत_दूसरा):
    चर पहला = स्वदेशी_संकलन_चलाओ(स्रोत_पथ, निर्गत_पहला)
    चर दूसरा = स्वदेशी_संकलन_चलाओ(स्रोत_पथ, निर्गत_दूसरा)
    प्रत्यागच्छ {
        "पहला": पहला,
        "दूसरा": दूसरा,
        "same_byte_hash": पहला["byte_hash"] == दूसरा["byte_hash"],
        "same_meta_hash": पहला["meta_hash"] == दूसरा["meta_hash"]
    }


वर्ग कंपाइलर:
    कर्म प्रारम्भ(स्वयं):
        प्रत्यागच्छ शून्य

    कर्म संकलन(स्वयं, स्रोत_पथ, निर्गत_पथ):
        प्रत्यागच्छ बूटस्ट्रैप_संकलन(स्रोत_पथ, निर्गत_पथ)

    कर्म पुनरुत्पादन(स्वयं, स्रोत_पथ, निर्गत_पहला, निर्गत_दूसरा):
        प्रत्यागच्छ बूटस्ट्रैप_पुनरुत्पादन(स्रोत_पथ, निर्गत_पहला, निर्गत_दूसरा)

    कर्म असेंबल(स्वयं, विशेष_पथ, निर्गत_पथ):
        प्रत्यागच्छ असेंबली_संकलन(विशेष_पथ, निर्गत_पथ)

    कर्म स्वदेशी_संकलन(स्वयं, स्रोत_पथ, निर्गत_पथ):
        प्रत्यागच्छ स्वदेशी_संकलन_चलाओ(स्रोत_पथ, निर्गत_पथ)

    कर्म स्वदेशी_पुनरुत्पादन(स्वयं, स्रोत_पथ, निर्गत_पहला, निर्गत_दूसरा):
        प्रत्यागच्छ स्वदेशी_पुनरुत्पादन_चलाओ(स्रोत_पथ, निर्गत_पहला, निर्गत_दूसरा)


कर्म _बूटस्ट्रैप_मोड_चलाओ():
    चर मोड = _पर्यावरण_मान("VAK_BOOTSTRAP_MODE", "")
    यदि मोड == "":
        प्रत्यागच्छ असत्य

    चर संकलक = नव कंपाइलर()
    यदि मोड == "compile":
        चर स्रोत_पथ = _पर्यावरण_मान("VAK_BOOTSTRAP_INPUT", "")
        चर निर्गत_पथ = _पर्यावरण_मान("VAK_BOOTSTRAP_OUTPUT", "")
        यदि स्रोत_पथ == "" अथवा निर्गत_पथ == "":
            उत्क्षिप "VAK_BOOTSTRAP_INPUT और VAK_BOOTSTRAP_OUTPUT अपेक्षित हैं"
        चर रिपोर्ट = संकलक.संकलन(स्रोत_पथ, निर्गत_पथ)
        मुद्रय "BOOTSTRAP_COMPILE_OK"
        मुद्रय "source:", रिपोर्ट["source_path"]
        मुद्रय "compiled:", रिपोर्ट["compiled_path"]
        मुद्रय "meta:", रिपोर्ट["meta_path"]
        मुद्रय "byte_hash:", रिपोर्ट["byte_hash"]
        मुद्रय "meta_hash:", रिपोर्ट["meta_hash"]
        मुद्रय "code_bytes:", रिपोर्ट["code_bytes"]
        मुद्रय "constants:", रिपोर्ट["constants"]
        प्रत्यागच्छ सत्य

    यदि मोड == "repro":
        चर स्रोत_पथ = _पर्यावरण_मान("VAK_BOOTSTRAP_INPUT", "")
        चर निर्गत_पहला = _पर्यावरण_मान("VAK_BOOTSTRAP_OUTPUT", "")
        चर निर्गत_दूसरा = _पर्यावरण_मान("VAK_BOOTSTRAP_OUTPUT_SECOND", "")
        यदि स्रोत_पथ == "" अथवा निर्गत_पहला == "" अथवा निर्गत_दूसरा == "":
            उत्क्षिप "repro मोड के लिए तीनों bootstrap paths अपेक्षित हैं"
        चर रिपोर्ट = संकलक.पुनरुत्पादन(स्रोत_पथ, निर्गत_पहला, निर्गत_दूसरा)
        मुद्रय "BOOTSTRAP_REPRO_OK"
        मुद्रय "same_byte_hash:", रिपोर्ट["same_byte_hash"]
        मुद्रय "same_meta_hash:", रिपोर्ट["same_meta_hash"]
        प्रत्यागच्छ सत्य

    यदि मोड == "assemble":
        चर विशेष_पथ = _पर्यावरण_मान("VAK_BOOTSTRAP_SPEC", "")
        चर निर्गत_पथ = _पर्यावरण_मान("VAK_BOOTSTRAP_OUTPUT", "")
        यदि विशेष_पथ == "" अथवा निर्गत_पथ == "":
            उत्क्षिप "assemble मोड के लिए VAK_BOOTSTRAP_SPEC और VAK_BOOTSTRAP_OUTPUT अपेक्षित हैं"
        चर रिपोर्ट = संकलक.असेंबल(विशेष_पथ, निर्गत_पथ)
        मुद्रय "BOOTSTRAP_ASSEMBLE_OK"
        मुद्रय "compiled:", रिपोर्ट["compiled_path"]
        मुद्रय "meta:", रिपोर्ट["meta_path"]
        मुद्रय "byte_hash:", रिपोर्ट["byte_hash"]
        मुद्रय "meta_hash:", रिपोर्ट["meta_hash"]
        मुद्रय "code_bytes:", रिपोर्ट["code_bytes"]
        प्रत्यागच्छ सत्य

    यदि मोड == "native_compile":
        चर स्रोत_पथ = _पर्यावरण_मान("VAK_BOOTSTRAP_INPUT", "")
        चर निर्गत_पथ = _पर्यावरण_मान("VAK_BOOTSTRAP_OUTPUT", "")
        यदि स्रोत_पथ == "" अथवा निर्गत_पथ == "":
            उत्क्षिप "native_compile के लिए VAK_BOOTSTRAP_INPUT और VAK_BOOTSTRAP_OUTPUT अपेक्षित हैं"
        चर रिपोर्ट = संकलक.स्वदेशी_संकलन(स्रोत_पथ, निर्गत_पथ)
        मुद्रय "BOOTSTRAP_NATIVE_COMPILE_OK"
        मुद्रय "compiled:", रिपोर्ट["compiled_path"]
        मुद्रय "meta:", रिपोर्ट["meta_path"]
        मुद्रय "byte_hash:", रिपोर्ट["byte_hash"]
        मुद्रय "meta_hash:", रिपोर्ट["meta_hash"]
        मुद्रय "code_bytes:", रिपोर्ट["code_bytes"]
        प्रत्यागच्छ सत्य

    यदि मोड == "native_repro":
        चर स्रोत_पथ = _पर्यावरण_मान("VAK_BOOTSTRAP_INPUT", "")
        चर निर्गत_पहला = _पर्यावरण_मान("VAK_BOOTSTRAP_OUTPUT", "")
        चर निर्गत_दूसरा = _पर्यावरण_मान("VAK_BOOTSTRAP_OUTPUT_SECOND", "")
        यदि स्रोत_पथ == "" अथवा निर्गत_पहला == "" अथवा निर्गत_दूसरा == "":
            उत्क्षिप "native_repro के लिए तीनों bootstrap paths अपेक्षित हैं"
        चर रिपोर्ट = संकलक.स्वदेशी_पुनरुत्पादन(स्रोत_पथ, निर्गत_पहला, निर्गत_दूसरा)
        मुद्रय "BOOTSTRAP_NATIVE_REPRO_OK"
        मुद्रय "same_byte_hash:", रिपोर्ट["same_byte_hash"]
        मुद्रय "same_meta_hash:", रिपोर्ट["same_meta_hash"]
        प्रत्यागच्छ सत्य

    उत्क्षिप "अज्ञात bootstrap mode: " + मोड


# ── Entry Point ──────────────────────────────────────────────────────────

कर्म मुख्य():
    यदि _बूटस्ट्रैप_मोड_चलाओ():
        प्रत्यागच्छ

    मुद्रय "═══════════════════════════════════════════════════════════"
    मुद्रय "   वाक् कंपाइलर v0.3.0 — Bootstrap Driver"
    मुद्रय "   © 2026 Raj Mitra (Visionary RM)"
    मुद्रय "═══════════════════════════════════════════════════════════"

    चर स्रोत = "चर x = १०\n" + "चर y = २०\n" + "मुद्रय x + y\n"

    मुद्रय "\n🔍 Lexical Analysis..."
    चर लेक्सर_यंत्र = नव लेक्सर(स्रोत)
    चर टोकन_सूची = लेक्सर_यंत्र.सभी_टोकन()
    चर पार्सर_यंत्र = नव पार्सर(टोकन_सूची)
    चर सार = पार्सर_यंत्र.कार्यक्रम_सार()

    मुद्रय "\nटोकन पाए गए:"
    प्रत्येक चर टोकन अन्तर्गत टोकन_सूची:
        मुद्रय "  " + टोकन.विवरण()

    मुद्रय "\nपार्सर सार:", सार
    मुद्रय "\n✅ लेक्सिकल विश्लेषण सफल!"
    मुद्रय "✅ Bootstrap compiler driver तैयार!"
    मुद्रय "✅ Frozen legacy backend linked!"
    मुद्रय "✅ Native subset compiler linked!"


मुख्य()
