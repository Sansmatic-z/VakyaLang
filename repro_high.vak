# Augmented Assignment and Chained Comparison Test
चर स = [१०, २०, ३०]
मुद्रय "मूल सूची: ", स
स[०] += ५
मुद्रय "अद्यतित सूची: ", स

# Chained Comparison
चर x = १५
यदि १० < x < २०:
    मुद्रय "x १० और २० के बीच है।"
अन्यथा:
    मुद्रय "गलत।"
    
# Triple Chain
चर y = ५
यदि १ < y < १० < २०:
    मुद्रय "y १ और २० के बीच है और १० < २० भी सत्य है।"
