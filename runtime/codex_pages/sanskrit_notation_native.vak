स्थिर CODEX_PAGE_NAME = "sanskrit_notation_native"
स्थिर CODEX_PAGE_DESCRIPTION = "Vak-native transliterated Sanskrit notation page"
स्थिर CODEX_PAGE_PRIORITY = 47
स्थिर CODEX_PAGE_KIND = "vak_module"
स्थिर CODEX_PAGE_CHAPTER = "vak_native"
स्थिर CODEX_PAGE_CHAPTER_TITLE = "Vak Native Pages"
स्थिर CODEX_PAGE_CHAPTER_ORDER = 50
स्थिर CODEX_PAGE_CAPABILITIES = ["sanskrit_notation", "transliteration", "normalize"]
स्थिर CODEX_PAGE_EMITS_VAK = सत्य
स्थिर CODEX_PAGE_EXTENSIONS = ["svk", "vakroman"]
स्थिर CODEX_PAGE_HINTS = ["karma ", "chara ", "sthira ", "yadi ", "anyatha ", "pratyagaccha ", "mudraya "]
स्थिर CODEX_PAGE_MAX_FIXPOINT_PASSES = 2

कर्म codex_probe(source, filename = शून्य):
    यदि "karma " अन्तर्गत source अथवा "chara " अन्तर्गत source अथवा "sthira " अन्तर्गत source:
        प्रत्यागच्छ {"score": 55, "reason": "transliterated Vak keywords detected by Vak page"}
    यदि "yadi " अन्तर्गत source अथवा "anyatha " अन्तर्गत source अथवा "pratyagaccha " अन्तर्गत source:
        प्रत्यागच्छ {"score": 53, "reason": "transliterated Sanskrit control flow detected by Vak page"}
    यदि filename != शून्य और (".svk" अन्तर्गत filename अथवा ".vakroman" अन्तर्गत filename):
        प्रत्यागच्छ {"score": 42, "reason": "transliterated notation path matched by Vak page"}
    प्रत्यागच्छ {"score": 0, "reason": "not a transliterated Vak-native candidate"}

कर्म codex_transform(source, filename = शून्य):
    प्रत्यागच्छ कोडेक्स_विवरण(source, "sanskrit_notation", filename)
