# वाक् मानक पुस्तकालय — विन्यास (Config Parser)

कर्म _बिना_उद्धरण(मान):
    यदि दीर्घता(मान) >= २:
        यदि (मान[०] == "\"" और मान[दीर्घता(मान) - १] == "\"") अथवा (मान[०] == "'" और मान[दीर्घता(मान) - १] == "'"):
            प्रत्यागच्छ मान[१:दीर्घता(मान) - १]
    प्रत्यागच्छ मान


कर्म विन्यास_पढ़ो(पथ):
    यदि न अस्तित्व(पथ):
        प्रत्यागच्छ {}

    चर सामग्री = पठन(पथ)
    चर पंक्तियाँ = विभाजन(सामग्री, "\n")
    चर विन्यास = {}

    प्रत्येक चर पंक्ति अन्तर्गत पंक्तियाँ:
        पंक्ति = छाँटो(पंक्ति)
        यदि दीर्घता(पंक्ति) == ०:
            जारी
        यदि पंक्ति[०] == "#":
            जारी

        चर भाग = विभाजन(पंक्ति, "=")
        यदि दीर्घता(भाग) < २:
            जारी

        चर कुंजी = छाँटो(भाग[०])
        चर मान = छाँटो(संयोग(भाग[१:], "="))
        विन्यास[कुंजी] = _बिना_उद्धरण(मान)

    प्रत्यागच्छ विन्यास


कर्म विन्यास_लिखो(विन्यास, पथ):
    चर पंक्तियाँ = ["# Vak Config"]
    प्रत्येक चर कुंजी अन्तर्गत कुंजियाँ(विन्यास):
        पंक्तियाँ.जोड़ो(पाठ_कर(कुंजी) + "=" + पाठ_कर(विन्यास[कुंजी]))
    लेखन(पथ, संयोग(पंक्तियाँ, "\n"))


कर्म विन्यास_प्राप्त(विन्यास, कुंजी, अन्यथा_मान=शून्य):
    यदि कुंजी in विन्यास:
        प्रत्यागच्छ विन्यास[कुंजी]
    प्रत्यागच्छ अन्यथा_मान
