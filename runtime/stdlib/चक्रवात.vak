# वाक् मानक पुस्तकालय — चक्रवात (Spinner and Progress)

स्थिर _चक्र_अक्षर = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"]


कर्म चक्र_प्राप्त(सूचक):
    प्रत्यागच्छ _चक्र_अक्षर[सूचक % दीर्घता(_चक्र_अक्षर)]


कर्म बिंदु_प्रगति(कुल, वर्तमान, चौड़ाई=३०):
    यदि कुल <= ०:
        कुल = १
    यदि चौड़ाई <= ०:
        चौड़ाई = ३०

    चर भरा_गिनती = पूर्णांक_कर((वर्तमान * चौड़ाई) / कुल)
    यदि भरा_गिनती < ०:
        भरा_गिनती = ०
    यदि भरा_गिनती > चौड़ाई:
        भरा_गिनती = चौड़ाई

    चर खाली_गिनती = चौड़ाई - भरा_गिनती
    चर भरा = ""
    चर खाली = ""
    चर ग = ०
    यावत् ग < भरा_गिनती:
        भरा = भरा + "█"
        ग += १

    ग = ०
    यावत् ग < खाली_गिनती:
        खाली = खाली + "░"
        ग += १

    चर प्रतिशत = पूर्णांक_कर((वर्तमान * १००) / कुल)
    यदि प्रतिशत < ०:
        प्रतिशत = ०
    यदि प्रतिशत > १००:
        प्रतिशत = १००

    चर प्रतिशत_पाठ = पाठ_कर(प्रतिशत)
    यदि दीर्घता(प्रतिशत_पाठ) < २:
        प्रतिशत_पाठ = " " + प्रतिशत_पाठ
    यदि दीर्घता(प्रतिशत_पाठ) < ३:
        प्रतिशत_पाठ = " " + प्रतिशत_पाठ
    प्रत्यागच्छ "[" + भरा + खाली + "] " + प्रतिशत_पाठ + "%"


कर्म कार्य_प्रगति(वर्तमान, कुल, चौड़ाई=३०):
    यदि कुल <= ०:
        कुल = १
    चर प्रतिशत = पूर्णांक_कर((वर्तमान * १००) / कुल)
    यदि प्रतिशत < ०:
        प्रतिशत = ०
    यदि प्रतिशत > १००:
        प्रतिशत = १००
    चर बाकी = कुल - वर्तमान
    यदि बाकी < ०:
        बाकी = ०
    प्रत्यागच्छ पाठ_कर(वर्तमान) + "/" + पाठ_कर(कुल) + " (" + पाठ_कर(प्रतिशत) + "%) — शेष: " + पाठ_कर(बाकी)
