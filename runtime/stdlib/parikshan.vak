# वाक् मानक पुस्तकालय — परीक्षण (Testing)
# Vak Standard Library — Unit testing framework

वर्ग परीक्षण_उपकरण:
    कर्म प्रारम्भ(स्वयं):
        स्वयं.उत्तीर्ण = ०
        स्वयं.अनुत्तीर्ण = ०

    कर्म दावा_समान(स्वयं, वास्तविक, अपेक्षित, संदेश=""):
        टीका Assert equals
        यदि वास्तविक == अपेक्षित:
            स्वयं.उत्तीर्ण += १
            मुद्रय "✓ सफल: ", संदेश
        अन्यथा:
            स्वयं.अनुत्तीर्ण += १
            मुद्रय "❌ विफल: ", संदेश, " (अपेक्षित: ", अपेक्षित, ", मिला: ", वास्तविक, ")"

    कर्म परिणाम(स्वयं):
        मुद्रय "=== परीक्षण परिणाम ==="
        मुद्रय "उत्तीर्ण: ", स्वयं.उत्तीर्ण
        मुद्रय "अनुत्तीर्ण: ", स्वयं.अनुत्तीर्ण
        यदि स्वयं.अनुत्तीर्ण == ०:
            मुद्रय "स्थिति: सभी परीक्षण सफल! 🏆"
        अन्यथा:
            मुद्रय "स्थिति: कुछ परीक्षण विफल हुए। ⚠️"

मुद्रय "परीक्षण (Testing) पुस्तकालय लोड हुआ।"