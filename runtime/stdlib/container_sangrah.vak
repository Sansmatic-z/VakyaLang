# ── शब्दकोश (Dictionary / Hash Map) ───────────────────────────────────────

वर्ग शब्दकोश:
    """
    Hash table / Dictionary implementation.
    
    Usage:
        चर dict = नव शब्दकोश()
        dict.डालो("name", "राज")
        चर val = dict.प्राप्त_करो("name")
    """
    
    कर्म प्रारम्भ(स्वयं, क्षमता=16):
        स्वयं.क्षमता = क्षमता
        स्वयं.लंबाई = 0
        स्वयं.buckets = []
        
        # Initialize empty buckets
        प्रत्येक चर _ अन्तर्गत परास(क्षमता):
            स्वयं.buckets.जोड़ो([])
    
    कर्म _हैश(स्वयं, key):
        """Simple hash function"""
        चर hash_value = 0
        चर key_str = पाठ_कर(key)
        
        प्रत्येक चर char अन्तर्गत key_str:
            hash_value = (hash_value * 31 + ord(char)) % स्वयं.क्षमता
        
        प्रत्यागच्छ hash_value
    
    कर्म डालो(स्वयं, key, value):
        """Insert key-value pair"""
        चर index = स्वयं._हैश(key)
        चर bucket = स्वयं.buckets[index]
        
        # Update if key exists
        प्रत्येक चर entry अन्तर्गत bucket:
            यदि entry[0] == key:
                entry[1] = value
                प्रत्यागच्छ
        
        # Insert new
        bucket.जोड़ो([key, value])
        स्वयं.लंबाई = स्वयं.लंबाई + 1
        
        # Resize if load factor > 0.75
        यदि स्वयं.लंबाई > स्वयं.क्षमता * 0.75:
            स्वयं._पुनराकार(स्वयं.क्षमता * 2)
    
    कर्म _पुनराकार(स्वयं, new_capacity):
        """Resize hash table"""
        चर old_buckets = स्वयं.buckets
        
        स्वयं.क्षमता = new_capacity
        स्वयं.buckets = []
        स्वयं.लंबाई = 0
        
        प्रत्येक चर _ अन्तर्गत परास(new_capacity):
            स्वयं.buckets.जोड़ो([])
        
        # Rehash all entries
        प्रत्येक चर bucket अन्तर्गत old_buckets:
            प्रत्येक चर entry अन्तर्गत bucket:
                स्वयं.डालो(entry[0], entry[1])
    
    कर्म प्राप्त_करो(स्वयं, key, default=शून्य):
        """Get value by key"""
        चर index = स्वयं._हैश(key)
        चर bucket = स्वयं.buckets[index]
        
        प्रत्येक चर entry अन्तर्गत bucket:
            यदि entry[0] == key:
                प्रत्यागच्छ entry[1]
        
        प्रत्यागच्छ default
    
    कर्म हटाओ(स्वयं, key):
        """Remove key-value pair"""
        चर index = स्वयं._हैश(key)
        चर bucket = स्वयं.buckets[index]
        
        प्रत्येक चर i अन्तर्गत परास(दीर्घता(bucket)):
            यदि bucket[i][0] == key:
                bucket.हटाओ(i)
                स्वयं.लंबाई = स्वयं.लंबाई - 1
                प्रत्यागच्छ सत्य
        
        प्रत्यागच्छ असत्य
    
    कर्म कुंजी_है(स्वयं, key):
        """Check if key exists"""
        चर index = स्वयं._हैश(key)
        चर bucket = स्वयं.buckets[index]
        
        प्रत्येक चर entry अन्तर्गत bucket:
            यदि entry[0] == key:
                प्रत्यागच्छ सत्य
        
        प्रत्यागच्छ असत्य
    
    कर्म कुंजियाँ(स्वयं):
        """Get all keys"""
        चर keys = []
        प्रत्येक चर bucket अन्तर्गत स्वयं.buckets:
            प्रत्येक चर entry अन्तर्गत bucket:
                keys.जोड़ो(entry[0])
        प्रत्यागच्छ keys
    
    कर्म मान(स्वयं):
        """Get all values"""
        चर values = []
        प्रत्येक चर bucket अन्तर्गत स्वयं.buckets:
            प्रत्येक चर entry अन्तर्गत bucket:
                values.जोड़ो(entry[1])
        प्रत्यागच्छ values
    
    कर्म जोड़ियाँ(स्वयं):
        """Get all key-value pairs"""
        चर pairs = []
        प्रत्येक चर bucket अन्तर्गत स्वयं.buckets:
            प्रत्येक चर entry अन्तर्गत bucket:
                pairs.जोड़ो(entry)
        प्रत्यागच्छ pairs
    
    कर्म आकार(स्वयं):
        """Get number of entries"""
        प्रत्यागच्छ स्वयं.लंबाई
    
    कर्म रिक्त_कर(स्वयं):
        """Clear dictionary"""
        स्वयं.क्षमता = 16
        स्वयं.लंबाई = 0
        स्वयं.buckets = []
        प्रत्येक चर _ अन्तर्गत परास(16):
            स्वयं.buckets.जोड़ो([])
    
    कर्म तार_कर(स्वयं):
        """String representation"""
        चर result = "{"
        चर first = सत्य
        
        प्रत्येक चर bucket अन्तर्गत स्वयं.buckets:
            प्रत्येक चर entry अन्तर्गत bucket:
                यदि first == असत्य:
                    result = result + ", "
                result = result + पाठ_कर(entry[0]) + ": " + पाठ_कर(entry[1])
                first = असत्य
        
        result = result + "}"
        प्रत्यागच्छ result

# ── समुच्चय (Set / HashSet) ───────────────────────────────────────────────

वर्ग समुच्चय:
    """
    Set implementation using hash table.
    
    Usage:
        चर set = नव समुच्चय()
        set.जोड़ो(1)
        set.जोड़ो(2)
        चर has = set.सदस्य_है(1)
    """
    
    कर्म प्रारम्भ(स्वयं):
        स्वयं.dict = नव शब्दकोश()
    
    कर्म जोड़ो(स्वयं, element):
        """Add element to set"""
        स्वयं.dict.डालो(element, सत्य)
    
    कर्म हटाओ(स्वयं, element):
        """Remove element from set"""
        स्वयं.dict.हटाओ(element)
    
    कर्म सदस्य_है(स्वयं, element):
        """Check if element is in set"""
        प्रत्यागच्छ स्वयं.dict.कुंजी_है(element)
    
    कर्म आकार(स्वयं):
        """Get number of elements"""
        प्रत्यागच्छ स्वयं.dict.आकार()
    
    कर्म रिक्त_है(स्वयं):
        """Check if set is empty"""
        प्रत्यागच्छ स्वयं.आकार() == 0
    
    कर्म रिक्त_कर(स्वयं):
        """Clear set"""
        स्वयं.dict.रिक्त_कर()
    
    कर्म सूची_में(स्वयं):
        """Convert to list"""
        प्रत्यागच्छ स्वयं.dict.कुंजियाँ()
    
    कर्म संघ(स्वयं, other_set):
        """Union: self ∪ other"""
        चर result = नव समुच्चय()
        
        प्रत्येक चर elem अन्तर्गत स्वयं.सूची_में():
            result.जोड़ो(elem)
        प्रत्येक चर elem अन्तर्गत other_set.सूची_में():
            result.जोड़ो(elem)
        
        प्रत्यागच्छ result
    
    कर्म प्रतिच्छेदन(स्वयं, other_set):
        """Intersection: self ∩ other"""
        चर result = नव समुच्चय()
        
        प्रत्येक चर elem अन्तर्गत स्वयं.सूची_में():
            यदि other_set.सदस्य_है(elem):
                result.जोड़ो(elem)
        
        प्रत्यागच्छ result
    
    कर्म अंतर(स्वयं, other_set):
        """Difference: self \ other"""
        चर result = नव समुच्चय()
        
        प्रत्येक चर elem अन्तर्गत स्वयं.सूची_में():
            यदि other_set.सदस्य_है(elem) == असत्य:
                result.जोड़ो(elem)
        
        प्रत्यागच्छ result
    
    कर्म उपसमुच्चय_है(स्वयं, other_set):
        """Check if self ⊆ other"""
        प्रत्येक चर elem अन्तर्गत स्वयं.सूची_में():
            यदि other_set.सदस्य_है(elem) == असत्य:
                प्रत्यागच्छ असत्य
        प्रत्यागच्छ सत्य
    
    कर्म तार_कर(स्वयं):
        """String representation"""
        चर result = "{"
        चर first = सत्य
        
        प्रत्येक चर elem अन्तर्गत स्वयं.सूची_में():
            यदि first == असत्य:
                result = result + ", "
            result = result + पाठ_कर(elem)
            first = असत्य
        
        result = result + "}"
        प्रत्यागच्छ result

# ── कतार (Queue / FIFO) ──────────────────────────────────────────────────

वर्ग कतार:
    """
    Queue (First-In-First-Out) implementation.
    
    Usage:
        चर q = नव कतार()
        q.जोड़ो(1)
        q.जोड़ो(2)
        चर val = q.निकालो()  # Returns 1
    """
    
    कर्म प्रारम्भ(स्वयं):
        स्वयं.डेटा = []
        स्वयं.अग्र = 0
        स्वयं.पृष्ठ = 0
    
    कर्म जोड़ो(स्वयं, element):
        """Enqueue - add to rear"""
        स्वयं.डेटा.जोड़ो(element)
        स्वयं.पृष्ठ = स्वयं.पृष्ठ + 1
    
    कर्म निकालो(स्वयं):
        """Dequeue - remove from front"""
        यदि स्वयं.रिक्त_है():
            उत्क्षिप "कतार रिक्त है"
        
        चर element = स्वयं.डेटा[स्वयं.अग्र]
        स्वयं.अग्र = स्वयं.अग्र + 1
        
        # Cleanup if too many dequeued
        यदि स्वयं.अग्र > 100:
            चर new_data = []
            प्रत्येक चर i अन्तर्गत परास(स्वयं.अग्र, स्वयं.पृष्ठ):
                new_data.जोड़ो(स्वयं.डेटा[i])
            स्वयं.डेटा = new_data
            स्वयं.अग्र = 0
            स्वयं.पृष्ठ = दीर्घता(new_data)
        
        प्रत्यागच्छ element
    
    कर्म अग्र_तत्व(स्वयं):
        """Peek at front element"""
        यदि स्वयं.रिक्त_है():
            प्रत्यागच्छ शून्य
        प्रत्यागच्छ स्वयं.डेटा[स्वयं.अग्र]
    
    कर्म पृष्ठ_तत्व(स्वयं):
        """Peek at rear element"""
        यदि स्वयं.रिक्त_है():
            प्रत्यागच्छ शून्य
        प्रत्यागच्छ स्वयं.डेटा[स्वयं.पृष्ठ - 1]
    
    कर्म आकार(स्वयं):
        """Get queue size"""
        प्रत्यागच्छ स्वयं.पृष्ठ - स्वयं.अग्र
    
    कर्म रिक्त_है(स्वयं):
        """Check if empty"""
        प्रत्यागच्छ स्वयं.आकार() == 0
    
    कर्म रिक्त_कर(स्वयं):
        """Clear queue"""
        स्वयं.डेटा = []
        स्वयं.अग्र = 0
        स्वयं.पृष्ठ = 0
    
    कर्म सूची_में(स्वयं):
        """Convert to list"""
        चर result = []
        प्रत्येक चर i अन्तर्गत परास(स्वयं.अग्र, स्वयं.पृष्ठ):
            result.जोड़ो(स्वयं.डेटा[i])
        प्रत्यागच्छ result
    
    कर्म तार_कर(स्वयं):
        """String representation"""
        प्रत्यागच्छ "कतार(" + पाठ_कर(स्वयं.सूची_में()) + ")"

# ── द्वि-कतार (Deque / Double-ended Queue) ───────────────────────────────

वर्ग द्वि_कतार:
    """
    Double-ended queue (elements can be added/removed from both ends).
    """
    
    कर्म प्रारम्भ(स्वयं):
        स्वयं.डेटा = []
    
    कर्म अग्र_जोड़ो(स्वयं, element):
        """Add to front"""
        # Insert at beginning
        चर new_data = [element]
        प्रत्येक चर item अन्तर्गत स्वयं.डेटा:
            new_data.जोड़ो(item)
        स्वयं.डेटा = new_data
    
    कर्म पृष्ठ_जोड़ो(स्वयं, element):
        """Add to rear"""
        स्वयं.डेटा.जोड़ो(element)
    
    कर्म अग्र_निकालो(स्वयं):
        """Remove from front"""
        यदि स्वयं.रिक्त_है():
            उत्क्षिप "द्वि-कतार रिक्त है"
        चर element = स्वयं.डेटा[0]
        स्वयं.डेटा.हटाओ(0)
        प्रत्यागच्छ element
    
    कर्म पृष्ठ_निकालो(स्वयं):
        """Remove from rear"""
        यदि स्वयं.रिक्त_है():
            उत्क्षिप "द्वि-कतार रिक्त है"
        चर index = दीर्घता(स्वयं.डेटा) - 1
        चर element = स्वयं.डेटा[index]
        स्वयं.डेटा.हटाओ(index)
        प्रत्यागच्छ element
    
    कर्म अग्र_तत्व(स्वयं):
        """Peek at front"""
        यदि स्वयं.रिक्त_है():
            प्रत्यागच्छ शून्य
        प्रत्यागच्छ स्वयं.डेटा[0]
    
    कर्म पृष्ठ_तत्व(स्वयं):
        """Peek at rear"""
        यदि स्वयं.रिक्त_है():
            प्रत्यागच्छ शून्य
        चर index = दीर्घता(स्वयं.डेटा) - 1
        प्रत्यागच्छ स्वयं.डेटा[index]
    
    कर्म आकार(स्वयं):
        """Get size"""
        प्रत्यागच्छ दीर्घता(स्वयं.डेटा)
    
    कर्म रिक्त_है(स्वयं):
        """Check if empty"""
        प्रत्यागच्छ स्वयं.आकार() == 0
    
    कर्म रिक्त_कर(स्वयं):
        """Clear"""
        स्वयं.डेटा = []
    
    कर्म तार_कर(स्वयं):
        """String representation"""
        प्रत्यागच्छ "द्वि_कतार(" + पाठ_कर(स्वयं.डेटा) + ")"

# ── ढेर (Stack / LIFO) ───────────────────────────────────────────────────

वर्ग ढेर:
    """
    Stack (Last-In-First-Out) implementation.
    
    Usage:
        चर stack = नव ढेर()
        stack.धकेलो(1)
        stack.धकेलो(2)
        चर val = stack.निकालो()  # Returns 2
    """
    
    कर्म प्रारम्भ(स्वयं):
        स्वयं.डेटा = []
    
    कर्म धकेलो(स्वयं, element):
        """Push - add to top"""
        स्वयं.डेटा.जोड़ो(element)
    
    कर्म निकालो(स्वयं):
        """Pop - remove from top"""
        यदि स्वयं.रिक्त_है():
            उत्क्षिप "ढेर रिक्त है"
        चर index = दीर्घता(स्वयं.डेटा) - 1
        चर element = स्वयं.डेटा[index]
        स्वयं.डेटा.हटाओ(index)
        प्रत्यागच्छ element
    
    कर्म शीर्ष(स्वयं):
        """Peek at top"""
        यदि स्वयं.रिक्त_है():
            प्रत्यागच्छ शून्य
        चर index = दीर्घता(स्वयं.डेटा) - 1
        प्रत्यागच्छ स्वयं.डेटा[index]
    
    कर्म आकार(स्वयं):
        """Get stack size"""
        प्रत्यागच्छ दीर्घता(स्वयं.डेटा)
    
    कर्म रिक्त_है(स्वयं):
        """Check if empty"""
        प्रत्यागच्छ स्वयं.आकार() == 0
    
    कर्म रिक्त_कर(स्वयं):
        """Clear stack"""
        स्वयं.डेटा = []
    
    कर्म न्यूनतम_खोजो(स्वयं):
        """Find minimum element"""
        यदि स्वयं.रिक्त_है():
            प्रत्यागच्छ शून्य
        
        चर min_val = स्वयं.डेटा[0]
        प्रत्येक चर elem अन्तर्गत स्वयं.डेटा:
            यदि elem < min_val:
                min_val = elem
        
        प्रत्यागच्छ min_val
    
    कर्म अधिकतम_खोजो(स्वयं):
        """Find maximum element"""
        यदि स्वयं.रिक्त_है():
            प्रत्यागच्छ शून्य
        
        चर max_val = स्वयं.डेटा[0]
        प्रत्येक चर elem अन्तर्गत स्वयं.डेटा:
            यदि elem > max_val:
                max_val = elem
        
        प्रत्यागच्छ max_val
    
    कर्म तार_कर(स्वयं):
        """String representation"""
        प्रत्यागच्छ "ढेर(" + पाठ_कर(स्वयं.डेटा) + ")"

# ── क्रमबद्ध सूची (Sorted List) ──────────────────────────────────────────

वर्ग क्रमबद्ध_सूची:
    """
    Automatically sorted list (ascending order).
    """
    
    कर्म प्रारम्भ(स्वयं):
        स्वयं.डेटा = []
    
    कर्म जोड़ो(स्वयं, element):
        """Add element in sorted position"""
        # Find insertion point
        चर left = 0
        चर right = दीर्घता(स्वयं.डेटा)
        
        यावत् left < right:
            चर mid = (left + right) // 2
            यदि स्वयं.डेटा[mid] < element:
                left = mid + 1
            अन्यथा:
                right = mid
        
        # Insert at position
        चर new_data = []
        प्रत्येक चर i अन्तर्गत परास(left):
            new_data.जोड़ो(स्वयं.डेटा[i])
        new_data.जोड़ो(element)
        प्रत्येक चर i अन्तर्गत परास(left, दीर्घता(स्वयं.डेटा)):
            new_data.जोड़ो(स्वयं.डेटा[i])
        
        स्वयं.डेटा = new_data
    
    कर्म हटाओ(स्वयं, element):
        """Remove element"""
        चर index = -1
        प्रत्येक चर i अन्तर्गत परास(दीर्घता(स्वयं.डेटा)):
            यदि स्वयं.डेटा[i] == element:
                index = i
                तोड़ो
        
        यदि index != -1:
            स्वयं.डेटा.हटाओ(index)
            प्रत्यागच्छ सत्य
        प्रत्यागच्छ असत्य
    
    कर्म खोजो(स्वयं, element):
        """Binary search"""
        चर left = 0
        चर right = दीर्घता(स्वयं.डेटा) - 1
        
        यावत् left <= right:
            चर mid = (left + right) // 2
            यदि स्वयं.डेटा[mid] == element:
                प्रत्यागच्छ mid
            अन्यथा यदि स्वयं.डेटा[mid] < element:
                left = mid + 1
            अन्यथा:
                right = mid - 1
        
        प्रत्यागच्छ -1
    
    कर्म आकार(स्वयं):
        """Get size"""
        प्रत्यागच्छ दीर्घता(स्वयं.डेटा)
    
    कर्म रिक्त_है(स्वयं):
        """Check if empty"""
        प्रत्यागच्छ स्वयं.आकार() == 0
    
    कर्म न्यूनतम(स्वयं):
        """Get minimum element"""
        यदि स्वयं.रिक्त_है():
            प्रत्यागच्छ शून्य
        प्रत्यागच्छ स्वयं.डेटा[0]
    
    कर्म अधिकतम(स्वयं):
        """Get maximum element"""
        यदि स्वयं.रिक्त_है():
            प्रत्यागच्छ शून्य
        प्रत्यागच्छ स्वयं.डेटा[दीर्घता(स्वयं.डेटा) - 1]
    
    कर्म सूची_में(स्वयं):
        """Convert to list"""
        प्रत्यागच्छ स्वयं.डेटा
    
    कर्म तार_कर(स्वयं):
        """String representation"""
        प्रत्यागच्छ "क्रमबद्ध_सूची(" + पाठ_कर(स्वयं.डेटा) + ")"

# ── टुपल (Tuple / Immutable List) ─────────────────────────────────────────

वर्ग टुपल:
    """
    Immutable tuple data structure.
    """
    
    कर्म प्रारम्भ(स्वयं, elements=None):
        यदि elements == शून्य:
            स्वयं.डेटा = []
        अन्यथा:
            स्वयं.डेटा = elements
    
    कर्म प्राप्त_करो(स्वयं, index):
        """Get element at index"""
        प्रत्यागच्छ स्वयं.डेटा[index]
    
    कर्म आकार(स्वयं):
        """Get size"""
        प्रत्यागच्छ दीर्घता(स्वयं.डेटा)
    
    कर्म दीर्घता(स्वयं):
        """Get length"""
        प्रत्यागच्छ दीर्घता(स्वयं.डेटा)
    
    कर्म सूची_में(स्वयं):
        """Convert to list (read-only copy)"""
        चर result = []
        प्रत्येक चर elem अन्तर्गत स्वयं.डेटा:
            result.जोड़ो(elem)
        प्रत्यागच्छ result
    
    कर्म तार_कर(स्वयं):
        """String representation"""
        प्रत्यागच्छ "(" + संयोजन(स्वयं.डेटा, ", ") + ")"

# ── नामित टुपल (Named Tuple) ─────────────────────────────────────────────

वर्ग नामित_टुपल:
    """
    Named tuple with field access by name.
    
    Usage:
        चर Point = नव नामित_टुपल(["x", "y"])
        चर p = Point.बनाओ([1, 2])
        चर x_val = p.क्षेत्र("x")
    """
    
    कर्म प्रारम्भ(स्वयं, field_names):
        स्वयं.fields = field_names
    
    कर्म बनाओ(स्वयं, values):
        """Create instance with values"""
        यदि दीर्घता(values) != दीर्घता(स्वयं.fields):
            उत्क्षिप "क्षेत्र और मान असमान"
        
        चर data = नव शब्दकोश()
        प्रत्येक चर i अन्तर्गत परास(दीर्घता(स्वयं.fields)):
            data.डालो(स्वयं.fields[i], values[i])
        
        प्रत्यागच्छ data
    
    कर्म क्षेत्र(स्वयं, instance, field_name):
        """Get field value"""
        प्रत्यागच्छ instance.प्राप्त_करो(field_name)

मुद्रय "पात्र संग्रह पुस्तकालय लोड हुआ। (Container data structures library loaded.)"
