# Compact icon facade for current Vak module limits
# Uses split category modules and keeps the lookup/UI API in one safe module.
#
# उपयोग उदाहरण:
#
#   आयात icon
#   मुद्रय icon.प्राप्त("स्थिति", "सफल")
#   icon.श्रेणियाँ_दिखाओ()
#   icon.स्थिति_दिखाओ("कार्य पूरा", "सफल")
#
#   आयात icon_status
#   मुद्रय icon_status.सफल
#

आयात icon_status
आयात icon_direction
आयात icon_face
आयात icon_nature
आयात icon_object
आयात icon_math
आयात icon_box
आयात icon_decor
आयात icon_tech
आयात icon_comm
आयात icon_transport
आयात icon_food
आयात icon_sport
आयात icon_time
आयात icon_creature
आयात icon_industry
आयात icon_classical
आयात icon_element
आयात icon_misc

स्थिर सफल = icon_status.सफल
स्थिर विफल = icon_status.विफल
स्थिर चेतावनी = icon_status.चेतावनी
स्थिर सूचना = icon_status.सूचना
स्थिर प्रश्न = icon_status.प्रश्न

स्थिर स्थिति_संग्रह = icon_status.स्थिति_संग्रह
स्थिर दिशा_संग्रह = icon_direction.दिशा_संग्रह
स्थिर मुख_संग्रह = icon_face.मुख_संग्रह
स्थिर प्रकृति_संग्रह = icon_nature.प्रकृति_संग्रह
स्थिर वस्तु_संग्रह = icon_object.वस्तु_संग्रह
स्थिर गणित_संग्रह = icon_math.गणित_संग्रह
स्थिर रेखाचित्र_संग्रह = icon_box.रेखाचित्र_संग्रह
स्थिर सजावट_संग्रह = icon_decor.सजावट_संग्रह
स्थिर प्रौद्योगिकी_संग्रह = icon_tech.प्रौद्योगिकी_संग्रह
स्थिर संचार_संग्रह = icon_comm.संचार_संग्रह
स्थिर परिवहन_संग्रह = icon_transport.परिवहन_संग्रह
स्थिर भोजन_संग्रह = icon_food.भोजन_संग्रह
स्थिर खेल_संग्रह = icon_sport.खेल_संग्रह
स्थिर समय_संग्रह = icon_time.समय_संग्रह
स्थिर जीव_संग्रह = icon_creature.जीव_संग्रह
स्थिर विनिर्माण_संग्रह = icon_industry.विनिर्माण_संग्रह
स्थिर शास्त्रीय_संग्रह = icon_classical.शास्त्रीय_संग्रह
स्थिर तत्व_संग्रह = icon_element.तत्व_संग्रह
स्थिर विविध_संग्रह = icon_misc.विविध_संग्रह

स्थिर श्रेणी_रजिस्टर = {
    "स्थिति": स्थिति_संग्रह,
    "दिशा": दिशा_संग्रह,
    "मुख": मुख_संग्रह,
    "प्रकृति": प्रकृति_संग्रह,
    "वस्तु": वस्तु_संग्रह,
    "गणित": गणित_संग्रह,
    "रेखाचित्र": रेखाचित्र_संग्रह,
    "सजावट": सजावट_संग्रह,
    "प्रौद्योगिकी": प्रौद्योगिकी_संग्रह,
    "संचार": संचार_संग्रह,
    "परिवहन": परिवहन_संग्रह,
    "भोजन": भोजन_संग्रह,
    "खेल": खेल_संग्रह,
    "समय": समय_संग्रह,
    "जीव": जीव_संग्रह,
    "विनिर्माण": विनिर्माण_संग्रह,
    "शास्त्रीय": शास्त्रीय_संग्रह,
    "तत्व": तत्व_संग्रह,
    "विविध": विविध_संग्रह
}

कर्म प्राप्त(श्रेणी_नाम, चिह्न_नाम):
    यदि श्रेणी_नाम == शून्य:
        प्रत्यागच्छ शून्य
    यदि चिह्न_नाम == शून्य:
        प्रत्यागच्छ शून्य

    चर संग्रह = श्रेणी_रजिस्टर.get(श्रेणी_नाम)
    यदि संग्रह == शून्य:
        प्रत्यागच्छ शून्य

    चर मान = संग्रह.get(चिह्न_नाम)
    यदि मान == शून्य:
        प्रत्यागच्छ शून्य

    प्रत्यागच्छ मान


कर्म खोज(चिह्न_नाम):
    चर परिणाम = []

    प्रत्येक चर श्रेणी_नाम अन्तर्गत कुंजियाँ(श्रेणी_रजिस्टर):
        चर संग्रह = श्रेणी_रजिस्टर.get(श्रेणी_नाम)
        चर मान = संग्रह.get(चिह्न_नाम)
        यदि मान != शून्य:
            परिणाम.जोड़ो({
                "श्रेणी": श्रेणी_नाम,
                "नाम": चिह्न_नाम,
                "चिह्न": मान
            })

    प्रत्यागच्छ परिणाम


कर्म खोज_दिखाओ(चिह्न_नाम):
    चर परिणाम = खोज(चिह्न_नाम)

    यदि दीर्घता(परिणाम) == ०:
        मुद्रय "  " + "☐" + " चिह्न नहीं मिला: " + चिह्न_नाम
        प्रत्यागच्छ शून्य

    मुद्रय "  " + "🔍" + " खोज: " + चिह्न_नाम + " (" + पाठ_कर(दीर्घता(परिणाम)) + " परिणाम)"
    प्रत्येक चर प अन्तर्गत परिणाम:
        मुद्रय "  " + "  " + "»" + " [" + प["श्रेणी"] + "] " + प["नाम"] + " → " + प["चिह्न"]


कर्म श्रेणियाँ_दिखाओ():
    चर नाम = कुंजियाँ(श्रेणी_रजिस्टर)
    मुद्रय "  " + "📚" + " उपलब्ध श्रेणियाँ (" + पाठ_कर(दीर्घता(नाम)) + "):"
    प्रत्येक चर श अन्तर्गत नाम:
        चर संग्रह = श्रेणी_रजिस्टर[श]
        चर गिनती = दीर्घता(कुंजियाँ(संग्रह))
        मुद्रय "  " + "  " + "»" + " " + श + " (" + पाठ_कर(गिनती) + " चिह्न)"


कर्म श्रेणी_दिखाओ(श्रेणी_नाम):
    चर संग्रह = श्रेणी_रजिस्टर.get(श्रेणी_नाम)

    यदि संग्रह == शून्य:
        मुद्रय "  " + "☐" + " श्रेणी नहीं मिली: " + श्रेणी_नाम
        प्रत्यागच्छ शून्य

    चर नाम = कुंजियाँ(संग्रह)
    चर गिनती = दीर्घता(नाम)
    मुद्रय "  " + "📖" + " श्रेणी: " + श्रेणी_नाम + " (" + पाठ_कर(गिनती) + " चिह्न)"

    प्रत्येक चर न अन्तर्गत नाम:
        चर चिह्न = संग्रह[न]
        मुद्रय "  " + "  " + "▸" + " " + न + " → " + चिह्न


कर्म सभी_दिखाओ():
    चर श्रेणी_नाम = कुंजियाँ(श्रेणी_रजिस्टर)
    चर कुल_चिह्न = ०

    मुद्रय "╔══════════════════════════════════════════════════════════╗"
    मुद्रय "║        चिह्न पुस्तकालय — पूर्ण सूची                    ║"
    मुद्रय "╚══════════════════════════════════════════════════════════╝"

    प्रत्येक चर श अन्तर्गत श्रेणी_नाम:
        श्रेणी_दिखाओ(श)
        चर संग्रह = श्रेणी_रजिस्टर[श]
        कुल_चिह्न += दीर्घता(कुंजियाँ(संग्रह))
        मुद्रय ""

    मुद्रय "──────────────────────────────────────────────────────────"
    मुद्रय "  कुल: " + पाठ_कर(दीर्घता(श्रेणी_नाम)) + " श्रेणी, " + पाठ_कर(कुल_चिह्न) + " चिह्न"


कर्म गिनती():
    चर कुल = ०
    प्रत्येक चर श अन्तर्गत कुंजियाँ(श्रेणी_रजिस्टर):
        चर संग्रह = श्रेणी_रजिस्टर[श]
        कुल += दीर्घता(कुंजियाँ(संग्रह))
    प्रत्यागच्छ कुल


कर्म श्रेणी_गिनती(श्रेणी_नाम):
    चर संग्रह = श्रेणी_रजिस्टर.get(श्रेणी_नाम)
    यदि संग्रह == शून्य:
        प्रत्यागच्छ ०
    प्रत्यागच्छ दीर्घता(कुंजियाँ(संग्रह))


कर्म शीर्षक_बनाओ(शीर्षक):
    चर लंबाई = दीर्घता(शीर्षक)
    चर कुल_लंबाई = लंबाई + ६
    चर रेखा = ""

    चर गिनती = ०
    यावत् गिनती < कुल_लंबाई:
        रेखा = रेखा + "═"
        गिनती += १

    मुद्रय "╔" + रेखा + "╗"
    मुद्रय "║  " + शीर्षक + "  ║"
    मुद्रय "╚" + रेखा + "╝"


कर्म उपशीर्षक_बनाओ(उपशीर्षक):
    चर लंबाई = दीर्घता(उपशीर्षक)
    चर कुल_लंबाई = लंबाई + ६
    चर रेखा = ""

    चर गिनती = ०
    यावत् गिनती < कुल_लंबाई:
        रेखा = रेखा + "─"
        गिनती += १

    मुद्रय "  " + उपशीर्षक
    मुद्रय "  " + रेखा


कर्म विभाजक_रेखा(लंबाई, शैली):
    यदि शैली == शून्य:
        शैली = "साधारण"

    चर वर्ण = "─"
    यदि शैली == "भारी":
        वर्ण = "═"
    यदि शैली == "बिंदु":
        वर्ण = "┄"
    यदि शैली == "दोहरा":
        वर्ण = "━"

    चर रेखा = ""
    चर गिनती = ०
    यावत् गिनती < लंबाई:
        रेखा = रेखा + वर्ण
        गिनती += १

    मुद्रय रेखा


कर्म वस्तु_सूची_दिखाओ(वस्तुएं, चिह्न_स्ट्र):
    यदि चिह्न_स्ट्र == शून्य:
        चिह्न_स्ट्र = "▸"

    चर क्र = ०
    प्रत्येक चर व अन्तर्गत वस्तुएं:
        क्र += १
        मुद्रय "  " + चिह्न_स्ट्र + " " + व


कर्म स्थिति_दिखाओ(संदेश, प्रकार):
    यदि प्रकार == शून्य:
        प्रकार = "सूचना"

    चर चिह्न_स्ट्र = प्राप्त("स्थिति", प्रकार)
    यदि चिह्न_स्ट्र == शून्य:
        चिह्न_स्ट्र = "ℹ️"

    मुद्रय "  " + चिह्न_स्ट्र + " " + संदेश


कर्म प्रगति_पट्टी(प्रतिशत, चौड़ाई):
    यदि चौड़ाई == शून्य:
        चौड़ाई = ३०
    यदि चौड़ाई < १०:
        चौड़ाई = १०

    चर भरा_गिनती = पूर्णांक_कर((प्रतिशत / १००) * चौड़ाई)
    यदि भरा_गिनती > चौड़ाई:
        भरा_गिनती = चौड़ाई

    चर खाली_गिनती = चौड़ाई - भरा_गिनती

    चर भरा_भाग = ""
    चर ग = ०
    यावत् ग < भरा_गिनती:
        भरा_भाग = भरा_भाग + "█"
        ग += १

    चर खाली_भाग = ""
    चर ग२ = ०
    यावत् ग२ < खाली_गिनती:
        खाली_भाग = खाली_भाग + "░"
        ग२ += १

    चर प्रतिशत_स्ट्र = पाठ_कर(पूर्णांक_कर(प्रतिशत))
    यदि दीर्घता(प्रतिशत_स्ट्र) == १:
        प्रतिशत_स्ट्र = " " + प्रतिशत_स्ट्र
    यदि दीर्घता(प्रतिशत_स्ट्र) == २:
        प्रतिशत_स्ट्र = " " + प्रतिशत_स्ट्र

    मुद्रय "[" + भरा_भाग + खाली_भाग + "] " + प्रतिशत_स्ट्र + "%"


कर्म बॉक्स_बनाओ(पंक्तियाँ, शैली):
    यदि शैली == शून्य:
        शैली = "भारी"

    चर कोना_ऊ = "╔"
    चर कोना_दा = "╗"
    चर कोना_नी_बा = "╚"
    चर कोना_नी_दा = "╝"
    चर क्षै = "═"
    चर उर्ध = "║"

    यदि शैली == "सरल":
        कोना_ऊ = "┌"
        कोना_दा = "┐"
        कोना_नी_बा = "└"
        कोना_नी_दा = "┘"
        क्षै = "─"
        उर्ध = "│"

    यदि शैली == "दोहरा":
        कोना_ऊ = "╔"
        कोना_दा = "╗"
        कोना_नी_बा = "╚"
        कोना_नी_दा = "╝"
        क्षै = "═"
        उर्ध = "║"

    चर अधिकतम_लंबाई = ०
    प्रत्येक चर प अन्तर्गत पंक्तियाँ:
        यदि दीर्घता(पं) > अधिकतम_लंबाई:
            अधिकतम_लंबाई = दीर्घता(पं)

    चर अंतर्गत_चौड़ाई = अधिकतम_लंबाई + २

    चर ऊपरी = कोना_ऊ
    चर ग१ = ०
    यावत् ग१ < अंतर्गत_चौड़ाई:
        ऊपरी = ऊपरी + क्षै
        ग१ += १
    ऊपरी = ऊपरी + कोना_दा
    मुद्रय ऊपरी

    प्रत्येक चर प अन्तर्गत पंक्तियाँ:
        चर रिक्ति = अंतर्गत_चौड़ाई - दीर्घता(पं)
        चर पैडिंग = ""
        चर ग२ = ०
        यावत् ग२ < रिक्ति:
            पैडिंग = पैडिंग + " "
            ग२ += १
        मुद्रय उर्ध + " " + प + पैडिंग + उर्ध

    चर निचली = कोना_नी_बा
    चर ग३ = ०
    यावत् ग३ < अंतर्गत_चौड़ाई:
        निचली = निचली + क्षै
        ग३ += १
    निचली = निचली + कोना_नी_दा
    मुद्रय निचली


कर्म कोष्ठक_दिखाओ(नाम, मान, चिह्न_स्ट्र):
    यदि चिह्न_स्ट्र == शून्य:
        चिह्न_स्ट्र = "▸"
    मुद्रय "  " + चिह्न_स्ट्र + " " + नाम + ": " + पाठ_कर(मान)


कर्म तालिका_शीर्षक(स्तंभ, चौड़ाईयाँ):
    चर पंक्ति = "┌"
    चर अनुक्रम = ०
    प्रत्येक चर चौ अन्तर्गत चौड़ाईयाँ:
        चर ग = ०
        यावत् ग < (चौ + २):
            पंक्ति = पंक्ति + "─"
            ग += १
        अनुक्रम += १
        यदि अनुक्रम < दीर्घता(चौड़ाईयाँ):
            पंक्ति = पंक्ति + "┬"
        अन्यथा:
            पंक्ति = पंक्ति + "┐"
    मुद्रय पंक्ति

    चर डेटा_पंक्ति = "│"
    चर अनुक्रम_दो = ०
    प्रत्येक चर स अन्तर्गत स्तंभ:
        चर चौ = चौड़ाईयाँ[अनुक्रम_दो]
        चर रिक्ति = चौ - दीर्घता(स)
        चर पैड = ""
        चर ग३ = ०
        यावत् ग३ < रिक्ति:
            पैड = पैड + " "
            ग३ += १
        डेटा_पंक्ति = डेटा_पंक्ति + " " + स + पैड + " │"
        अनुक्रम_दो += १
    मुद्रय डेटा_पंक्ति

    चर विभाजक_पं = "├"
    चर अनुक्रम_तीन = ०
    प्रत्येक चर चौ अन्तर्गत चौड़ाईयाँ:
        चर ग४ = ०
        यावत् ग४ < (चौ + २):
            विभाजक_पं = विभाजक_पं + "─"
            ग४ += १
        अनुक्रम_तीन += १
        यदि अनुक्रम_तीन < दीर्घता(चौड़ाईयाँ):
            विभाजक_पं = विभाजक_पं + "┼"
        अन्यथा:
            विभाजक_पं = विभाजक_पं + "┤"
    मुद्रय विभाजक_पं


कर्म तालिका_पंक्ति(मान, चौड़ाईयाँ):
    चर पंक्ति = "│"
    चर अनुक्रम = ०
    प्रत्येक चर म अन्तर्गत मान:
        चर म_स्ट्र = पाठ_कर(म)
        चर चौ = चौड़ाईयाँ[अनुक्रम]
        चर रिक्ति = चौ - दीर्घता(म_स्ट्र)
        यदि रिक्ति < ०:
            रिक्ति = ०
        चर पैड = ""
        चर ग = ०
        यावत् ग < रिक्ति:
            पैड = पैड + " "
            ग += १
        पंक्ति = पंक्ति + " " + म_स्ट्र + पैड + " │"
        अनुक्रम += १
    मुद्रय पंक्ति


कर्म तालिका_पाद(चौड़ाईयाँ):
    चर पंक्ति = "└"
    चर अनुक्रम = ०
    प्रत्येक चर चौ अन्तर्गत चौड़ाईयाँ:
        चर ग = ०
        यावत् ग < (चौ + २):
            पंक्ति = पंक्ति + "─"
            ग += १
        अनुक्रम += १
        यदि अनुक्रम < दीर्घता(चौड़ाईयाँ):
            पंक्ति = पंक्ति + "┴"
        अन्यथा:
            पंक्ति = पंक्ति + "┘"
    मुद्रय पंक्ति


कर्म तालिका_बनाओ(शीर्षक, पंक्तियाँ, चौड़ाईयाँ):
    तालिका_शीर्षक(शीर्षक, चौड़ाईयाँ)
    प्रत्येक चर प अन्तर्गत पंक्तियाँ:
        तालिका_पंक्ति(प, चौड़ाईयाँ)
    तालिका_पाद(चौड़ाईयाँ)


कर्म वृक्ष_दिखाओ(नाम, स्तर, अंतिम):
    चर उपसर्ग = ""
    चर ग = ०
    यावत् ग < स्तर:
        उपसर्ग = उपसर्ग + "    "
        ग += १

    यदि स्तर > ०:
        यदि अंतिम:
            उपसर्ग = उपसर्ग + "└── "
        अन्यथा:
            उपसर्ग = उपसर्ग + "├── "
    अन्यथा:
        उपसर्ग = उपसर्ग + "◉ "

    मुद्रय उपसर्ग + नाम


कर्म मेनू_दिखाओ(विकल्प, शीर्षक):
    यदि शीर्षक != शून्य:
        शीर्षक_बनाओ(शीर्षक)

    चर क्र = ०
    प्रत्येक चर व अन्तर्गत विकल्प:
        क्र += १
        चर क्र_स्ट्र = पाठ_कर(क्र)
        यदि दीर्घता(क्र_स्ट्र) == १:
            क्र_स्ट्र = " " + क्र_स्ट्र
        मुद्रय "  " + क्र_स्ट्र + ". " + व


कर्म टैब_दिखाओ(शीर्षक, सामग्री, सक्रिय):
    चर सक्रिय_चिह्न = "●"
    चर निष्क्रिय_चिह्न = "○"

    चर पंक्ति = ""
    चर गिनती = ०
    प्रत्येक चर श अन्तर्गत शीर्षक:
        यदि गिनती == सक्रिय:
            पंक्ति = पंक्ति + " " + सक्रिय_चिह्न + " " + श + " │"
        अन्यथा:
            पंक्ति = पंक्ति + " " + निष्क्रिय_चिह्न + " " + श + " │"
        गिनती += १

    मुद्रय पंक्ति
    मुद्रय "│ " + सामग्री[सक्रिय]


कर्म सूचीबद्ध_दिखाओ(वस्तुएं):
    चर क्र = ०
    प्रत्येक चर व अन्तर्गत वस्तुएं:
        क्र += १
        चर क्र_स्ट्र = प्राप्त("विविध", "अंक_" + पाठ_कर(क्र))
        यदि क्र_स्ट्र == शून्य:
            क्र_स्ट्र = पाठ_कर(क्र) + "."
        अन्यथा:
            क्र_स्ट्र = क्र_स्ट्र + " "
        मुद्रय "  " + क्र_स्ट्र + व


कर्म बुलेट_दिखाओ(वस्तुएं, चिह्न_स्ट्र):
    यदि चिह्न_स्ट्र == शून्य:
        चिह्न_स्ट्र = "•"
    प्रत्येक चर व अन्तर्गत वस्तुएं:
        मुद्रय "  " + चिह्न_स्ट्र + " " + व


कर्म समापन_संदेश(संदेश):
    यदि संदेश == शून्य:
        संदेश = "समाप्त"
    मुद्रय "  " + "✅" + " " + संदेश
