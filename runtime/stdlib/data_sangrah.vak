# वाक् मानक पुस्तकालय — डाटा संग्रह (Data Structures)
# Vak Standard Library — Data Structures
# आयात: आयात गणित से data_sangrah

# ── स्टैक (Stack — LIFO) ──────────────────────────────────────────────────────

वर्ग स्टैक:
    टीका Stack — Last In First Out (LIFO) data structure
    
    कर्म प्रारम्भ(स्वयं):
        स्वयं.डाटा = []
        स्वयं.शीर्ष = -१
    
    कर्म धक्का(स्वयं, मान):
        टीका Push element onto stack
        स्वयं.डाटा.जोड़ो(मान)
        स्वयं.शीर्ष += १
        प्रत्यागच्छ स्वयं
    
    कर्म पॉप(स्वयं):
        टीका Pop element from stack
        यदि स्वयं.रिक्त_है():
            उत्क्षिप "स्टैक रिक्त है (Stack underflow)"
        चर मान = स्वयं.डाटा[स्वयं.शीर्ष]
        स्वयं.डाटा.हटाओ(स्वयं.शीर्ष)
        स्वयं.शीर्ष -= १
        प्रत्यागच्छ मान
    
    कर्म शीर्ष_तत्व(स्वयं):
        टीका Peek at top element without removing
        यदि स्वयं.रिक्त_है():
            प्रत्यागच्छ शून्य
        प्रत्यागच्छ स्वयं.डाटा[स्वयं.शीर्ष]
    
    कर्म रिक्त_है(स्वयं):
        प्रत्यागच्छ दीर्घता(स्वयं.डाटा) == ०
    
    कर्म आकार(स्वयं):
        प्रत्यागच्छ दीर्घता(स्वयं.डाटा)
    
    कर्म तार_कर(स्वयं):
        प्रत्यागच्छ "स्टैक(" + पाठ_कर(स्वयं.डाटा) + ")"

# ── कतार (Queue — FIFO) ───────────────────────────────────────────────────────

वर्ग कतार:
    टीका Queue — First In First Out (FIFO) data structure
    
    कर्म प्रारम्भ(स्वयं):
        स्वयं.डाटा = []
    
    कर्म प्रवेश(स्वयं, मान):
        टीका Enqueue — add to rear
        स्वयं.डाटा.जोड़ो(मान)
        प्रत्यागच्छ स्वयं
    
    कर्म निर्गम(स्वयं):
        टीका Dequeue — remove from front
        यदि स्वयं.रिक्त_है():
            उत्क्षिप "कतार रिक्त है (Queue underflow)"
        प्रत्यागच्छ स्वयं.डाटा.हटाओ(०)
    
    कर्म अग्र(स्वयं):
        टीका Peek at front element
        यदि स्वयं.रिक्त_है():
            प्रत्यागच्छ शून्य
        प्रत्यागच्छ स्वयं.डाटा[०]
    
    कर्म रिक्त_है(स्वयं):
        प्रत्यागच्छ दीर्घता(स्वयं.डाटा) == ०
    
    कर्म आकार(स्वयं):
        प्रत्यागच्छ दीर्घता(स्वयं.डाटा)
    
    कर्म तार_कर(स्वयं):
        प्रत्यागच्छ "कतार(" + पाठ_कर(स्वयं.डाटा) + ")"

# ── लिंक्ड लिस्ट नोड (Linked List Node) ───────────────────────────────────────

वर्ग लिंक_नोड:
    टीका Node for linked list
    
    कर्म प्रारम्भ(स्वयं, डाटा):
        स्वयं.डाटा = डाटा
        स्वयं.अगला = शून्य

# ── सिंगली लिंक्ड लिस्ट (Singly Linked List) ──────────────────────────────────

वर्ग लिंक्ड_लिस्ट:
    टीका Singly Linked List data structure
    
    कर्म प्रारम्भ(स्वयं):
        स्वयं.शीर्ष = शून्य
        स्वयं.लंबाई = ०
    
    कर्म जोड़ो(स्वयं, डाटा):
        टीका Add element at end
        चर नया_नोड = नव लिंक_नोड(डाटा)
        यदि स्वयं.शीर्ष == शून्य:
            स्वयं.शीर्ष = नया_नोड
        अन्यथा:
            चर वर्तमान = स्वयं.शीर्ष
            यावत् वर्तमान.अगला != शून्य:
                वर्तमान = वर्तमान.अगला
            वर्तमान.अगला = नया_नोड
        स्वयं.लंबाई += १
        प्रत्यागच्छ स्वयं
    
    कर्म हटाओ(स्वयं, डाटा):
        टीका Remove first occurrence of data
        यदि स्वयं.शीर्ष == शून्य:
            प्रत्यागच्छ असत्य
        
        यदि स्वयं.शीर्ष.डाटा == डाटा:
            स्वयं.शीर्ष = स्वयं.शीर्ष.अगला
            स्वयं.लंबाई -= १
            प्रत्यागच्छ सत्य
        
        चर वर्तमान = स्वयं.शीर्ष
        यावत् वर्तमान.अगला != शून्य:
            यदि वर्तमान.अगला.डाटा == डाटा:
                वर्तमान.अगला = वर्तमान.अगला.अगला
                स्वयं.लंबाई -= १
                प्रत्यागच्छ सत्य
            वर्तमान = वर्तमान.अगला
        
        प्रत्यागच्छ असत्य
    
    कर्म खोजो(स्वयं, डाटा):
        टीका Search for element, return index or -1
        चर सूचकांक = ०
        चर वर्तमान = स्वयं.शीर्ष
        यावत् वर्तमान != शून्य:
            यदि वर्तमान.डाटा == डाटा:
                प्रत्यागच्छ सूचकांक
            वर्तमान = वर्तमान.अगला
            सूचकांक += १
        प्रत्यागच्छ -१
    
    कर्म आकार(स्वयं):
        प्रत्यागच्छ स्वयं.लंबाई
    
    कर्म रिक्त_है(स्वयं):
        प्रत्यागच्छ स्वयं.लंबाई == ०
    
    कर्म सूची_में(स्वयं):
        टीका Convert to Python list
        चर परिणाम = []
        चर वर्तमान = स्वयं.शीर्ष
        यावत् वर्तमान != शून्य:
            परिणाम.जोड़ो(वर्तमान.डाटा)
            वर्तमान = वर्तमान.अगला
        प्रत्यागच्छ परिणाम
    
    कर्म तार_कर(स्वयं):
        प्रत्यागच्छ "लिंक्ड_लिस्ट(" + पाठ_कर(स्वयं.सूची_में()) + ")"

# ── बाइनरी ट्री नोड (Binary Tree Node) ────────────────────────────────────────

वर्ग ट्री_नोड:
    टीका Node for binary tree
    
    कर्म प्रारम्भ(स्वयं, मान):
        स्वयं.मान = मान
        स्वयं.बायाँ = शून्य
        स्वयं.दायाँ = शून्य

# ── बाइनरी सर्च ट्री (Binary Search Tree) ─────────────────────────────────────

वर्ग बाइनरी_सर्च_ट्री:
    टीका Binary Search Tree (BST) data structure
    
    कर्म प्रारम्भ(स्वयं):
        स्वयं.मूल = शून्य
        स्वयं.लंबाई = ०
    
    कर्म जोड़ो(स्वयं, मान):
        टीका Insert value into BST
        यदि स्वयं.मूल == शून्य:
            स्वयं.मूल = नव ट्री_नोड(मान)
        अन्यथा:
            स्वयं._जोड़ो_सहायक(स्वयं.मूल, मान)
        स्वयं.लंबाई += १
        प्रत्यागच्छ स्वयं
    
    कर्म _जोड़ो_सहायक(स्वयं, नोड, मान):
        टीका Helper method for insertion
        यदि मान < नोड.मान:
            यदि नोड.बायाँ == शून्य:
                नोड.बायाँ = नव ट्री_नोड(मान)
            अन्यथा:
                स्वयं._जोड़ो_सहायक(नोड.बायाँ, मान)
        अन्यथा:
            यदि नोड.दायाँ == शून्य:
                नोड.दायाँ = नव ट्री_नोड(मान)
            अन्यथा:
                स्वयं._जोड़ो_सहायक(नोड.दायाँ, मान)
    
    कर्म खोजो(स्वयं, मान):
        टीका Search for value, return True/False
        प्रत्यागच्छ स्वयं._खोजो_सहायक(स्वयं.मूल, मान)
    
    कर्म _खोजो_सहायक(स्वयं, नोड, मान):
        टीका Helper method for search
        यदि नोड == शून्य:
            प्रत्यागच्छ असत्य
        यदि नोड.मान == मान:
            प्रत्यागच्छ सत्य
        यदि मान < नोड.मान:
            प्रत्यागच्छ स्वयं._खोजो_सहायक(नोड.बायाँ, मान)
        अन्यथा:
            प्रत्यागच्छ स्वयं._खोजो_सहायक(नोड.दायाँ, मान)
    
    कर्म इनऑर्डर(स्वयं):
        टीका In-order traversal (sorted order)
        चर परिणाम = []
        स्वयं._इनऑर्डर_सहायक(स्वयं.मूल, परिणाम)
        प्रत्यागच्छ परिणाम
    
    कर्म _इनऑर्डर_सहायक(स्वयं, नोड, परिणाम):
        टीका Helper for in-order traversal
        यदि नोड != शून्य:
            स्वयं._इनऑर्डर_सहायक(नोड.बायाँ, परिणाम)
            परिणाम.जोड़ो(नोड.मान)
            स्वयं._इनऑर्डर_सहायक(नोड.दायाँ, परिणाम)
    
    कर्म प्रीऑर्डर(स्वयं):
        टीका Pre-order traversal
        चर परिणाम = []
        स्वयं._प्रीऑर्डर_सहायक(स्वयं.मूल, परिणाम)
        प्रत्यागच्छ परिणाम
    
    कर्म _प्रीऑर्डर_सहायक(स्वयं, नोड, परिणाम):
        टीका Helper for pre-order traversal
        यदि नोड != शून्य:
            परिणाम.जोड़ो(नोड.मान)
            स्वयं._प्रीऑर्डर_सहायक(नोड.बायाँ, परिणाम)
            स्वयं._प्रीऑर्डर_सहायक(नोड.दायाँ, परिणाम)
    
    कर्म पोस्टऑर्डर(स्वयं):
        टीका Post-order traversal
        चर परिणाम = []
        स्वयं._पोस्टऑर्डर_सहायक(स्वयं.मूल, परिणाम)
        प्रत्यागच्छ परिणाम
    
    कर्म _पोस्टऑर्डर_सहायक(स्वयं, नोड, परिणाम):
        टीका Helper for post-order traversal
        यदि नोड != शून्य:
            स्वयं._पोस्टऑर्डर_सहायक(नोड.बायाँ, परिणाम)
            स्वयं._पोस्टऑर्डर_सहायक(नोड.दायाँ, परिणाम)
            परिणाम.जोड़ो(नोड.मान)
    
    कर्म आकार(स्वयं):
        प्रत्यागच्छ स्वयं.लंबाई
    
    कर्म ऊँचाई(स्वयं):
        प्रत्यागच्छ स्वयं._ऊँचाई_सहायक(स्वयं.मूल)
    
    कर्म _ऊँचाई_सहायक(स्वयं, नोड):
        यदि नोड == शून्य:
            प्रत्यागच्छ ०
        चर बायाँ_ऊँचाई = स्वयं._ऊँचाई_सहायक(नोड.बायाँ)
        चर दायाँ_ऊँचाई = स्वयं._ऊँचाई_सहायक(नोड.दायाँ)
        प्रत्यागच्छ १ + अधिकतम(बायाँ_ऊँचाई, दायाँ_ऊँचाई)

# ── हैश टेबल (Hash Table) ─────────────────────────────────────────────────────

वर्ग हैश_टेबल:
    टीका Hash Table / Dictionary with chaining
    
    कर्म प्रारम्भ(स्वयं, क्षमता):
        स्वयं.क्षमता = क्षमता
        स्वयं.टेबल = []
        प्रत्येक चर _ अन्तर्गत परास(क्षमता):
            स्वयं.टेबल.जोड़ो([])  # Empty buckets
        स्वयं.लंबाई = ०
    
    कर्म _हैश(स्वयं, कुंजी):
        टीका Simple hash function
        चर ह = ०
        चर कुंजी_तार = पाठ_कर(कुंजी)
        प्रत्येक चर अक्षर अन्तर्गत कुंजी_तार:
            ह = (ह * ३१ + अक्षर_मान(अक्षर)) % स्वयं.क्षमता
        प्रत्यागच्छ ह
    
    कर्म डालो(स्वयं, कुंजी, मान):
        टीका Insert key-value pair
        चर बकेट_सूचकांक = स्वयं._हैश(कुंजी)
        चर बकेट = स्वयं.टेबल[बकेट_सूचकांक]
        
        # Update if key exists
        प्रत्येक चर जोड़ी अन्तर्गत बकेट:
            यदि जोड़ी[०] == कुंजी:
                जोड़ी[१] = मान
                प्रत्यागच्छ स्वयं
        
        # Insert new
        बकेट.जोड़ो([कुंजी, मान])
        स्वयं.लंबाई += १
        प्रत्यागच्छ स्वयं
    
    कर्म प्राप्त_करो(स्वयं, कुंजी, डिफ़ॉल्ट=शून्य):
        टीका Get value by key
        चर बकेट_सूचकांक = स्वयं._हैश(कुंजी)
        चर बकेट = स्वयं.टेबल[बकेट_सूचकांक]
        
        प्रत्येक चर जोड़ी अन्तर्गत बकेट:
            यदि जोड़ी[०] == कुंजी:
                प्रत्यागच्छ जोड़ी[१]
        
        प्रत्यागच्छ डिफ़ॉल्ट
    
    कर्म हटाओ(स्वयं, कुंजी):
        टीका Remove key-value pair
        चर बकेट_सूचकांक = स्वयं._हैश(कुंजी)
        चर बकेट = स्वयं.टेबल[बकेट_सूचकांक]
        
        प्रत्येक चर इ अन्तर्गत परास(दीर्घता(बकेट)):
            यदि बकेट[इ][०] == कुंजी:
                बकेट.हटाओ(इ)
                स्वयं.लंबाई -= १
                प्रत्यागच्छ सत्य
        
        प्रत्यागच्छ असत्य
    
    कर्म कुंजी_है(स्वयं, कुंजी):
        टीका Check if key exists
        चर बकेट_सूचकांक = स्वयं._हैश(कुंजी)
        चर बकेट = स्वयं.टेबल[बकेट_सूचकांक]
        
        प्रत्येक चर जोड़ी अन्तर्गत बकेट:
            यदि जोड़ी[०] == कुंजी:
                प्रत्यागच्छ सत्य
        
        प्रत्यागच्छ असत्य
    
    कर्म कुंजियाँ(स्वयं):
        टीका Get all keys
        चर परिणाम = []
        प्रत्येक चर बकेट अन्तर्गत स्वयं.टेबल:
            प्रत्येक चर जोड़ी अन्तर्गत बकेट:
                परिणाम.जोड़ो(जोड़ी[०])
        प्रत्यागच्छ परिणाम
    
    कर्म मान(स्वयं):
        टीका Get all values
        चर परिणाम = []
        प्रत्येक चर बकेट अन्तर्गत स्वयं.टेबल:
            प्रत्येक चर जोड़ी अन्तर्गत बकेट:
                परिणाम.जोड़ो(जोड़ी[१])
        प्रत्यागच्छ परिणाम
    
    कर्म आकार(स्वयं):
        प्रत्यागच्छ स्वयं.लंबाई
    
    कर्म तार_कर(स्वयं):
        प्रत्यागच्छ "हैश_टेबल(क्षमता=" + पाठ_कर(स्वयं.क्षमता) + ", आकार=" + पाठ_कर(स्वयं.लंबाई) + ")"

मुद्रय "डाटा संग्रह पुस्तकालय लोड हुआ। (Data structures library loaded.)"
