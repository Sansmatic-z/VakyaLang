# वाक् मानक पुस्तकालय — संग्रह (Collections)
# Vak Standard Library — Collections module

वर्ग स्टैक:
    कर्म प्रारम्भ(स्वयं):
        स्वयं.डेटा = []
        
    कर्म डालो(स्वयं, मान):
        टीका Push item to stack
        स्वयं.डेटा.जोड़ो(मान)
        
    कर्म निकालो(स्वयं):
        टीका Pop item from stack
        प्रत्यागच्छ स्वयं.डेटा.निकालो()
        
    कर्म आकार(स्वयं):
        प्रत्यागच्छ दीर्घता(स्वयं.डेटा)

वर्ग कतार:
    कर्म प्रारम्भ(स्वयं):
        स्वयं.डेटा = []
        
    कर्म डालो(स्वयं, मान):
        टीका Enqueue item
        स्वयं.डेटा.जोड़ो(मान)
        
    कर्म निकालो(स्वयं):
        टीका Dequeue item (requires removing from start)
        चर प्रथम = स्वयं.डेटा[०]
        स्वयं.डेटा = स्वयं.डेटा[१:दीर्घता(स्वयं.डेटा)]
        प्रत्यागच्छ प्रथम

मुद्रय "संग्रह (Collections) पुस्तकालय लोड हुआ।"