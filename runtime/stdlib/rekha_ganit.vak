# वाक् मानक पुस्तकालय — रेखा गणित (Linear Algebra)
# Vak Standard Library — Linear Algebra Utilities
# आयात: आयात गणित से रेखा_ganit

आयात ganit_vistarit

# ── सदिश संचालन (Vector Operations) ───────────────────────────────────────────

कर्म सदिश_योग(अ, ब):
    टीका Vector addition — add two vectors element-wise
    यदि दीर्घता(अ) != दीर्घता(ब):
        उत्क्षिप "सदिश लंबाई असमान है (vector lengths unequal)"
    चर परिणाम = []
    प्रत्येक चर इ अन्तर्गत परास(दीर्घता(अ)):
        परिणाम.जोड़ो(अ[इ] + ब[इ])
    प्रत्यागच्छ परिणाम

कर्म सदिश_व्यवकलन(अ, ब):
    टीका Vector subtraction — subtract vector b from a
    यदि दीर्घता(अ) != दीर्घता(ब):
        उत्क्षिप "सदिश लंबाई असमान है"
    चर परिणाम = []
    प्रत्येक चर इ अन्तर्गत परास(दीर्घता(अ)):
        परिणाम.जोड़ो(अ[इ] - ब[इ])
    प्रत्यागच्छ परिणाम

कर्म सदिश_अदिश_गुणन(सदिश, अदिश):
    टीका Scalar multiplication — multiply vector by scalar
    चर परिणाम = []
    प्रत्येक चर व अन्तर्गत सदिश:
        परिणाम.जोड़ो(व * अदिश)
    प्रत्यागच्छ परिणाम

कर्म सदिश_गुणनफल(अ, ब):
    टीका Dot product — scalar product of two vectors
    यदि दीर्घता(अ) != दीर्घता(ब):
        उत्क्षिप "सदिश लंबाई असमान है"
    चर योग = ०
    प्रत्येक चर इ अन्तर्गत परास(दीर्घता(अ)):
        योग += अ[इ] * ब[इ]
    प्रत्यागच्छ योग

कर्म सदिश_लंबाई(सदिश):
    टीका Vector magnitude/length — Euclidean norm
    चर योग = ०
    प्रत्येक चर व अन्तर्गत सदिश:
        योग += व * व
    प्रत्यागच्छ वर्गमूल(योग)

कर्म सदिश_सामान्यीकरण(सदिश):
    टीका Normalize vector — unit vector
    चर लंबाई = सदिश_लंबाई(सदिश)
    यदि लंबाई == ०:
        उत्क्षिप "शून्य सदिश को सामान्य नहीं किया जा सकता"
    प्रत्यागच्छ सदिश_अदिश_गुणन(सदिश, १ / लंबाई)

कर्म सदिश_कोण(अ, ब):
    टीका Angle between two vectors (in radians)
    चर डॉट = सदिश_गुणनफल(अ, ब)
    चर लंबाई_अ = सदिश_लंबाई(अ)
    चर लंबाई_ब = सदिश_लंबाई(ब)
    यदि लंबाई_अ == ० अथवा लंबाई_ब == ०:
        उत्क्षिप "शून्य सदिश के लिए कोण परिभाषित नहीं"
    चर कोज्या = डॉट / (लंबाई_अ * लंबाई_ब)
    # Clamp to [-1, 1] for numerical stability
    यदि कोज्या > १: कोज्या = १
    यदि कोज्या < -१: कोज्या = -१
    प्रत्यागच्छ ganit_vistarit.आर्ककोसाइन(कोज्या)

# ── मैट्रिक्स संचालन (Matrix Operations) ──────────────────────────────────────

कर्म मैट्रिक्स_योग(अ, ब):
    टीका Matrix addition — add two matrices
    यदि दीर्घता(अ) != दीर्घता(ब):
        उत्क्षिप "मैट्रिक्स पंक्तियाँ असमान हैं"
    यदि दीर्घता(अ[०]) != दीर्घता(ब[०]):
        उत्क्षिप "मैट्रिक्स स्तंभ असमान हैं"
    चर परिणाम = []
    प्रत्येक चर पंक्ति अन्तर्गत परास(दीर्घता(अ)):
        चर नई_पंक्ति = []
        प्रत्येक चर स्तंभ अन्तर्गत परास(दीर्घता(अ[०])):
            नई_पंक्ति.जोड़ो(अ[पंक्ति][स्तंभ] + ब[पंक्ति][स्तंभ])
        परिणाम.जोड़ो(नई_पंक्ति)
    प्रत्यागच्छ परिणाम

कर्म मैट्रिक्स_व्यवकलन(अ, ब):
    टीका Matrix subtraction
    यदि दीर्घता(अ) != दीर्घता(ब):
        उत्क्षिप "मैट्रिक्स पंक्तियाँ असमान हैं"
    यदि दीर्घता(अ[०]) != दीर्घता(ब[०]):
        उत्क्षिप "मैट्रिक्स स्तंभ असमान हैं"
    चर परिणाम = []
    प्रत्येक चर पंक्ति अन्तर्गत परास(दीर्घता(अ)):
        चर नई_पंक्ति = []
        प्रत्येक चर स्तंभ अन्तर्गत परास(दीर्घता(अ[०])):
            नई_पंक्ति.जोड़ो(अ[पंक्ति][स्तंभ] - ब[पंक्ति][स्तंभ])
        परिणाम.जोड़ो(नई_पंक्ति)
    प्रत्यागच्छ परिणाम

कर्म मैट्रिक्स_अदिश_गुणन(मैट्रिक्स, अदिश):
    टीका Scalar multiplication of matrix
    चर परिणाम = []
    प्रत्येक चर पंक्ति अन्तर्गत मैट्रिक्स:
        चर नई_पंक्ति = []
        प्रत्येक चर तत्व अन्तर्गत पंक्ति:
            नई_पंक्ति.जोड़ो(तत्व * अदिश)
        परिणाम.जोड़ो(नई_पंक्ति)
    प्रत्यागच्छ परिणाम

कर्म मैट्रिक्स_गुणन(अ, ब):
    टीका Matrix multiplication — A × B
    चर अ_पंक्तियाँ = दीर्घता(अ)
    चर अ_स्तंभ = दीर्घता(अ[०])
    चर ब_पंक्तियाँ = दीर्घता(ब)
    चर ब_स्तंभ = दीर्घता(ब[०])
    
    यदि अ_स्तंभ != ब_पंक्तियाँ:
        उत्क्षिप "मैट्रिक्स गुणन असंभव: A columns != B rows"
    
    चर परिणाम = []
    प्रत्येक चर इ अन्तर्गत परास(अ_पंक्तियाँ):
        चर नई_पंक्ति = []
        प्रत्येक चर ज अन्तर्गत परास(ब_स्तंभ):
            चर योग = ०
            प्रत्येक चर क अन्तर्गत परास(अ_स्तंभ):
                योग += अ[इ][क] * ब[क][ज]
            नई_पंक्ति.जोड़ो(योग)
        परिणाम.जोड़ो(नई_पंक्ति)
    प्रत्यागच्छ परिणाम

कर्म मैट्रिक्स_स्थानांतरण(मैट्रिक्स):
    टीका Matrix transpose — A^T
    चर पंक्तियाँ = दीर्घता(मैट्रिक्स)
    चर स्तंभ = दीर्घता(मैट्रिक्स[०])
    चर परिणाम = []
    प्रत्येक चर ज अन्तर्गत परास(स्तंभ):
        चर नई_पंक्ति = []
        प्रत्येक चर इ अन्तर्गत परास(पंक्तियाँ):
            नई_पंक्ति.जोड़ो(मैट्रिक्स[इ][ज])
        परिणाम.जोड़ो(नई_पंक्ति)
    प्रत्यागच्छ परिणाम

कर्म मैट्रिक्स_निर्धारक(मैट्रिक्स):
    टीका Matrix determinant — recursive calculation
    चर आकार = दीर्घता(मैट्रिक्स)
    यदि आकार != दीर्घता(मैट्रिक्स[०]):
        उत्क्षिप "केवल वर्ग मैट्रिक्स का निर्धारक"
    
    # Base case: 2x2 matrix
    यदि आकार == १:
        प्रत्यागच्छ मैट्रिक्स[०][०]
    यदि आकार == २:
        प्रत्यागच्छ मैट्रिक्स[०][०] * मैट्रिक्स[१][१] - मैट्रिक्स[०][१] * मैट्रिक्स[१][०]
    
    # Recursive case: expansion by first row
    चर निर्धारक = ०
    प्रत्येक चर ज अन्तर्गत परास(आकार):
        # Create submatrix (minor)
        चर उपमैट्रिक्स = []
        प्रत्येक चर इ अन्तर्गत परास(१, आकार):
            चर पंक्ति = []
            प्रत्येक चर क अन्तर्गत परास(आकार):
                यदि क != ज:
                    पंक्ति.जोड़ो(मैट्रिक्स[इ][क])
            उपमैट्रिक्स.जोड़ो(पंक्ति)
        
        चर संकेत = ०
        यदि ज % २ == ०:
            संकेत = १
        अन्यथा:
            संकेत = -१
        निर्धारक += संकेत * मैट्रिक्स[०][ज] * मैट्रिक्स_निर्धारक(उपमैट्रिक्स)
    
    प्रत्यागच्छ निर्धारक

कर्म मैट्रिक्स_उपमैट्रिक्स(मैट्रिक्स, हटाओ_पंक्ति, हटाओ_स्तंभ):
    टीका Matrix minor — remove one row and one column
    चर परिणाम = []
    प्रत्येक चर इ अन्तर्गत परास(दीर्घता(मैट्रिक्स)):
        यदि इ == हटाओ_पंक्ति:
            जारी
        चर पंक्ति = []
        प्रत्येक चर ज अन्तर्गत परास(दीर्घता(मैट्रिक्स[इ])):
            यदि ज == हटाओ_स्तंभ:
                जारी
            पंक्ति.जोड़ो(मैट्रिक्स[इ][ज])
        परिणाम.जोड़ो(पंक्ति)
    प्रत्यागच्छ परिणाम

कर्म मैट्रिक्स_उल्टा(मैट्रिक्स):
    टीका Matrix inverse — A^(-1) using adjugate method
    चर आकार = दीर्घता(मैट्रिक्स)
    चर निर्धारक = मैट्रिक्स_निर्धारक(मैट्रिक्स)
    
    यदि निर्धारक == ०:
        उत्क्षिप "मैट्रिक्स विलक्षण है (singular), उल्टा संभव नहीं"
    
    यदि आकार == १:
        प्रत्यागच्छ [[१ / मैट्रिक्स[०][०]]]
    
    # For 2x2 matrix
    यदि आकार == २:
        प्रत्यागच्छ [
            [मैट्रिक्स[१][१] / निर्धारक, -मैट्रिक्स[०][१] / निर्धारक],
            [-मैट्रिक्स[१][०] / निर्धारक, मैट्रिक्स[०][०] / निर्धारक]
        ]

    चर सहघटक = []
    प्रत्येक चर इ अन्तर्गत परास(आकार):
        चर पंक्ति = []
        प्रत्येक चर ज अन्तर्गत परास(आकार):
            चर उपमैट्रिक्स = मैट्रिक्स_उपमैट्रिक्स(मैट्रिक्स, इ, ज)
            चर संकेत = १
            यदि (इ + ज) % २ == १:
                संकेत = -१
            पंक्ति.जोड़ो(संकेत * मैट्रिक्स_निर्धारक(उपमैट्रिक्स))
        सहघटक.जोड़ो(पंक्ति)

    चर adjugate = मैट्रिक्स_स्थानांतरण(सहघटक)
    चर परिणाम = []
    प्रत्येक चर इ अन्तर्गत परास(आकार):
        चर पंक्ति = []
        प्रत्येक चर ज अन्तर्गत परास(आकार):
            पंक्ति.जोड़ो(adjugate[इ][ज] / निर्धारक)
        परिणाम.जोड़ो(पंक्ति)
    प्रत्यागच्छ परिणाम

# ── सदिश उत्पाद (Vector Products) ─────────────────────────────────────────────

कर्म सदिश_पार_गुणनफल(अ, ब):
    टीका Cross product — only for 3D vectors
    यदि दीर्घता(अ) != ३ अथवा दीर्घता(ब) != ३:
        उत्क्षिप "पार गुणनफल केवल ३डी सदिश के लिए"
    
    प्रत्यागच्छ [
        अ[१] * ब[२] - अ[२] * ब[१],
        अ[२] * ब[०] - अ[०] * ब[२],
        अ[०] * ब[१] - अ[१] * ब[०]
    ]

# ── रूपांतरण (Conversions) ────────────────────────────────────────────────────

कर्म सूची_से_सदिश(सूची):
    टीका Convert list to vector (same representation)
    प्रत्यागच्छ सूची

कर्म सदिश_से_तार(सदिश):
    टीका Convert vector to string representation
    चर भाग = []
    प्रत्येक चर व अन्तर्गत सदिश:
        भाग.जोड़ो(पाठ_कर(व))
    प्रत्यागच्छ "[" + संयोग(भाग, ", ") + "]"

मुद्रय "रेखा गणित पुस्तकालय लोड हुआ। (Linear algebra library loaded.)"
