# वाक् मानक पुस्तकालय — वादा (Promise/Future)
# Vak Standard Library — Promise/Future utilities

वर्ग मूल_श्रोता:
    कर्म प्रारम्भ(स्वयं, सफलता_फलन, विफलता_फलन):
        स्वयं.सफलता_फलन = सफलता_फलन
        स्वयं.विफलता_फलन = विफलता_फलन

    कर्म सफलता(स्वयं, परिणाम):
        यदि स्वयं.सफलता_फलन != शून्य:
            चर फलन = स्वयं.सफलता_फलन
            फलन(परिणाम)

    कर्म विफलता(स्वयं, त्रुटि):
        यदि स्वयं.विफलता_फलन != शून्य:
            चर फलन = स्वयं.विफलता_फलन
            फलन(त्रुटि)


वर्ग वादा:
    कर्म प्रारम्भ(स्वयं):
        स्वयं.अवस्था = "लंबित"
        स्वयं.परिणाम = शून्य
        स्वयं.त्रुटि = शून्य
        स्वयं.श्रोता_सूची = []

    कर्म पूर्ण_करो(स्वयं, परिणाम):
        यदि स्वयं.अवस्था != "लंबित":
            प्रत्यागच्छ असत्य

        स्वयं.अवस्था = "पूर्ण"
        स्वयं.परिणाम = परिणाम

        प्रत्येक चर श्रोता अन्तर्गत स्वयं.श्रोता_सूची:
            श्रोता.सफलता(परिणाम)

        स्वयं.श्रोता_सूची = []
        प्रत्यागच्छ सत्य

    कर्म विफल_करो(स्वयं, त्रुटि):
        यदि स्वयं.अवस्था != "लंबित":
            प्रत्यागच्छ असत्य

        स्वयं.अवस्था = "विफल"
        स्वयं.त्रुटि = त्रुटि

        प्रत्येक चर श्रोता अन्तर्गत स्वयं.श्रोता_सूची:
            श्रोता.विफलता(त्रुटि)

        स्वयं.श्रोता_सूची = []
        प्रत्यागच्छ सत्य

    कर्म तब_वस्तु(स्वयं, श्रोता_वस्तु):
        यदि स्वयं.अवस्था == "पूर्ण":
            श्रोता_वस्तु.सफलता(स्वयं.परिणाम)
        अन्यत् स्वयं.अवस्था == "विफल":
            श्रोता_वस्तु.विफलता(स्वयं.त्रुटि)
        अन्यथा:
            स्वयं.श्रोता_सूची.जोड़ो(श्रोता_वस्तु)
        प्रत्यागच्छ स्वयं

    कर्म तब(स्वयं, सफलता_कॉलबैक, विफलता_कॉलबैक):
        चर श्रोता = नव मूल_श्रोता(सफलता_कॉलबैक, विफलता_कॉलबैक)
        प्रत्यागच्छ स्वयं.तब_वस्तु(श्रोता)


वर्ग _सब_स्थिति:
    कर्म प्रारम्भ(स्वयं, कुल, परिणाम_वादा):
        स्वयं.पूर्ण_संख्या = ०
        स्वयं.विफल = असत्य
        स्वयं.परिणाम_सूची = []
        स्वयं.परिणाम_वादा = परिणाम_वादा
        स्वयं.कुल = कुल
        चर i = ०
        यावत् i < कुल:
            स्वयं.परिणाम_सूची.जोड़ो(शून्य)
            i = i + १


वर्ग _सब_श्रोता:
    कर्म प्रारम्भ(स्वयं, स्थिति, सूचकांक):
        स्वयं.स्थिति = स्थिति
        स्वयं.सूचकांक = सूचकांक

    कर्म सफलता(स्वयं, परिणाम):
        यदि स्वयं.स्थिति.विफल:
            प्रत्यागच्छ शून्य
        स्वयं.स्थिति.परिणाम_सूची[स्वयं.सूचकांक] = परिणाम
        स्वयं.स्थिति.पूर्ण_संख्या = स्वयं.स्थिति.पूर्ण_संख्या + १
        यदि स्वयं.स्थिति.पूर्ण_संख्या == स्वयं.स्थिति.कुल:
            स्वयं.स्थिति.परिणाम_वादा.पूर्ण_करो(स्वयं.स्थिति.परिणाम_सूची)

    कर्म विफलता(स्वयं, त्रुटि):
        यदि न स्वयं.स्थिति.विफल:
            स्वयं.स्थिति.विफल = सत्य
            स्वयं.स्थिति.परिणाम_वादा.विफल_करो(त्रुटि)


वर्ग _कोई_भी_स्थिति:
    कर्म प्रारम्भ(स्वयं, परिणाम_वादा):
        स्वयं.समाप्त = असत्य
        स्वयं.परिणाम_वादा = परिणाम_वादा


वर्ग _कोई_भी_श्रोता:
    कर्म प्रारम्भ(स्वयं, स्थिति):
        स्वयं.स्थिति = स्थिति

    कर्म सफलता(स्वयं, परिणाम):
        यदि न स्वयं.स्थिति.समाप्त:
            स्वयं.स्थिति.समाप्त = सत्य
            स्वयं.स्थिति.परिणाम_वादा.पूर्ण_करो(परिणाम)

    कर्म विफलता(स्वयं, त्रुटि):
        यदि न स्वयं.स्थिति.समाप्त:
            स्वयं.स्थिति.समाप्त = सत्य
            स्वयं.स्थिति.परिणाम_वादा.विफल_करो(त्रुटि)


वर्ग वादा_यंत्र:
    कर्म प्रारम्भ(स्वयं):
        प्रत्यागच्छ शून्य

    कर्म सब(स्वयं, वादे_सूची):
        चर परिणाम_वादा = नव वादा()
        चर कुल = दीर्घता(वादे_सूची)

        यदि कुल == ०:
            परिणाम_वादा.पूर्ण_करो([])
            प्रत्यागच्छ परिणाम_वादा

        चर स्थिति = नव _सब_स्थिति(कुल, परिणाम_वादा)

        चर सूचकांक = ०
        यावत् सूचकांक < कुल:
            चर व = वादे_सूची[सूचकांक]
            चर श्रोता = नव _सब_श्रोता(स्थिति, सूचकांक)
            व.तब_वस्तु(श्रोता)
            सूचकांक = सूचकांक + १

        प्रत्यागच्छ परिणाम_वादा

    कर्म कोई_भी(स्वयं, वादे_सूची):
        चर परिणाम_वादा = नव वादा()
        चर स्थिति = नव _कोई_भी_स्थिति(परिणाम_वादा)

        प्रत्येक चर व अन्तर्गत वादे_सूची:
            चर श्रोता = नव _कोई_भी_श्रोता(स्थिति)
            व.तब_वस्तु(श्रोता)

        प्रत्यागच्छ परिणाम_वादा
