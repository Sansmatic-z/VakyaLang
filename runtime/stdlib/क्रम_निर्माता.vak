# वाक् मानक पुस्तकालय — क्रम निर्माता (ID Generation)

आयात बायाँ_पैड, तार_प्रतिस्थापन से bhasha_prasadan
आयात दशमलव_से_षोडशभुज से upayogita

चर _क्रमांक = ०


कर्म अगला_क्रम():
    वैश्विक _क्रमांक
    _क्रमांक += १
    प्रत्यागच्छ _क्रमांक


कर्म उपसर्ग_बनाओ(उपसर्ग):
    प्रत्यागच्छ पाठ_कर(उपसर्ग) + "_" + पाठ_कर(अगला_क्रम())


कर्म छोटा_यूयुआईडी():
    चर आधार = अगला_क्रम()
    चर भाग_१ = बायाँ_पैड(दशमलव_से_षोडशभुज(आधार), ४, "0")
    चर भाग_२ = बायाँ_पैड(दशमलव_से_षोडशभुज(आधार * ३७), ४, "0")
    प्रत्यागच्छ भाग_१ + भाग_२


कर्म स्लग_बनाओ(आधार):
    चर पाठ = पाठ_कर(आधार)
    पाठ = तार_प्रतिस्थापन(पाठ, " ", "-")
    पाठ = तार_प्रतिस्थापन(पाठ, "_", "-")
    प्रत्यागच्छ पाठ + "-" + पाठ_कर(अगला_क्रम())
