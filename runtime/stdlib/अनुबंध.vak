# वाक् मानक पुस्तकालय — अनुबंध (Design by Contract)

कर्म आवश्यक(स्थिति, संदेश="पूर्वापेक्षा विफल"):
    यदि न स्थिति:
        उत्क्षिप "अनुबंध विफल (पूर्वापेक्षा): " + पाठ_कर(संदेश)


कर्म सुनिश्चित(स्थिति, संदेश="उत्तरापेक्षा विफल"):
    यदि न स्थिति:
        उत्क्षिप "अनुबंध विफल (उत्तरापेक्षा): " + पाठ_कर(संदेश)


कर्म अचल_जाँच(वस्तु, अचल_कार्य, संदेश="अचल शर्त विफल"):
    यदि न अचल_कार्य(वस्तु):
        उत्क्षिप "अनुबंध विफल (अचल): " + पाठ_कर(संदेश)


कर्म सीमा_जाँच(मान, निम्न, उच्च, नाम="मान"):
    यदि मान < निम्न अथवा मान > उच्च:
        उत्क्षिप "सीमा उल्लंघन: " + पाठ_कर(नाम) + " के लिए " + पाठ_कर(निम्न) + " से " + पाठ_कर(उच्च) + " अपेक्षित, " + पाठ_कर(मान) + " मिला"
    प्रत्यागच्छ मान


कर्म अशून्य_जाँच(मान, नाम="मान"):
    यदि मान == शून्य:
        उत्क्षिप "शून्य त्रुटि: " + पाठ_कर(नाम) + " शून्य नहीं हो सकता"
    प्रत्यागच्छ मान


कर्म प्रकार_जाँच(मान, अपेक्षित_प्रकार, नाम="मान"):
    चर वास्तविक = प्रकार(मान)
    यदि वास्तविक != अपेक्षित_प्रकार:
        उत्क्षिप "प्रकार त्रुटि: " + पाठ_कर(नाम) + " के लिए " + पाठ_कर(अपेक्षित_प्रकार) + " अपेक्षित, " + पाठ_कर(वास्तविक) + " मिला"
    प्रत्यागच्छ मान
