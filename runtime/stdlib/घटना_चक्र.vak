# वाक् मानक पुस्तकालय — घटना चक्र (Event Emitter)

कर्म उत्सर्जक_बनाओ():
    प्रत्यागच्छ {"श्रोता": {}, "एक_बार": {}}


कर्म सुनो(उत्सर्जक, घटना, फलन):
    यदि न (घटना in उत्सर्जक["श्रोता"]):
        उत्सर्जक["श्रोता"][घटना] = []
    उत्सर्जक["श्रोता"][घटना].जोड़ो(फलन)
    प्रत्यागच्छ फलन


कर्म उत्सर्जित_करो(उत्सर्जक, घटना, आंकड़ा=शून्य):
    यदि न (घटना in उत्सर्जक["श्रोता"]):
        प्रत्यागच्छ ०

    चर चलाए_गए = ०
    चर श्रोता = उत्सर्जक["श्रोता"][घटना]
    चर नया_श्रोता = []
    चर एक_बार_सूची = []
    यदि घटना in उत्सर्जक["एक_बार"]:
        एक_बार_सूची = उत्सर्जक["एक_बार"][घटना]

    प्रत्येक चर फलन अन्तर्गत श्रोता:
        फलन(आंकड़ा)
        चलाए_गए += १
        यदि न (फलन in एक_बार_सूची):
            नया_श्रोता.जोड़ो(फलन)

    उत्सर्जक["श्रोता"][घटना] = नया_श्रोता
    यदि घटना in उत्सर्जक["एक_बार"]:
        उत्सर्जक["एक_बार"][घटना] = []
    प्रत्यागच्छ चलाए_गए


कर्म हटाओ_सुनो(उत्सर्जक, घटना, फलन):
    यदि न (घटना in उत्सर्जक["श्रोता"]):
        प्रत्यागच्छ असत्य

    चर नया = []
    चर हटाया = असत्य
    प्रत्येक चर वर्तमान अन्तर्गत उत्सर्जक["श्रोता"][घटना]:
        यदि वर्तमान == फलन:
            हटाया = सत्य
        यदि वर्तमान != फलन:
            नया.जोड़ो(वर्तमान)
    उत्सर्जक["श्रोता"][घटना] = नया

    यदि घटना in उत्सर्जक["एक_बार"]:
        चर नया_एक_बार = []
        प्रत्येक चर वर्तमान अन्तर्गत उत्सर्जक["एक_बार"][घटना]:
            यदि वर्तमान != फलन:
                नया_एक_बार.जोड़ो(वर्तमान)
        उत्सर्जक["एक_बार"][घटना] = नया_एक_बार

    प्रत्यागच्छ हटाया


कर्म एक_बार(उत्सर्जक, घटना, फलन):
    यदि न (घटना in उत्सर्जक["एक_बार"]):
        उत्सर्जक["एक_बार"][घटना] = []
    उत्सर्जक["एक_बार"][घटना].जोड़ो(फलन)
    सुनो(उत्सर्जक, घटना, फलन)
    प्रत्यागच्छ फलन
