# वाक् मानक पुस्तकालय — अक्षर चित्र (Text Canvas)

कर्म कैनवास_बनाओ(चौड़ाई, ऊँचाई, पृष्ठभूमि=" "):
    चर पंक्तियाँ = []
    चर y = ०
    यावत् y < ऊँचाई:
        चर पंक्ति = ""
        चर x = ०
        यावत् x < चौड़ाई:
            पंक्ति = पंक्ति + पृष्ठभूमि
            x += १
        पंक्तियाँ.जोड़ो(पंक्ति)
        y += १
    प्रत्यागच्छ {"चौड़ाई": चौड़ाई, "ऊँचाई": ऊँचाई, "पंक्तियाँ": पंक्तियाँ}


कर्म कैनवास_बिंदु(कैनवास, x, y, अक्षर):
    यदि y < ० अथवा y >= कैनवास["ऊँचाई"]:
        प्रत्यागच्छ कैनवास
    यदि x < ० अथवा x >= कैनवास["चौड़ाई"]:
        प्रत्यागच्छ कैनवास
    चर पंक्ति = कैनवास["पंक्तियाँ"][y]
    कैनवास["पंक्तियाँ"][y] = पंक्ति[०:x] + अक्षर + पंक्ति[x + १:कैनवास["चौड़ाई"]]
    प्रत्यागच्छ कैनवास


कर्म कैनवास_रेखा(कैनवास, x1, y1, x2, y2, अक्षर="*"):
    यदि y1 == y2:
        चर x = न्यूनतम(x1, x2)
        चर अंत = अधिकतम(x1, x2)
        यावत् x <= अंत:
            कैनवास_बिंदु(कैनवास, x, y1, अक्षर)
            x += १
        प्रत्यागच्छ कैनवास

    यदि x1 == x2:
        चर y = न्यूनतम(y1, y2)
        चर अंत = अधिकतम(y1, y2)
        यावत् y <= अंत:
            कैनवास_बिंदु(कैनवास, x1, y, अक्षर)
            y += १
        प्रत्यागच्छ कैनवास

    चर dx = x2 - x1
    चर dy = y2 - y1
    चर कदम = परम(dx)
    यदि परम(dy) > कदम:
        कदम = परम(dy)
    यदि कदम == ०:
        कैनवास_बिंदु(कैनवास, x1, y1, अक्षर)
        प्रत्यागच्छ कैनवास

    चर ग = ०
    यावत् ग <= कदम:
        चर x = पूर्णांक_कर(x1 + (dx * ग) / कदम)
        चर y = पूर्णांक_कर(y1 + (dy * ग) / कदम)
        कैनवास_बिंदु(कैनवास, x, y, अक्षर)
        ग += १
    प्रत्यागच्छ कैनवास


कर्म कैनवास_आयत(कैनवास, x, y, चौड़ाई, ऊँचाई, अक्षर="#", भरा=असत्य):
    यदि भरा:
        चर row = ०
        यावत् row < ऊँचाई:
            कैनवास_रेखा(कैनवास, x, y + row, x + चौड़ाई - १, y + row, अक्षर)
            row += १
        प्रत्यागच्छ कैनवास

    कैनवास_रेखा(कैनवास, x, y, x + चौड़ाई - १, y, अक्षर)
    कैनवास_रेखा(कैनवास, x, y + ऊँचाई - १, x + चौड़ाई - १, y + ऊँचाई - १, अक्षर)
    कैनवास_रेखा(कैनवास, x, y, x, y + ऊँचाई - १, अक्षर)
    कैनवास_रेखा(कैनवास, x + चौड़ाई - १, y, x + चौड़ाई - १, y + ऊँचाई - १, अक्षर)
    प्रत्यागच्छ कैनवास


कर्म कैनवास_पाठ(कैनवास, x, y, पाठ):
    चर ग = ०
    यावत् ग < दीर्घता(पाठ):
        कैनवास_बिंदु(कैनवास, x + ग, y, पाठ[ग])
        ग += १
    प्रत्यागच्छ कैनवास


कर्म कैनवास_स्ट्रिंग(कैनवास):
    प्रत्यागच्छ संयोग(कैनवास["पंक्तियाँ"], "\n")


कर्म कैनवास_प्रदर्शन(कैनवास):
    मुद्रय कैनवास_स्ट्रिंग(कैनवास)
