स्थिर हेक्स_अंक = "0123456789ABCDEF"


कर्म पूर्णांक_मिलाओ(संख्या):
    यदि संख्या >= ०:
        प्रत्यागच्छ पूर्णांक_कर(संख्या + 0.5)
    प्रत्यागच्छ पूर्णांक_कर(संख्या - 0.5)


कर्म सीमित(मान, न्यूनतम_मान, अधिकतम_मान):
    यदि मान < न्यूनतम_मान:
        प्रत्यागच्छ न्यूनतम_मान
    यदि मान > अधिकतम_मान:
        प्रत्यागच्छ अधिकतम_मान
    प्रत्यागच्छ मान


कर्म _क्या_हेक्स_है(मान):
    चर पाठ = पाठ_कर(मान)
    यदि दीर्घता(पाठ) != 7:
        प्रत्यागच्छ असत्य
    यदि पाठ[0] != "#":
        प्रत्यागच्छ असत्य
    चर ग = 1
    यावत् ग < 7:
        यदि _हेक्स_वर्ण_मान(पाठ[ग]) == -1:
            प्रत्यागच्छ असत्य
        ग += 1
    प्रत्यागच्छ सत्य


कर्म _हेक्स_वर्ण_मान(वर्ण):
    चर च = निम्न(पाठ_कर(वर्ण))
    चर ग = 0
    यावत् ग < 16:
        यदि निम्न(हेक्स_अंक[ग]) == च:
            प्रत्यागच्छ ग
        ग += 1
    प्रत्यागच्छ -1


कर्म _द्वय_हेक्स(मान):
    चर पूर्ण = पूर्णांक_मिलाओ(सीमित(मान, ०, 255))
    चर उच्च = पूर्ण // 16
    चर निम्न_भाग = पूर्ण % 16
    प्रत्यागच्छ हेक्स_अंक[उच्च] + हेक्स_अंक[निम्न_भाग]


कर्म hex_से_rgb(हेक्स):
    चर पाठ = पाठ_कर(हेक्स)
    यदि दीर्घता(पाठ) == 4 और पाठ[0] == "#":
        पाठ = "#" + पाठ[1] + पाठ[1] + पाठ[2] + पाठ[2] + पाठ[3] + पाठ[3]
    यदि न _क्या_हेक्स_है(पाठ):
        उत्क्षिप "अमान्य hex रंग: " + पाठ_कर(हेक्स)
    प्रत्यागच्छ {
        "र": _हेक्स_वर्ण_मान(पाठ[1]) * 16 + _हेक्स_वर्ण_मान(पाठ[2]),
        "ह": _हेक्स_वर्ण_मान(पाठ[3]) * 16 + _हेक्स_वर्ण_मान(पाठ[4]),
        "नी": _हेक्स_वर्ण_मान(पाठ[5]) * 16 + _हेक्स_वर्ण_मान(पाठ[6]),
    }


कर्म rgb_से_hex(र, ह, नी):
    प्रत्यागच्छ "#" + _द्वय_हेक्स(र) + _द्वय_हेक्स(ह) + _द्वय_हेक्स(नी)


कर्म rgb_से_स्ट्रिंग(र, ह, नी):
    प्रत्यागच्छ "rgb(" + पाठ_कर(पूर्णांक_मिलाओ(र)) + "," + पाठ_कर(पूर्णांक_मिलाओ(ह)) + "," + पाठ_कर(पूर्णांक_मिलाओ(नी)) + ")"


कर्म rgba_से_स्ट्रिंग(र, ह, नी, अल्फा):
    प्रत्यागच्छ "rgba(" + पाठ_कर(पूर्णांक_मिलाओ(र)) + "," + पाठ_कर(पूर्णांक_मिलाओ(ह)) + "," + पाठ_कर(पूर्णांक_मिलाओ(नी)) + "," + पाठ_कर(अल्फा) + ")"


कर्म प्राप्त(नाम):
    यदि नाम == शून्य:
        प्रत्यागच्छ शून्य
    चर पाठ = छाँटो(पाठ_कर(नाम))
    यदि _क्या_हेक्स_है(पाठ):
        प्रत्यागच्छ उच्च(पाठ)
    यदि पाठ अन्तर्गत संस्कृत_रंग:
        प्रत्यागच्छ संस्कृत_रंग[पाठ]
    चर छोटा = निम्न(पाठ)
    यदि छोटा अन्तर्गत css_रंग:
        प्रत्यागच्छ css_रंग[छोटा]
    यदि छोटा अन्तर्गत tailwind_रंग:
        प्रत्यागच्छ tailwind_रंग[छोटा]
    यदि छोटा अन्तर्गत material_रंग:
        प्रत्यागच्छ material_रंग[छोटा]
    प्रत्यागच्छ शून्य


कर्म प्राप्त_rgb(नाम):
    चर रंग = प्राप्त(नाम)
    यदि रंग == शून्य:
        प्रत्यागच्छ शून्य
    प्रत्यागच्छ hex_से_rgb(रंग)


कर्म गिनती():
    चर कुल = 0
    प्रत्येक चर श्रेणी अन्तर्गत कुंजियाँ(सभी_रंग):
        कुल += दीर्घता(कुंजियाँ(सभी_रंग[श्रेणी]))
    प्रत्यागच्छ कुल


कर्म _रंग_rgb_कर(रंग):
    यदि रंग == शून्य:
        प्रत्यागच्छ {"र": 0, "ह": 0, "नी": 0}
    यदि प्रकार(रंग) == "dict":
        यदि ("र" अन्तर्गत रंग) और ("ह" अन्तर्गत रंग) और ("नी" अन्तर्गत रंग):
            प्रत्यागच्छ रंग
    चर resolved = प्राप्त(रंग)
    यदि resolved != शून्य:
        प्रत्यागच्छ hex_से_rgb(resolved)
    उत्क्षिप "अमान्य रंग: " + पाठ_कर(रंग)


कर्म _svg_रंग_पाठ(रंग, अन्यथा_मान="none"):
    यदि रंग == शून्य:
        प्रत्यागच्छ अन्यथा_मान
    चर resolved = प्राप्त(रंग)
    यदि resolved != शून्य:
        प्रत्यागच्छ resolved
    प्रत्यागच्छ पाठ_कर(रंग)


कर्म _ह्यू_सहायक(t1, t2, hue):
    यदि hue < 0:
        hue = hue + 1
    यदि hue > 1:
        hue = hue - 1
    यदि hue < 0.166667:
        प्रत्यागच्छ t1 + (t2 - t1) * 6 * hue
    यदि hue < 0.5:
        प्रत्यागच्छ t2
    यदि hue < 0.666667:
        प्रत्यागच्छ t1 + (t2 - t1) * (0.666667 - hue) * 6
    प्रत्यागच्छ t1


कर्म hsl_से_rgb(व, त, प्र):
    चर h = ((व % 360) + 360) % 360 / 360
    चर s = सीमित(त, 0, 100) / 100
    चर l = सीमित(प्र, 0, 100) / 100

    यदि s == 0:
        चर gray = पूर्णांक_मिलाओ(l * 255)
        प्रत्यागच्छ {"र": gray, "ह": gray, "नी": gray}

    चर t2 = 0
    यदि l < 0.5:
        t2 = l * (1 + s)
    अन्यथा:
        t2 = l + s - l * s
    चर t1 = 2 * l - t2

    प्रत्यागच्छ {
        "र": पूर्णांक_मिलाओ(_ह्यू_सहायक(t1, t2, h + 0.333333) * 255),
        "ह": पूर्णांक_मिलाओ(_ह्यू_सहायक(t1, t2, h) * 255),
        "नी": पूर्णांक_मिलाओ(_ह्यू_सहायक(t1, t2, h - 0.333333) * 255),
    }


कर्म rgb_से_hsl(र, ह, नी):
    चर r = सीमित(र, 0, 255) / 255
    चर g = सीमित(ह, 0, 255) / 255
    चर b = सीमित(नी, 0, 255) / 255

    चर अधिक = अधिकतम(r, अधिकतम(g, b))
    चर न्यून = न्यूनतम(r, न्यूनतम(g, b))
    चर प्रकाश = (अधिक + न्यून) / 2

    यदि अधिक == न्यून:
        प्रत्यागच्छ {"व": 0, "त": 0, "प्र": पूर्णांक_मिलाओ(प्रकाश * 100)}

    चर delta = अधिक - न्यून
    चर संतृप्ति = 0
    यदि प्रकाश > 0.5:
        संतृप्ति = delta / (2 - अधिक - न्यून)
    अन्यथा:
        संतृप्ति = delta / (अधिक + न्यून)

    चर hue = 0
    यदि अधिक == r:
        hue = (g - b) / delta
        यदि g < b:
            hue = hue + 6
    अन्यथा यदि अधिक == g:
        hue = ((b - r) / delta) + 2
    अन्यथा:
        hue = ((r - g) / delta) + 4

    hue = hue / 6
    प्रत्यागच्छ {
        "व": पूर्णांक_मिलाओ(hue * 360),
        "त": पूर्णांक_मिलाओ(संतृप्ति * 100),
        "प्र": पूर्णांक_मिलाओ(प्रकाश * 100),
    }


कर्म hsl_रंग(व, त, प्र):
    चर rgb = hsl_से_rgb(व, त, प्र)
    प्रत्यागच्छ rgb_से_hex(rgb["र"], rgb["ह"], rgb["नी"])


कर्म तरंगदैर्ध्य_से_rgb(तरंगदैर्ध्य):
    चर w = सीमित(तरंगदैर्ध्य, 380, 780)
    चर r = 0.0
    चर g = 0.0
    चर b = 0.0

    यदि w < 440:
        r = (440 - w) / 60
        b = 1
    अन्यथा यदि w < 490:
        g = (w - 440) / 50
        b = 1
    अन्यथा यदि w < 510:
        g = 1
        b = (510 - w) / 20
    अन्यथा यदि w < 580:
        r = (w - 510) / 70
        g = 1
    अन्यथा यदि w < 645:
        r = 1
        g = (645 - w) / 65
    अन्यथा:
        r = 1

    चर factor = 1.0
    यदि w < 420:
        factor = 0.3 + 0.7 * (w - 380) / 40
    अन्यथा यदि w > 700:
        factor = 0.3 + 0.7 * (780 - w) / 80

    प्रत्यागच्छ {
        "र": पूर्णांक_मिलाओ((r ** 0.8) * 255 * factor),
        "ह": पूर्णांक_मिलाओ((g ** 0.8) * 255 * factor),
        "नी": पूर्णांक_मिलाओ((b ** 0.8) * 255 * factor),
    }


कर्म तरंगदैर्ध्य_रंग(तरंगदैर्ध्य):
    चर rgb = तरंगदैर्ध्य_से_rgb(तरंगदैर्ध्य)
    प्रत्यागच्छ rgb_से_hex(rgb["र"], rgb["ह"], rgb["नी"])


कर्म तापमान_से_rgb(केल्विन):
    चर t = सीमित(केल्विन, 1000, 40000) / 100
    चर r = 255
    चर g = 255
    चर b = 255

    यदि t <= 66:
        g = सीमित(99.4708 * वर्गमूल(t) - 161.1196, 0, 255)
        यदि t <= 19:
            b = 0
        अन्यथा:
            b = सीमित(138.5177 * वर्गमूल(t - 10) - 305.0448, 0, 255)
    अन्यथा:
        r = सीमित(329.6987 * ((t - 60) ** -0.133205), 0, 255)
        g = सीमित(288.1222 * ((t - 60) ** -0.075515), 0, 255)

    प्रत्यागच्छ {
        "र": पूर्णांक_मिलाओ(r),
        "ह": पूर्णांक_मिलाओ(g),
        "नी": पूर्णांक_मिलाओ(b),
    }


कर्म तापमान_रंग(केल्विन):
    चर rgb = तापमान_से_rgb(केल्विन)
    प्रत्यागच्छ rgb_से_hex(rgb["र"], rgb["ह"], rgb["नी"])


कर्म मिश्रण(रंग१, रंग२, अनुपात):
    चर a = _रंग_rgb_कर(रंग१)
    चर b = _रंग_rgb_कर(रंग२)
    चर t = सीमित(अनुपात, 0, 1)
    प्रत्यागच्छ rgb_से_hex(
        a["र"] * (1 - t) + b["र"] * t,
        a["ह"] * (1 - t) + b["ह"] * t,
        a["नी"] * (1 - t) + b["नी"] * t,
    )


कर्म प्रकाशित(रंग, मात्रा=10):
    चर rgb = _रंग_rgb_कर(रंग)
    चर hsl = rgb_से_hsl(rgb["र"], rgb["ह"], rgb["नी"])
    प्रत्यागच्छ hsl_रंग(hsl["व"], hsl["त"], सीमित(hsl["प्र"] + मात्रा, 0, 100))


कर्म अंधकारित(रंग, मात्रा=10):
    चर rgb = _रंग_rgb_कर(रंग)
    चर hsl = rgb_से_hsl(rgb["र"], rgb["ह"], rgb["नी"])
    प्रत्यागच्छ hsl_रंग(hsl["व"], hsl["त"], सीमित(hsl["प्र"] - मात्रा, 0, 100))


कर्म पूरक(रंग):
    चर rgb = _रंग_rgb_कर(रंग)
    चर hsl = rgb_से_hsl(rgb["र"], rgb["ह"], rgb["नी"])
    प्रत्यागच्छ hsl_रंग((hsl["व"] + 180) % 360, hsl["त"], hsl["प्र"])


कर्म रंग_दूरी(रंग१, रंग२):
    चर a = _रंग_rgb_कर(रंग१)
    चर b = _रंग_rgb_कर(रंग२)
    चर dr = a["र"] - b["र"]
    चर dg = a["ह"] - b["ह"]
    चर db = a["नी"] - b["नी"]
    प्रत्यागच्छ वर्गमूल(dr * dr + dg * dg + db * db)


कर्म चमक(रंग):
    चर rgb = _रंग_rgb_कर(रंग)
    प्रत्यागच्छ 0.299 * rgb["र"] + 0.587 * rgb["ह"] + 0.114 * rgb["नी"]


कर्म पाठ_रंग(पृष्ठभूमि):
    यदि चमक(पृष्ठभूमि) > 186:
        प्रत्यागच्छ "#000000"
    प्रत्यागच्छ "#FFFFFF"


कर्म पूरक_श्रेणी(रंग):
    प्रत्यागच्छ [प्राप्त(रंग), पूरक(रंग)]


कर्म समान_श्रेणी(रंग, कोण=30):
    चर rgb = _रंग_rgb_कर(रंग)
    चर hsl = rgb_से_hsl(rgb["र"], rgb["ह"], rgb["नी"])
    प्रत्यागच्छ [
        hsl_रंग((hsl["व"] - कोण + 360) % 360, hsl["त"], hsl["प्र"]),
        hsl_रंग(hsl["व"], hsl["त"], hsl["प्र"]),
        hsl_रंग((hsl["व"] + कोण) % 360, hsl["त"], hsl["प्र"]),
    ]


कर्म त्रिशीर्षी(रंग):
    चर rgb = _रंग_rgb_कर(रंग)
    चर hsl = rgb_से_hsl(rgb["र"], rgb["ह"], rgb["नी"])
    प्रत्यागच्छ [
        hsl_रंग(hsl["व"], hsl["त"], hsl["प्र"]),
        hsl_रंग((hsl["व"] + 120) % 360, hsl["त"], hsl["प्र"]),
        hsl_रंग((hsl["व"] + 240) % 360, hsl["त"], hsl["प्र"]),
    ]


कर्म रैखिक_ढाल(रंग१, रंग२, चरण):
    चर परिणाम = []
    यदि चरण <= 1:
        परिणाम.जोड़ो(प्राप्त(रंग१))
        प्रत्यागच्छ परिणाम
    चर ग = 0
    यावत् ग < चरण:
        परिणाम.जोड़ो(मिश्रण(रंग१, रंग२, ग / (चरण - 1)))
        ग += 1
    प्रत्यागच्छ परिणाम


कर्म वर्ण_वर्णक्रम(चरण):
    चर परिणाम = []
    यदि चरण <= 0:
        प्रत्यागच्छ परिणाम
    चर ग = 0
    यावत् ग < चरण:
        परिणाम.जोड़ो(hsl_रंग((ग * 360) / चरण, 100, 50))
        ग += 1
    प्रत्यागच्छ परिणाम


कर्म स्पेक्ट्रम_ढाल(प्रारंभ_nm, अंत_nm, चरण):
    चर परिणाम = []
    यदि चरण <= 1:
        परिणाम.जोड़ो(तरंगदैर्ध्य_रंग(प्रारंभ_nm))
        प्रत्यागच्छ परिणाम
    चर ग = 0
    यावत् ग < चरण:
        चर तरंग = प्रारंभ_nm + (अंत_nm - प्रारंभ_nm) * ग / (चरण - 1)
        परिणाम.जोड़ो(तरंगदैर्ध्य_रंग(तरंग))
        ग += 1
    प्रत्यागच्छ परिणाम


कर्म svg_आरम्भ(चौड़ाई, ऊंचाई):
    प्रत्यागच्छ [
        "<?xml version=\"1.0\" encoding=\"UTF-8\"?>",
        "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"" + पाठ_कर(चौड़ाई) + "\" height=\"" + पाठ_कर(ऊंचाई) + "\" viewBox=\"0 0 " + पाठ_कर(चौड़ाई) + " " + पाठ_कर(ऊंचाई) + "\">"
    ]


कर्म svg_समाप्त(निर्माता):
    निर्माता.जोड़ो("</svg>")
    प्रत्यागच्छ निर्माता


कर्म svg_आयत(निर्माता, x, y, चौड़ाई, ऊंचाई, भरण, सीमा="none", सीमा_चौड़ाई=1):
    निर्माता.जोड़ो("  <rect x=\"" + पाठ_कर(x) + "\" y=\"" + पाठ_कर(y) + "\" width=\"" + पाठ_कर(चौड़ाई) + "\" height=\"" + पाठ_कर(ऊंचाई) + "\" fill=\"" + _svg_रंग_पाठ(भरण, "none") + "\" stroke=\"" + _svg_रंग_पाठ(सीमा, "none") + "\" stroke-width=\"" + पाठ_कर(सीमा_चौड़ाई) + "\"/>")
    प्रत्यागच्छ निर्माता


कर्म svg_वृत्त(निर्माता, cx, cy, त्रिज्या, भरण, सीमा="none", सीमा_चौड़ाई=1):
    निर्माता.जोड़ो("  <circle cx=\"" + पाठ_कर(cx) + "\" cy=\"" + पाठ_कर(cy) + "\" r=\"" + पाठ_कर(त्रिज्या) + "\" fill=\"" + _svg_रंग_पाठ(भरण, "none") + "\" stroke=\"" + _svg_रंग_पाठ(सीमा, "none") + "\" stroke-width=\"" + पाठ_कर(सीमा_चौड़ाई) + "\"/>")
    प्रत्यागच्छ निर्माता


कर्म svg_रेखा(निर्माता, x1, y1, x2, y2, रंग, मोटाई=1):
    निर्माता.जोड़ो("  <line x1=\"" + पाठ_कर(x1) + "\" y1=\"" + पाठ_कर(y1) + "\" x2=\"" + पाठ_कर(x2) + "\" y2=\"" + पाठ_कर(y2) + "\" stroke=\"" + _svg_रंग_पाठ(रंग, "#000000") + "\" stroke-width=\"" + पाठ_कर(मोटाई) + "\"/>")
    प्रत्यागच्छ निर्माता


कर्म svg_पाठ(निर्माता, x, y, सामग्री, रंग="#000000", आकार=16):
    निर्माता.जोड़ो("  <text x=\"" + पाठ_कर(x) + "\" y=\"" + पाठ_कर(y) + "\" fill=\"" + _svg_रंग_पाठ(रंग, "#000000") + "\" font-size=\"" + पाठ_कर(आकार) + "\" font-family=\"sans-serif\">" + पाठ_कर(सामग्री) + "</text>")
    प्रत्यागच्छ निर्माता


कर्म svg_रेखीय_ढाल(निर्माता, x1, y1, x2, y2, रंग१, रंग२, आईडी="grad1"):
    निर्माता.जोड़ो("  <defs>")
    निर्माता.जोड़ो("    <linearGradient id=\"" + पाठ_कर(आईडी) + "\" x1=\"" + पाठ_कर(x1) + "\" y1=\"" + पाठ_कर(y1) + "\" x2=\"" + पाठ_कर(x2) + "\" y2=\"" + पाठ_कर(y2) + "\">")
    निर्माता.जोड़ो("      <stop offset=\"0%\" stop-color=\"" + _svg_रंग_पाठ(रंग१, "#000000") + "\"/>")
    निर्माता.जोड़ो("      <stop offset=\"100%\" stop-color=\"" + _svg_रंग_पाठ(रंग२, "#FFFFFF") + "\"/>")
    निर्माता.जोड़ो("    </linearGradient>")
    निर्माता.जोड़ो("  </defs>")
    प्रत्यागच्छ निर्माता


कर्म svg_स्तर_ढाल(निर्माता, रंग_श्रेणी, आईडी="layerGrad"):
    चर चरण = दीर्घता(रंग_श्रेणी)
    यदि चरण < 2:
        प्रत्यागच्छ निर्माता
    निर्माता.जोड़ो("  <defs>")
    निर्माता.जोड़ो("    <linearGradient id=\"" + पाठ_कर(आईडी) + "\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"0\">")
    चर ग = 0
    यावत् ग < चरण:
        चर प्रतिशत = पूर्णांक_मिलाओ((ग / (चरण - 1)) * 100)
        निर्माता.जोड़ो("      <stop offset=\"" + पाठ_कर(प्रतिशत) + "%\" stop-color=\"" + _svg_रंग_पाठ(रंग_श्रेणी[ग], "#000000") + "\"/>")
        ग += 1
    निर्माता.जोड़ो("    </linearGradient>")
    निर्माता.जोड़ो("  </defs>")
    प्रत्यागच्छ निर्माता


कर्म svg_स्पेक्ट्रम_पट्टी(निर्माता, x, y, चौड़ाई, ऊंचाई, प्रारंभ_nm=380, अंत_nm=780):
    चर श्रेणी = स्पेक्ट्रम_ढाल(प्रारंभ_nm, अंत_nm, चौड़ाई)
    चर ग = 0
    यावत् ग < चौड़ाई:
        निर्माता = svg_आयत(निर्माता, x + ग, y, 1, ऊंचाई, श्रेणी[ग], "none", 0)
        ग += 1
    प्रत्यागच्छ निर्माता


कर्म svg_स्ट्रिंग(निर्माता):
    यदि दीर्घता(निर्माता) == 0 अथवा निर्माता[दीर्घता(निर्माता) - 1] != "</svg>":
        निर्माता = svg_समाप्त(निर्माता)
    प्रत्यागच्छ संयोग(निर्माता, "\n")


कर्म svg_लिखो(निर्माता, पथ):
    लेखन(पथ, svg_स्ट्रिंग(निर्माता), "w")


कर्म ppm_आरम्भ(चौड़ाई, ऊंचाई, पृष्ठभूमि="#000000"):
    चर कुल = चौड़ाई * ऊंचाई
    चर पिक्सेल_सूची = []
    चर rgb = _रंग_rgb_कर(पृष्ठभूमि)
    चर ग = 0
    यावत् ग < कुल:
        पिक्सेल_सूची.जोड़ो(rgb["र"])
        पिक्सेल_सूची.जोड़ो(rgb["ह"])
        पिक्सेल_सूची.जोड़ो(rgb["नी"])
        ग += 1
    प्रत्यागच्छ {"चौड़ाई": चौड़ाई, "ऊंचाई": ऊंचाई, "डेटा": पिक्सेल_सूची}


कर्म ppm_पिक्सेल_सेट(चित्र, x, y, र, ह, नी):
    यदि x < 0 अथवा x >= चित्र["चौड़ाई"]:
        प्रत्यागच्छ असत्य
    यदि y < 0 अथवा y >= चित्र["ऊंचाई"]:
        प्रत्यागच्छ असत्य
    चर सूचकांक = (y * चित्र["चौड़ाई"] + x) * 3
    चित्र["डेटा"][सूचकांक] = पूर्णांक_मिलाओ(सीमित(र, 0, 255))
    चित्र["डेटा"][सूचकांक + 1] = पूर्णांक_मिलाओ(सीमित(ह, 0, 255))
    चित्र["डेटा"][सूचकांक + 2] = पूर्णांक_मिलाओ(सीमित(नी, 0, 255))
    प्रत्यागच्छ सत्य


कर्म ppm_पिक्सेल_हेक्स(चित्र, x, y, रंग):
    चर rgb = _रंग_rgb_कर(रंग)
    प्रत्यागच्छ ppm_पिक्सेल_सेट(चित्र, x, y, rgb["र"], rgb["ह"], rgb["नी"])


कर्म ppm_आयत(चित्र, x, y, चौड़ाई, ऊंचाई, रंग):
    चर dy = 0
    यावत् dy < ऊंचाई:
        चर dx = 0
        यावत् dx < चौड़ाई:
            ppm_पिक्सेल_हेक्स(चित्र, x + dx, y + dy, रंग)
            dx += 1
        dy += 1
    प्रत्यागच्छ चित्र


कर्म ppm_वृत्त(चित्र, cx, cy, त्रिज्या, रंग):
    चर y = cy - त्रिज्या
    यावत् y <= cy + त्रिज्या:
        चर x = cx - त्रिज्या
        यावत् x <= cx + त्रिज्या:
            चर dx = x - cx
            चर dy = y - cy
            यदि dx * dx + dy * dy <= त्रिज्या * त्रिज्या:
                ppm_पिक्सेल_हेक्स(चित्र, x, y, रंग)
            x += 1
        y += 1
    प्रत्यागच्छ चित्र


कर्म ppm_स्ट्रिंग(चित्र):
    चर पंक्तियाँ = ["P3", पाठ_कर(चित्र["चौड़ाई"]) + " " + पाठ_कर(चित्र["ऊंचाई"]), "255"]
    चर y = 0
    यावत् y < चित्र["ऊंचाई"]:
        चर टुकड़े = []
        चर x = 0
        यावत् x < चित्र["चौड़ाई"]:
            चर सूचकांक = (y * चित्र["चौड़ाई"] + x) * 3
            टुकड़े.जोड़ो(पाठ_कर(चित्र["डेटा"][सूचकांक]))
            टुकड़े.जोड़ो(पाठ_कर(चित्र["डेटा"][सूचकांक + 1]))
            टुकड़े.जोड़ो(पाठ_कर(चित्र["डेटा"][सूचकांक + 2]))
            x += 1
        पंक्तियाँ.जोड़ो(संयोग(टुकड़े, " "))
        y += 1
    प्रत्यागच्छ संयोग(पंक्तियाँ, "\n")


कर्म ppm_लिखो(चित्र, पथ):
    लेखन(पथ, ppm_स्ट्रिंग(चित्र), "w")
