# वाक् मानक पुस्तकालय — घटना_लूप (Tick Event Loop)
# Vak Standard Library — Pure Vak event loop helpers

वर्ग _फलन_रैपर:
    कर्म प्रारम्भ(स्वयं, फलन):
        स्वयं.फलन = फलन

    कर्म चलाओ(स्वयं):
        चर मेरा_फलन = स्वयं.फलन
        मेरा_फलन()


वर्ग घटना_लूप:
    कर्म प्रारम्भ(स्वयं):
        स्वयं.सूक्ष्म_कतार = []
        स्वयं.कार्य_कतार = []
        स्वयं.विलम्बित_कार्य = []
        स्वयं.टिक = ०
        स्वयं.चल_रहा_है = असत्य
        स्वयं.आईडी_काउंटर = ०

    कर्म सूक्ष्म_कार्य_जोड़ो(स्वयं, कार्य_फलन):
        चर रैपर = नव _फलन_रैपर(कार्य_फलन)
        स्वयं.सूक्ष्म_कतार.जोड़ो(रैपर)

    कर्म कार्य_जोड़ो(स्वयं, कार्य_फलन):
        चर रैपर = नव _फलन_रैपर(कार्य_फलन)
        स्वयं.कार्य_कतार.जोड़ो(रैपर)

    कर्म कार्य_जोड़ो_वस्तु(स्वयं, वस्तु):
        स्वयं.कार्य_कतार.जोड़ो(वस्तु)

    कर्म विलम्ब_जोड़ो(स्वयं, कार्य_फलन, टिक_विलम्ब):
        स्वयं.आईडी_काउंटर = स्वयं.आईडी_काउंटर + १
        चर लक्ष्य_टिक = स्वयं.टिक + टिक_विलम्ब
        चर रैपर = नव _फलन_रैपर(कार्य_फलन)
        स्वयं.विलम्बित_कार्य.जोड़ो([स्वयं.आईडी_काउंटर, लक्ष्य_टिक, रैपर])
        प्रत्यागच्छ स्वयं.आईडी_काउंटर

    कर्म विलम्ब_रद्द_करो(स्वयं, आईडी):
        चर नये_विलम्बित = []
        प्रत्येक चर विलम्ब_कार्य अन्तर्गत स्वयं.विलम्बित_कार्य:
            यदि विलम्ब_कार्य[०] != आईडी:
                नये_विलम्बित.जोड़ो(विलम्ब_कार्य)
        स्वयं.विलम्बित_कार्य = नये_विलम्बित

    कर्म _कतार_हटाओ_प्रथम(स्वयं, कतार):
        चर नई_कतार = []
        चर प्रथम = कतार[०]
        चर सूचकांक = १
        यावत् सूचकांक < दीर्घता(कतार):
            नई_कतार.जोड़ो(कतार[सूचकांक])
            सूचकांक = सूचकांक + १
        प्रत्यागच्छ [प्रथम, नई_कतार]

    कर्म _सूक्ष्म_कार्य_निपटाओ(स्वयं):
        यावत् दीर्घता(स्वयं.सूक्ष्म_कतार) > ०:
            चर परिणाम = स्वयं._कतार_हटाओ_प्रथम(स्वयं.सूक्ष्म_कतार)
            चर कार्य = परिणाम[०]
            स्वयं.सूक्ष्म_कतार = परिणाम[१]
            कार्य.चलाओ()

    कर्म एक_कदम(स्वयं):
        स्वयं._सूक्ष्म_कार्य_निपटाओ()
        स्वयं.टिक = स्वयं.टिक + १

        चर नये_विलम्बित = []
        प्रत्येक चर विलम्ब_कार्य अन्तर्गत स्वयं.विलम्बित_कार्य:
            चर लक्ष्य = विलम्ब_कार्य[१]
            चर वस्तु = विलम्ब_कार्य[२]
            यदि स्वयं.टिक >= लक्ष्य:
                स्वयं.कार्य_कतार.जोड़ो(वस्तु)
            अन्यथा:
                नये_विलम्बित.जोड़ो(विलम्ब_कार्य)
        स्वयं.विलम्बित_कार्य = नये_विलम्बित

        यदि दीर्घता(स्वयं.कार्य_कतार) > ०:
            चर परिणाम = स्वयं._कतार_हटाओ_प्रथम(स्वयं.कार्य_कतार)
            चर कार्य = परिणाम[०]
            स्वयं.कार्य_कतार = परिणाम[१]
            कार्य.चलाओ()
            स्वयं._सूक्ष्म_कार्य_निपटाओ()
            प्रत्यागच्छ सत्य

        यदि दीर्घता(स्वयं.विलम्बित_कार्य) > ०:
            प्रत्यागच्छ सत्य

        प्रत्यागच्छ असत्य

    कर्म चलाओ(स्वयं):
        स्वयं.चल_रहा_है = सत्य
        यावत् स्वयं.चल_रहा_है:
            चर कुछ_शेष_है = स्वयं.एक_कदम()
            यदि न कुछ_शेष_है:
                स्वयं.चल_रहा_है = असत्य
