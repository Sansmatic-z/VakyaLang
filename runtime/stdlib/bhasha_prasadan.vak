# वाक् मानक पुस्तकालय — भाषा प्रसंस्करण (Language Processing)
# Vak Standard Library — Text and Sanskrit Language Processing
# शुद्ध वाक् कार्यान्वयन (Pure VakyaLang Implementation)
# लेखक: Visionary RM (Raj Mitra)

# ── वर्णमाला और वर्ग (Alphabet and Character Classes) ──────────────────────

स्थिर स्वर = ["अ", "आ", "इ", "ई", "उ", "ऊ", "ऋ", "ॠ", "ऌ", "ॡ", "ए", "ऐ", "ओ", "औ"]
स्थिर व्यंजन = [
    "क", "ख", "ग", "घ", "ङ",  # कण्ठ्य
    "च", "छ", "ज", "झ", "ञ",  # तालव्य
    "ट", "ठ", "ड", "ढ", "ण",  # मूर्धन्य
    "त", "थ", "द", "ध", "न",  # दन्त्य
    "प", "फ", "ब", "भ", "म",  # ओष्ठ्य
    "य", "र", "ल", "व",       # अन्तस्थ
    "श", "ष", "स", "ह"        # ऊष्म
]
स्थिर अनुनासिक = ["ङ", "ञ", "ण", "न", "म", "ं", "ँ", "ः", "ऽ"]

# ── मूल तार संचालन (Basic String Operations) ────────────────────────────────

कर्म वर्ण_सूची(तार):
    टीका Convert string to list of characters
    चर परिणाम = []
    प्रत्येक चर वर्ण अन्तर्गत तार:
        परिणाम.जोड़ो(वर्ण)
    प्रत्यागच्छ परिणाम

कर्म तार_लंबाई(तार):
    टीका String length
    चर गणना = ०
    प्रत्येक चर _ अन्तर्गत तार:
        गणना = गणना + १
    प्रत्यागच्छ गणना

कर्म तार_उल्टा(तार):
    टीका Reverse string
    चर परिणाम = ""
    चर i = तार_लंबाई(तार) - १
    यावत् i >= ०:
        परिणाम = परिणाम + तार[i]
        i = i - १
    प्रत्यागच्छ परिणाम

कर्म तार_उपतार(तार, प्रारम्भ, अंत):
    टीका Substring from start to end (exclusive)
    चर परिणाम = ""
    प्रत्येक चर i अन्तर्गत परास(प्रारम्भ, अंत):
        परिणाम = परिणाम + तार[i]
    प्रत्यागच्छ परिणाम

कर्म तार_संयोजन(तार१, तार२):
    टीका String concatenation
    प्रत्यागच्छ तार१ + तार२

कर्म तार_तुलना(तार१, तार२):
    टीका Compare two strings: returns 0 if equal, <0 if t1<t2, >0 if t1>t2
    चर लंबाई१ = तार_लंबाई(तार१)
    चर लंबाई२ = तार_लंबाई(तार२)
    चर न्यूनतम = लंबाई१ यदि लंबाई१ < लंबाई२ अन्यथा लंबाई२
    
    प्रत्येक चर i अन्तर्गत परास(न्यूनतम):
        यदि तार१[i] < तार२[i]:
            प्रत्यागच्छ -१
        यदि तार१[i] > तार२[i]:
            प्रत्यागच्छ १
    
    यदि लंबाई१ < लंबाई२:
        प्रत्यागच्छ -१
    यदि लंबाई१ > लंबाई२:
        प्रत्यागच्छ १
    
    प्रत्यागच्छ ०

कर्म समान_है(तार१, तार२):
    टीका Check if strings are equal
    प्रत्यागच्छ तार_तुलना(तार१, तार२) == ०

# ── तार खोज और प्रतिस्थापन (String Search and Replace) ─────────────────────

कर्म तार_खोजो(तार, उपतार):
    टीका Find first occurrence of substring, returns index or -1
    चर तार_लंबा = तार_लंबाई(तार)
    चर उपतार_लंबा = तार_लंबाई(उपतार)
    
    यदि उपतार_लंबा == ०:
        प्रत्यागच्छ ०
    यदि उपतार_लंबा > तार_लंबा:
        प्रत्यागच्छ -१
    
    प्रत्येक चर i अन्तर्गत परास(तार_लंबा - उपतार_लंबा + १):
        चर मिलान = सत्य
        प्रत्येक चर j अन्तर्गत परास(उपतार_लंबा):
            यदि तार[i + j] != उपतार[j]:
                मिलान = असत्य
                तोड़ो
        यदि मिलान:
            प्रत्यागच्छ i
    
    प्रत्यागच्छ -१

कर्म तार_अंतिम_खोजो(तार, उपतार):
    टीका Find last occurrence of substring
    चर तार_लंबा = तार_लंबाई(तार)
    चर उपतार_लंबा = तार_लंबाई(उपतार)
    
    चर i = तार_लंबा - उपतार_लंबा
    यावत् i >= ०:
        चर मिलान = सत्य
        प्रत्येक चर j अन्तर्गत परास(उपतार_लंबा):
            यदि तार[i + j] != उपतार[j]:
                मिलान = असत्य
                तोड़ो
        यदि मिलान:
            प्रत्यागच्छ i
        i = i - १
    
    प्रत्यागच्छ -१

कर्म तार_गिनो(तार, उपतार):
    टीका Count occurrences of substring
    चर गणना = ०
    चर स्थिति = ०
    चर उपतार_लंबा = तार_लंबाई(उपतार)
    
    यावत् स्थिति <= तार_लंबाई(तार) - उपतार_लंबा:
        स्थिति = तार_खोजो(तार_उपतार(तार, स्थिति, तार_लंबाई(तार)), उपतार)
        यदि स्थिति == -१:
            तोड़ो
        गणना = गणना + १
        स्थिति = स्थिति + उपतार_लंबा
    
    प्रत्यागच्छ गणना

कर्म तार_प्रतिस्थापन(तार, पुराना, नया, गणना=-१):
    टीका Replace occurrences of old substring with new
    चर परिणाम = ""
    चर स्थिति = ०
    चर पुराना_लंबा = तार_लंबाई(पुराना)
    चर प्रतिस्थापित = ०
    
    यावत् स्थिति < तार_लंबाई(तार):
        यदि गणना != -१ और प्रतिस्थापित >= गणना:
            परिणाम = परिणाम + तार_उपतार(तार, स्थिति, तार_लंबाई(तार))
            तोड़ो
        
        चर खोज = तार_खोजो(तार_उपतार(तार, स्थिति, तार_लंबाई(तार)), पुराना)
        यदि खोज == -१:
            परिणाम = परिणाम + तार_उपतार(तार, स्थिति, तार_लंबाई(तार))
            तोड़ो
        
        परिणाम = परिणाम + तार_उपतार(तार, स्थिति, स्थिति + खोज)
        परिणाम = परिणाम + नया
        स्थिति = स्थिति + खोज + पुराना_लंबा
        प्रतिस्थापित = प्रतिस्थापित + १
    
    प्रत्यागच्छ परिणाम

# ── तार रूपांतरण (String Case Conversion) ──────────────────────────────────

कर्म लघु_अक्षर(वर्ण):
    टीका Convert single character to lowercase
    # ASCII A-Z: 65-90, a-z: 97-122
    चर कोड = अक्षर_मान(वर्ण)
    यदि कोड >= ६५ और कोड <= ९०:
        प्रत्यागच्छ अक्षर_कर(कोड + ३२)
    प्रत्यागच्छ वर्ण

कर्म दीर्घ_अक्षर(वर्ण):
    टीका Convert single character to uppercase
    चर कोड = अक्षर_मान(वर्ण)
    यदि कोड >= ९७ और कोड <= १२२:
        प्रत्यागच्छ अक्षर_कर(कोड - ३२)
    प्रत्यागच्छ वर्ण

कर्म निम्न(तार):
    टीका Convert string to lowercase
    चर परिणाम = ""
    प्रत्येक चर वर्ण अन्तर्गत तार:
        परिणाम = परिणाम + लघु_अक्षर(वर्ण)
    प्रत्यागच्छ परिणाम

कर्म उच्च(तार):
    टीका Convert string to uppercase
    चर परिणाम = ""
    प्रत्येक चर वर्ण अन्तर्गत तार:
        परिणाम = परिणाम + दीर्घ_अक्षर(वर्ण)
    प्रत्यागच्छ परिणाम

कर्म शीर्षक(तार):
    टीका Convert to title case (first letter of each word uppercase)
    चर परिणाम = ""
    चर नया_शब्द = सत्य
    
    प्रत्येक चर वर्ण अन्तर्गत तार:
        यदि वर्ण == " " अथवा वर्ण == "\n" अथवा वर्ण == "\t":
            परिणाम = परिणाम + वर्ण
            नया_शब्द = सत्य
        अन्यथा:
            यदि नया_शब्द:
                परिणाम = परिणाम + दीर्घ_अक्षर(वर्ण)
                नया_शब्द = असत्य
            अन्यथा:
                परिणाम = परिणाम + लघु_अक्षर(वर्ण)
    
    प्रत्यागच्छ परिणाम

# ── तार ट्रिमिंग (String Trimming) ──────────────────────────────────────────

कर्म बायाँ_ट्रिम(तार):
    टीका Remove leading whitespace
    चर स्थिति = ०
    यावत् स्थिति < तार_लंबाई(तार):
        यदि तार[स्थिति] != " " और तार[स्थिति] != "\n" और तार[स्थिति] != "\t":
            तोड़ो
        स्थिति = स्थिति + १
    प्रत्यागच्छ तार_उपतार(तार, स्थिति, तार_लंबाई(तार))

कर्म दायाँ_ट्रिम(तार):
    टीका Remove trailing whitespace
    चर स्थिति = तार_लंबाई(तार) - १
    यावत् स्थिति >= ०:
        यदि तार[स्थिति] != " " और तार[स्थिति] != "\n" और तार[स्थिति] != "\t":
            तोड़ो
        स्थिति = स्थिति - १
    प्रत्यागच्छ तार_उपतार(तार, ०, स्थिति + १)

कर्म ट्रिम(तार):
    टीका Remove leading and trailing whitespace
    प्रत्यागच्छ बायाँ_ट्रिम(दायाँ_ट्रिम(तार))

# ── तार विभाजन और संयोजन (String Split and Join) ───────────────────────────

कर्म विभाजित(तार, विभाजक=","):
    टीका Split string by delimiter
    चर परिणाम = []
    चर प्रारम्भ = ०
    चर विभाजक_लंबा = तार_लंबाई(विभाजक)
    
    यदि विभाजक_लंबा == ०:
        प्रत्येक चर वर्ण अन्तर्गत तार:
            परिणाम.जोड़ो(वर्ण)
        प्रत्यागच्छ परिणाम
    
    चर स्थिति = ०
    यावत् स्थिति <= तार_लंबाई(तार):
        चर खोज = तार_खोजो(तार_उपतार(तार, स्थिति, तार_लंबाई(तार)), विभाजक)
        यदि खोज == -१:
            परिणाम.जोड़ो(तार_उपतार(तार, स्थिति, तार_लंबाई(तार)))
            तोड़ो
        
        परिणाम.जोड़ो(तार_उपतार(तार, स्थिति, स्थिति + खोज))
        स्थिति = स्थिति + खोज + विभाजक_लंबा
    
    प्रत्यागच्छ परिणाम

कर्म संयोजन(सूची, विभाजक=","):
    टीका Join list of strings with delimiter
    चर परिणाम = ""
    चर पहला = सत्य
    
    प्रत्येक चर तार अन्तर्गत सूची:
        यदि पहला:
            परिणाम = परिणाम + पाठ_कर(तार)
            पहला = असत्य
        अन्यथा:
            परिणाम = परिणाम + विभाजक + पाठ_कर(तार)
    
    प्रत्यागच्छ परिणाम

# ── पंक्ति संचालन (Line Operations) ────────────────────────────────────────

कर्म पंक्तियाँ(तार):
    टीका Split string into lines
    प्रत्यागच्छ विभाजित(तार, "\n")

कर्म पंक्ति_गिनो(तार):
    टीका Count number of lines
    चर गणना = १
    प्रत्येक चर वर्ण अन्तर्गत तार:
        यदि वर्ण == "\n":
            गणना = गणना + १
    यदि तार_लंबाई(तार) == ०:
        प्रत्यागच्छ ०
    प्रत्यागच्छ गणना

# ── संस्करण तुलना (Version Comparison) ──────────────────────────────────────

कर्म संस्करण_तुलना(व१, व२):
    टीका Compare version strings (e.g., "1.2.3" vs "1.2.4")
    चर भाग१ = विभाजित(व१, ".")
    चर भाग२ = विभाजित(व२, ".")
    
    चर अधिकतम = दीर्घता(भाग१)
    यदि दीर्घता(भाग२) > अधिकतम:
        अधिकतम = दीर्घता(भाग२)
    
    प्रत्येक चर i अन्तर्गत परास(अधिकतम):
        चर न१ = ०
        चर न२ = ०
        
        यदि i < दीर्घता(भाग१):
            न१ = पूर्णांक_कर(भाग१[i])
        यदि i < दीर्घता(भाग२):
            न२ = पूर्णांक_कर(भाग२[i])
        
        यदि न१ < न२:
            प्रत्यागच्छ -१
        यदि न१ > न२:
            प्रत्यागच्छ १
    
    प्रत्यागच्छ ०

# ── संस्कृत ध्वनि परिवर्तन (Sanskrit Sound Changes) ────────────────────────

कर्म सन्धि(शब्द१, शब्द२):
    टीका Basic Sanskrit sandhi (euphonic combination)
    # Get last character of first word
    चर अंतिम = शब्द१[तार_लंबाई(शब्द१) - १]
    चर प्रथम = शब्द२[०]
    
    # Simple vowel sandhi rules
    यदि अंतिम == "अ" और प्रथम == "अ":
        प्रत्यागच्छ शब्द१ + शब्द२  # अ + अ = अ (दीर्घ सन्धि)
    यदि अंतिम == "अ" और प्रथम == "आ":
        प्रत्यागच्छ तार_उपतार(शब्द१, ०, तार_लंबाई(शब्द१) - १) + "आ" + तार_उपतार(शब्द२, १, तार_लंबाई(शब्द२))
    यदि अंतिम == "अ" और प्रथम == "इ":
        प्रत्यागच्छ तार_उपतार(शब्द१, ०, तार_लंबाई(शब्द१) - १) + "इ" + तार_उपतार(शब्द२, १, तार_लंबाई(शब्द२))
    यदि अंतिम == "अ" और प्रथम == "उ":
        प्रत्यागच्छ तार_उपतार(शब्द१, ०, तार_लंबाई(शब्द१) - १) + "उ" + तार_उपतार(शब्द२, १, तार_लंबाई(शब्द२))
    
    # Default: simple concatenation
    प्रत्यागच्छ शब्द१ + शब्द२

कर्म विसर्ग_सन्धि(शब्द, अगला_शब्द):
    टीका Visarga sandhi rules
    चर अंतिम = शब्द[तार_लंबाई(शब्द) - १]
    
    यदि अंतिम != "ः":
        प्रत्यागच्छ शब्द + अगला_शब्द
    
    चर प्रथम = अगला_शब्द[०]
    
    # Visarga before sibilants
    यदि प्रथम == "श":
        प्रत्यागच्छ तार_उपतार(शब्द, ०, तार_लंबाई(शब्द) - १) + "श्" + अगला_शब्द
    यदि प्रथम == "ष":
        प्रत्यागच्छ तार_उपतार(शब्द, ०, तार_लंबाई(शब्द) - १) + "ष्" + अगला_शब्द
    यदि प्रथम == "स":
        प्रत्यागच्छ तार_उपतार(शब्द, ०, तार_लंबाई(शब्द) - १) + "स्" + अगला_शब्द
    
    प्रत्यागच्छ शब्द + अगला_शब्द

# ── छंद मीटर (Sanskrit Prosody) ────────────────────────────────────────────

कर्म गुरु_लघु(वर्ण):
    टीका Determine if syllable is guru (long) or laghu (short)
    # Simple heuristic: vowels with matra or ending in consonant are guru
    चर अगला_वर्ण = ""  # Would need context
    
    # Basic short vowels
    यदि वर्ण == "अ" अथवा वर्ण == "इ" अथवा वर्ण == "उ":
        प्रत्यागच्छ "लघु"
    
    # Basic long vowels
    यदि वर्ण == "आ" अथवा वर्ण == "ई" अथवा वर्ण == "ऊ" अथवा वर्ण == "ए" अथवा वर्ण == "ऐ" अथवा वर्ण == "ओ" अथवा वर्ण == "औ":
        प्रत्यागच्छ "गुरु"
    
    प्रत्यागच्छ "लघु"  # Default

कर्म छंद_विश्लेषण(पंक्ति):
    टीका Analyze meter of Sanskrit verse line
    चर गुरु_गणना = ०
    चर लघु_गणना = ०
    
    प्रत्येक चर वर्ण अन्तर्गत पंक्ति:
        यदि वर्ण in स्वर अथवा वर्ण in व्यंजन:
            चर प्रकार = गुरु_लघु(वर्ण)
            यदि प्रकार == "गुरु":
                गुरु_गणना = गुरु_गणना + १
            अन्यथा:
                लघु_गणना = लघु_गणना + १
    
    प्रत्यागच्छ {"गुरु": गुरु_गणना, "लघु": लघु_गणना, "कुल": गुरु_गणना + लघु_गणना}

# ── शब्द गणना (Word Count) ─────────────────────────────────────────────────

कर्म शब्द_गिनो(तार):
    टीका Count words in text
    चर शब्द = विभाजित(तार, " ")
    चर गणना = ०
    प्रत्येक चर श अन्तर्गत शब्द:
        यदि तार_लंबाई(श) > ०:
            गणना = गणना + १
    प्रत्यागच्छ गणना

कर्म शब्द_सूची(तार):
    टीका Extract list of words
    चर कच्चे_शब्द = विभाजित(तार, " ")
    चर परिणाम = []
    प्रत्येक चर श अन्तर्गत कच्चे_शब्द:
        चर trimmed = ट्रिम(श)
        यदि तार_लंबाई(trimmed) > ०:
            परिणाम.जोड़ो(trimmed)
    प्रत्यागच्छ परिणाम

# ── पैलिंड्रोम और पैटर्न (Palindrome and Patterns) ─────────────────────────

कर्म पेलिंड्रोम_है(तार):
    टीका Check if string is palindrome
    चर उल्टा = तार_उल्टा(तार)
    प्रत्यागच्छ समान_है(तार, उल्टा)

कर्म अनग्राम_है(तार१, तार२):
    टीका Check if two strings are anagrams
    यदि तार_लंबाई(तार१) != तार_लंबाई(तार२):
        प्रत्यागच्छ असत्य
    
    चर वर्ण१ = वर्ण_सूची(तार१)
    चर वर्ण२ = वर्ण_सूची(तार२)
    
    # Simple bubble sort for comparison
    चर n = दीर्घता(वर्ण१)
    प्रत्येक चर i अन्तर्गत परास(n):
        प्रत्येक चर j अन्तर्गत परास(n - i - १):
            यदि वर्ण१[j] > वर्ण१[j + १]:
                चर temp = वर्ण१[j]
                वर्ण१[j] = वर्ण१[j + १]
                वर्ण१[j + १] = temp
            
            यदि वर्ण२[j] > वर्ण२[j + १]:
                चर temp = वर्ण२[j]
                वर्ण२[j] = वर्ण२[j + १]
                वर्ण२[j + १] = temp
    
    प्रत्येक चर i अन्तर्गत परास(n):
        यदि वर्ण१[i] != वर्ण२[i]:
            प्रत्यागच्छ असत्य
    
    प्रत्यागच्छ सत्य

# ── फॉर्मेटिंग (Formatting) ────────────────────────────────────────────────

कर्म बायाँ_पैड(तार, लंबाई, पैड_वर्ण=" "):
    टीका Pad string on left to specified length
    चर वर्तमान_लंबाई = तार_लंबाई(तार)
    यदि वर्तमान_लंबाई >= लंबाई:
        प्रत्यागच्छ तार
    
    चर padding = ""
    प्रत्येक चर _ अन्तर्गत परास(लंबाई - वर्तमान_लंबाई):
        padding = padding + पैड_वर्ण
    
    प्रत्यागच्छ padding + तार

कर्म दायाँ_पैड(तार, लंबाई, पैड_वर्ण=" "):
    टीका Pad string on right to specified length
    चर वर्तमान_लंबाई = तार_लंबाई(तार)
    यदि वर्तमान_लंबाई >= लंबाई:
        प्रत्यागच्छ तार
    
    चर padding = ""
    प्रत्येक चर _ अन्तर्गत परास(लंबाई - वर्तमान_लंबाई):
        padding = padding + पैड_वर्ण
    
    प्रत्यागच्छ तार + padding

कर्म मध्य_पैड(तार, लंबाई, पैड_वर्ण=" "):
    टीका Center string with padding
    चर वर्तमान_लंबाई = तार_लंबाई(तार)
    यदि वर्तमान_लंबाई >= लंबाई:
        प्रत्यागच्छ तार
    
    चर कुल_पैड = लंबाई - वर्तमान_लंबाई
    चर बायाँ_पैड_लंबा = कुल_पैड // २
    चर दायाँ_पैड_लंबा = कुल_पैड - बायाँ_पैड_लंबा
    
    चर बायाँ = ""
    चर दायाँ = ""
    प्रत्येक चर _ अन्तर्गत परास(बायाँ_पैड_लंबा):
        बायाँ = बायाँ + पैड_वर्ण
    प्रत्येक चर _ अन्तर्गत परास(दायाँ_पैड_लंबा):
        दायाँ = दायाँ + पैड_वर्ण
    
    प्रत्यागच्छ बायाँ + तार + दायाँ

मुद्रय "भाषा प्रसंस्करण पुस्तकालय लोड हुआ। (Language processing library loaded.)"
