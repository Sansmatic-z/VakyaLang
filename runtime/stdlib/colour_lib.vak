# ╔══════════════════════════════════════════════════════════════════╗
# ║  भाग ५: मास्टर रंग रजिस्टर (Master Color Registry)            ║
# ╚════════════════════════════════════════════════════════════════════╝

स्थिर सभी_रंग = {
    "css": css_रंग,
    "संस्कृत": संस्कृत_रंग,
    "tailwind": tailwind_रंग,
    "material": material_रंग
}

स्थिर हेक्स_अंक = "0123456789ABCDEF"


# ╔══════════════════════════════════════════════════════════════════╗
# ║  भाग ६: आधारभूत रूपांतरण कार्य (Core Conversions)           ║
# ║  NO trigonometric functions needed — pure arithmetic              ║
# ╚════════════════════════════════════════════════════════════════════╝


# ── HEX ↔ RGB ────────────────────────────────────────────────────────

कर्म पूर्णांक_मिलाओ(संख्या):
    """Round to nearest integer (for color clamping)."""
    प्रत्यागच्छ पूर्णांक_कर(संख्या + 0.5)

कर्म सीमित(मान, न्यूनतम_मान, अधिकतम_मान):
    """Clamp value between min and max."""
    यदि मान < न्यूनतम_मान:
        प्रत्यागच्छ न्यूनतम_मान
    यदि मान > अधिकतम_मान:
        प्रत्यागच्छ अधिकतम_मान
    प्रत्यागच्छ मान

कर्म hex_से_rgb(हेक्स):
    """Convert '#RRGGBB' to {र, ह, नी} dict."""
    चर h = हेक्स
    यदि h[०] == "#":
        h = h[१:]
    चर r = संख्या("0x" + h[०:२], 16)
    चर g = संख्या("0x" + h[२:४], 16)
    चर b = संख्या("0x" + h[४:६], 16)
    प्रत्यागच्छ {"र": r, "ह": g, "नी": b}

कर्म _द्वय_हेक्स(मान):
    चर पूर्ण = पूर्णांक_मिलाओ(सीमित(मान, ०, 255))
    चर उच्च = पूर्ण // 16
    चर निम्न_भाग = पूर्ण % 16
    प्रत्यागच्छ हेक्स_अंक[उच्च] + हेक्स_अंक[निम्न_भाग]

कर्म rgb_से_hex(r, ह, नी):
    """Convert R,G,B (0-255) to '#RRGGBB' string."""
    प्रत्यागच्छ "#" + _द्वय_हेक्स(r) + _द्वय_हेक्स(ह) + _द्वय_हेक्स(नी)

कर्म rgb_से_स्ट्रिंग(r, ह, नी):
    """Convert R,G,B to 'rgb(r,g,b)' CSS string."""
    प्रत्यागच्छ "rgb(" + पाठ_कर(पूर्णांक_मिलाओ(r)) + "," + पाठ_कर(पूर्णांक_मिलाओ(ह)) + "," + पाठ_कर(पूर्णांक_मिलाओ(नी)) + ")"

कर्म rgba_से_स्ट्रिंग(r, ह, नी, अल्फा):
    """Convert R,G,B,A to 'rgba(r,g,b,a)' CSS string."""
    प्रत्यागच्छ "rgba(" + पाठ_कर(पूर्णांक_मिलाओ(r)) + "," + पाठ_कर(पूर्णांक_मिलाओ(ह)) + "," + पाठ_कर(पूर्णांक_मिलाओ(नी)) + "," + पाठ_कर(अल्फा) + ")"


# ── HSL ↔ RGB (No trig — piecewise linear) ──────────────────────────

कर्म _ह्यू_सहायक(टी१, टी२, ह्यू):
    """HSL hue helper — piecewise linear, no sin/cos needed."""
    यदि ह्यू < ०:
        ह्यू = ह्यू + १
    यदि ह्यू > १:
        ह्यू = ह्यू - १
    यदि ह्यू < 0.166667:
        प्रत्यागच्छ टी१ + (टी२ - टी१) * ६ * ह्यू
    यदि ह्यू < ०.५:
        प्रत्यागच्छ टी२
    यदि ह्यू < 0.666667:
        प्रत्यागच्छ टी१ + (टी२ - टी१) * (0.666667 - ह्यू) * ६
    प्रत्यागच्छ टी१

कर्म hsl_से_rgb(व, त, प्र):
    """HSL to RGB. व=Hue(0-360), त=Saturation(0-100), प्र=Lightness(0-100)."""
    चर h = व / 360
    चर s = त / 100
    चर l = प्र / 100

    यदि s == ०:
        चर v = पूर्णांक_मिलाओ(l * 255)
        प्रत्यागच्छ {"र": v, "ह": v, "नी": v}

    चर टी२ = शून्य
    यदि l < 0.5:
        टी२ = l * (1 + s)
    अन्यथा:
        टी२ = l + s - l * s

    चर टी१ = 2 * l - टी२

    चर r = पूर्णांक_मिलाओ(_ह्यू_सहायक(टी१, टी२, h + 0.333333) * 255)
    चर g = पूर्णांक_मिलाओ(_ह्यू_सहायक(टी१, टी२, h) * 255)
    चर b = पूर्णांक_मिलाओ(_ह्यू_सहायक(टी१, टी२, h - 0.333333) * 255)

    प्रत्यागच्छ {"र": r, "ह": g, "नी": b}

कर्म rgb_से_hsl(r, ह, नी):
    """RGB (0-255) to HSL (0-360, 0-100, 0-100)."""
    चर r = r / 255
    चर g = ह / 255
    चर b = नी / 255

    चर उच्च = अधिकतम(r, अधिकतम(g, b))
    चर निम्न = न्यूनतम(r, न्यूनतम(g, b))
    चर l = (उच्च + निम्न) / 2

    यदि उच्च == निम्न:
        प्रत्यागच्छ {"व": ०, "त": ०, "प्र": पूर्णांक_मिलाओ(l * 100)}

    चर d = उच्च - निम्न
    चर s = शून्य
    यदि l > 0.5:
        s = d / (2 - उच्च - निम्न)
    अन्यथा:
        s = d / (उच्च + निम्न)

    चर h = शून्य
    यदि उच्च == r:
        h = (g - b) / d
        यदि g < b:
            h = h + 6
    अन्यथा यदि उच्च == g:
        h = (b - r) / d + 2
    अन्यथा:
        h = (r - g) / d + 4

    प्रत्यागच्छ {"व": पूर्णांक_मिलाओ(h * 60), "त": पूर्णांक_मिलाओ(s * 100), "प्र": पूर्णांक_मिलाओ(l * 100)}

कर्म hsl_रंग(व, त, प्र):
    """Generate hex color from HSL values."""
    चर rgb = hsl_से_rgb(व, त, प्र)
    प्रत्यागच्छ rgb_से_hex(rgb["र"], rgb["ह"], rgb["नी"])

कर्म hsl_स्ट्रिंग(व, त, प्र):
    """Generate CSS hsl() string."""
    प्रत्यागच्छ "hsl(" + पाठ_कर(व) + "," + पाठ_कर(त) + "%," + पाठ_कर(प्र) + "%)"


# ── HSV ↔ RGB ────────────────────────────────────────────────────────

कर्म hsv_से_rgb(व, त, म):
    """HSV to RGB. व=Hue(0-360), त=Saturation(0-100), म=Value(0-100)."""
    चर h = व / 60
    चर s = त / 100
    चर v = म / 100

    चर i = पूर्णांक_कर(h)
    चर f = h - i
    चर p = v * (1 - s)
    चर q = v * (1 - s * f)
    चर t = v * (1 - s * (1 - f))

    चर r = शून्य
    चर g = शून्य
    चर b = शून्य

    यदि i == ०:
        r = v
        g = t
        b = p
    यदि i == १:
        r = q
        g = v
        b = p
    यदि i == २:
        r = p
        g = v
        b = t
    यदि i == ३:
        r = p
        g = q
        b = v
    यदि i == ४:
        r = t
        g = p
        b = v
    यदि i == ५:
        r = v
        g = p
        b = q

    प्रत्यागच्छ {"र": पूर्णांक_मिलाओ(r * 255), "ह": पूर्णांक_मिलाओ(g * 255), "नी": पूर्णांक_मिलाओ(b * 255)}

कर्म rgb_से_hsv(r, ह, नी):
    """RGB (0-255) to HSV (0-360, 0-100, 0-100)."""
    चर r = r / 255
    चर g = ह / 255
    चर b = नी / 255

    चर उच्च = अधिकतम(r, अधिकतम(g, b))
    चर निम्न = न्यूनतम(r, न्यूनतम(g, b))
    चर d = उच्च - निम्न

    चर s = शून्य
    यदि उच्च != ०:
        s = d / उच्च

    चर h = शून्य
    यदि d != ०:
        यदि उच्च == r:
            h = 60 * (((g - b) / d) % 6)
        अन्यथा यदि उच्च == g:
            h = 60 * ((b - r) / d + 2)
        अन्यथा:
            h = 60 * ((r - g) / d + 4)
        यदि h < ०:
            h = h + 360

    प्रत्यागच्छ {"व": पूर्णांक_मिलाओ(h), "त": पूर्णांक_मिलाओ(s * 100), "म": पूर्णांक_मिलाओ(उच्च * 100)}

कर्म hsv_रंग(व, त, म):
    """Generate hex color from HSV values."""
    चर rgb = hsv_से_rgb(व, त, म)
    प्रत्यागच्छ rgb_से_hex(rgb["र"], rgb["ह"], rgb["नी"])


# ── CMYK ↔ RGB ───────────────────────────────────────────────────────

कर्म cmyk_से_rgb(नी, मै, पी, क):
    """CMYK (0-100) to RGB (0-255)."""
    चर c = नी / 100
    चर m = मै / 100
    चर y = पी / 100
    चर k = क / 100
    चर r = पूर्णांक_मिलाओ(255 * (1 - c) * (1 - k))
    चर g = पूर्णांक_मिलाओ(255 * (1 - m) * (1 - k))
    चर b = पूर्णांक_मिलाओ(255 * (1 - y) * (1 - k))
    प्रत्यागच्छ {"र": r, "ह": g, "नी": b}

कर्म rgb_से_cmyk(r, ह, नी):
    """RGB (0-255) to CMYK (0-100)."""
    यदि r == ० और ह == ० और नी == ०:
        प्रत्यागच्छ {"नी": ०, "मै": ०, "पी": ०, "क": 100}
    चर r = r / 255
    चर g = ह / 255
    चर b = नी / 255
    चर k = 1 - अधिकतम(r, अधिकतम(g, b))
    चर c = (1 - r - k) / (1 - k)
    चर m = (1 - g - k) / (1 - k)
    चर y = (1 - b - k) / (1 - k)
    प्रत्यागच्छ {"नी": पूर्णांक_मिलाओ(c * 100), "मै": पूर्णांक_मिलाओ(m * 100), "पी": पूर्णांक_मिलाओ(y * 100), "क": पूर्णांक_मिलाओ(k * 100)}

कर्म cmyk_रंग(नी, मै, पी, क):
    """Generate hex from CMYK."""
    चर rgb = cmyk_से_rgb(नी, मै, पी, क)
    प्रत्यागच्छ rgb_से_hex(rgb["र"], rgb["ह"], rgb["नी"])


# ── Spectral: Wavelength → RGB (380–780nm) ──────────────────────────
# Dan Bruton's algorithm — piecewise linear approximation

कर्म तरंगदैर्ध्य_से_rgb(तरंगदैर्ध्य):
    """
    Convert wavelength (380–780 nm) to RGB.
    Generates every color the human eye can perceive along the spectrum.
    Returns {र, ह, नी} with values 0-255.
    """
    चर w = तरंगदैर्ध्य
    चर r = ०
    चर g = ०
    चर b = ०

    यदि w >= 380 और w < 440:
        r = (440 - w) / 60
        b = 1.0
    अन्यथा यदि w >= 440 और w < 490:
        g = (w - 440) / 50
        b = 1.0
    अन्यथा यदि w >= 490 और w < 510:
        g = 1.0
        b = (510 - w) / 20
    अन्यथा यदि w >= 510 और w < 580:
        r = (w - 510) / 70
        g = 1.0
    अन्यथा यदि w >= 580 और w < 645:
        r = 1.0
        g = (645 - w) / 65
    अन्यथा यदि w >= 645 और w <= 780:
        r = 1.0

    # Intensity fall-off at spectrum edges
    चर कारक = शून्य
    यदि w >= 380 और w < 420:
        कारक = 0.3 + 0.7 * (w - 380) / 40
    अन्यथा यदि w >= 420 और w <= 700:
        कारक = 1.0
    अन्यथा यदि w > 700 और w <= 780:
        कारक = 0.3 + 0.7 * (780 - w) / 80

    r = पूर्णांक_मिलाओ(सीमित(r * कारक * 255, ०, 255))
    g = पूर्णांक_मिलाओ(सीमित(g * कारक * 255, ०, 255))
    b = पूर्णांक_मिलाओ(सीमित(b * कारक * 255, ०, 255))

    प्रत्यागच्छ {"र": r, "ह": g, "नी": b}

कर्म तरंगदैर्ध्य_रंग(तरंगदैर्ध्य):
    """Generate hex color from wavelength (380–780 nm)."""
    चर rgb = तरंगदैर्ध्य_से_rgb(तरंगदैर्ध्य)
    प्रत्यागच्छ rgb_से_hex(rgb["र"], rgb["ह"], rgb["नी"])


# ── Blackbody: Temperature → RGB (1000K–40000K) ──────────────────────
# Tanner Helland's algorithm — no trig needed

कर्म तापमान_से_rgb(केल्विन):
    """
    Convert blackbody temperature (1000–40000 K) to RGB.
    Generates candlelight (~1800K) through blue sky (~30000K).
    """
    चर t = केल्विन / 100

    # Red
    चर r = 255
    यदि t <= 66:
        r = t
        r = 99.4708025861 * वर्गमूल(r) - 161.1195681661
        r = सीमित(r, ०, 255)

    # Green
    चर g = शून्य
    यदि t <= 66:
        g = t
        g = 99.4708025861 * वर्गमूल(g) - 161.1195681661
        g = सीमित(g, ०, 255)
    अन्यथा:
        g = t - 60
        g = 288.1221695283 * वर्गमूल(g) - 80
        g = सीमित(g, ०, 255)

    # Blue
    चर b = शून्य
    यदि t >= 66:
        b = 255
    अन्यथा यदि t <= 19:
        b = ०
    अन्यथा:
        b = t - 10
        b = 138.5177312231 * वर्गमूल(b) - 305.0447927307
        b = सीमित(b, ०, 255)

    प्रत्यागच्छ {"र": पूर्णांक_मिलाओ(r), "ह": पूर्णांक_मिलाओ(g), "नी": पूर्णांक_मिलाओ(b)}

कर्म तापमान_रंग(केल्विन):
    """Generate hex from blackbody temperature."""
    चर rgb = तापमान_से_rgb(केल्विन)
    प्रत्यागच्छ rgb_से_hex(rgb["र"], rgb["ह"], rgb["नी"])


# ╔══════════════════════════════════════════════════════════════════╗
# ║  भाग ७: रंग हेरफेर कार्य (Color Manipulation)                 ║
# ╚════════════════════════════════════════════════════════════════════╝

कर्म _हेक्स_विश्लेषण(रंग):
    """Normalize any color input to RGB dict."""
    यदि रंग == शून्य:
        प्रत्यागच्छ {"र": ०, "ह": ०, "नी": ०}
    यदि प्रकार(रंग) == "शब्दकोश":
        प्रत्यागच्छ रंग
    चर h = पाठ_कर(रंग)
    यदि दीर्घता(h) >= 7 और h[०] == "#":
        प्रत्यागच्छ hex_से_rgb(h)
    प्रत्यागच्छ {"र": ०, "ह": ०, "नी": ०}

कर्म मिश्रण(रंग१, रंग२, अनुपात):
    """Mix two colors. अनुपात=0 gives color1, 1 gives color2."""
    चर a = _हेक्स_विश्लेषण(रंग१)
    चर b = _हेक्स_विश्लेषण(रंग२)
    चर t = अनुपात
    चर r = पूर्णांक_मिलाओ(a["र"] * (1 - t) + b["र"] * t)
    चर g = पूर्णांक_मिलाओ(a["ह"] * (1 - t) + b["ह"] * t)
    चर bl = पूर्णांक_मिलाओ(a["नी"] * (1 - t) + b["नी"] * t)
    प्रत्यागच्छ rgb_से_hex(r, g, bl)

कर्म प्रकाशित(रंग, मात्रा):
    """Lighten a color. मात्रा=0-100."""
    चर rgb = _हेक्स_विश्लेषण(रंग)
    चर hsl = rgb_से_hsl(rgb["र"], rgb["ह"], rgb["नी"])
    चर नया_प्र = सीमित(hsl["प्र"] + मात्रा, ०, 100)
    प्रत्यागच्छ hsl_रंग(hsl["व"], hsl["त"], नया_प्र)

कर्म अंधकारित(रंग, मात्रा):
    """Darken a color. मात्रा=0-100."""
    चर rgb = _हेक्स_विश्लेषण(रंग)
    चर hsl = rgb_से_hsl(rgb["र"], rgb["ह"], rgb["नी"])
    चर नया_प्र = सीमित(hsl["प्र"] - मात्रा, ०, 100)
    प्रत्यागच्छ hsl_रंग(hsl["व"], hsl["त"], नया_प्र)

कर्म संतृप्त(रंग, मात्रा):
    """Saturate a color. मात्रा=0-100."""
    चर rgb = _हेक्स_विश्लेषण(रंग)
    चर hsl = rgb_से_hsl(rgb["र"], rgb["ह"], rgb["नी"])
    चर नया_त = सीमित(hsl["त"] + मात्रा, ०, 100)
    प्रत्यागच्छ hsl_रंग(hsl["व"], नया_त, hsl["प्र"])

कर्म असंतृप्त(रंग, मात्रा):
    """Desaturate a color. मात्रा=0-100."""
    चर rgb = _हेक्स_विश्लेषण(रंग)
    चर hsl = rgb_से_hsl(rgb["र"], rgb["ह"], rgb["नी"])
    चर नया_त = सीमित(hsl["त"] - मात्रा, ०, 100)
    प्रत्यागच्छ hsl_रंग(hsl["व"], नया_त, hsl["प्र"])

कर्म पूरक(रंग):
    """Complementary color (180 degrees on color wheel)."""
    चर rgb = _हेक्स_विश्लेषण(रंग)
    चर hsl = rgb_से_hsl(rgb["र"], rgb["ह"], rgb["नी"])
    चर नया_व = (hsl["व"] + 180) % 360
    प्रत्यागच्छ hsl_रंग(नया_व, hsl["त"], hsl["प्र"])

कर्म विपरीत(रंग):
    """Invert a color (255 - value)."""
    चर rgb = _हेक्स_विश्लेषण(रंग)
    प्रत्यागच्छ rgb_से_hex(255 - rgb["र"], 255 - rgb["ह"], 255 - rgb["नी"])

कर्म ग्रेस्केल(रंग):
    """Convert to grayscale using luminance formula."""
    चर rgb = _हेक्स_विश्लेषण(रंग)
    चर v = पूर्णांक_मिलाओ(0.299 * rgb["र"] + 0.587 * rgb["ह"] + 0.114 * rgb["नी"])
    प्रत्यागच्छ rgb_से_hex(v, v, v)

कर्म अस्पष्ट(रंग, मात्रा):
    """Fade toward transparent (mix with white). मात्रा=0-100."""
    प्रत्यागच्छ मिश्रण(रंग, "#FFFFFF", मात्रा / 100)

कर्म स्पष्ट(रंग, मात्रा):
    """Remove transparency (mix away from white). मात्रा=0-100."""
    प्रत्यागच्छ मिश्रण("#FFFFFF", रंग, मात्रा / 100)


# ╔══════════════════════════════════════════════════════════════════╗
# ║  भाग ८: रंग दूरी और तुलना (Color Distance & Comparison)      ║
# ╚════════════════════════════════════════════════════════════════════╝

कर्म रंग_दूरी(रंग१, रंग२):
    """Euclidean distance between two colors (0-441.67)."""
    चर a = _हेक्स_विश्लेषण(रंग१)
    चर b = _हेक्स_विश्लेषण(रंग२)
    चर dr = a["र"] - b["र"]
    चर dg = a["ह"] - b["ह"]
    चर db = a["नी"] - b["नी"]
    प्रत्यागच्छ वर्गमूल(dr * dr + dg * dg + db * db)

कर्म मान(रंग१, रंग२, सहिष्णुता):
    """Check if two colors are within tolerance distance."""
    यदि रंग_दूरी(रंग१, रंग२) <= सहिष्णुता:
        प्रत्यागच्छ सत्य
    प्रत्यागच्छ असत्य

कर्म चमक(रंग):
    """Perceived brightness (0-255)."""
    चर rgb = _हेक्स_विश्लेषण(रंग)
    प्रत्यागच्छ पूर्णांक_मिलाओ(वर्गमूल(0.299 * rgb["र"] ** 2 + 0.587 * rgb["ह"] ** 2 + 0.114 * rgb["नी"] ** 2))

कर्म पाठ_चमक(रंग):
    """Return 'light' or 'dark' for text contrast."""
    यदि चमक(रंग) > 128:
        प्रत्यागच्छ "dark"
    प्रत्यागच्छ "light"

कर्म पाठ_रंग(पृष्ठभूमि):
    """Get best text color (black or white) for contrast."""
    यदि पाठ_चमक(पृष्ठभूमि) == "dark":
        प्रत्यागच्छ "#000000"
    प्रत्यागच्छ "#FFFFFF"


# ╔══════════════════════════════════════════════════════════════════╗
# ║  भाग ९: श्रेणी उत्पादन (Palette Generation)                   ║
# ╚════════════════════════════════════════════════════════════════════╝

कर्म पूरक_श्रेणी(रंग):
    """Complementary palette: base + opposite."""
    चर p = पूरक(रंग)
    प्रत्यागच्छ [रंग, p]

कर्म समान_श्रेणी(रंग, कोण):
    """Analogous palette: colors adjacent on wheel. कोण=degrees apart."""
    चर rgb = _हेक्स_विश्लेषण(रंग)
    चर hsl = rgb_से_hsl(rgb["र"], rgb["ह"], rgb["नी"])
    चर श्रेणी = []
    चर i = -2
    यावत् i <= 2:
        चर नया_व = (hsl["व"] + i * कोण + 360) % 360
        श्रेणी.जोड़ो(hsl_रंग(नया_व, hsl["त"], hsl["प्र"]))
        i += १
    प्रत्यागच्छ श्रेणी

कर्म त्रिशीर्षी(रंग):
    """Triadic palette: 3 colors at 120 degree intervals."""
    चर rgb = _हेक्स_विश्लेषण(रंग)
    चर hsl = rgb_से_hsl(rgb["र"], rgb["ह"], rgb["नी"])
    चर श्रेणी = []
    चर i = ०
    यावत् i < 3:
        चर नया_व = (hsl["व"] + i * 120) % 360
        श्रेणी.जोड़ो(hsl_रंग(नया_व, hsl["त"], hsl["प्र"]))
        i += १
    प्रत्यागच्छ श्रेणी

कर्म चतुर्शीर्षी(रंग):
    """Tetradic palette: 4 colors at 90 degree intervals."""
    चर rgb = _हेक्स_विश्लेषण(रंग)
    चर hsl = rgb_से_hsl(rgb["र"], rgb["ह"], rgb["नी"])
    चर श्रेणी = []
    चर i = ०
    यावत् i < 4:
        चर नया_व = (hsl["व"] + i * 90) % 360
        श्रेणी.जोड़ो(hsl_रंग(नया_व, hsl["त"], hsl["प्र"]))
        i += १
    प्रत्यागच्छ श्रेणी

कर्म विभाजित_पूरक(रंग):
    """Split-complementary: base + two colors adjacent to complement."""
    चर rgb = _हेक्स_विश्लेषण(रंग)
    चर hsl = rgb_से_hsl(rgb["र"], rgb["ह"], rgb["नी"])
    चर c = (hsl["व"] + 180) % 360
    प्रत्यागच्छ [
        रंग,
        hsl_रंग((c - 30 + 360) % 360, hsl["त"], hsl["प्र"]),
        hsl_रंग(c, hsl["त"], hsl["प्र"]),
        hsl_रंग((c + 30) % 360, hsl["त"], hsl["प्र"])
    ]

कर्म रैखिक_ढाल(रंग१, रंग२, चरण):
    """Linear gradient: N steps between two colors."""
    चर श्रेणी = []
    यदि चरण < 2:
        श्रेणी.जोड़ो(रंग१)
        प्रत्यागच्छ श्रेणी
    चर i = ०
    यावत् i < चरण:
        चर t = i / (चरण - 1)
        श्रेणी.जोड़ो(मिश्रण(रंग१, रंग२, t))
        i += १
    प्रत्यागच्छ श्रेणी

कर्म वर्ण_वर्णक्रम(चरण):
    """Full hue spectrum gradient (rainbow)."""
    चर श्रेणी = []
    चर i = ०
    यावत् i < चरण:
        चर व = (i / चरण) * 360
        श्रेणी.जोड़ो(hsl_रंग(व, 100, 50))
        i += १
    प्रत्यागच्छ श्रेणी

कर्म स्वरूप_ढाल(रंग, चरण):
    """Monochrome palette: same hue, varying lightness."""
    चर rgb = _हेक्स_विश्लेषण(रंग)
    चर hsl = rgb_से_hsl(rgb["र"], rgb["ह"], rgb["नी"])
    चर श्रेणी = []
    चर i = ०
    यावत् i < चरण:
        चर प्र = (i / (चरण - 1)) * 100
        श्रेणी.जोड़ो(hsl_रंग(hsl["व"], hsl["त"], प्र))
        i += १
    प्रत्यागच्छ श्रेणी

कर्म संतृप्ति_ढाल(रंग, चरण):
    """Saturation gradient: same hue/lightness, varying saturation."""
    चर rgb = _हेक्स_विश्लेषण(रंग)
    चर hsl = rgb_से_hsl(rgb["र"], rgb["ह"], rgb["नी"])
    चर श्रेणी = []
    चर i = ०
    यावत् i < चरण:
        चर त = (i / (चरण - 1)) * 100
        श्रेणी.जोड़ो(hsl_रंग(hsl["व"], त, hsl["प्र"]))
        i += १
    प्रत्यागच्छ श्रेणी

कर्म स्पेक्ट्रम_ढाल(प्रारंभ, अंत, चरण):
    """Spectral gradient: wavelength range to color list."""
    चर श्रेणी = []
    यदि चरण < 2:
        श्रेणी.जोड़ो(तरंगदैर्ध्य_रंग(प्रारंभ))
        प्रत्यागच्छ श्रेणी
    चर i = ०
    यावत् i < चरण:
        चर w = प्रारंभ + (अंत - प्रारंभ) * i / (चरण - 1)
        श्रेणी.जोड़ो(तरंगदैर्ध्य_रंग(w))
        i += १
    प्रत्यागच्छ श्रेणी

कर्म ताप_ढाल(प्रारंभ_K, अंत_K, चरण):
    """Blackbody temperature gradient."""
    चर श्रेणी = []
    यदि चरण < 2:
        श्रेणी.जोड़ो(तापमान_रंग(प्रारंभ_K))
        प्रत्यागच्छ श्रेणी
    चर i = ०
    यावत् i < चरण:
        चर k = प्रारंभ_K + (अंत_K - प्रारंभ_K) * i / (चरण - 1)
        श्रेणी.जोड़ो(तापमान_रंग(k))
        i += १
    प्रत्यागच्छ श्रेणी


# ╔══════════════════════════════════════════════════════════════════╗
# ║  भाग १०: नाम से रंग प्राप्त करें (Lookup API)                ║
# ╚════════════════════════════════════════════════════════════════════╝

कर्म प्राप्त(नाम):
    """Get color by name from any collection. Returns hex string."""
    चर नाम_पाठ = पाठ_कर(नाम)
    यदि दीर्घता(नाम_पाठ) >= 7 और नाम_पाठ[०] == "#":
        प्रत्यागच्छ नाम_पाठ

    चर श्रेणी_नाम = कुंजियाँ(सभी_रंग)
    प्रत्येक चर श अन्तर्गत श्रेणी_नाम:
        चर संग्रह = सभी_रंग[श]
        यदि नाम_पाठ अन्तर्गत संग्रह:
            प्रत्यागच्छ संग्रह[नाम_पाठ]

    चर नाम_नीचे = निम्न(नाम_पाठ)
    प्रत्येक चर श अन्तर्गत श्रेणी_नाम:
        चर संग्रह = सभी_रंग[श]
        प्रत्येक चर कुंजी अन्तर्गत कुंजियाँ(संग्रह):
            यदि निम्न(पाठ_कर(कुंजी)) == नाम_नीचे:
                प्रत्यागच्छ संग्रह[कुंजी]

    प्रत्यागच्छ शून्य

कर्म प्राप्त_rgb(नाम):
    """Get {र,ह,नी} dict by name."""
    चर h = प्राप्त(नाम)
    यदि h == शून्य:
        प्रत्यागच्छ शून्य
    प्रत्यागच्छ hex_से_rgb(h)

कर्म गिनती():
    """Total number of named colors available."""
    चर कुल = ०
    चर श्रेणी_नाम = कुंजियाँ(सभी_रंग)
    प्रत्येक चर श अन्तर्गत श्रेणी_नाम:
        कुल += दीर्घता(कुंजियाँ(सभी_रंग[श]))
    प्रत्यागच्छ कुल


# ╔══════════════════════════════════════════════════════════════════╗
# ║  भाग ११: SVG चित्र उत्पादन (Vector — Any Resolution)           ║
# ║  SVG is pure XML text — no new dependencies needed                ║
# ╚════════════════════════════════════════════════════════════════════╝

कर्म svg_आरम्भ(चौड़ाई, ऊंचाई):
    """Start a new SVG canvas. Returns string builder list."""
    प्रत्यागच्छ [
        "<?xml version=\"1.0\" encoding=\"UTF-8\"?>",
        "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"" + पाठ_कर(चौड़ाई) + "\" height=\"" + पाठ_कर(ऊंचाई) + "\" viewBox=\"0 0 " + पाठ_कर(चौड़ाई) + " " + पाठ_कर(ऊंचाई) + "\">"
    ]

कर्म svg_समाप्त(निर्माता):
    """Close SVG tags."""
    निर्माता.जोड़ो("</svg>")
    प्रत्यागच्छ निर्माता

कर्म svg_आयत(निर्माता, x, y, चौड़ाई, ऊंचाई, भरण, सीमा = शून्य, सीमा_चौड़ाई = शून्य):
    """Add rectangle. भरण/सीमा are hex colors or 'none'."""
    यदि सीमा == शून्य:
        सीमा = "none"
    यदि सीमा_चौड़ाई == शून्य:
        सीमा_चौड़ाई = 0
    निर्माता.जोड़ो("  <rect x=\"" + पाठ_कर(x) + "\" y=\"" + पाठ_कर(y) + "\" width=\"" + पाठ_कर(चौड़ाई) + "\" height=\"" + पाठ_कर(ऊंचाई) + "\" fill=\"" + पाठ_कर(भरण) + "\" stroke=\"" + पाठ_कर(सीमा) + "\" stroke-width=\"" + पाठ_कर(सीमा_चौड़ाई) + "\"/>")
    प्रत्यागच्छ निर्माता

कर्म svg_वृत्त(निर्माता, cx, cy, त्रिज्या, भरण, सीमा = शून्य):
    """Add circle."""
    यदि सीमा == शून्य:
        सीमा = "none"
    निर्माता.जोड़ो("  <circle cx=\"" + पाठ_कर(cx) + "\" cy=\"" + पाठ_कर(cy) + "\" r=\"" + पाठ_कर(त्रिज्या) + "\" fill=\"" + पाठ_कर(भरण) + "\" stroke=\"" + पाठ_कर(सीमा) + "\" stroke-width=\"1\"/>")
    प्रत्यागच्छ निर्माता

कर्म svg_दीर्घवृत्त(निर्माता, cx, cy, rx, ry, भरण, सीमा = शून्य):
    """Add ellipse."""
    यदि सीमा == शून्य:
        सीमा = "none"
    निर्माता.जोड़ो("  <ellipse cx=\"" + पाठ_कर(cx) + "\" cy=\"" + पाठ_कर(cy) + "\" rx=\"" + पाठ_कर(rx) + "\" ry=\"" + पाठ_कर(ry) + "\" fill=\"" + पाठ_कर(भरण) + "\" stroke=\"" + पाठ_कर(सीमा) + "\" stroke-width=\"1\"/>")
    प्रत्यागच्छ निर्माता

कर्म svg_रेखा(निर्माता, x1, y1, x2, y2, रंग, मोटाई = शून्य):
    """Add line."""
    यदि मोटाई == शून्य:
        मोटाई = 1
    निर्माता.जोड़ो("  <line x1=\"" + पाठ_कर(x1) + "\" y1=\"" + पाठ_कर(y1) + "\" x2=\"" + पाठ_कर(x2) + "\" y2=\"" + पाठ_कर(y2) + "\" stroke=\"" + पाठ_कर(रंग) + "\" stroke-width=\"" + पाठ_कर(मोटाई) + "\"/>")
    प्रत्यागच्छ निर्माता

कर्म svg_बहुभुज(निर्माता, बिंदु, भरण, सीमा = शून्य):
    """Add polygon. बिंदु = 'x1,y1 x2,y2 x3,y3'."""
    यदि सीमा == शून्य:
        सीमा = "none"
    निर्माता.जोड़ो("  <polygon points=\"" + पाठ_कर(बिंदु) + "\" fill=\"" + पाठ_कर(भरण) + "\" stroke=\"" + पाठ_कर(सीमा) + "\" stroke-width=\"1\"/>")
    प्रत्यागच्छ निर्माता

कर्म svg_बहुरेखा(निर्माता, बिंदु, रंग, मोटाई = शून्य):
    """Add polyline. बिंदु = 'x1,y1 x2,y2 ...'"""
    यदि मोटाई == शून्य:
        मोटाई = 1
    निर्माता.जोड़ो("  <polyline points=\"" + पाठ_कर(बिंदु) + "\" fill=\"none\" stroke=\"" + पाठ_कर(रंग) + "\" stroke-width=\"" + पाठ_कर(मोटाई) + "\"/>")
    प्रत्यागच्छ निर्माता

कर्म svg_पाठ(निर्माता, x, y, सामग्री, रंग = शून्य, आकार = शून्य):
    """Add text."""
    यदि आकार == शून्य:
        आकार = 16
    यदि रंग == शून्य:
        रंग = "#000000"
    निर्माता.जोड़ो("  <text x=\"" + पाठ_कर(x) + "\" y=\"" + पाठ_कर(y) + "\" fill=\"" + पाठ_कर(रंग) + "\" font-size=\"" + पाठ_कर(आकार) + "\" font-family=\"sans-serif\">" + पाठ_कर(सामग्री) + "</text>")
    प्रत्यागच्छ निर्माता

कर्म svg_पथ(निर्माता, d, भरण, सीमा = शून्य):
    """Add path with SVG path data."""
    यदि सीमा == शून्य:
        सीमा = "none"
    निर्माता.जोड़ो("  <path d=\"" + पाठ_कर(d) + "\" fill=\"" + पाठ_कर(भरण) + "\" stroke=\"" + पाठ_कर(सीमा) + "\" stroke-width=\"1\"/>")
    प्रत्यागच्छ निर्माता

कर्म svg_रेखीय_ढाल(निर्माता, x1, y1, x2, y2, रंग१, रंग२, आईडी = शून्य):
    """Add linear gradient definition. Returns updated builder."""
    यदि आईडी == शून्य:
        आईडी = "grad1"
    निर्माता.जोड़ो("  <defs>")
    निर्माता.जोड़ो("    <linearGradient id=\"" + पाठ_कर(आईडी) + "\" x1=\"" + पाठ_कर(x1) + "\" y1=\"" + पाठ_कर(y1) + "\" x2=\"" + पाठ_कर(x2) + "\" y2=\"" + पाठ_कर(y2) + "\">")
    निर्माता.जोड़ो("      <stop offset=\"0%\" stop-color=\"" + पाठ_कर(रंग१) + "\"/>")
    निर्माता.जोड़ो("      <stop offset=\"100%\" stop-color=\"" + पाठ_कर(रंग२) + "\"/>")
    निर्माता.जोड़ो("    </linearGradient>")
    निर्माता.जोड़ो("  </defs>")
    प्रत्यागच्छ निर्माता

कर्म svg_विकिरणीय_ढाल(निर्माता, cx, cy, त्रिज्या, रंग१, रंग२, आईडी = शून्य):
    """Add radial gradient definition."""
    यदि आईडी == शून्य:
        आईडी = "rgrad1"
    निर्माता.जोड़ो("  <defs>")
    निर्माता.जोड़ो("    <radialGradient id=\"" + पाठ_कर(आईडी) + "\" cx=\"" + पाठ_कर(cx) + "\" cy=\"" + पाठ_कर(cy) + "\" r=\"" + पाठ_कर(त्रिज्या) + "\">")
    निर्माता.जोड़ो("      <stop offset=\"0%\" stop-color=\"" + पाठ_कर(रंग१) + "\"/>")
    निर्माता.जोड़ो("      <stop offset=\"100%\" stop-color=\"" + पाठ_कर(रंग२) + "\"/>")
    निर्माता.जोड़ो("    </radialGradient>")
    निर्माता.जोड़ो("  </defs>")
    प्रत्यागच्छ निर्माता

कर्म svg_स्तर_ढाल(निर्माता, रंग_श्रेणी, आईडी = शून्य):
    """Add multi-stop gradient from color list."""
    यदि आईडी == शून्य:
        आईडी = "layerGrad"
    चर चरण = दीर्घता(रंग_श्रेणी)
    यदि चरण < 2:
        प्रत्यागच्छ निर्माता
    निर्माता.जोड़ो("  <defs>")
    निर्माता.जोड़ो("    <linearGradient id=\"" + पाठ_कर(आईडी) + "\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"0\">")
    चर i = ०
    यावत् i < चरण:
        चर प्रतिशत = पूर्णांक_मिलाओ((i / (चरण - 1)) * 100)
        निर्माता.जोड़ो("      <stop offset=\"" + पाठ_कर(प्रतिशत) + "%\" stop-color=\"" + पाठ_कर(रंग_श्रेणी[i]) + "\"/>")
        i += १
    निर्माता.जोड़ो("    </linearGradient>")
    निर्माता.जोड़ो("  </defs>")
    प्रत्यागच्छ निर्माता

कर्म svg_ढाल_आयत(निर्माता, x, y, चौड़ाई, ऊंचाई, ढाल_आईडी, सीमा = शून्य):
    """Rectangle filled with a gradient."""
    यदि सीमा == शून्य:
        सीमा = "none"
    निर्माता.जोड़ो("  <rect x=\"" + पाठ_कर(x) + "\" y=\"" + पाठ_कर(y) + "\" width=\"" + पाठ_कर(चौड़ाई) + "\" height=\"" + पाठ_कर(ऊंचाई) + "\" fill=\"url(#" + पाठ_कर(ढाल_आईडी) + ")\" stroke=\"" + पाठ_कर(सीमा) + "\" stroke-width=\"1\"/>")
    प्रत्यागच्छ निर्माता

कर्म svg_स्पेक्ट्रम_पट्टी(निर्माता, x, y, चौड़ाई, ऊंचाई, प्रारंभ_nm, अंत_nm):
    """Draw visible spectrum as a horizontal strip."""
    चर चरण = चौड़ाई
    यदि चरण > 400:
        चरण = 400
    चर श्रेणी = स्पेक्ट्रम_ढाल(प्रारंभ_nm, अंत_nm, चरण)
    चर i = ०
    यावत् i < चरण:
        चर px = x + i
        निर्माता = svg_आयत(निर्माता, px, y, 1, ऊंचाई, श्रेणी[i], "none")
        i += १
    प्रत्यागच्छ निर्माता

कर्म svg_रंग_वर्ग(निर्माता, x, y, आकार, रंग):
    """Draw a single color swatch with border."""
    निर्माता = svg_आयत(निर्माता, x, y, आकार, आकार, रंग, "#333333")
    प्रत्यागच्छ निर्माता

कर्म svg_श्रेणी_दिखाओ(निर्माता, x, y, आकार, श्रेणी):
    """Draw a palette as row of swatches."""
    चर i = ०
    प्रत्येक चर r अन्तर्गत श्रेणी:
        निर्माता = svg_रंग_वर्ग(निर्माता, x + i * (आकार + 2), y, आकार, r)
        i += १
    प्रत्यागच्छ निर्माता

कर्म svg_लिखो(निर्माता, पथ):
    """Write SVG to file."""
    निर्माता = svg_समाप्त(निर्माता)
    लेखन(पथ, संयोग(निर्माता, "\n"))


# ╔══════════════════════════════════════════════════════════════════╗
# ║  भाग १२: PPM रेखाचित्र उत्पादन (Raster — Any Resolution)        ║
# ║  PPM (Portable Pixmap) — pure ASCII, no compression needed      ║
# ║  Openable by GIMP, Photoshop, ImageMagick, FFmpeg, browsers     ║
# ╚══════════════════════════════════════════════════════════════════╝

कर्म ppm_आरम्भ(चौड़ाई, ऊंचाई):
    """
    Create a PPM image buffer.
    Returns {"चौड़ाई": w, "ऊंचाई": h, "डेटा": flat list of R,G,B,R,G,B,...}
    """
    चर कुल_पिक्सेल = चौड़ाई * ऊंचाई
    चर डेटा_मान = []
    चर i = ०
    यावत् i < कुल_पिक्सेल:
        डेटा_मान.जोड़ो(०)
        डेटा_मान.जोड़ो(०)
        डेटा_मान.जोड़ो(०)
        i += १
    प्रत्यागच्छ {"चौड़ाई": चौड़ाई, "ऊंचाई": ऊंचाई, "डेटा": डेटा_मान}

कर्म ppm_पिक्सेल_सेट(चित्र, x, y, r, ह, नी):
    """Set a single pixel (0-indexed)."""
    यदि x < ० अथवा x >= चित्र["चौड़ाई"]:
        प्रत्यागच्छ शून्य
    यदि y < ० अथवा y >= चित्र["ऊंचाई"]:
        प्रत्यागच्छ शून्य
    चर सूचकांक = (y * चित्र["चौड़ाई"] + x) * 3
    चित्र["डेटा"][सूचकांक] = सीमित(r, ०, 255)
    चित्र["डेटा"][सूचकांक + 1] = सीमित(ह, ०, 255)
    चित्र["डेटा"][सूचकांक + 2] = सीमित(नी, ०, 255)
    प्रत्यागच्छ सत्य

कर्म ppm_पिक्सेल_हेक्स(चित्र, x, y, हेक्स):
    """Set pixel from hex color string."""
    चर rgb = hex_से_rgb(हेक्स)
    प्रत्यागच्छ ppm_पिक्सेल_सेट(चित्र, x, y, rgb["र"], rgb["ह"], rgb["नी"])

कर्म ppm_पिक्सेल_प्राप्त(चित्र, x, y):
    """Get {र,ह,नी} of a pixel."""
    यदि x < ० अथवा x >= चित्र["चौड़ाई"]:
        प्रत्यागच्छ {"र": ०, "ह": ०, "नी": ०}
    यदि y < ० अथवा y >= चित्र["ऊंचाई"]:
        प्रत्यागच्छ {"र": ०, "ह": ०, "नी": ०}
    चर सूचकांक = (y * चित्र["चौड़ाई"] + x) * 3
    प्रत्यागच्छ {
        "र": चित्र["डेटा"][सूचकांक],
        "ह": चित्र["डेटा"][सूचकांक + 1],
        "नी": चित्र["डेटा"][सूचकांक + 2]
    }

कर्म ppm_आयत_भरो(चित्र, x1, y1, x2, y2, r, ह, नी):
    """Fill a rectangular region with solid color."""
    चर py = अधिकतम(y1, ०)
    चर py_end = न्यूनतम(y2, चित्र["ऊंचाई"] - 1)
    यावत् py <= py_end:
        चर px = अधिकतम(x1, ०)
        चर px_end = न्यूनतम(x2, चित्र["चौड़ाई"] - 1)
        यावत् px <= px_end:
            ppm_पिक्सेल_सेट(चित्र, px, py, r, ह, नी)
            px += १
        py += १
    प्रत्यागच्छ सत्य

कर्म ppm_आयत_हेक्स(चित्र, x1, y1, x2, y2, हेक्स):
    """Fill rectangle from hex color."""
    चर rgb = hex_से_rgb(हेक्स)
    प्रत्यागच्छ ppm_आयत_भरो(चित्र, x1, y1, x2, y2, rgb["र"], rgb["ह"], rgb["नी"])

कर्म ppm_रेखीय_ढाल_भरो(चित्र, x1, y1, x2, y2, रंग१, रंग२):
    """Fill rectangle with linear gradient between two colors."""
    चर a = _हेक्स_विश्लेषण(रंग१)
    चर b = _हेक्स_विश्लेषण(रंग२)
    चर py = अधिकतम(y1, ०)
    चर py_end = न्यूनतम(y2, चित्र["ऊंचाई"] - 1)
    यावत् py <= py_end:
        चर px = अधिकतम(x1, ०)
        चर px_end = न्यूनतम(x2, चित्र["चौड़ाई"] - 1)
        यावत् px <= px_end:
            # Gradient along x-axis
            चर t = ०
            यदि px_end > px:
                t = (px - px) / (px_end - px)
            चर r = पूर्णांक_मिलाओ(a["र"] * (1 - t) + b["र"] * t)
            चर g = पूर्णांक_मिलाओ(a["ह"] * (1 - t) + b["ह"] * t)
            चर bl = पूर्णांक_मिलाओ(a["नी"] * (1 - t) + b["नी"] * t)
            ppm_पिक्सेल_सेट(चित्र, px, py, r, g, bl)
            px += १
        py += १
    प्रत्यागच्छ सत्य

कर्म ppm_ऊर्ध्वाधर_ढाल(चित्र, x1, y1, x2, y2, रंग१, रंग२):
    """Fill rectangle with vertical gradient."""
    चर a = _हेक्स_विश्लेषण(रंग१)
    चर b = _हेक्स_विश्लेषण(रंग२)
    चर py = अधिकतम(y1, ०)
    चर py_end = न्यूनतम(y2, चित्र["ऊंचाई"] - 1)
    यावत् py <= py_end:
        चर t = ०
        यदि py_end > py:
            t = (py - py) / (py_end - py)
        चर r = पूर्णांक_मिलाओ(a["र"] * (1 - t) + b["र"] * t)
        चर g = पूर्णांक_मिलाओ(a["ह"] * (1 - t) + b["ह"] * t)
        चर bl = पूर्णांक_मिलाओ(a["नी"] * (1 - t) + b["नी"] * t)
        चर px = अधिकतम(x1, ०)
        चर px_end = न्यूनतम(x2, चित्र["चौड़ाई"] - 1)
        यावत् px <= px_end:
            ppm_पिक्सेल_सेट(चित्र, px, py, r, g, bl)
            px += १
        py += १
    प्रत्यागच्छ सत्य

कर्म ppm_वृत्त_भरो(चित्र, cx, cy, त्रिज्या, r, ह, नी):
    """Fill a circle using midpoint algorithm."""
    चर x = पूर्णांक_मिलाओ(त्रिज्या)
    चर y = ०
    चर d = 1 - पूर्णांक_मिलाओ(त्रिज्या)
    यावत् x >= y:
        # Draw 8 octants
        ppm_आयत_भरो(चित्र, cx + x, cy + y, cx + x, cy + y, r, ह, नी)
        ppm_आयत_भरो(चित्र, cx - x, cy + y, cx - x, cy + y, r, ह, नी)
        ppm_आयत_भरो(चित्र, cx + x, cy - y, cx + x, cy - y, r, ह, नी)
        ppm_आयत_भरो(चित्र, cx - x, cy - y, cx - x, cy - y, r, ह, नी)
        ppm_आयत_भरो(चित्र, cx + y, cy + x, cx + y, cy + x, r, ह, नी)
        ppm_आयत_भरो(चित्र, cx - y, cy + x, cx - y, cy + x, r, ह, नी)
        ppm_आयत_भरो(चित्र, cx + y, cy - x, cx + y, cy - x, r, ह, नी)
        ppm_आयत_भरो(चित्र, cx - y, cy - x, cx - y, cy - x, r, ह, नी)
        यदि d < ०:
            d = d + 2 * y + 3
        अन्यथा:
            d = d + 2 * (y - x) + 5
            x -= १
        y += १
    प्रत्यागच्छ सत्य

कर्म ppm_वृत्त_हेक्स(चित्र, cx, cy, त्रिज्या, हेक्स):
    """Fill circle from hex color."""
    चर rgb = hex_से_rgb(हेक्स)
    प्रत्यागच्छ ppm_वृत्त_भरो(चित्र, cx, cy, त्रिज्या, rgb["र"], rgb["ह"], rgb["नी"])

कर्म ppm_रेखा(चित्र, x1, y1, x2, y2, r, ह, नी):
    """Draw a line using Bresenham's algorithm."""
    चर dx = अधिकतम(x2 - x1, x1 - x2)
    चर dy = न्यूनतम(x2 - x1, x1 - x2)
    चर sx = ०
    यदि x1 < x2:
        sx = 1
    अन्यथा:
        sx = -1
    चर sy = ०
    यदि y1 < y2:
        sy = 1
    अन्यथा:
        sy = -1
    चर err = dx - dy
    यावत् सत्य:
        ppm_पिक्सेल_सेट(चित्र, x1, y1, r, ह, नी)
        यदि x1 == x2 और y1 == y2:
            विराम
        चर e2 = 2 * err
        यदि e2 > -dy:
            err -= dy
            x1 += sx
        यदि e2 < dx:
            err += dx
            y1 += sy
    प्रत्यागच्छ सत्य

कर्म ppm_रेखा_हेक्स(चित्र, x1, y1, x2, y2, हेक्स):
    """Draw line from hex color."""
    चर rgb = hex_से_rgb(हेक्स)
    प्रत्यागच्छ ppm_रेखा(चित्र, x1, y1, x2, y2, rgb["र"], rgb["ह"], rgb["नी"])

कर्म ppm_आयत_रेखा(चित्र, x1, y1, x2, y2, r, ह, नी):
    """Draw rectangle outline (not filled)."""
    ppm_रेखा(चित्र, x1, y1, x2, y1, r, ह, नी)
    ppm_रेखा(चित्र, x2, y1, x2, y2, r, ह, नी)
    ppm_रेखा(चित्र, x2, y2, x1, y2, r, ह, नी)
    ppm_रेखा(चित्र, x1, y2, x1, y1, r, ह, नी)
    प्रत्यागच्छ सत्य

कर्म ppm_आयत_रेखा_हेक्स(चित्र, x1, y1, x2, y2, हेक्स):
    """Draw rectangle outline from hex."""
    चर rgb = hex_से_rgb(हेक्स)
    प्रत्यागच्छ ppm_आयत_रेखा(चित्र, x1, y1, x2, y2, rgb["र"], rgb["ह"], rgb["नी"])

कर्म ppm_स्पेक्ट्रम_पट्टी(चित्र, x, y, चौड़ाई, ऊंचाई):
    """Draw visible spectrum (380-780nm) as horizontal strip."""
    चर चरण = चौड़ाई
    यदि चरण > 400:
        चरण = 400
    चर श्रेणी = स्पेक्ट्रम_ढाल(380, 780, चरण)
    चर i = ०
    यावत् i < चरण:
        चर rgb = hex_से_rgb(श्रेणी[i])
        ppm_आयत_भरो(चित्र, x + i, y, x + i, y + ऊंचाई - 1, rgb["र"], rgb["ह"], rgb["नी"])
        i += १
    प्रत्यागच्छ सत्य

कर्म ppm_श्रेणी_पट्टी(चित्र, x, y, चौड़ाई_प्रत्येक, ऊंचाई, श्रेणी):
    """Draw palette as row of color blocks."""
    चर i = ०
    प्रत्येक चर r अन्तर्गत श्रेणी:
        चर rgb = hex_से_rgb(r)
        ppm_आयत_भरो(चित्र, x + i * चौड़ाई_प्रत्येक, y, x + (i + 1) * चौड़ाई_प्रत्येक - 1, y + ऊंचाई - 1, rgb["र"], rgb["ह"], rgb["नी"])
        i += १
    प्रत्यागच्छ सत्य

कर्म ppm_शोर(चित्र, तीव्रता):
    """Add random-looking noise. तीव्रता=0-100."""
    चर डेटा_मान = चित्र["डेटा"]
    चर i = ०
    यावत् i < दीर्घता(डेटा_मान):
        चर विचलन = पूर्णांक_कर((तीव्रता / 100) * 255)
        चर शोर = (i * 7 + i * i * 13) % (विचलन + 1) - विचलन / 2
        डेटा_मान[i] = सीमित(डेटा_मान[i] + शोर, ०, 255)
        i += १
    प्रत्यागच्छ सत्य

कर्म ppm_प्रतिलिपि(चित्र):
    """Deep copy an image buffer."""
    चर नया_डेटा = []
    चर i = ०
    यावत् i < दीर्घता(चित्र["डेटा"]):
        नया_डेटा.जोड़ो(चित्र["डेटा"][i])
        i += १
    प्रत्यागच्छ {"चौड़ाई": चित्र["चौड़ाई"], "ऊंचाई": चित्र["ऊंचाई"], "डेटा": नया_डेटा}

कर्म ppm_फसल(चित्र, x1, y1, x2, y2):
    """Crop image to rectangle region. Returns new image."""
    चर w = x2 - x1
    चर h = y2 - y1
    यदि w <= ० अथवा h <= ०:
        प्रत्यागच्छ ppm_आरम्भ(1, 1)
    चर नया = ppm_आरम्भ(w, h)
    चर py = ०
    यावत् py < h:
        चर px = ०
        यावत् px < w:
            चर पिक्सेल = ppm_पिक्सेल_प्राप्त(चित्र, x1 + px, y1 + py)
            ppm_पिक्सेल_सेट(नया, px, py, पिक्सेल["र"], पिक्सेल["ह"], पिक्सेल["नी"])
            px += १
        py += १
    प्रत्यागच्छ नया

कर्म ppm_समानुपात_बदलो(चित्र, नया_चौड़ाई, नया_ऊंचाई):
    """Scale image to new size (nearest neighbor)."""
    चर नया = ppm_आरम्भ(नया_चौड़ाई, नया_ऊंचाई)
    चर py = ०
    यावत् py < नया_ऊंचाई:
        चर src_y = पूर्णांक_कर(py * चित्र["ऊंचाई"] / नया_ऊंचाई)
        चर px = ०
        यावत् px < नया_चौड़ाई:
            चर src_x = पूर्णांक_कर(px * चित्र["चौड़ाई"] / नया_चौड़ाई)
            चर पिक्सेल = ppm_पिक्सेल_प्राप्त(चित्र, src_x, src_y)
            ppm_पिक्सेल_सेट(नया, px, py, पिक्सेल["र"], पिक्सेल["ह"], पिक्सेल["नी"])
            px += १
        py += १
    प्रत्यागच्छ नया

कर्म ppm_जोड़(चित्र, दूसरा):
    """Concatenate two images side by side. Must have same height."""
    चर नया_चौड़ाई = चित्र["चौड़ाई"] + दूसरा["चौड़ाई"]
    चर नया_ऊंचाई = चित्र["ऊंचाई"]
    यदि दूसरा["ऊंचाई"] > नया_ऊंचाई:
        नया_ऊंचाई = दूसरा["ऊंचाई"]
    चर नया = ppm_आरम्भ(नया_चौड़ाई, नया_ऊंचाई)
    ppm_आयत_भरो(नया, ०, ०, नया_चौड़ाई - 1, नया_ऊंचाई - 1, ०, ०, ०)
    # Copy first image
    चर py = ०
    यावत् py < चित्र["ऊंचाई"]:
        चर px = ०
        यावत् px < चित्र["चौड़ाई"]:
            चर पिक्सेल = ppm_पिक्सेल_प्राप्त(चित्र, px, py)
            ppm_पिक्सेल_सेट(नया, px, py, पिक्सेल["र"], पिक्सेल["ह"], पिक्सेल["नी"])
            px += १
        py += १
    # Copy second image
    चर py2 = ०
    यावत् py2 < दूसरा["ऊंचाई"]:
        चर px2 = ०
        यावत् px2 < दूसरा["चौड़ाई"]:
            चर पिक्सेल2 = ppm_पिक्सेल_प्राप्त(दूसरा, px2, py2)
            ppm_पिक्सेल_सेट(नया, चित्र["चौड़ाई"] + px2, py2, पिक्सेल2["र"], पिक्सेल2["ह"], पिक्सेल2["नी"])
            px2 += १
        py2 += १
    प्रत्यागच्छ नया

कर्म ppm_लिखो(चित्र, पथ):
    """Write PPM image to file (P3 ASCII format)."""
    चर पंक्तियाँ = []
    पंक्तियाँ.जोड़ो("P3")
    पंक्तियाँ.जोड़ो(पाठ_कर(चित्र["चौड़ाई"]) + " " + पाठ_कर(चित्र["ऊंचाई"]))
    पंक्तियाँ.जोड़ो("255")
    चर डेटा_मान = चित्र["डेटा"]
    चर कुल = दीर्घता(डेटा_मान)
    चर i = ०
    चर पंक्ति_डेटा = ""
    चर पंक्ति_गिनती = ०
    यावत् i < कुल:
        पंक्ति_डेटा = पंक्ति_डेटा + पाठ_कर(डेटा_मान[i]) + " "
        पंक्ति_गिनती += १
        यदि पंक्ति_गिनती >= 12:
            पंक्तियाँ.जोड़ो(छाँटो(पंक्ति_डेटा))
            पंक्ति_डेटा = ""
            पंक्ति_गिनती = ०
        i += १
    यदि दीर्घता(छाँटो(पंक्ति_डेटा)) > ०:
        पंक्तियाँ.जोड़ो(छाँटो(पंक्ति_डेटा))
    लेखन(पथ, संयोग(पंक्तियाँ, "\n"))


# ╔══════════════════════════════════════════════════════════════════╗
# ║  भाग १३: उपयोगिता कार्य (Utility Functions)                    ║
# ╚════════════════════════════════════════════════════════════════════╝

कर्म विवरण(रंग):
    """Full color analysis: hex, RGB, HSL, HSV, CMYK, brightness, text color."""
    चर rgb = _हेक्स_विश्लेषण(रंग)
    चर h = rgb_से_hex(rgb["र"], rgb["ह"], rgb["नी"])
    चर hsl = rgb_से_hsl(rgb["र"], rgb["ह"], rgb["नी"])
    चर hsv = rgb_से_hsv(rgb["र"], rgb["ह"], rgb["नी"])
    चर cmyk = rgb_से_cmyk(rgb["र"], rgb["ह"], rgb["नी"])
    चर चमक_मान = चमक(h)
    चर पाठ_कर = पाठ_रंग(h)
    प्रत्यागच्छ {
        "हेक्स": h,
        "rgb": rgb,
        "hsl": hsl,
        "hsv": hsv,
        "cmyk": cmyk,
        "चमक": चमक_मान,
        "पाठ_रंग": पाठ_कर,
        "पूरक": पूरक(h),
        "विपरीत": विपरीत(h),
        "ग्रेस्केल": ग्रेस्केल(h)
    }

कर्म विवरण_दिखाओ(रंग):
    """Print formatted color analysis."""
    चर v = विवरण(रंग)
    मुद्रय "╔══════════════════════════════════════════╗"
    मुद्रय "║        रंग विवरण (Color Analysis)        ║"
    मुद्रय "╚══════════════════════════════════════════╝"
    मुद्रय "  हेक्स:     " + v["हेक्स"]
    मुद्रय "  RGB:      " + पाठ_कर(v["rgb"]["र"]) + ", " + पाठ_कर(v["rgb"]["ह"]) + ", " + पाठ_कर(v["rgb"]["नी"])
    मुद्रय "  HSL:      " + पाठ_कर(v["hsl"]["व"]) + "°, " + पाठ_कर(v["hsl"]["त"]) + "%, " + पाठ_कर(v["hsl"]["प्र"]) + "%"
    मुद्रय "  HSV:      " + पाठ_कर(v["hsv"]["व"]) + "°, " + पाठ_कर(v["hsv"]["त"]) + "%, " + पाठ_कर(v["hsv"]["म"]) + "%"
    मुद्रय "  CMYK:     " + पाठ_कर(v["cmyk"]["नी"]) + "%, " + पाठ_कर(v["cmyk"]["मै"]) + "%, " + पाठ_कर(v["cmyk"]["पी"]) + "%, " + पाठ_कर(v["cmyk"]["क"]) + "%"
    मुद्रय "  चमक:     " + पाठ_कर(v["चमक"]) + "/255"
    मुद्रय "  पाठ रंग:  " + v["पाठ_रंग"] + " (" + v["पाठ_रंग"] + ")"
    मुद्रय "  पूरक:    " + v["पूरक"]
    मुद्रय "  विपरीत:   " + v["विपरीत"]
    मुद्रय "  ग्रेस्केल: " + v["ग्रेस्केल"]

कर्म रंग_पट्टी_दिखाओ(रंग_सूची, ब्लॉक_आकार = शून्य):
    """Print color swatches in terminal using block characters."""
    यदि ब्लॉक_आकार == शून्य:
        ब्लॉक_आकार = 4
    चर पंक्ति = ""
    चर गिनती = ०
    प्रत्येक चर r अन्तर्गत रंग_सूची:
        पंक्ति = पंक्ति + " " + r
        गिनती += १
        यदि गिनती >= 8:
            मुद्रय पंक्ति
            पंक्ति = ""
            गिनती = ०
    यदि दीर्घता(छाँटो(पंक्ति)) > ०:
        मुद्रय पंक्ति

कर्म स्पेक्ट्रम_दिखाओ():
    """Print visible spectrum color strip in terminal."""
    चर श्रेणी = स्पेक्ट्रम_ढाल(380, 780, 40)
    चर पंक्ति = ""
    प्रत्येक चर r अन्तर्गत श्रेणी:
        पंक्ति = पंक्ति + " " + r
    मुद्रय पंक्ति
    मुद्रय "  380nm                                780nm"

कर्म ताप_स्पेक्ट्रम_दिखाओ():
    """Print blackbody temperature strip in terminal."""
    चर श्रेणी = ताप_ढाल(1000, 40000, 20)
    चर पंक्ति = ""
    प्रत्येक चर r अन्तर्गत श्रेणी:
        पंक्ति = पंक्ति + " " + r
    मुद्रय पंक्ति
    मुद्रय "  1000K                                40000K"

कर्म श्रेणी_दिखाओ(नाम, श्रेणी):
    """Print a named palette."""
    मुद्रय "  " + नाम + " (" + पाठ_कर(दीर्घता(श्रेणी)) + "):"
    रंग_पट्टी_दिखाओ(श्रेणी)

कर्म सभी_संग्रह_दिखाओ():
    """List all color collections with counts."""
    चर श्रेणी_नाम = कुंजियाँ(सभी_रंग)
    मुद्रय "╔══════════════════════════════════════════════╗"
    मुद्रय "║     रंग संग्रह (Color Collections)           ║"
    मुद्रय "╚══════════════════════════════════════════════╝"
    चर कुल = ०
    प्रत्येक चर श अन्तर्गत श्रेणी_नाम:
        चर गिनती = दीर्घता(कुंजियाँ(सभी_रंग[श]))
        कुल += गिनती
        मुद्रय "  " + "▸" + " " + श + " (" + पाठ_कर(गिनती) + " रंग)"
    मुद्रय "──────────────────────────────────────────────"
    मुद्रय "  कुल: " + पाठ_कर(कुल) + " नामित रंग"
    मुद्रय "  + स्पेक्ट्रम: 380-780nm (निरंतर)"
    मुद्रय "  + काले शरीर: 1000-40000K (निरंतर)"
    मुद्रय "  + HSL/HSV/CMYK: असीम रंग उत्पादन"
