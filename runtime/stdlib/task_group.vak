# वाक् मानक पुस्तकालय — कार्य_समूह (Structured Task Group)
# Vak Standard Library — Promise-based task aggregation

आयात promise

वर्ग आंतरिक_कार्य_सहायक:
    कर्म प्रारम्भ(स्वयं, फलन, वादा):
        स्वयं.फलन = फलन
        स्वयं.वादा = वादा

    कर्म चलाओ(स्वयं):
        चर मेरा_फलन = स्वयं.फलन
        चर परिणाम = मेरा_फलन()
        स्वयं.वादा.पूर्ण_करो(परिणाम)


वर्ग कार्य_समूह:
    कर्म प्रारम्भ(स्वयं, लूप):
        स्वयं.लूप = लूप
        स्वयं.वादे = []
        स्वयं.यंत्र = नव promise.वादा_यंत्र()

    कर्म जोड़ो(स्वयं, कार्य_फलन):
        चर नया_वादा = नव promise.वादा()
        स्वयं.वादे.जोड़ो(नया_वादा)

        चर सहायक = नव आंतरिक_कार्य_सहायक(कार्य_फलन, नया_वादा)
        स्वयं.लूप.कार्य_जोड़ो_वस्तु(सहायक)

        प्रत्यागच्छ नया_वादा

    कर्म प्रतीक्षा_करो(स्वयं):
        प्रत्यागच्छ स्वयं.यंत्र.सब(स्वयं.वादे)
