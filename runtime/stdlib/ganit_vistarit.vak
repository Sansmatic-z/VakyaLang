# वाक् मानक पुस्तकालय — गणित विस्तारित (Comprehensive Mathematics)
# Vak Standard Library — Complete Mathematics from Scratch
# शुद्ध वाक् कार्यान्वयन (Pure VakyaLang Implementation)
# लेखक: Visionary RM (Raj Mitra)

# ── स्थिरांक (Constants) ─────────────────────────────────────────────────────

स्थिर पाई = ३.१४१५९२६५३५८९७९३२३८४६२६४३३८३२७९५०२८८४१९७१६९३९
स्थिर ई = २.७१८२८१८२८४५९०४५२३५३६०२८७४७१३५२६६२४९७७५७२४७०९
स्थिर सुवर्ण_अनुपात = १.६१८०३३९८८७४९८९४८४८२०४५८६८३४३६५६३८११७४९०९

# ── मूल गणितीय संचालन (Basic Mathematical Operations) ───────────────────────

कर्म निरपेक्ष(गण):
    टीका Absolute value |x|
    यदि गण < ०:
        प्रत्यागच्छ -गण
    प्रत्यागच्छ गण

कर्म चिन्ह(गण):
    टीका Sign function: returns -1, 0, or 1
    यदि गण < ०:
        प्रत्यागच्छ -१
    यदि गण > ०:
        प्रत्यागच्छ १
    प्रत्यागच्छ ०

कर्म फर्श(गण):
    टीका Floor function — greatest integer ≤ x
    चर पूर्ण = पूर्णांक_कर(गण)
    यदि गण < ० और गण != पूर्ण:
        प्रत्यागच्छ पूर्ण - १
    प्रत्यागच्छ पूर्ण

कर्म छत(गण):
    टीका Ceiling function — smallest integer ≥ x
    चर पूर्ण = पूर्णांक_कर(गण)
    यदि गण > ० और गण != पूर्ण:
        प्रत्यागच्छ पूर्ण + १
    प्रत्यागच्छ पूर्ण

कर्म गोल(गण, अंक=०):
    टीका Round to nearest integer or decimal places
    चर गुणक = १० ** अंक
    प्रत्यागच्छ फर्श(गण * गुणक + ०.५) / गुणक

# ── घात और मूल (Powers and Roots) ───────────────────────────────────────────

कर्म वर्ग(गण):
    टीका Square: x²
    प्रत्यागच्छ गण * गण

कर्म घन(गण):
    टीका Cube: x³
    प्रत्यागच्छ गण * गण * गण

कर्म घात(आधार, घातांक):
    टीका Power: a^b using binary exponentiation
    यदि घातांक == ०:
        प्रत्यागच्छ १
    यदि घातांक < ०:
        प्रत्यागच्छ १ / घात(आधार, -घातांक)
    यदि घातांक == १:
        प्रत्यागच्छ आधार
    
    चर परिणाम = १
    चर आधार_प्रतिलिपि = आधार
    चर घात_प्रतिलिपि = घातांक
    
    यावत् घात_प्रतिलिपि > ०:
        यदि घात_प्रतिलिपि % २ == १:
            परिणाम = परिणाम * आधार_प्रतिलिपि
        आधार_प्रतिलिपि = आधार_प्रतिलिपि * आधार_प्रतिलिपि
        घात_प्रतिलिपि = घात_प्रतिलिपि // २
    
    प्रत्यागच्छ परिणाम

कर्म वर्गमूल(गण):
    टीका Square root using Newton-Raphson method
    यदि गण < ०:
        उत्क्षिप "ऋणात्मक संख्या का वर्गमूल नहीं"
    यदि गण == ०:
        प्रत्यागच्छ ०
    
    चर अनुमान = गण / २
    चर पूर्व_अनुमान = ०
    चर सहनशीलता = ०.०००००००००१
    
    यावत् निरपेक्ष(अनुमान - पूर्व_अनुमान) > सहनशीलता:
        पूर्व_अनुमान = अनुमान
        अनुमान = (अनुमान + गण / अनुमान) / २
    
    प्रत्यागच्छ अनुमान

कर्म घनमूल(गण):
    टीका Cube root using Newton-Raphson
    यदि गण < ०:
        प्रत्यागच्छ -घनमूल(-गण)
    यदि गण == ०:
        प्रत्यागच्छ ०
    
    चर अनुमान = गण / ३
    चर पूर्व_अनुमान = ०
    चर सहनशीलता = ०.०००००००००१
    
    यावत् निरपेक्ष(अनुमान - पूर्व_अनुमान) > सहनशीलता:
        पूर्व_अनुमान = अनुमान
        अनुमान = (२ * अनुमान + गण / (अनुमान * अनुमान)) / ३
    
    प्रत्यागच्छ अनुमान

कर्म nवाँ_मूल(गण, n):
    टीका nth root using Newton-Raphson
    यदि गण < ० और n % २ == ०:
        उत्क्षिप "सम मूल ऋणात्मक संख्या का नहीं"
    यदि गण == ०:
        प्रत्यागच्छ ०
    
    चर अनुमान = गण / n
    चर पूर्व_अनुमान = ०
    चर सहनशीलता = ०.०००००००००१
    
    यावत् निरपेक्ष(अनुमान - पूर्व_अनुमान) > सहनशीलता:
        पूर्व_अनुमान = अनुमान
        चर अनुमान_घात = घात(अनुमान, n - १)
        अनुमान = ((n - १) * अनुमान + गण / अनुमान_घात) / n
    
    प्रत्यागच्छ अनुमान

# ── लघुगणक (Logarithms) ─────────────────────────────────────────────────────

कर्म प्राकृतिक_लघुगणक(गण):
    टीका Natural logarithm ln(x) using Taylor series
    यदि गण <= ०:
        उत्क्षिप "लघुगणक केवल धनात्मक संख्याओं के लिए"
    
    # Use ln(x) = 2 * arctanh((x-1)/(x+1)) for better convergence
    चर y = (गण - १) / (गण + १)
    चर y_वर्ग = y * y
    चर योग = ०
    चर पद = y
    चर i = १
    
    # Sum odd powers: y + y³/3 + y⁵/5 + ...
    यावत् i < १००:
        योग = योग + पद / i
        पद = पद * y_वर्ग
        i = i + २
    
    प्रत्यागच्छ २ * योग

कर्म लघुगणक_१०(गण):
    टीका Logarithm base 10
    चर ln_१० = २.३०२५८५०९२९९४०४५६८४०१७९९१४५४६८४३६४२०७६०१
    प्रत्यागच्छ प्राकृतिक_लघुगणक(गण) / ln_१०

कर्म लघुगणक(गण, आधार):
    टीका Logarithm with arbitrary base
    प्रत्यागच्छ प्राकृतिक_लघुगणक(गण) / प्राकृतिक_लघुगणक(आधार)

# ── त्रिकोणमिति (Trigonometry) ──────────────────────────────────────────────

कर्म रेडियन_से_डिग्री(रेडियन):
    प्रत्यागच्छ रेडियन * १८० / पाई

कर्म डिग्री_से_रेडियन(डिग्री):
    प्रत्यागच्छ डिग्री * पाई / १८०

कर्म साइन(कोण):
    टीका Sine using Taylor series: sin(x) = x - x³/3! + x⁵/5! - ...
    # Normalize angle to [-π, π]
    चर x = कोण
    यावत् x > पाई:
        x = x - २ * पाई
    यावत् x < -पाई:
        x = x + २ * पाई
    
    चर योग = x
    चर पद = x
    चर i = ३
    
    यावत् i < ५०:
        पद = -पद * x * x / (i * (i - १))
        योग = योग + पद
        i = i + २
    
    प्रत्यागच्छ योग

कर्म कोसाइन(कोण):
    टीका Cosine using Taylor series: cos(x) = 1 - x²/2! + x⁴/4! - ...
    # Normalize angle to [-π, π]
    चर x = कोण
    यावत् x > पाई:
        x = x - २ * पाई
    यावत् x < -पाई:
        x = x + २ * पाई
    
    चर योग = १
    चर पद = १
    चर i = २
    
    यावत् i < ५०:
        पद = -पद * x * x / (i * (i - १))
        योग = योग + पद
        i = i + २
    
    प्रत्यागच्छ योग

कर्म टैन(कोण):
    टीका Tangent: tan(x) = sin(x)/cos(x)
    चर s = साइन(कोण)
    चर c = कोसाइन(कोण)
    यदि निरपेक्ष(c) < ०.००००००१:
        उत्क्षिप "टैन अपरिभाषित (कोण π/2 का गुणज)"
    प्रत्यागच्छ s / c

कर्म कोटैंज(कोण):
    टीका Cotangent: cot(x) = cos(x)/sin(x)
    चर s = साइन(कोण)
    चर c = कोसाइन(कोण)
    यदि निरपेक्ष(s) < ०.००००००१:
        उत्क्षिप "कोटैंज अपरिभाषित (कोण π का गुणज)"
    प्रत्यागच्छ c / s

कर्म सेकैंट(कोण):
    टीका Secant: sec(x) = 1/cos(x)
    चर c = कोसाइन(कोण)
    यदि निरपेक्ष(c) < ०.००००००१:
        उत्क्षिप "सेकैंट अपरिभाषित"
    प्रत्यागच्छ १ / c

कर्म कोसेकैंट(कोण):
    टीका Cosecant: csc(x) = 1/sin(x)
    चर s = साइन(कोण)
    यदि निरपेक्ष(s) < ०.००००००१:
        उत्क्षिप "कोसेकैंट अपरिभाषित"
    प्रत्यागच्छ १ / s

# ── व्युत्क्रम त्रिकोणमिति (Inverse Trigonometry) ───────────────────────────

कर्म आर्कसाइन(x):
    टीका Arcsin using Newton's method
    यदि निरपेक्ष(x) > १:
        उत्क्षिप "आर्कसाइन केवल [-1, 1] के लिए"
    
    यदि x == १:
        प्रत्यागच्छ पाई / २
    यदि x == -१:
        प्रत्यागच्छ -पाई / २
    यदि x == ०:
        प्रत्यागच्छ ०
    
    # Use Newton's method: y = arcsin(x), f(y) = sin(y) - x = 0
    चर y = x  # Initial guess
    चर पूर्व_y = ०
    चर सहनशीलता = ०.०००००००००१
    
    यावत् निरपेक्ष(y - पूर्व_y) > सहनशीलता:
        पूर्व_y = y
        चर sin_y = साइन(y)
        चर cos_y = कोसाइन(y)
        y = y - (sin_y - x) / cos_y
    
    प्रत्यागच्छ y

कर्म आर्ककोसाइन(x):
    टीका Arccos: arccos(x) = π/2 - arcsin(x)
    प्रत्यागच्छ पाई / २ - आर्कसाइन(x)

कर्म आर्कटैन(x):
    टीका Arctan using Taylor series for |x| < 1, identity for |x| > 1
    यदि x == ०:
        प्रत्यागच्छ ०
    
    # For |x| > 1, use: arctan(x) = π/2 - arctan(1/x)
    यदि निरपेक्ष(x) > १:
        प्रत्यागच्छ पाई / २ * चिन्ह(x) - आर्कटैन(१ / x)
    
    # For |x| <= 1, use Taylor series
    चर योग = x
    चर पद = x
    चर x_वर्ग = x * x
    चर i = ३
    
    यावत् i < १००:
        पद = -पद * x_वर्ग
        योग = योग + पद / i
        i = i + २
    
    प्रत्यागच्छ योग

कर्म आर्कटैन२(y, x):
    टीका Arctan2 - angle in correct quadrant
    यदि x > ०:
        प्रत्यागच्छ आर्कटैन(y / x)
    यदि x < ० और y >= ०:
        प्रत्यागच्छ आर्कटैन(y / x) + पाई
    यदि x < ० और y < ०:
        प्रत्यागच्छ आर्कटैन(y / x) - पाई
    यदि x == ० और y > ०:
        प्रत्यागच्छ पाई / २
    यदि x == ० और y < ०:
        प्रत्यागच्छ -पाई / २
    प्रत्यागच्छ ०  # x == 0 and y == 0

# ── अतिपरवलयिक फलन (Hyperbolic Functions) ──────────────────────────────────

कर्म अतिवृत्तज_साइन(x):
    टीका Hyperbolic sine: sinh(x) = (e^x - e^-x) / 2
    चर e_x = घात(ई, x)
    प्रत्यागच्छ (e_x - १ / e_x) / २

कर्म अतिवृत्तज_कोसाइन(x):
    टीका Hyperbolic cosine: cosh(x) = (e^x + e^-x) / 2
    चर e_x = घात(ई, x)
    प्रत्यागच्छ (e_x + १ / e_x) / २

कर्म अतिवृत्तज_टैन(x):
    टीका Hyperbolic tangent: tanh(x) = sinh(x)/cosh(x)
    चर e_x = घात(ई, x)
    चर e_neg_x = १ / e_x
    प्रत्यागच्छ (e_x - e_neg_x) / (e_x + e_neg_x)

# ── क्रमगुणित और द्विपद (Factorials and Binomials) ─────────────────────────

कर्म क्रमगुणित(n):
    टीका Factorial: n!
    यदि n < ०:
        उत्क्षिप "ऋणात्मक संख्या का क्रमगुणित नहीं"
    यदि n == ० अथवा n == १:
        प्रत्यागच्छ १
    
    चर परिणाम = १
    प्रत्येक चर i अन्तर्गत परास(२, n + १):
        परिणाम = परिणाम * i
    
    प्रत्यागच्छ परिणाम

कर्म द्विपद_गुणांक(n, k):
    टीका Binomial coefficient: C(n,k) = n! / (k! * (n-k)!)
    यदि k < ० अथवा k > n:
        प्रत्यागच्छ ०
    यदि k == ० अथवा k == n:
        प्रत्यागच्छ १
    
    # Use multiplicative formula for efficiency
    चर परिणाम = १
    प्रत्येक चर i अन्तर्गत परास(k):
        परिणाम = परिणाम * (n - i) / (i + १)
    
    प्रत्यागच्छ पूर्णांक_कर(गोल(परिणाम))

कर्म फिबोनचि(n):
    टीका Fibonacci number F(n) using matrix-free iteration
    यदि n <= ०:
        प्रत्यागच्छ ०
    यदि n == १:
        प्रत्यागच्छ १
    
    चर a = ०
    चर b = १
    प्रत्येक चर _ अन्तर्गत परास(२, n + १):
        चर temp = a + b
        a = b
        b = temp
    
    प्रत्यागच्छ b

# ── श्रेणियाँ (Series) ──────────────────────────────────────────────────────

कर्म समांतर_श्रेणी_योग(प्रथम, अंतिम, पदों_संख्या):
    टीका Sum of arithmetic progression: S = n(a+l)/2
    प्रत्यागच्छ पदों_संख्या * (प्रथम + अंतिम) / २

कर्म गुणोत्तर_श्रेणी_योग(प्रथम, अनुपात, पदों_संख्या):
    टीका Sum of geometric progression: S = a(r^n - 1)/(r - 1)
    यदि अनुपात == १:
        प्रत्यागच्छ प्रथम * पदों_संख्या
    प्रत्यागच्छ प्रथम * (घात(अनुपात, पदों_संख्या) - १) / (अनुपात - १)

कर्म अनंत_गुणोत्तर_योग(प्रथम, अनुपात):
    टीका Sum of infinite geometric series: S = a/(1-r)
    यदि निरपेक्ष(अनुपात) >= १:
        उत्क्षिप "अनंत श्रेणी अभिसरण नहीं करती"
    प्रत्यागच्छ प्रथम / (१ - अनुपात)

# ── अवकलन (Differentiation) ─────────────────────────────────────────────────

कर्म संख्यात्मक_अवकलज(कर्म_नाम, x, h=०.०००१):
    टीका Numerical derivative using central difference
    चर f_x_plus_h = कर्म_नाम(x + h)
    चर f_x_minus_h = कर्म_नाम(x - h)
    प्रत्यागच्छ (f_x_plus_h - f_x_minus_h) / (२ * h)

# ── समाकलन (Integration) ────────────────────────────────────────────────────

कर्म संख्यात्मक_समाकलन(कर्म_नाम, a, b, n=१०००):
    टीका Numerical integration using Simpson's rule
    चर h = (b - a) / n
    चर योग = कर्म_नाम(a) + कर्म_नाम(b)
    
    प्रत्येक चर i अन्तर्गत परास(१, n):
        चर x = a + i * h
        यदि i % २ == ०:
            योग = योग + २ * कर्म_नाम(x)
        अन्यथा:
            योग = योग + ४ * कर्म_नाम(x)
    
    प्रत्यागच्छ योग * h / ३

# ── महत्तम समापवर्तक और लघुत्तम समापवर्त्य ─────────────────────────────────

कर्म महत्तम_समापवर्तक(अ, ब):
    टीका GCD using Euclidean algorithm
    अ = निरपेक्ष(अ)
    ब = निरपेक्ष(ब)
    यावत् ब != ०:
        चर अस्थाई = ब
        ब = अ % ब
        अ = अस्थाई
    प्रत्यागच्छ अ

कर्म लघुत्तम_समापवर्त्य(अ, ब):
    टीका LCM using GCD
    यदि अ == ० अथवा ब == ०:
        प्रत्यागच्छ ०
    प्रत्यागच्छ निरपेक्ष(अ * ब) / महत्तम_समापवर्तक(अ, ब)

# ── अभाज्य संख्याएँ (Prime Numbers) ─────────────────────────────────────────

कर्म अभाज्य_है(n):
    टीका Check if n is prime
    यदि n < २:
        प्रत्यागच्छ असत्य
    यदि n == २:
        प्रत्यागच्छ सत्य
    यदि n % २ == ०:
        प्रत्यागच्छ असत्य
    
    चर i = ३
    यावत् i * i <= n:
        यदि n % i == ०:
            प्रत्यागच्छ असत्य
        i = i + २
    
    प्रत्यागच्छ सत्य

कर्म अभाज्य_सूची(सीमा):
    टीका List of primes up to limit using Sieve of Eratosthenes
    यदि सीमा < २:
        प्रत्यागच्छ []
    
    चर छलनी = []
    प्रत्येक चर _ अन्तर्गत परास(सीमा + १):
        छलनी.जोड़ो(सत्य)
    
    छलनी[०] = असत्य
    छलनी[१] = असत्य
    
    चर i = २
    यावत् i * i <= सीमा:
        यदि छलनी[i]:
            चर j = i * i
            यावत् j <= सीमा:
                छलनी[j] = असत्य
                j = j + i
        i = i + १
    
    चर परिणाम = []
    प्रत्येक चर i अन्तर्गत परास(सीमा + १):
        यदि छलनी[i]:
            परिणाम.जोड़ो(i)
    
    प्रत्यागच्छ परिणाम

# ── संख्या सिद्धांत (Number Theory) ─────────────────────────────────────────

कर्म यूलर_टोशिएंट(n):
    टीका Euler's totient function φ(n)
    चर परिणाम = n
    चर p = २
    
    यावत् p * p <= n:
        यदि n % p == ०:
            यावत् n % p == ०:
                n = n / p
            परिणाम = परिणाम - परिणाम / p
        p = p + १
    
    यदि n > १:
        परिणाम = परिणाम - परिणाम / n
    
    प्रत्यागच्छ पूर्णांक_कर(परिणाम)

कर्म विभाजक_सूची(n):
    टीका List of all divisors of n
    चर परिणाम = []
    प्रत्येक चर i अन्तर्गत परास(१, निरपेक्ष(n) + १):
        यदि n % i == ०:
            परिणाम.जोड़ो(i)
    प्रत्यागच्छ परिणाम

कर्म विभाजक_योग(n):
    टीका Sum of all divisors of n
    चर योग = ०
    प्रत्येक चर d अन्तर्गत विभाजक_सूची(n):
        योग = योग + d
    प्रत्यागच्छ योग

# ── सम्मिश्र संख्याएँ (Complex Numbers) ─────────────────────────────────────

वर्ग सम्मिश्र:
    टीका Complex number: a + bi
    
    कर्म प्रारम्भ(स्वयं, वास्तविक, काल्पनिक=०):
        स्वयं.वास्तविक = वास्तविक
        स्वयं.काल्पनिक = काल्पनिक
    
    कर्म योग(स्वयं, अन्य):
        प्रत्यागच्छ नव सम्मिश्र(
            स्वयं.वास्तविक + अन्य.वास्तविक,
            स्वयं.काल्पनिक + अन्य.काल्पनिक
        )
    
    कर्म व्यवकलन(स्वयं, अन्य):
        प्रत्यागच्छ नव सम्मिश्र(
            स्वयं.वास्तविक - अन्य.वास्तविक,
            स्वयं.काल्पनिक - अन्य.काल्पनिक
        )
    
    कर्म गुणन(स्वयं, अन्य):
        चर वा = स्वयं.वास्तविक * अन्य.वास्तविक - स्वयं.काल्पनिक * अन्य.काल्पनिक
        चर का = स्वयं.वास्तविक * अन्य.काल्पनिक + स्वयं.काल्पनिक * अन्य.वास्तविक
        प्रत्यागच्छ नव सम्मिश्र(वा, का)
    
    कर्म भाग(स्वयं, अन्य):
        चर हर = अन्य.वास्तविक * अन्य.वास्तविक + अन्य.काल्पनिक * अन्य.काल्पनिक
        यदि हर == ०:
            उत्क्षिप "शून्य से भाग नहीं"
        चर वा = (स्वयं.वास्तविक * अन्य.वास्तविक + स्वयं.काल्पनिक * अन्य.काल्पनिक) / हर
        चर का = (स्वयं.काल्पनिक * अन्य.वास्तविक - स्वयं.वास्तविक * अन्य.काल्पनिक) / हर
        प्रत्यागच्छ नव सम्मिश्र(वा, का)
    
    कर्म मापांक(स्वयं):
        प्रत्यागच्छ वर्गमूल(स्वयं.वास्तविक² + स्वयं.काल्पनिक²)
    
    कर्म कोण(स्वयं):
        प्रत्यागच्छ आर्कटैन२(स्वयं.काल्पनिक, स्वयं.वास्तविक)
    
    कर्म संयुग्मी(स्वयं):
        प्रत्यागच्छ नव सम्मिश्र(स्वयं.वास्तविक, -स्वयं.काल्पनिक)
    
    कर्म तार_कर(स्वयं):
        यदि स्वयं.काल्पनिक >= ०:
            प्रत्यागच्छ पाठ_कर(स्वयं.वास्तविक) + " + " + पाठ_कर(स्वयं.काल्पनिक) + "i"
        अन्यथा:
            प्रत्यागच्छ पाठ_कर(स्वयं.वास्तविक) + " - " + पाठ_कर(-स्वयं.काल्पनिक) + "i"

# ── सदिश (Vectors) ──────────────────────────────────────────────────────────

वर्ग सदिश:
    टीका Vector class for n-dimensional vectors
    
    कर्म प्रारम्भ(स्वयं, घटक):
        स्वयं.घटक = घटक
        स्वयं.आयाम = दीर्घता(घटक)
    
    कर्म योग(स्वयं, अन्य):
        यदि स्वयं.आयाम != अन्य.आयाम:
            उत्क्षिप "सदिश आयाम असमान"
        चर परिणाम = []
        प्रत्येक चर i अन्तर्गत परास(स्वयं.आयाम):
            परिणाम.जोड़ो(स्वयं.घटक[i] + अन्य.घटक[i])
        प्रत्यागच्छ नव सदिश(परिणाम)
    
    कर्म व्यवकलन(स्वयं, अन्य):
        यदि स्वयं.आयाम != अन्य.आयाम:
            उत्क्षिप "सदिश आयाम असमान"
        चर परिणाम = []
        प्रत्येक चर i अन्तर्गत परास(स्वयं.आयाम):
            परिणाम.जोड़ो(स्वयं.घटक[i] - अन्य.घटक[i])
        प्रत्यागच्छ नव सदिश(परिणाम)
    
    कर्म अदिश_गुणन(स्वयं, अदिश):
        चर परिणाम = []
        प्रत्येक चर घ अन्तर्गत स्वयं.घटक:
            परिणाम.जोड़ो(घ * अदिश)
        प्रत्यागच्छ नव सदिश(परिणाम)
    
    कर्म डॉट_गुणनफल(स्वयं, अन्य):
        यदि स्वयं.आयाम != अन्य.आयाम:
            उत्क्षिप "सदिश आयाम असमान"
        चर योग = ०
        प्रत्येक चर i अन्तर्गत परास(स्वयं.आयाम):
            योग = योग + स्वयं.घटक[i] * अन्य.घटक[i]
        प्रत्यागच्छ योग
    
    कर्म लंबाई(स्वयं):
        चर योग = ०
        प्रत्येक चर घ अन्तर्गत स्वयं.घटक:
            योग = योग + घ * घ
        प्रत्यागच्छ वर्गमूल(योग)
    
    कर्म सामान्यीकृत(स्वयं):
        चर लंबाई = स्वयं.लंबाई()
        यदि लंबाई == ०:
            उत्क्षिप "शून्य सदिश को सामान्य नहीं किया जा सकता"
        प्रत्यागच्छ स्वयं.अदिश_गुणन(१ / लंबाई)

मुद्रय "गणित विस्तारित पुस्तकालय लोड हुआ। (Comprehensive mathematics library loaded.)"
