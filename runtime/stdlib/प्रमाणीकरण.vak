# वाक् मानक पुस्तकालय — प्रमाणीकरण (Validation)

आयात निम्न, तार_खोजो, तार_अंतिम_खोजो, तार_गिनो, तार_लंबाई, तार_प्रतिस्थापन से bhasha_prasadan


कर्म _अंक_है(च):
    चर कोड = अक्षर_मान(च)
    यदि (कोड >= ४८ और कोड <= ५७) अथवा (कोड >= २४०६ और कोड <= २४१५):
        प्रत्यागच्छ सत्य
    प्रत्यागच्छ असत्य


कर्म _लैटिन_अक्षर_है(च):
    चर कोड = अक्षर_मान(च)
    यदि (कोड >= ६५ और कोड <= ९०) अथवा (कोड >= ९७ और कोड <= १२२):
        प्रत्यागच्छ सत्य
    प्रत्यागच्छ असत्य


कर्म _अंक_मान(च):
    चर कोड = अक्षर_मान(च)
    यदि कोड >= ४८ और कोड <= ५७:
        प्रत्यागच्छ कोड - ४८
    यदि कोड >= २४०६ और कोड <= २४१५:
        प्रत्यागच्छ कोड - २४०६
    उत्क्षिप "अमान्य अंक: " + पाठ_कर(च)


कर्म ईमेल_वैध(ईमेल):
    यदि तार_लंबाई(ईमेल) < ५:
        प्रत्यागच्छ असत्य
    यदि तार_गिनो(ईमेल, "@") != १:
        प्रत्यागच्छ असत्य

    चर at = तार_खोजो(ईमेल, "@")
    यदि at <= ० अथवा at >= तार_लंबाई(ईमेल) - १:
        प्रत्यागच्छ असत्य

    चर अंतिम_बिंदु = तार_अंतिम_खोजो(ईमेल, ".")
    यदि अंतिम_बिंदु <= at + १:
        प्रत्यागच्छ असत्य
    यदि अंतिम_बिंदु >= तार_लंबाई(ईमेल) - १:
        प्रत्यागच्छ असत्य

    प्रत्यागच्छ सत्य


कर्म लूहन_जाँच(संख्या_पाठ):
    संख्या_पाठ = तार_प्रतिस्थापन(पाठ_कर(संख्या_पाठ), " ", "")
    संख्या_पाठ = तार_प्रतिस्थापन(संख्या_पाठ, "-", "")
    यदि तार_लंबाई(संख्या_पाठ) == ०:
        प्रत्यागच्छ असत्य

    चर योग = ०
    चर दोगुना = असत्य
    चर ग = तार_लंबाई(संख्या_पाठ) - १
    यावत् ग >= ०:
        यदि न _अंक_है(संख्या_पाठ[ग]):
            प्रत्यागच्छ असत्य
        चर अंक = _अंक_मान(संख्या_पाठ[ग])
        यदि दोगुना:
            अंक = अंक * २
            यदि अंक > ९:
                अंक = अंक - ९
        योग += अंक
        दोगुना = न दोगुना
        ग -= १
    प्रत्यागच्छ योग % १० == ०


कर्म फोन_वैध(फोन):
    चर अंक_गिनती = ०
    प्रत्येक चर च अन्तर्गत फोन:
        यदि _अंक_है(च):
            अंक_गिनती += १
    प्रत्यागच्छ अंक_गिनती == १०


कर्म URL_वैध(यूआरएल):
    चर छोटा = निम्न(पाठ_कर(यूआरएल))
    यदि न (छोटा[०:७] == "http://" अथवा छोटा[०:८] == "https://"):
        प्रत्यागच्छ असत्य
    चर योजना_लंबाई = ७
    यदि छोटा[०:८] == "https://":
        योजना_लंबाई = ८
    यदि तार_खोजो(छोटा[योजना_लंबाई:तार_लंबाई(छोटा)], ".") == -१:
        प्रत्यागच्छ असत्य
    प्रत्यागच्छ सत्य


कर्म संकेत_शक्ति(संकेत):
    चर शक्ति = ०
    यदि तार_लंबाई(संकेत) >= ८:
        शक्ति += १
    यदि तार_लंबाई(संकेत) >= १२:
        शक्ति += १

    चर बड़ा = असत्य
    चर छोटा = असत्य
    चर अंक_मिला = असत्य
    प्रत्येक चर च अन्तर्गत संकेत:
        चर कोड = अक्षर_मान(च)
        यदि कोड >= ६५ और कोड <= ९०:
            बड़ा = सत्य
        यदि कोड >= ९७ और कोड <= १२२:
            छोटा = सत्य
        यदि _अंक_है(च):
            अंक_मिला = सत्य

    यदि बड़ा और छोटा और अंक_मिला:
        शक्ति += २
    अन्यथा यदि (बड़ा अथवा छोटा) और अंक_मिला:
        शक्ति += १

    यदि शक्ति <= १:
        प्रत्यागच्छ "कमज़ोर"
    यदि शक्ति == २:
        प्रत्यागच्छ "मध्यम"
    यदि शक्ति == ३:
        प्रत्यागच्छ "मजबूत"
    प्रत्यागच्छ "बहुत मजबूत"


कर्म संख्यात्मक_है(स्ट्र):
    यदि तार_लंबाई(स्ट्र) == ०:
        प्रत्यागच्छ असत्य

    चर प्रारंभ = ०
    यदि स्ट्र[०] == "-" अथवा स्ट्र[०] == "+":
        यदि तार_लंबाई(स्ट्र) == १:
            प्रत्यागच्छ असत्य
        प्रारंभ = १

    चर बिंदु_मिला = असत्य
    चर ग = प्रारंभ
    यावत् ग < तार_लंबाई(स्ट्र):
        चर च = स्ट्र[ग]
        यदि च == ".":
            यदि बिंदु_मिला:
                प्रत्यागच्छ असत्य
            बिंदु_मिला = सत्य
        अन्यथा यदि न _अंक_है(च):
            प्रत्यागच्छ असत्य
        ग += १
    प्रत्यागच्छ सत्य


कर्म वर्णमाला_है(स्ट्र):
    यदि तार_लंबाई(स्ट्र) == ०:
        प्रत्यागच्छ असत्य
    प्रत्येक चर च अन्तर्गत स्ट्र:
        यदि न _लैटिन_अक्षर_है(च):
            प्रत्यागच्छ असत्य
    प्रत्यागच्छ सत्य


कर्म अल्फान्यूमेरिक_है(स्ट्र):
    यदि तार_लंबाई(स्ट्र) == ०:
        प्रत्यागच्छ असत्य
    प्रत्येक चर च अन्तर्गत स्ट्र:
        यदि न (_लैटिन_अक्षर_है(च) अथवा _अंक_है(च)):
            प्रत्यागच्छ असत्य
    प्रत्यागच्छ सत्य
