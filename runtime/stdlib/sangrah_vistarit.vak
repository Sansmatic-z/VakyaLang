# ── क्रमबद्ध एल्गोरिदम (Sorting Algorithms) ────────────────────────────────

कर्म सूची_प्रतिलिपि(सूची):
    टीका Create a shallow copy so sort helpers do not mutate caller input
    चर परिणाम = []
    प्रत्येक चर तत्व अन्तर्गत सूची:
        परिणाम.जोड़ो(तत्व)
    प्रत्यागच्छ परिणाम

कर्म बुलबुला_क्रमबद्ध(सूची):
    टीका Bubble Sort - O(n²)
    चर n = दीर्घता(सूची)
    चर परिणाम = सूची_प्रतिलिपि(सूची)
    
    प्रत्येक चर i अन्तर्गत परास(n):
        प्रत्येक चर j अन्तर्गत परास(०, n - i - १):
            यदि परिणाम[j] > परिणाम[j + १]:
                चर temp = परिणाम[j]
                परिणाम[j] = परिणाम[j + १]
                परिणाम[j + १] = temp
    
    प्रत्यागच्छ परिणाम

कर्म चयन_क्रमबद्ध(सूची):
    टीका Selection Sort - O(n²)
    चर n = दीर्घता(सूची)
    चर परिणाम = सूची_प्रतिलिपि(सूची)
    
    प्रत्येक चर i अन्तर्गत परास(n):
        चर न्यूनतम_सूचकांक = i
        प्रत्येक चर j अन्तर्गत परास(i + १, n):
            यदि परिणाम[j] < परिणाम[न्यूनतम_सूचकांक]:
                न्यूनतम_सूचकांक = j
        
        यदि न्यूनतम_सूचकांक != i:
            चर temp = परिणाम[i]
            परिणाम[i] = परिणाम[न्यूनतम_सूचकांक]
            परिणाम[न्यूनतम_सूचकांक] = temp
    
    प्रत्यागच्छ परिणाम

कर्म सम्मिलन_क्रमबद्ध(सूची):
    टीका Insertion Sort - O(n²)
    चर n = दीर्घता(सूची)
    चर परिणाम = सूची_प्रतिलिपि(सूची)
    
    प्रत्येक चर i अन्तर्गत परास(१, n):
        चर कुंजी = परिणाम[i]
        चर j = i - १
        
        यावत् j >= ० और परिणाम[j] > कुंजी:
            परिणाम[j + १] = परिणाम[j]
            j = j - १
        
        परिणाम[j + १] = कुंजी
    
    प्रत्यागच्छ परिणाम

कर्म द्रुत_क्रमबद्ध(सूची):
    टीका Quick Sort - O(n log n) average
    यदि दीर्घता(सूची) <= १:
        प्रत्यागच्छ सूची
    
    चर pivot = सूची[दीर्घता(सूची) // २]
    चर बायाँ = []
    चर मध्य = []
    चर दायाँ = []
    
    प्रत्येक चर तत्व अन्तर्गत सूची:
        यदि तत्व < pivot:
            बायाँ.जोड़ो(तत्व)
        अन्यथा यदि तत्व > pivot:
            दायाँ.जोड़ो(तत्व)
        अन्यथा:
            मध्य.जोड़ो(तत्व)
    
    प्रत्यागच्छ संयोजन(द्रुत_क्रमबद्ध(बायाँ), संयोजन(मध्य, द्रुत_क्रमबद्ध(दायाँ)))

कर्म मिश्रण_क्रमबद्ध(सूची):
    टीका Merge Sort - O(n log n)
    यदि दीर्घता(सूची) <= १:
        प्रत्यागच्छ सूची
    
    चर मध्य = दीर्घता(सूची) // २
    चर बायाँ = मिश्रण_क्रमबद्ध(तार_उपतार(सूची, ०, मध्य))
    चर दायाँ = मिश्रण_क्रमबद्ध(तार_उपतार(सूची, मध्य, दीर्घता(सूची)))
    
    प्रत्यागच्छ मिश्रण(बायाँ, दायाँ)

कर्म मिश्रण(बायाँ, दायाँ):
    टीका Merge two sorted lists
    चर परिणाम = []
    चर i = ०
    चर j = ०
    
    यावत् i < दीर्घता(बायाँ) और j < दीर्घता(दायाँ):
        यदि बायाँ[i] <= दायाँ[j]:
            परिणाम.जोड़ो(बायाँ[i])
            i = i + १
        अन्यथा:
            परिणाम.जोड़ो(दायाँ[j])
            j = j + १
    
    यावत् i < दीर्घता(बायाँ):
        परिणाम.जोड़ो(बायाँ[i])
        i = i + १
    
    यावत् j < दीर्घता(दायाँ):
        परिणाम.जोड़ो(दायाँ[j])
        j = j + १
    
    प्रत्यागच्छ परिणाम

कर्म हीप_क्रमबद्ध(सूची):
    टीका Heap Sort - O(n log n)
    चर n = दीर्घता(सूची)
    चर परिणाम = सूची_प्रतिलिपि(सूची)
    
    # Build max heap
    प्रत्येक चर i अन्तर्गत परास(n // २ - १, -१, -१):
        हीपify(परिणाम, n, i)
    
    # Extract elements
    प्रत्येक चर i अन्तर्गत परास(n - १, ०, -१):
        चर temp = परिणाम[०]
        परिणाम[०] = परिणाम[i]
        परिणाम[i] = temp
        हीपify(परिणाम, i, ०)
    
    प्रत्यागच्छ परिणाम

कर्म हीपify(सूची, n, i):
    टीका Heapify subtree rooted at i
    चर largest = i
    चर बायाँ = २ * i + १
    चर दायाँ = २ * i + २
    
    यदि बायाँ < n और सूची[बायाँ] > सूची[largest]:
        largest = बायाँ
    
    यदि दायाँ < n और सूची[दायाँ] > सूची[largest]:
        largest = दायाँ
    
    यदि largest != i:
        चर temp = सूची[i]
        सूची[i] = सूची[largest]
        सूची[largest] = temp
        हीपify(सूची, n, largest)

# ── खोज एल्गोरिदम (Search Algorithms) ─────────────────────────────────────

कर्म रैखिक_खोज(सूची, लक्ष्य):
    टीका Linear Search - O(n)
    प्रत्येक चर i अन्तर्गत परास(दीर्घता(सूची)):
        यदि सूची[i] == लक्ष्य:
            प्रत्यागच्छ i
    प्रत्यागच्छ -१

कर्म द्विआधारी_खोज(सूची, लक्ष्य):
    टीका Binary Search - O(log n), requires sorted list
    चर बायाँ = ०
    चर दायाँ = दीर्घता(सूची) - १
    
    यावत् बायाँ <= दायाँ:
        चर मध्य = (बायाँ + दायाँ) // २
        
        यदि सूची[मध्य] == लक्ष्य:
            प्रत्यागच्छ मध्य
        अन्यथा यदि सूची[मध्य] < लक्ष्य:
            बायाँ = मध्य + १
        अन्यथा:
            दायाँ = मध्य - १
    
    प्रत्यागच्छ -१

कर्म अन्तराल_खोज(सूची, लक्ष्य):
    टीका Jump Search - O(√n), requires sorted list
    चर n = दीर्घता(सूची)
    चर step = वर्गमूल(n)
    चर prev = ०
    
    यावत् सूची[फर्श(step) - १] < लक्ष्य:
        prev = step
        step = step + वर्गमूल(n)
        यदि prev >= n:
            प्रत्यागच्छ -१
    
    यावत् सूची[prev] < लक्ष्य:
        prev = prev + १
        यदि prev > न्यूनतम(step, n):
            प्रत्यागच्छ -१
    
    यदि सूची[prev] == लक्ष्य:
        प्रत्यागच्छ prev
    
    प्रत्यागच्छ -१

# ── ग्राफ संरचना (Graph Data Structure) ────────────────────────────────────

वर्ग ग्राफ:
    टीका Graph data structure with adjacency list
    
    कर्म प्रारम्भ(स्वयं):
        स्वयं.श्रृंखला = {}
    
    कर्म शीर्ष_जोड़ो(स्वयं, शीर्ष):
        यदि शीर्ष not in स्वयं.श्रृंखला:
            स्वयं.श्रृंखला[शीर्ष] = []
    
    कर्म किनारा_जोड़ो(स्वयं, v1, v2, भार=१):
        स्वयं.शीर्ष_जोड़ो(v1)
        स्वयं.शीर्ष_जोड़ो(v2)
        स्वयं.श्रृंखला[v1].जोड़ो([v2, भार])
        स्वयं.श्रृंखला[v2].जोड़ो([v1, भार])  # Undirected
    
    कर्म किनारा_जोड़ो_निर्देशित(स्वयं, v1, v2, भार=१):
        स्वयं.शीर्ष_जोड़ो(v1)
        स्वयं.शीर्ष_जोड़ो(v2)
        स्वयं.श्रृंखला[v1].जोड़ो([v2, भार])
    
    कर्म पड़ोसी(स्वयं, शीर्ष):
        यदि शीर्ष in स्वयं.श्रृंखला:
            प्रत्यागच्छ स्वयं.श्रृंखला[शीर्ष]
        प्रत्यागच्छ []
    
    कर्म शीर्ष(स्वयं):
        प्रत्यागच्छ स्वयं.श्रृंखला.कुंजियाँ()
    
    कर्म शीर्ष_गिनो(स्वयं):
        चर गणना = ०
        प्रत्येक चर _ अन्तर्गत स्वयं.श्रृंखला:
            गणना = गणना + १
        प्रत्यागच्छ गणना
    
    कर्म किनारा_गिनो(स्वयं):
        चर गणना = ०
        प्रत्येक चर शीर्ष अन्तर्गत स्वयं.श्रृंखला:
            गणना = गणना + दीर्घता(स्वयं.श्रृंखला[शीर्ष])
        प्रत्यागच्छ गणना // २  # Undirected
    
    कर्म बीएफएस(स्वयं, प्रारम्भ):
        टीका Breadth-First Search
        चर परिणाम = []
        चर देखा_गया = {}
        चर कतार = [प्रारम्भ]
        देखा_गया[प्रारम्भ] = सत्य
        
        यावत् दीर्घता(कतार) > ०:
            चर वर्तमान = कतार.हटाओ(०)
            परिणाम.जोड़ो(वर्तमान)
            
            प्रत्येक चर पड़ोसी अन्तर्गत स्वयं.पड़ोसी(वर्तमान):
                चर पड़ोसी_शीर्ष = पड़ोसी[०]
                यदि पड़ोसी_शीर्ष not in देखा_गया:
                    देखा_गया[पड़ोसी_शीर्ष] = सत्य
                    कतार.जोड़ो(पड़ोसी_शीर्ष)
        
        प्रत्यागच्छ परिणाम
    
    कर्म डीएफएस(स्वयं, प्रारम्भ):
        टीका Depth-First Search
        चर परिणाम = []
        चर देखा_गया = {}
        
        स्वयं._डीएफएस_सहायक(प्रारम्भ, देखा_गया, परिणाम)
        प्रत्यागच्छ परिणाम
    
    कर्म _डीएफएस_सहायक(स्वयं, शीर्ष, देखा_गया, परिणाम):
        देखा_गया[शीर्ष] = सत्य
        परिणाम.जोड़ो(शीर्ष)
        
        प्रत्येक चर पड़ोसी अन्तर्गत स्वयं.पड़ोसी(शीर्ष):
            चर पड़ोसी_शीर्ष = पड़ोसी[०]
            यदि पड़ोसी_शीर्ष not in देखा_गया:
                स्वयं._डीएफएस_सहायक(पड़ोसी_शीर्ष, देखा_गया, परिणाम)
    
    कर्म मार्ग_खोजो(स्वयं, प्रारम्भ, अंत):
        टीका Find path using BFS
        चर कतार = [[प्रारम्भ]]
        चर देखा_गया = {प्रारम्भ}
        
        यावत् दीर्घता(कतार) > ०:
            चर मार्ग = कतार.हटाओ(०)
            चर शीर्ष = मार्ग[दीर्घता(मार्ग) - १]
            
            यदि शीर्ष == अंत:
                प्रत्यागच्छ मार्ग
            
            प्रत्येक चर पड़ोसी अन्तर्गत स्वयं.पड़ोसी(शीर्ष):
                चर पड़ोसी_शीर्ष = पड़ोसी[०]
                यदि पड़ोसी_शीर्ष not in देखा_गया:
                    देखा_गया[पड़ोसी_शीर्ष] = सत्य
                    चर नया_मार्ग = मार्ग + [पड़ोसी_शीर्ष]
                    कतार.जोड़ो(नया_मार्ग)
        
        प्रत्यागच्छ []  # No path found

# ── ट्री संरचना (Tree Data Structures) ────────────────────────────────────

वर्ग सामान्य_ट्री:
    टीका General Tree data structure
    
    कर्म प्रारम्भ(स्वयं, मान):
        स्वयं.मान = मान
        स्वयं.बच्चे = []
    
    कर्म बच्चा_जोड़ो(स्वयं, child_node):
        स्वयं.बच्चे.जोड़ो(child_node)
    
    कर्म बच्चा_हटाओ(स्वयं, child_node):
        चर index = -१
        प्रत्येक चर i अन्तर्गत परास(दीर्घता(स्वयं.बच्चे)):
            यदि स्वयं.बच्चे[i] == child_node:
                index = i
                तोड़ो
        यदि index != -१:
            स्वयं.बच्चे.हटाओ(index)
    
    कर्म ऊँचाई(स्वयं):
        यदि दीर्घता(स्वयं.बच्चे) == ०:
            प्रत्यागच्छ १
        चर अधिकतम_ऊँचाई = ०
        प्रत्येक चर child अन्तर्गत स्वयं.बच्चे:
            चर h = child.ऊँचाई()
            यदि h > अधिकतम_ऊँचाई:
                अधिकतम_ऊँचाई = h
        प्रत्यागच्छ १ + अधिकतम_ऊँचाई
    
    कर्म आकार(स्वयं):
        चर गणना = १
        प्रत्येक चर child अन्तर्गत स्वयं.बच्चे:
            गणना = गणना + child.आकार()
        प्रत्यागच्छ गणना
    
    कर्म प्रीऑर्डर(स्वयं):
        चर परिणाम = [स्वयं.मान]
        प्रत्येक चर child अन्तर्गत स्वयं.बच्चे:
            चर child_result = child.प्रीऑर्डर()
            प्रत्येक चर v अन्तर्गत child_result:
                परिणाम.जोड़ो(v)
        प्रत्यागच्छ परिणाम
    
    कर्म पोस्टऑर्डर(स्वयं):
        चर परिणाम = []
        प्रत्येक चर child अन्तर्गत स्वयं.बच्चे:
            चर child_result = child.पोस्टऑर्डर()
            प्रत्येक चर v अन्तर्गत child_result:
                परिणाम.जोड़ो(v)
        परिणाम.जोड़ो(स्वयं.मान)
        प्रत्यागच्छ परिणाम

# ── हीप संरचना (Heap Data Structure) ──────────────────────────────────────

वर्ग न्यूनतम_हीप:
    टीका Min-Heap implementation
    
    कर्म प्रारम्भ(स्वयं):
        स्वयं.हीप = []
    
    कर्म जोड़ो(स्वयं, मान):
        स्वयं.हीप.जोड़ो(मान)
        स्वयं._ऊपर_जाओ(दीर्घता(स्वयं.हीप) - १)
    
    कर्म निकालो(स्वयं):
        यदि दीर्घता(स्वयं.हीप) == ०:
            उत्क्षिप "हीप रिक्त है"
        
        चर न्यूनतम = स्वयं.हीप[०]
        स्वयं.हीप[०] = स्वयं.हीप[दीर्घता(स्वयं.हीप) - १]
        स्वयं.हीप.हटाओ(दीर्घता(स्वयं.हीप) - १)
        
        यदि दीर्घता(स्वयं.हीप) > ०:
            स्वयं._नीचे_जाओ(०)
        
        प्रत्यागच्छ न्यूनतम
    
    कर्म न्यूनतम(स्वयं):
        यदि दीर्घता(स्वयं.हीप) == ०:
            प्रत्यागच्छ शून्य
        प्रत्यागच्छ स्वयं.हीप[०]
    
    कर्म आकार(स्वयं):
        प्रत्यागच्छ दीर्घता(स्वयं.हीप)
    
    कर्म _ऊपर_जाओ(स्वयं, index):
        यावत् index > ०:
            चर parent = (index - १) // २
            यदि स्वयं.हीप[parent] <= स्वयं.हीप[index]:
                तोड़ो
            चर temp = स्वयं.हीप[parent]
            स्वयं.हीप[parent] = स्वयं.हीप[index]
            स्वयं.हीप[index] = temp
            index = parent
    
    कर्म _नीचे_जाओ(स्वयं, index):
        चर n = दीर्घता(स्वयं.हीप)
        यावत् सत्य:
            चर smallest = index
            चर बायाँ = २ * index + १
            चर दायाँ = २ * index + २
            
            यदि बायाँ < n और स्वयं.हीप[बायाँ] < स्वयं.हीप[smallest]:
                smallest = बायाँ
            यदि दायाँ < n और स्वयं.हीप[दायाँ] < स्वयं.हीप[smallest]:
                smallest = दायाँ
            
            यदि smallest == index:
                तोड़ो
            
            चर temp = स्वयं.हीप[index]
            स्वयं.हीप[index] = स्वयं.हीप[smallest]
            स्वयं.हीप[smallest] = temp
            index = smallest

वर्ग अधिकतम_हीप:
    टीका Max-Heap implementation
    
    कर्म प्रारम्भ(स्वयं):
        स्वयं.हीप = []
    
    कर्म जोड़ो(स्वयं, मान):
        स्वयं.हीप.जोड़ो(मान)
        स्वयं._ऊपर_जाओ(दीर्घता(स्वयं.हीप) - १)
    
    कर्म निकालो(स्वयं):
        यदि दीर्घता(स्वयं.हीप) == ०:
            उत्क्षिप "हीप रिक्त है"
        
        चर अधिकतम = स्वयं.हीप[०]
        स्वयं.हीप[०] = स्वयं.हीप[दीर्घता(स्वयं.हीप) - १]
        स्वयं.हीप.हटाओ(दीर्घता(स्वयं.हीप) - १)
        
        यदि दीर्घता(स्वयं.हीप) > ०:
            स्वयं._नीचे_जाओ(०)
        
        प्रत्यागच्छ अधिकतम
    
    कर्म अधिकतम(स्वयं):
        यदि दीर्घता(स्वयं.हीप) == ०:
            प्रत्यागच्छ शून्य
        प्रत्यागच्छ स्वयं.हीप[०]
    
    कर्म आकार(स्वयं):
        प्रत्यागच्छ दीर्घता(स्वयं.हीप)
    
    कर्म _ऊपर_जाओ(स्वयं, index):
        यावत् index > ०:
            चर parent = (index - १) // २
            यदि स्वयं.हीप[parent] >= स्वयं.हीप[index]:
                तोड़ो
            चर temp = स्वयं.हीप[parent]
            स्वयं.हीप[parent] = स्वयं.हीप[index]
            स्वयं.हीप[index] = temp
            index = parent
    
    कर्म _नीचे_जाओ(स्वयं, index):
        चर n = दीर्घता(स्वयं.हीप)
        यावत् सत्य:
            चर largest = index
            चर बायाँ = २ * index + १
            चर दायाँ = २ * index + २
            
            यदि बायाँ < n और स्वयं.हीप[बायाँ] > स्वयं.हीप[largest]:
                largest = बायाँ
            यदि दायाँ < n और स्वयं.हीप[दायाँ] > स्वयं.हीप[largest]:
                largest = दायाँ
            
            यदि largest == index:
                तोड़ो
            
            चर temp = स्वयं.हीप[index]
            स्वयं.हीप[index] = स्वयं.हीप[largest]
            स्वयं.हीप[largest] = temp
            index = largest

# ── उपयोगिता फलन (Utility Functions) ─────────────────────────────────────

कर्म संयोजन(सूची१, सूची२):
    टीका Concatenate two lists
    चर परिणाम = []
    प्रत्येक चर v अन्तर्गत सूची१:
        परिणाम.जोड़ो(v)
    प्रत्येक चर v अन्तर्गत सूची२:
        परिणाम.जोड़ो(v)
    प्रत्यागच्छ परिणाम

कर्म न्यूनतम(सूची):
    टीका Find minimum element
    यदि दीर्घता(सूची) == ०:
        प्रत्यागच्छ शून्य
    चर min_val = सूची[०]
    प्रत्येक चर v अन्तर्गत सूची:
        यदि v < min_val:
            min_val = v
    प्रत्यागच्छ min_val

कर्म अधिकतम(सूची):
    टीका Find maximum element
    यदि दीर्घता(सूची) == ०:
        प्रत्यागच्छ शून्य
    चर max_val = सूची[०]
    प्रत्येक चर v अन्तर्गत सूची:
        यदि v > max_val:
            max_val = v
    प्रत्यागच्छ max_val

कर्म योग(सूची):
    टीका Sum of all elements
    चर total = ०
    प्रत्येक चर v अन्तर्गत सूची:
        total = total + v
    प्रत्यागच्छ total

कर्म माध्य(सूची):
    टीका Average/mean of elements
    चर n = दीर्घता(सूची)
    यदि n == ०:
        प्रत्यागच्छ ०
    प्रत्यागच्छ योग(सूची) / n

कर्म मध्यक(सूची):
    टीका Median of elements
    चर sorted_list = बुलबुला_क्रमबद्ध(सूची)
    चर n = दीर्घता(sorted_list)
    यदि n == ०:
        प्रत्यागच्छ ०
    यदि n % २ == १:
        प्रत्यागच्छ sorted_list[n // २]
    अन्यथा:
        चर mid = n // २
        प्रत्यागच्छ (sorted_list[mid - १] + sorted_list[mid]) / २

कर्म बहुलक(सूची):
    टीका Mode - most frequent element
    यदि दीर्घता(सूची) == ०:
        प्रत्यागच्छ शून्य
    
    चर गणना = {}
    प्रत्येक चर v अन्तर्गत सूची:
        यदि v in गणना:
            गणना[v] = गणना[v] + १
        अन्यथा:
            गणना[v] = १
    
    चर अधिकतम_गणना = ०
    चर mode = सूची[०]
    
    प्रत्येक चर key अन्तर्गत गणना:
        यदि गणना[key] > अधिकतम_गणना:
            अधिकतम_गणना = गणना[key]
            mode = key
    
    प्रत्यागच्छ mode

