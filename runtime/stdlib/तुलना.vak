# वाक् मानक पुस्तकालय — तुलना (Deep Comparison)

कर्म गहरा_बराबर(अ, ब):
    यदि प्रकार(अ) != प्रकार(ब):
        प्रत्यागच्छ असत्य

    यदि प्रकार(अ) == "NoneType" अथवा प्रकार(अ) == "bool" अथवा प्रकार(अ) == "int" अथवा प्रकार(अ) == "float" अथवा प्रकार(अ) == "str":
        प्रत्यागच्छ अ == ब

    यदि प्रकार(अ) == "list" अथवा प्रकार(अ) == "tuple":
        यदि दीर्घता(अ) != दीर्घता(ब):
            प्रत्यागच्छ असत्य
        चर ग = ०
        यावत् ग < दीर्घता(अ):
            यदि न गहरा_बराबर(अ[ग], ब[ग]):
                प्रत्यागच्छ असत्य
            ग += १
        प्रत्यागच्छ सत्य

    यदि प्रकार(अ) == "dict":
        यदि दीर्घता(कुंजियाँ(अ)) != दीर्घता(कुंजियाँ(ब)):
            प्रत्यागच्छ असत्य
        प्रत्येक चर कुंजी अन्तर्गत कुंजियाँ(अ):
            यदि न (कुंजी in ब):
                प्रत्यागच्छ असत्य
            यदि न गहरा_बराबर(अ[कुंजी], ब[कुंजी]):
                प्रत्यागच्छ असत्य
        प्रत्यागच्छ सत्य

    यदि प्रकार(अ) == "set":
        यदि दीर्घता(अ) != दीर्घता(ब):
            प्रत्यागच्छ असत्य
        प्रत्येक चर तत्व अन्तर्गत अ:
            यदि न (तत्व in ब):
                प्रत्यागच्छ असत्य
        प्रत्यागच्छ सत्य

    प्रत्यागच्छ अ == ब
